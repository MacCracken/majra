# --- error.cyr ---

# majra/error — error codes and result helpers
#
# Replaces Rust's MajraError enum + IpcError enum.
# Uses integer error codes. Detail messages stored in a global buffer.

# --- MajraError codes ---
enum MajraErr {
    ERR_NONE = 0;
    ERR_QUEUE = 1;
    ERR_PUBSUB = 2;
    ERR_RELAY = 3;
    ERR_IPC = 4;
    ERR_HEARTBEAT = 5;
    ERR_BARRIER = 6;
    ERR_DAG_CYCLE = 7;
    ERR_CAPACITY = 8;
    ERR_INVALID_STATE = 9;
    ERR_RESOURCE_UNAVAIL = 10;
    ERR_PERSISTENCE = 11;
    ERR_WORKFLOW_VALIDATION = 12;
    ERR_WORKFLOW_STEP = 13;
    ERR_WORKFLOW_NOT_FOUND = 14;
    ERR_WORKFLOW_STORAGE = 15;
}

# --- IpcError codes ---
enum IpcErr {
    ERR_IPC_FRAME_TOO_LARGE = 100;
    ERR_IPC_CONN_CLOSED = 101;
    ERR_IPC_IO = 102;
    ERR_IPC_JSON = 103;
}

# --- Error message buffer ---
# Stores the detail string for the most recent error.
var _err_msg_buf[64];
var _err_msg_len = 0;

# Set the error detail message (copies up to 504 bytes).
# ⚠ PROCESS-GLOBAL, UNSYNCHRONISED, AND BORROWED BY get_err_msg.
#
# set_err_msg writes a single process-wide buffer and get_err_msg returns a Str
# that BORROWS it, so any later error anywhere in the process rewrites the
# contents of a Str a caller is still holding — and two threads erroring at
# once interleave bytes into one message. This is a diagnostic aid, not a
# reliable channel: copy the bytes out immediately if you need them to survive,
# and do not rely on it from multiple threads. The typed MajraErr codes
# returned through Result are the load-bearing error channel.
fn set_err_msg(msg) {
    var len = str_len(msg);
    if (len > 504) {
        len = 504;
    }
    var src = str_data(msg);
    var i = 0;
    while (i < len) {
        store8(&_err_msg_buf + i, load8(src + i));
        i = i + 1;
    }
    _err_msg_len = len;
}

# Get the current error message as a Str.
fn get_err_msg() {
    return str_new(&_err_msg_buf, _err_msg_len);
}

# Clear the error message.
fn clear_err_msg() {
    _err_msg_len = 0;
}

# Create a majra error result with a message.
fn majra_err(code, msg) {
    set_err_msg(msg);
    return Err(code);
}

# Print an error code name for debugging.
fn err_name(code) {
    if (code == ERR_NONE) { return "ok"; }
    if (code == ERR_QUEUE) { return "queue"; }
    if (code == ERR_PUBSUB) { return "pubsub"; }
    if (code == ERR_RELAY) { return "relay"; }
    if (code == ERR_IPC) { return "ipc"; }
    if (code == ERR_HEARTBEAT) { return "heartbeat"; }
    if (code == ERR_BARRIER) { return "barrier"; }
    if (code == ERR_DAG_CYCLE) { return "dag_cycle"; }
    if (code == ERR_CAPACITY) { return "capacity"; }
    if (code == ERR_INVALID_STATE) { return "invalid_state"; }
    if (code == ERR_RESOURCE_UNAVAIL) { return "resource_unavail"; }
    if (code == ERR_PERSISTENCE) { return "persistence"; }
    if (code == ERR_WORKFLOW_VALIDATION) { return "workflow_validation"; }
    if (code == ERR_WORKFLOW_STEP) { return "workflow_step"; }
    if (code == ERR_WORKFLOW_NOT_FOUND) { return "workflow_not_found"; }
    if (code == ERR_WORKFLOW_STORAGE) { return "workflow_storage"; }
    if (code == ERR_IPC_FRAME_TOO_LARGE) { return "ipc_frame_too_large"; }
    if (code == ERR_IPC_CONN_CLOSED) { return "ipc_conn_closed"; }
    if (code == ERR_IPC_IO) { return "ipc_io"; }
    if (code == ERR_IPC_JSON) { return "ipc_json"; }
    return "unknown";
}

# --- counter.cyr ---

# majra/counter — mutex-protected counter and map eviction helper
#
# Replaces Rust's AtomicU64 Counter and evict_from_dashmap utility.

# Counter struct layout (16 bytes):
#   offset 0: value (i64)
#   offset 8: mutex ptr (i64)

fn counter_new() {
    var c = fl_alloc(16);
    store64(c, 0);
    store64(c + 8, mutex_new());
    return c;
}

fn counter_inc(c) {
    var m = load64(c + 8);
    mutex_lock(m);
    store64(c, load64(c) + 1);
    mutex_unlock(m);
}

fn counter_add(c, n) {
    var m = load64(c + 8);
    mutex_lock(m);
    store64(c, load64(c) + n);
    mutex_unlock(m);
}

fn counter_get(c) {
    return load64(c);
}

# Evict entries from a hashmap where predicate_fn(key, value) returns 1.
# Returns number of entries evicted.
#
# Rewritten at 2.6.9 to be ALLOCATION-FREE. It previously built two vecs per
# call (map_keys plus a keys_to_remove list), both from the BUMP allocator,
# which never reclaims — the exact leak ratelimit_evict_stale was rewritten to
# eliminate at 2.6.4, still sitting here in the generic helper.
#
# It walks the slot array directly. Deleting during the walk is safe because
# map_delete leaves a tombstone rather than reshuffling: _map_find skips
# st == 2 and _map_grow_a rehashes only live entries, so no slot this loop has
# yet to visit is moved.
#
# ⚠ The caller owns key/value lifetime. This helper removes the ENTRY only; it
# does not free the key or the value, because it cannot know how they were
# allocated. See ratelimit_evict_stale for the pattern that frees both.
fn map_evict(m, predicate_fn) {
    var entries = map_entries(m);
    var cap = map_cap(m);
    var evicted = 0;
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var k = load64(ep);
            var v = load64(ep + 8);
            if (fncall2(predicate_fn, k, v) == 1) {
                map_delete(m, k);
                evicted = evicted + 1;
            }
        }
        i = i + 1;
    }
    return evicted;
}

# --- envelope.cyr ---

# majra/envelope — universal message envelope
#
# Every message flowing through pub/sub, relay, or IPC shares this structure.

# Target kinds
enum TargetKind {
    TARGET_NODE = 0;
    TARGET_TOPIC = 1;
    TARGET_BROADCAST = 2;
}

# Envelope struct layout (56 bytes, 7 fields):
#   offset  0: id_hi     (i64) — upper 64 bits of UUID
#   offset  8: id_lo     (i64) — lower 64 bits of UUID
#   offset 16: from      (i64) — Str pointer (sender ID)
#   offset 24: to_kind   (i64) — TargetKind enum value
#   offset 32: to_name   (i64) — Str pointer (node/topic name, 0 for broadcast)
#   offset 40: payload   (i64) — pointer to payload data (Str or json)
#   offset 48: timestamp (i64) — nanoseconds since CLOCK_MONOTONIC

var SYS_CLOCK_GETTIME = 228;
var SYS_GETRANDOM = 318;

# Get current monotonic time in nanoseconds.
fn time_now_ns() {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: monotonic uptime in ms (#40); no clock_gettime (228 is out of
    # the frozen 0-63 range). Coarse (100 Hz tick) but correct.
    return sys_uptime_ms() * 1000000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 16 bytes for a struct timespec (2×i64). Function-local `var X[N]` is
    # N BYTES, so `var ts[2]` = 2 bytes — clock_gettime's 16-byte write
    # overflowed it. Benign under the pre-6.3.13 shared-global-buffer local
    # model; a stack smash under 6.3.13+ (locals are stack-allocated).
    var ts[16];
    syscall(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, &ts);
    return load64(&ts) * 1000000000 + load64(&ts + 8);
    #endif
}

# Get current WALL-CLOCK time in epoch nanoseconds.
#
# ⚠ **A sibling of `time_now_ns`, not a call into `chrono`.** `clock_epoch_ns`
# exists in the stdlib, but `chrono` is not among the modules a `--no-deps`
# build prepends — which is what CI runs — so reaching for it built fine locally
# and failed there with `undefined function 'clock_epoch_ns'`. Rolling it here,
# beside the monotonic reader that already does this dance, keeps majra's time
# sources in one place and adds no dependency.
#
# The only difference from `time_now_ns` is the clock id: `CLOCK_REALTIME` (0)
# rather than `CLOCK_MONOTONIC`. Used by `relay_msg_new`, whose stamp crosses
# process boundaries and so must be a portable instant.
fn time_epoch_ns() {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos exposes whole-second wall clock only (#46); the low nine digits are
    # always zero, which is the same limitation `lib/chrono.cyr` documents.
    return sys_time_unix() * 1000000000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 16 bytes for a struct timespec — see `time_now_ns` for why `var ts[2]`
    # would be a stack smash rather than two slots.
    var ts[16];
    syscall(SYS_CLOCK_GETTIME, 0, &ts);
    return load64(&ts) * 1000000000 + load64(&ts + 8);
    #endif
}

# Generate a pseudo-UUID (128 random bits) using getrandom syscall.
# Returns two values: hi in rax, lo via rethi().
fn uuid_generate() {
    var buf[16];   # 16 bytes (128 random bits); `var X[N]` local is N bytes
    # Zero the buffer first so a short/failed getrandom cannot leave stale
    # stack bytes standing in for entropy, and RETRY rather than proceed.
    #
    # The return was previously discarded entirely, so on failure the id was
    # built from whatever the stack held — plausibly identical across calls,
    # which collapses envelope ids that dedup and signature canonicalisation
    # both key on.
    memset(&buf, 0, 16);
    var got = 0;
    var attempts = 0;
    while (got < 16 && attempts < 8) {
        #ifdef CYRIUS_TARGET_AGNOS
        var n = sys_getrandom(&buf + got, 16 - got, 0);
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        var n = syscall(SYS_GETRANDOM, &buf + got, 16 - got, 0);
        #endif
        if (n > 0) { got = got + n; }
        attempts = attempts + 1;
    }
    if (got < 16) {
        # Entropy is unavailable. Returning a predictable id is worse than
        # returning nothing: report 0/0 so the caller can fail loudly.
        ret2(0, 0);
    }
    var hi = load64(&buf);
    var lo = load64(&buf + 8);
    # Set version 4 (bits 48-51 of hi) and variant 1 (bits 62-63 of lo)
    hi = (hi & 0xFFFFFFFFFFFF0FFF) | 0x0000000000004000;
    lo = (lo & 0x3FFFFFFFFFFFFFFF) | 0x8000000000000000;
    ret2(hi, lo);
}

# Create a new envelope.
# from_str: Str pointer for sender ID
# to_kind: TargetKind enum value
# to_name: Str pointer for target name (0 for broadcast)
# payload: pointer to payload data
fn envelope_new(from_str, to_kind, to_name, payload) {
    var e = fl_alloc(56);
    var hi = uuid_generate();
    var lo = rethi();
    store64(e, hi);
    store64(e + 8, lo);
    store64(e + 16, from_str);
    store64(e + 24, to_kind);
    store64(e + 32, to_name);
    store64(e + 40, payload);
    store64(e + 48, time_now_ns());
    return e;
}

# Accessors
fn envelope_id_hi(e)    { return load64(e); }
fn envelope_id_lo(e)    { return load64(e + 8); }
fn envelope_from(e)     { return load64(e + 16); }
fn envelope_to_kind(e)  { return load64(e + 24); }
fn envelope_to_name(e)  { return load64(e + 32); }
fn envelope_payload(e)  { return load64(e + 40); }
fn envelope_timestamp(e){ return load64(e + 48); }

fn envelope_is_broadcast(e) {
    return load64(e + 24) == TARGET_BROADCAST;
}

fn envelope_is_topic(e) {
    return load64(e + 24) == TARGET_TOPIC;
}

fn envelope_is_node(e) {
    return load64(e + 24) == TARGET_NODE;
}

# --- signed_envelope.cyr ---

# majra/signed_envelope — Ed25519-signed envelopes
#
# Wraps `envelope` with a sigil-backed Ed25519 signature for cross-node
# integrity. The signature covers a canonical serialization of the
# envelope fields; verifiers MUST use the same serialization.
#
# Opt-in: unsigned envelopes still flow through pub/sub, relay, etc.
# Signing is per-message and costs one Ed25519 sign (~50-100 μs under
# sigil's software impl; AES-NI-style speedup pending AES-NI in sigil).
#
# SignedEnvelope struct layout (40 bytes, 5 fields):
#   offset  0: envelope  (i64) — ptr to the inner envelope (56 B struct)
#   offset  8: signature (i64) — ptr to 64 raw bytes (Ed25519 sig)
#   offset 16: signer_pk (i64) — ptr to 32 raw bytes (the Ed25519 public key
#                                that signed it; verifiers key off this —
#                                consumers can look up trust separately)
#   offset 24: signed_at (i64) — nanoseconds since CLOCK_MONOTONIC
#   offset 32: canon_len (i64) — length of the canonical buffer (cached
#                                for debug/observability; verifier recomputes)

var SIGNED_ENV_SIG_LEN = 64;
var SIGNED_ENV_PK_LEN = 32;

# Canonical serialization of an envelope into a byte buffer.
# Layout (fixed 48 B header + 3 variable-length Str fields, length-prefixed):
#   [8] id_hi
#   [8] id_lo
#   [8] timestamp_ns
#   [8] to_kind
#   [4] from_len       [from bytes]
#   [4] to_name_len    [to_name bytes (0 bytes if to_name == 0)]
#   [4] payload_len    [payload bytes (payload is treated as a Str)]
#
# Returns a buffer pointer; length returned via ret2/rethi.
# Canonical = deterministic: same envelope → same bytes.
fn _envelope_canonicalize(e) {
    var from = envelope_from(e);
    var to_name = envelope_to_name(e);
    var payload = envelope_payload(e);

    # A NULL field and an EMPTY field both used to canonicalise to a zero
    # length followed by zero bytes, so two structurally different envelopes —
    # one broadcast (to_name == 0), one addressed to "" — produced identical
    # signing input and a signature valid for both. Encode presence in the
    # length prefix: 0xFFFFFFFF means absent, any other value is a real length.
    var from_len = 0;
    var from_tag = 4294967295;
    if (from != 0) { from_len = str_len(from); from_tag = from_len; }
    var to_len = 0;
    var to_tag = 4294967295;
    if (to_name != 0) { to_len = str_len(to_name); to_tag = to_len; }
    var pay_len = 0;
    var pay_tag = 4294967295;
    if (payload != 0) { pay_len = str_len(payload); pay_tag = pay_len; }

    var hdr = 8 + 8 + 8 + 8 + 4 + 4 + 4;
    var total = hdr + from_len + to_len + pay_len;
    var buf = fl_alloc(total);

    store64(buf, envelope_id_hi(e));
    store64(buf + 8, envelope_id_lo(e));
    store64(buf + 16, envelope_timestamp(e));
    store64(buf + 24, envelope_to_kind(e));

    var pos = 32;
    # Write u32 big-endian length + bytes for each variable field
    store8(buf + pos, (from_tag >> 24) & 0xFF);
    store8(buf + pos + 1, (from_tag >> 16) & 0xFF);
    store8(buf + pos + 2, (from_tag >> 8) & 0xFF);
    store8(buf + pos + 3, from_tag & 0xFF);
    pos = pos + 4;
    if (from_len > 0) { memcpy(buf + pos, str_data(from), from_len); pos = pos + from_len; }

    store8(buf + pos, (to_tag >> 24) & 0xFF);
    store8(buf + pos + 1, (to_tag >> 16) & 0xFF);
    store8(buf + pos + 2, (to_tag >> 8) & 0xFF);
    store8(buf + pos + 3, to_tag & 0xFF);
    pos = pos + 4;
    if (to_len > 0) { memcpy(buf + pos, str_data(to_name), to_len); pos = pos + to_len; }

    store8(buf + pos, (pay_tag >> 24) & 0xFF);
    store8(buf + pos + 1, (pay_tag >> 16) & 0xFF);
    store8(buf + pos + 2, (pay_tag >> 8) & 0xFF);
    store8(buf + pos + 3, pay_tag & 0xFF);
    pos = pos + 4;
    if (pay_len > 0) { memcpy(buf + pos, str_data(payload), pay_len); pos = pos + pay_len; }

    ret2(buf, total);
}

# Sign an envelope. Produces a SignedEnvelope.
#   sk_ptr: Ed25519 secret key buffer. ⚠ sigil's ed25519_sign reads sk[0..32]
#           as the seed AND sk[32..64] as the cached public key, so this buffer
#           must be the 64-BYTE expanded form, not a bare 32-byte seed. Passing
#           32 bytes reads 32 bytes past the allocation and signs against
#           whatever follows it, producing signatures that never verify. The
#           comment previously said "raw 32-byte Ed25519 secret key", which is
#           what made that an easy mistake. Caller owns it; zeroize after the
#           signing session ends.
#   pk_ptr: raw 32-byte Ed25519 public key that corresponds to sk
fn signed_envelope_new(e, sk_ptr, pk_ptr) {
    ed25519_init();

    var canon = _envelope_canonicalize(e);
    var canon_len = rethi();

    var sig = fl_alloc(SIGNED_ENV_SIG_LEN);
    ed25519_sign(sk_ptr, canon, canon_len, sig);
    # The canonical buffer is scratch — free it once it has been signed over.
    fl_free(canon);

    var pk_copy = fl_alloc(SIGNED_ENV_PK_LEN);
    memcpy(pk_copy, pk_ptr, SIGNED_ENV_PK_LEN);

    var se = fl_alloc(40);
    store64(se, e);
    store64(se + 8, sig);
    store64(se + 16, pk_copy);
    store64(se + 24, time_now_ns());
    store64(se + 32, canon_len);
    return se;
}

# Verify a SignedEnvelope. Returns 0 if the signature is valid over the
# canonical encoding of the inner envelope and the stored public key.
# Returns non-zero on any failure (bad signature, mismatched content,
# pk mismatch if expected_pk != 0).
#
# expected_pk: if non-zero, verify that the signer_pk matches this
#              specific key (trust anchoring). If 0, verify only that
#              the signature is valid for the embedded pk (transport
#              integrity without identity binding).
fn signed_envelope_verify(se, expected_pk) {
    if (se == 0) { return 1; }
    var e = load64(se);
    var sig = load64(se + 8);
    var signer_pk = load64(se + 16);

    if (expected_pk != 0) {
        # Constant-time compare of 32 public-key bytes
        if (ct_eq_bytes_lens(signer_pk, SIGNED_ENV_PK_LEN, expected_pk, SIGNED_ENV_PK_LEN) == 0) {
            return 2;
        }
    }

    var canon = _envelope_canonicalize(e);
    var canon_len = rethi();
    var ok = ed25519_verify(signer_pk, canon, canon_len, sig);
    # This is the UNTRUSTED path — a peer that feeds verify failures could
    # otherwise leak a payload-sized buffer per attempt.
    fl_free(canon);
    if (ok == 0) { return 3; }
    return 0;
}

# Release a SignedEnvelope produced by signed_envelope_new. Does NOT free the
# inner envelope, which the caller supplied and still owns.
fn signed_envelope_free(se) {
    if (se == 0) { return 0; }
    var sig = load64(se + 8);
    var pk = load64(se + 16);
    if (sig != 0) { fl_free(sig); }
    if (pk != 0) { fl_free(pk); }
    fl_free(se);
    return 0;
}

# Accessors
fn signed_envelope_envelope(se)  { return load64(se); }
fn signed_envelope_signature(se) { return load64(se + 8); }
fn signed_envelope_signer_pk(se) { return load64(se + 16); }
fn signed_envelope_signed_at(se) { return load64(se + 24); }
fn signed_envelope_canon_len(se) { return load64(se + 32); }

# --- namespace.cyr ---

# majra/namespace — tenant-scoped identifier prefixing
#
# Provides namespace-prefixed access to pub/sub, relay, and rate limiting
# so multiple tenants can share a single process without cross-contamination.
#
# Topics:   {prefix}/{topic}
# Keys:     {prefix}:{key}
# Node IDs: {prefix}:{node_id}

# Namespace is just a Str pointer to the prefix string.
# All functions take the prefix Str as their first argument.

# Create a new namespace from a C string. Returns 0 for an invalid prefix.
#
# ⚠ THIS IS A TENANT-ISOLATION BOUNDARY, so the prefix is validated.
#
# namespace_new used to accept anything. Two ways that broke isolation:
#
#  1. A prefix containing '#' or '+' turns the tenant's OWN
#     namespace_wildcard()/namespace_pattern() into a cross-tenant
#     subscription — namespace_wildcard builds "<prefix>/#", so a prefix of
#     "a/#" yields "a/#/#", and matches_pattern honours the embedded '#' as a
#     multi-level wildcard covering every other tenant under "a".
#
#  2. A prefix containing the delimiters '/' or ':' makes prefixes
#     non-prefix-free: tenants "acme" and "acme/eu" both produce topics under
#     "acme/", so acme's wildcard "acme/#" matches every acme/eu topic, and
#     namespace_strip_topic hands acme a topic that belongs to acme/eu.
#
# Rejecting the metacharacters outright is the only cheap fix that closes both:
# escaping them would change every topic string majra has ever emitted.
fn namespace_valid_prefix(prefix_cstr) {
    if (prefix_cstr == 0) { return 0; }
    var n = strlen(prefix_cstr);
    if (n == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(prefix_cstr + i);
        # '/' 47, ':' 58, '#' 35, '+' 43
        if (c == 47 || c == 58 || c == 35 || c == 43) { return 0; }
        # Control bytes and NUL-adjacent junk have no business in an identifier
        # that ends up in topic strings, keys and node ids.
        if (c < 32 || c == 127) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn namespace_new(prefix_cstr) {
    if (namespace_valid_prefix(prefix_cstr) == 0) { return 0; }
    return str_from(prefix_cstr);
}

# Get the prefix Str.
fn namespace_prefix(ns) {
    return ns;
}

# Prefix a topic with / delimiter.
fn namespace_topic(ns, topic_cstr) {
    # namespace_new returns 0 for an invalid prefix, and the module's own usage
    # recipes feed its result straight in here. Guard rather than dereference:
    # a caller that skipped the check gets 0 back instead of a segfault.
    if (ns == 0 || topic_cstr == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, ns);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, topic_cstr);
    return str_builder_build(sb);
}

# Prefix a key with : delimiter.
fn namespace_key(ns, key_cstr) {
    if (ns == 0 || key_cstr == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, ns);
    str_builder_add_cstr(sb, ":");
    str_builder_add_cstr(sb, key_cstr);
    return str_builder_build(sb);
}

# Prefix a node ID with : delimiter.
fn namespace_node_id(ns, node_id_cstr) {
    return namespace_key(ns, node_id_cstr);
}

# Prefix a subscription pattern with / delimiter.
fn namespace_pattern(ns, pattern_cstr) {
    return namespace_topic(ns, pattern_cstr);
}

# Build wildcard pattern: {prefix}/#
fn namespace_wildcard(ns) {
    if (ns == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, ns);
    str_builder_add_cstr(sb, "/#");
    return str_builder_build(sb);
}

# Strip namespace prefix from a topic (/ delimiter).
# Returns the bare topic as a Str, or 0 if topic doesn't belong to this namespace.
fn namespace_strip_topic(ns, topic) {
    if (ns == 0 || topic == 0) { return 0; }
    var prefix_len = str_len(ns);
    var topic_len = str_len(topic);
    # Must be longer than prefix + "/"
    if (topic_len <= prefix_len + 1) {
        return 0;
    }
    # Check prefix matches
    var pd = str_data(ns);
    var td = str_data(topic);
    var i = 0;
    while (i < prefix_len) {
        if (load8(pd + i) != load8(td + i)) {
            return 0;
        }
        i = i + 1;
    }
    # Check delimiter is /
    if (load8(td + prefix_len) != 47) {
        return 0;
    }
    # Return the rest after prefix/
    return str_new(td + prefix_len + 1, topic_len - prefix_len - 1);
}

# Strip namespace prefix from a key (: delimiter).
# Returns the bare key as a Str, or 0 if key doesn't belong to this namespace.
fn namespace_strip_key(ns, key) {
    if (ns == 0 || key == 0) { return 0; }
    var prefix_len = str_len(ns);
    var key_len = str_len(key);
    if (key_len <= prefix_len + 1) {
        return 0;
    }
    var pd = str_data(ns);
    var kd = str_data(key);
    var i = 0;
    while (i < prefix_len) {
        if (load8(pd + i) != load8(kd + i)) {
            return 0;
        }
        i = i + 1;
    }
    # Check delimiter is :
    if (load8(kd + prefix_len) != 58) {
        return 0;
    }
    return str_new(kd + prefix_len + 1, key_len - prefix_len - 1);
}

# --- metrics.cyr ---

# majra/metrics — observability hooks via function pointer vtable
#
# Replaces Rust's MajraMetrics trait with a 22-slot vtable struct.
# Each slot is a function pointer; noop_metrics() fills all slots with a no-op.
#
# Vtable layout (22 * 8 = 176 bytes):
#   offset   0: queue_enqueued(name, priority)
#   offset   8: queue_dequeued(name, priority)
#   offset  16: queue_state_changed(name, from, to)      [3 args - use global]
#   offset  24: queue_depth(name, depth)
#   offset  32: queue_running(name, count)
#   offset  40: pubsub_published(topic, subscriber_count)
#   offset  48: pubsub_dropped(topic)
#   offset  56: heartbeat_transition(node_id, from, to)   [3 args - use global]
#   offset  64: heartbeat_evicted(node_id)
#   offset  72: ratelimit_allowed(key)
#   offset  80: ratelimit_rejected(key)
#   offset  88: ratelimit_evicted(count)
#   offset  96: relay_sent(from, seq)
#   offset 104: relay_received(from, seq)
#   offset 112: relay_duplicate_dropped(from, seq)
#   offset 120: barrier_arrived(name, arrived, expected)   [3 args - use global]
#   offset 128: barrier_released(name)
#   offset 136: workflow_run_started(workflow_id)
#   offset 144: workflow_run_completed(workflow_id, duration_ms)
#   offset 152: workflow_run_failed(workflow_id, duration_ms)
#   offset 160: workflow_step_started(workflow_id, step_id)
#   offset 168: workflow_step_finished(workflow_id, step_id) [extra args via global]

var METRICS_VTABLE_SIZE = 176;

# No-op function for default vtable slots (1-arg and 2-arg versions both just return 0)
fn _metrics_noop(a, b) { return 0; }

# Create a no-op metrics vtable.
fn noop_metrics() {
    var vt = fl_alloc(METRICS_VTABLE_SIZE);
    var i = 0;
    while (i < 22) {
        store64(vt + i * 8, &_metrics_noop);
        i = i + 1;
    }
    return vt;
}

# --- Metrics dispatch helpers ---
# For 2-arg methods, call directly via fncall2.
# For 3+ arg methods, store extras in globals before calling.

var _metrics_arg3 = 0;
var _metrics_arg4 = 0;

fn metrics_queue_enqueued(vt, name, priority) {
    fncall2(load64(vt), name, priority);
}

fn metrics_queue_dequeued(vt, name, priority) {
    fncall2(load64(vt + 8), name, priority);
}

fn metrics_queue_state_changed(vt, name, from, to) {
    _metrics_arg3 = to;
    fncall2(load64(vt + 16), name, from);
}

fn metrics_queue_depth(vt, name, depth) {
    fncall2(load64(vt + 24), name, depth);
}

fn metrics_queue_running(vt, name, count) {
    fncall2(load64(vt + 32), name, count);
}

fn metrics_pubsub_published(vt, topic, sub_count) {
    fncall2(load64(vt + 40), topic, sub_count);
}

fn metrics_pubsub_dropped(vt, topic) {
    fncall2(load64(vt + 48), topic, 0);
}

fn metrics_heartbeat_transition(vt, node_id, from, to) {
    _metrics_arg3 = to;
    fncall2(load64(vt + 56), node_id, from);
}

fn metrics_heartbeat_evicted(vt, node_id) {
    fncall2(load64(vt + 64), node_id, 0);
}

fn metrics_ratelimit_allowed(vt, key) {
    fncall2(load64(vt + 72), key, 0);
}

fn metrics_ratelimit_rejected(vt, key) {
    fncall2(load64(vt + 80), key, 0);
}

fn metrics_ratelimit_evicted(vt, count) {
    fncall2(load64(vt + 88), count, 0);
}

fn metrics_relay_sent(vt, from, seq) {
    fncall2(load64(vt + 96), from, seq);
}

fn metrics_relay_received(vt, from, seq) {
    fncall2(load64(vt + 104), from, seq);
}

fn metrics_relay_duplicate_dropped(vt, from, seq) {
    fncall2(load64(vt + 112), from, seq);
}

fn metrics_barrier_arrived(vt, name, arrived, expected) {
    _metrics_arg3 = expected;
    fncall2(load64(vt + 120), name, arrived);
}

fn metrics_barrier_released(vt, name) {
    fncall2(load64(vt + 128), name, 0);
}

fn metrics_workflow_run_started(vt, workflow_id) {
    fncall2(load64(vt + 136), workflow_id, 0);
}

fn metrics_workflow_run_completed(vt, workflow_id, duration_ms) {
    fncall2(load64(vt + 144), workflow_id, duration_ms);
}

fn metrics_workflow_run_failed(vt, workflow_id, duration_ms) {
    fncall2(load64(vt + 152), workflow_id, duration_ms);
}

fn metrics_workflow_step_started(vt, workflow_id, step_id) {
    fncall2(load64(vt + 160), workflow_id, step_id);
}

fn metrics_workflow_step_finished(vt, workflow_id, step_id, status, duration_ms) {
    _metrics_arg3 = status;
    _metrics_arg4 = duration_ms;
    fncall2(load64(vt + 168), workflow_id, step_id);
}

# --- Counting metrics (for testing) ---
# A simple metrics impl that counts queue_enqueued calls.
# Stores count at a known global.

var _counting_metrics_enqueued = 0;

fn _counting_queue_enqueued(name, priority) {
    _counting_metrics_enqueued = _counting_metrics_enqueued + 1;
    return 0;
}

fn counting_metrics() {
    var vt = noop_metrics();
    _counting_metrics_enqueued = 0;
    store64(vt, &_counting_queue_enqueued);
    return vt;
}

# --- ratelimit.cyr ---

# majra/ratelimit — per-key token bucket rate limiter
#
# Lazy refill: tokens replenished on each check() based on elapsed time.
# No background tasks required. Uses fixed-point math (x1000 scaling).
#
# Also provides a sliding-window rate limiter variant.

# --- Token Bucket Rate Limiter ---

# Bucket struct layout (16 bytes):
#   offset 0: tokens_x1000 (i64) — tokens * 1000
#   offset 8: last_access_ns (i64) — nanoseconds from CLOCK_MONOTONIC

# RateLimiter struct layout (56 bytes):
#   offset  0: rate_x1000    (i64) — tokens per second * 1000
#   offset  8: burst_x1000   (i64) — max tokens * 1000
#   offset 16: buckets       (i64) — hashmap ptr (string -> bucket ptr)
#   offset 24: mutex         (i64) — mutex ptr for thread safety
#   offset 32: total_allowed (i64) — counter ptr
#   offset 40: total_rejected(i64) — counter ptr
#   offset 48: total_evicted (i64) — counter ptr

fn ratelimit_new(rate_x1000, burst) {
    var rl = fl_alloc(56);
    store64(rl, rate_x1000);
    store64(rl + 8, burst * 1000);
    store64(rl + 16, map_new());
    store64(rl + 24, mutex_new());
    store64(rl + 32, counter_new());
    store64(rl + 40, counter_new());
    store64(rl + 48, counter_new());
    return rl;
}

# Take ownership of a caller's key.
#
# ⚠ `map_set` stores the key pointer BY REFERENCE (`lib/hashmap.cyr:296` is
# `store64(ep, key)`), and the entry lives until eviction — so a limiter that
# does not copy is holding a borrow of unbounded lifetime. Every real caller
# derives its key per request (a header, a peer address, a token), often into a
# per-request arena that is reset moments later, which leaves the map probing
# freed bytes. Own the copy on the same freelist as the bucket it keys.
fn _ratelimit_key_own(key) {
    var n = strlen(key);
    var p = fl_alloc(n + 1);
    memcpy(p, key, n);
    store8(p + n, 0);
    return p;
}

# Check if a request for key is allowed. Consumes one token if yes.
#
# ⚠ `key` is a **cstr** (null-terminated `char*`), not a `Str`. The map is
# `KeyTypeCstr`, so it hashes with `hash_str` and compares with `streq`, both of
# which read from the pointer as bytes. Handing it a `Str` VALUE instead reads
# the Str header — whose first eight bytes are the data pointer — so two keys
# with identical content but different allocations hash differently and the
# limiter silently grants every request its own full-burst bucket. Callers
# holding a `Str` must pass `str_cstr(s)`, not `s`.
# Returns 1 (allowed) or 0 (rejected).
fn ratelimit_check(rl, key) {
    var now = time_now_ns();
    var rate_x1000 = load64(rl);
    var burst_x1000 = load64(rl + 8);
    var buckets = load64(rl + 16);
    var mtx = load64(rl + 24);

    mutex_lock(mtx);

    var bucket_ptr = map_get(buckets, key);
    if (bucket_ptr == 0) {
        # New key: start with full burst
        bucket_ptr = fl_alloc(16);
        store64(bucket_ptr, burst_x1000);
        store64(bucket_ptr + 8, now);
        map_set(buckets, _ratelimit_key_own(key), bucket_ptr);
    }

    # Refill tokens based on elapsed time
    var last_ns = load64(bucket_ptr + 8);
    var elapsed_ns = now - last_ns;
    var tokens = load64(bucket_ptr);

    # refill = elapsed_ns * rate_x1000 / 1_000_000_000
    # To avoid overflow: split into seconds and remainder.
    #
    # elapsed_rem is up to 999,999,999, so `elapsed_rem * rate_x1000` still
    # overflows i64 once rate_x1000 exceeds ~9.2e9 (a rate around 9.2M/sec).
    # Divide first in that case: the precision loss is irrelevant at a rate
    # that high, whereas the wrap produced a NEGATIVE refill and starved the
    # bucket permanently.
    var elapsed_sec = elapsed_ns / 1000000000;
    var elapsed_rem = elapsed_ns - elapsed_sec * 1000000000;
    var rem_refill = 0;
    if (rate_x1000 > 9000000000) {
        rem_refill = elapsed_rem / 1000000000 * rate_x1000;
    } else {
        rem_refill = elapsed_rem * rate_x1000 / 1000000000;
    }
    var refill = elapsed_sec * rate_x1000 + rem_refill;

    tokens = tokens + refill;
    if (tokens > burst_x1000) {
        tokens = burst_x1000;
    }

    # Only consume the elapsed time we actually converted into tokens.
    #
    # last_access_ns used to be advanced to `now` unconditionally. The refill
    # is integer-truncated, so a caller polling faster than one token-period
    # computed refill == 0 every time and still reset the clock — discarding
    # the fractional credit on every call. A limiter polled in a tight loop
    # therefore refilled at ZERO no matter how much wall time passed. Advancing
    # only by the consumed whole-token time keeps the remainder for next call.
    # ⚠ ORDER MATTERS, and the guard on `refill` is load-bearing.
    #
    # 2.6.9 computed `refill * 1000000000` FIRST and unconditionally. `refill`
    # is bounded by nothing — only `tokens` is clamped to burst above — so a
    # bucket idle long enough overflows i64, `consumed_ns` comes back NEGATIVE,
    # and `last_ns + consumed_ns` moves the clock BACKWARD. Every later call
    # then sees an even larger elapsed_ns, refills to full burst, and returns
    # allowed. That is a permanent, silent bypass of the limiter for that key —
    # a security control failing open, introduced by the fix for a starvation
    # bug. For a 1000 req/s limiter it needs roughly 2.6 hours idle, i.e. a
    # reconnecting tenant reaches it on its own.
    #
    # A full bucket carries nothing, so it takes the clock outright and never
    # reaches the multiply. Below that, refill is bounded by construction (a
    # larger refill would have clamped tokens to burst), and the explicit cap
    # keeps that reasoning from silently breaking if burst grows.
    if (tokens >= burst_x1000) {
        store64(bucket_ptr + 8, now);
    } elif (refill > 0 && rate_x1000 > 0 && refill < 9000000000) {
        var consumed_ns = refill * 1000000000 / rate_x1000;
        if (consumed_ns < 0 || consumed_ns > elapsed_ns) { consumed_ns = elapsed_ns; }
        store64(bucket_ptr + 8, last_ns + consumed_ns);
    } elif (refill > 0) {
        # Refill too large to convert back safely; the bucket is effectively
        # full anyway, so take the clock rather than risk the multiply.
        store64(bucket_ptr + 8, now);
    }

    var result = 0;
    if (tokens >= 1000) {
        tokens = tokens - 1000;
        result = 1;
        counter_inc(load64(rl + 32));
    } else {
        counter_inc(load64(rl + 40));
    }
    store64(bucket_ptr, tokens);

    mutex_unlock(mtx);
    return result;
}

# Number of tracked keys.
fn ratelimit_key_count(rl) {
    return map_size(load64(rl + 16));
}

# Evict keys idle longer than max_idle_ns.
# Returns number of keys evicted.
#
# ⚠ **Allocates nothing.** The obvious shape — `map_keys` into a vec, a second
# vec of victims, then delete — leaked both vecs on every sweep: `vec_new` is
# `vec_new_a(default_alloc())`, the global **no-free** bump, and `vec_push`
# growth abandons each old buffer there too. A 100k-key sweep burned well over a
# megabyte that never came back, so the routine whose entire purpose is bounding
# a limiter's memory consumed more of it the better it worked — and agnosai now
# calls this on a timer, which turns a latent leak into a live one.
#
# Instead it walks the entries array directly through the map's own public
# accessors (`map_entries` / `map_cap`), which is the same iteration `map_keys`
# and `map_iter` perform internally: 24-byte entries, state `1` = live.
# Deleting during the walk is safe because `map_delete` only writes a tombstone
# at the slot it finds — it never moves, reallocs or rehashes — so the array
# this loop holds stays valid to the end.
fn ratelimit_evict_stale(rl, max_idle_ns) {
    var now = time_now_ns();
    var buckets = load64(rl + 16);
    var mtx = load64(rl + 24);

    mutex_lock(mtx);

    var entries = map_entries(buckets);
    var cap = map_cap(buckets);
    var evicted = 0;
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var bucket_ptr = load64(ep + 8);
            if (now - load64(bucket_ptr + 8) >= max_idle_ns) {
                var k = load64(ep);
                map_delete(buckets, k);
                # Free strictly AFTER the delete, which needs the key to find
                # the entry. The tombstone it leaves is never key-compared
                # (`_map_find` skips `st == 2`) and `_map_grow_a` rehashes only
                # live entries, so the stale pointer in the slot is never read.
                fl_free(bucket_ptr);
                fl_free(k);
                evicted = evicted + 1;
            }
        }
        i = i + 1;
    }
    counter_add(load64(rl + 48), evicted);

    mutex_unlock(mtx);
    return evicted;
}

# Get stats: returns ptr to RateLimitStats struct (32 bytes)
#   offset  0: total_allowed
#   offset  8: total_rejected
#   offset 16: active_keys
#   offset 24: total_evicted — cumulative, across every sweep
fn ratelimit_stats(rl) {
    var s = fl_alloc(32);
    store64(s, counter_get(load64(rl + 32)));
    store64(s + 8, counter_get(load64(rl + 40)));
    store64(s + 16, map_size(load64(rl + 16)));
    store64(s + 24, counter_get(load64(rl + 48)));
    return s;
}

# --- Sliding Window Rate Limiter ---

# WindowCounter struct (24 bytes):
#   offset  0: prev_count (i64)
#   offset  8: curr_count (i64)
#   offset 16: window_start_ns (i64)

# SlidingWindowLimiter struct (48 bytes):
# (The comment said 40 while listing six 8-byte fields at offsets 0..40, which
# needs 48 — and sliding_window_new has always allocated 48. Comment corrected.)
#   offset  0: windows       (i64) — hashmap ptr
#   offset  8: max_requests  (i64)
#   offset 16: window_ns     (i64) — window duration in nanoseconds
#   offset 24: mutex         (i64)
#   offset 32: total_allowed (i64) — counter ptr
#   offset 40: total_rejected(i64) — counter ptr

# window_ns must be > 0: sliding_window_check divides by it, and a zero-length
# window is a SIGFPE that kills the process. Returns 0 for an invalid config.
fn sliding_window_new(max_requests, window_ns) {
    if (window_ns <= 0) { return 0; }
    var sw = fl_alloc(48);
    store64(sw, map_new());
    store64(sw + 8, max_requests);
    store64(sw + 16, window_ns);
    store64(sw + 24, mutex_new());
    store64(sw + 32, counter_new());
    store64(sw + 40, counter_new());
    return sw;
}

# Evict sliding-window entries whose window has not advanced in max_idle_ns.
# Returns the number evicted.
#
# The sliding-window limiter had NO eviction sweep, so every distinct key ever
# seen retained an owned key copy plus a 24-byte WindowCounter for the life of
# the process — unbounded growth driven by whatever the caller keys on (an IP,
# a tenant, a request id). The token-bucket limiter grew this sweep at 2.6.4;
# this is the same shape, and likewise allocation-free: it walks the hashmap
# slot array directly rather than calling map_keys.
fn sliding_window_evict_stale(sw, max_idle_ns) {
    if (sw == 0) { return 0; }
    var now = time_now_ns();
    var windows = load64(sw);
    var mtx = load64(sw + 24);

    mutex_lock(mtx);

    var entries = map_entries(windows);
    var cap = map_cap(windows);
    var evicted = 0;
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var wc_ptr = load64(ep + 8);
            if (now - load64(wc_ptr + 16) >= max_idle_ns) {
                var k = load64(ep);
                map_delete(windows, k);
                # Free strictly AFTER the delete — same ordering rule as
                # ratelimit_evict_stale, which needs the key to find the entry.
                fl_free(wc_ptr);
                fl_free(k);
                evicted = evicted + 1;
            }
        }
        i = i + 1;
    }

    mutex_unlock(mtx);
    return evicted;
}

fn sliding_window_table_size(sw) {
    if (sw == 0) { return 0; }
    var mtx = load64(sw + 24);
    mutex_lock(mtx);
    var n = map_size(load64(sw));
    mutex_unlock(mtx);
    return n;
}

fn sliding_window_check(sw, key) {
    if (sw == 0) { return 0; }
    var now = time_now_ns();
    var windows = load64(sw);
    var max_req = load64(sw + 8);
    var window_ns = load64(sw + 16);
    var mtx = load64(sw + 24);

    mutex_lock(mtx);

    var wc_ptr = map_get(windows, key);
    if (wc_ptr == 0) {
        wc_ptr = fl_alloc(24);
        store64(wc_ptr, 0);
        store64(wc_ptr + 8, 0);
        store64(wc_ptr + 16, now);
        # Owned for the same reason as `ratelimit_check`. ⚠ The sliding window
        # has no eviction sweep, so its entries — key and counter both — live
        # for the process. That predates this change (the counter already did);
        # owning the key makes it correct rather than dangling.
        map_set(windows, _ratelimit_key_own(key), wc_ptr);
    }

    var elapsed = now - load64(wc_ptr + 16);

    # Advance windows if needed
    if (elapsed >= window_ns * 2) {
        store64(wc_ptr, 0);
        store64(wc_ptr + 8, 0);
        store64(wc_ptr + 16, now);
    } elif (elapsed >= window_ns) {
        store64(wc_ptr, load64(wc_ptr + 8));
        store64(wc_ptr + 8, 0);
        store64(wc_ptr + 16, load64(wc_ptr + 16) + window_ns);
    }

    # Weighted estimate using integer approximation
    # weight = 1.0 - elapsed_in_current / window_ns
    # estimate = prev_count * weight + curr_count
    # Using x1000 scaling:
    var elapsed_in_current = now - load64(wc_ptr + 16);
    var weight_x1000 = 1000 - elapsed_in_current * 1000 / window_ns;
    if (weight_x1000 < 0) { weight_x1000 = 0; }
    var prev = load64(wc_ptr);
    var curr = load64(wc_ptr + 8);
    var estimate_x1000 = prev * weight_x1000 + curr * 1000;

    var result = 0;
    if (estimate_x1000 < max_req * 1000) {
        store64(wc_ptr + 8, curr + 1);
        result = 1;
        counter_inc(load64(sw + 32));
    } else {
        counter_inc(load64(sw + 40));
    }

    mutex_unlock(mtx);
    return result;
}

fn sliding_window_key_count(sw) {
    return map_size(load64(sw));
}

fn sliding_window_total_allowed(sw) {
    return counter_get(load64(sw + 32));
}

fn sliding_window_total_rejected(sw) {
    return counter_get(load64(sw + 40));
}

# --- heartbeat.cyr ---

# majra/heartbeat — TTL-based node health tracking
#
# Tracks last-seen timestamps per node and transitions through:
# Online -> Suspect (after suspect timeout) -> Offline (after offline timeout)

# Node health status
enum NodeStatus {
    STATUS_ONLINE = 0;
    STATUS_SUSPECT = 1;
    STATUS_OFFLINE = 2;
}

# Default timeouts in nanoseconds
var DEFAULT_SUSPECT_NS = 30000000000;
var DEFAULT_OFFLINE_NS = 90000000000;

# HeartbeatConfig struct (24 bytes):
#   offset  0: suspect_after_ns (i64)
#   offset  8: offline_after_ns (i64)
#   offset 16: eviction_cycles  (i64) — 0 = no eviction

fn heartbeat_config_default() {
    var cfg = fl_alloc(24);
    store64(cfg, DEFAULT_SUSPECT_NS);
    store64(cfg + 8, DEFAULT_OFFLINE_NS);
    store64(cfg + 16, 0);
    return cfg;
}

fn heartbeat_config_new(suspect_ns, offline_ns, eviction_cycles) {
    var cfg = fl_alloc(24);
    store64(cfg, suspect_ns);
    store64(cfg + 8, offline_ns);
    store64(cfg + 16, eviction_cycles);
    return cfg;
}

# Classify status based on elapsed time
fn _classify_status(elapsed_ns, cfg) {
    if (elapsed_ns >= load64(cfg + 8)) {
        return STATUS_OFFLINE;
    }
    if (elapsed_ns >= load64(cfg)) {
        return STATUS_SUSPECT;
    }
    return STATUS_ONLINE;
}

fn status_name(s) {
    if (s == STATUS_ONLINE) { return "online"; }
    if (s == STATUS_SUSPECT) { return "suspect"; }
    if (s == STATUS_OFFLINE) { return "offline"; }
    return "unknown";
}

# NodeState struct (40 bytes):
#   offset  0: status (i64)
#   offset  8: last_seen_ns (i64)
#   offset 16: metadata (i64) — arbitrary payload pointer
#   offset 24: gpu_telemetry (i64) — vec of GpuTelemetry ptrs, or 0
#   offset 32: offline_cycles (i64)

fn _node_state_new(metadata) {
    var ns = fl_alloc(40);
    store64(ns, STATUS_ONLINE);
    store64(ns + 8, time_now_ns());
    store64(ns + 16, metadata);
    store64(ns + 24, 0);
    store64(ns + 32, 0);
    return ns;
}

# GpuTelemetry struct (32 bytes):
#   offset  0: util_pct_x100 (i64) — utilization % * 100
#   offset  8: mem_used_mb (i64)
#   offset 16: mem_total_mb (i64)
#   offset 24: temp_c_x100 (i64) — temperature * 100, or -1 if unavailable

fn gpu_telemetry_new(util_x100, mem_used, mem_total, temp_x100) {
    var g = fl_alloc(32);
    store64(g, util_x100);
    store64(g + 8, mem_used);
    store64(g + 16, mem_total);
    store64(g + 24, temp_x100);
    return g;
}

# FleetStats struct (56 bytes):
#   offset  0: total_nodes
#   offset  8: online
#   offset 16: suspect
#   offset 24: offline
#   offset 32: total_gpus
#   offset 40: total_vram_mb
#   offset 48: available_vram_mb

# --- HeartbeatTracker (single-threaded, for use within one thread) ---

# HeartbeatTracker struct (16 bytes):
#   offset 0: nodes (i64) — hashmap: string -> NodeState ptr
#   offset 8: config (i64) — HeartbeatConfig ptr

fn hb_tracker_new(cfg) {
    var ht = fl_alloc(16);
    store64(ht, map_new());
    store64(ht + 8, cfg);
    return ht;
}

fn hb_register(ht, id, metadata) {
    var nodes = load64(ht);
    var ns = _node_state_new(metadata);
    map_set(nodes, id, ns);
}

fn hb_heartbeat(ht, id) {
    var nodes = load64(ht);
    var ns = map_get(nodes, id);
    if (ns == 0) { return 0; }
    store64(ns, STATUS_ONLINE);
    store64(ns + 8, time_now_ns());
    store64(ns + 32, 0);
    return 1;
}

fn hb_heartbeat_with_metadata(ht, id, metadata) {
    var nodes = load64(ht);
    var ns = map_get(nodes, id);
    if (ns == 0) { return 0; }
    store64(ns, STATUS_ONLINE);
    store64(ns + 8, time_now_ns());
    store64(ns + 16, metadata);
    store64(ns + 32, 0);
    return 1;
}

fn hb_deregister(ht, id) {
    var nodes = load64(ht);
    var old = map_get(nodes, id);
    var r = map_delete(nodes, id);
    # NodeState blocks were fl_alloc'd and never freed on ANY removal path, so
    # a fleet that churns nodes leaked one per removal.
    if (old != 0) { fl_free(old); }
    return r;
}

# Sweep all nodes, return vec of (id_str, new_status) pairs for transitions.
# Each pair is stored as a 16-byte struct: { id_ptr, status }.
fn hb_update_statuses(ht) {
    var nodes = load64(ht);
    var cfg = load64(ht + 8);
    var now = time_now_ns();
    var transitions = vec_new();

    # Walks the hashmap slot array directly. map_keys builds a vec from the
    # BUMP allocator on every call and this runs on every sweep, twice — the
    # same never-reclaimed-allocation class 2.6.9 removed from fleet, pubsub
    # and relay and did not apply here.
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var id = load64(ep);
            var ns = load64(ep + 8);
            var elapsed = now - load64(ns + 8);
            var prev = load64(ns);
            var new_status = _classify_status(elapsed, cfg);

            if (new_status == STATUS_OFFLINE) {
                store64(ns + 32, load64(ns + 32) + 1);
            } else {
                store64(ns + 32, 0);
            }

            if (new_status != prev) {
                store64(ns, new_status);
                # Store transition as pair: push id then status
                var pair = fl_alloc(16);
                store64(pair, id);
                store64(pair + 8, new_status);
                vec_push(transitions, pair);
            }
        }
        i = i + 1;
    }

    # Handle eviction
    var eviction_cycles = load64(cfg + 16);
    if (eviction_cycles > 0) {
        # Two-pass, but over an fl_alloc'd array rather than two bump vecs.
        # The collect pass is separate because map_delete during a slot walk is
        # safe only for the entry being deleted; sizing by map_size bounds it.
        var nlive = map_size(nodes);
        var to_evict = 0;
        var nev = 0;
        if (nlive > 0) { to_evict = fl_alloc(nlive * 8); }
        i = 0;
        while (i < cap && to_evict != 0) {
            var ep2 = entries + i * 24;
            if (load64(ep2 + 16) == 1) {
                var ns2 = load64(ep2 + 8);
                if (load64(ns2 + 32) >= eviction_cycles && nev < nlive) {
                    store64(to_evict + nev * 8, load64(ep2));
                    nev = nev + 1;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < nev) {
            var ev_id = load64(to_evict + i * 8);
            var ev_ns = map_get(nodes, ev_id);
            map_delete(nodes, ev_id);
            if (ev_ns != 0) { fl_free(ev_ns); }
            i = i + 1;
        }
        if (to_evict != 0) { fl_free(to_evict); }
    }

    return transitions;
}

fn hb_get(ht, id) {
    return map_get(load64(ht), id);
}

fn hb_len(ht) {
    return map_size(load64(ht));
}

fn hb_is_empty(ht) {
    return map_size(load64(ht)) == 0;
}

# List nodes by status — returns vec of id string pointers
fn hb_list_by_status(ht, status) {
    var nodes = load64(ht);
    var result = vec_new();
    var keys = map_keys(nodes);
    var i = 0;
    var len = vec_len(keys);
    while (i < len) {
        var id = vec_get(keys, i);
        var ns = map_get(nodes, id);
        if (load64(ns) == status) {
            vec_push(result, id);
        }
        i = i + 1;
    }
    return result;
}

fn hb_online(ht) {
    return hb_list_by_status(ht, STATUS_ONLINE);
}

# --- ConcurrentHeartbeatTracker (thread-safe wrapper) ---

# Same struct layout as HeartbeatTracker but adds a mutex at offset 16.
# ConcurrentHeartbeatTracker struct (24 bytes):
#   offset  0: nodes (i64) — hashmap
#   offset  8: config (i64) — HeartbeatConfig ptr
#   offset 16: mutex (i64)

fn chb_tracker_new(cfg) {
    var cht = fl_alloc(24);
    store64(cht, map_new());
    store64(cht + 8, cfg);
    store64(cht + 16, mutex_new());
    return cht;
}

fn chb_register(cht, id, metadata) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    # Re-registering an existing id replaced the map entry and abandoned the
    # previous NodeState — and re-register on reconnect is exactly what a
    # flapping node does.
    var prev = map_get(load64(cht), id);
    var ns = _node_state_new(metadata);
    map_set(load64(cht), id, ns);
    if (prev != 0) { fl_free(prev); }
    mutex_unlock(mtx);
}

fn chb_register_with_telemetry(cht, id, metadata, gpu_vec) {
    # Same re-registration leak chb_register closes: replacing an existing
    # entry abandoned the previous NodeState. 2.6.9 fixed only chb_register.
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var prev = map_get(load64(cht), id);
    var ns = _node_state_new(metadata);
    store64(ns + 24, gpu_vec);
    map_set(load64(cht), id, ns);
    if (prev != 0) { fl_free(prev); }
    mutex_unlock(mtx);
}

fn chb_heartbeat(cht, id) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var ns = map_get(load64(cht), id);
    if (ns == 0) {
        mutex_unlock(mtx);
        return 0;
    }
    store64(ns, STATUS_ONLINE);
    store64(ns + 8, time_now_ns());
    store64(ns + 32, 0);
    mutex_unlock(mtx);
    return 1;
}

fn chb_heartbeat_with_metadata(cht, id, metadata) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var ns = map_get(load64(cht), id);
    if (ns == 0) {
        mutex_unlock(mtx);
        return 0;
    }
    store64(ns, STATUS_ONLINE);
    store64(ns + 8, time_now_ns());
    store64(ns + 16, metadata);
    store64(ns + 32, 0);
    mutex_unlock(mtx);
    return 1;
}

fn chb_heartbeat_with_telemetry(cht, id, gpu_vec) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var ns = map_get(load64(cht), id);
    if (ns == 0) {
        mutex_unlock(mtx);
        return 0;
    }
    store64(ns, STATUS_ONLINE);
    store64(ns + 8, time_now_ns());
    store64(ns + 24, gpu_vec);
    store64(ns + 32, 0);
    mutex_unlock(mtx);
    return 1;
}

fn chb_deregister(cht, id) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var old_ns = map_get(load64(cht), id);
    var r = map_delete(load64(cht), id);
    if (old_ns != 0) { fl_free(old_ns); }
    mutex_unlock(mtx);
    return r;
}

fn chb_update_statuses(cht) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    # Reuse the single-threaded logic by constructing a temp tracker view
    var nodes = load64(cht);
    var cfg = load64(cht + 8);
    var now = time_now_ns();
    var transitions = vec_new();

    # Slot-array walk — see the note on the non-concurrent sweep above.
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var id = load64(ep);
            var ns = load64(ep + 8);
            var elapsed = now - load64(ns + 8);
            var prev = load64(ns);
            var new_status = _classify_status(elapsed, cfg);

            if (new_status == STATUS_OFFLINE) {
                store64(ns + 32, load64(ns + 32) + 1);
            } else {
                store64(ns + 32, 0);
            }

            if (new_status != prev) {
                store64(ns, new_status);
                var pair = fl_alloc(16);
                store64(pair, id);
                store64(pair + 8, new_status);
                vec_push(transitions, pair);
            }
        }
        i = i + 1;
    }

    # Handle eviction
    var eviction_cycles = load64(cfg + 16);
    if (eviction_cycles > 0) {
        # Two-pass, but over an fl_alloc'd array rather than two bump vecs.
        # The collect pass is separate because map_delete during a slot walk is
        # safe only for the entry being deleted; sizing by map_size bounds it.
        var nlive = map_size(nodes);
        var to_evict = 0;
        var nev = 0;
        if (nlive > 0) { to_evict = fl_alloc(nlive * 8); }
        i = 0;
        while (i < cap && to_evict != 0) {
            var ep2 = entries + i * 24;
            if (load64(ep2 + 16) == 1) {
                var ns2 = load64(ep2 + 8);
                if (load64(ns2 + 32) >= eviction_cycles && nev < nlive) {
                    store64(to_evict + nev * 8, load64(ep2));
                    nev = nev + 1;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < nev) {
            var ev_id = load64(to_evict + i * 8);
            var ev_ns = map_get(nodes, ev_id);
            map_delete(nodes, ev_id);
            if (ev_ns != 0) { fl_free(ev_ns); }
            i = i + 1;
        }
        if (to_evict != 0) { fl_free(to_evict); }
    }

    mutex_unlock(mtx);
    return transitions;
}

# Returns a CALLER-OWNED COPY of the node's state, or 0. Release with
# chb_node_free.
#
# This used to hand back the tracker's internal NodeState pointer after
# dropping the mutex. That was merely racy until 2.6.9 added fl_free on every
# removal path — at which point it became a USE-AFTER-FREE: an eviction sweep
# or a deregister on another thread can recycle the block while the caller is
# still reading it, and the freelist will hand those 40 bytes to the next
# allocation. Copying under the lock is the only way to hand out a value that
# stays valid without refcounting.
fn chb_get(cht, id) {
    if (cht == 0) { return 0; }
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var ns = map_get(load64(cht), id);
    var copy = 0;
    if (ns != 0) {
        copy = fl_alloc(40);
        if (copy != 0) { memcpy(copy, ns, 40); }
    }
    mutex_unlock(mtx);
    return copy;
}

# Release a NodeState copy returned by chb_get.
fn chb_node_free(ns) {
    if (ns != 0) { fl_free(ns); }
    return 0;
}

fn chb_get_gpu_telemetry(cht, id) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var ns = map_get(load64(cht), id);
    var result = 0;
    if (ns != 0) {
        result = load64(ns + 24);
    }
    mutex_unlock(mtx);
    return result;
}

fn chb_len(cht) {
    return map_size(load64(cht));
}

fn chb_is_empty(cht) {
    return map_size(load64(cht)) == 0;
}

fn chb_list_by_status(cht, status) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var nodes = load64(cht);
    var result = vec_new();
    var keys = map_keys(nodes);
    var i = 0;
    var len = vec_len(keys);
    while (i < len) {
        var id = vec_get(keys, i);
        var ns = map_get(nodes, id);
        if (load64(ns) == status) {
            vec_push(result, id);
        }
        i = i + 1;
    }
    mutex_unlock(mtx);
    return result;
}

fn chb_online(cht) {
    return chb_list_by_status(cht, STATUS_ONLINE);
}

# Fleet stats aggregation
fn chb_fleet_stats(cht) {
    var mtx = load64(cht + 16);
    mutex_lock(mtx);
    var nodes = load64(cht);
    var s = fl_alloc(56);
    # Zero-init
    var j = 0;
    while (j < 7) { store64(s + j * 8, 0); j = j + 1; }

    var keys = map_keys(nodes);
    var i = 0;
    var len = vec_len(keys);
    while (i < len) {
        var id = vec_get(keys, i);
        var ns = map_get(nodes, id);
        store64(s, load64(s) + 1);
        var st = load64(ns);
        if (st == STATUS_ONLINE) { store64(s + 8, load64(s + 8) + 1); }
        elif (st == STATUS_SUSPECT) { store64(s + 16, load64(s + 16) + 1); }
        elif (st == STATUS_OFFLINE) { store64(s + 24, load64(s + 24) + 1); }

        var gpu_vec = load64(ns + 24);
        if (gpu_vec != 0) {
            var g = 0;
            var glen = vec_len(gpu_vec);
            while (g < glen) {
                var gp = vec_get(gpu_vec, g);
                store64(s + 32, load64(s + 32) + 1);
                var total_mb = load64(gp + 16);
                var used_mb = load64(gp + 8);
                store64(s + 40, load64(s + 40) + total_mb);
                var avail = total_mb - used_mb;
                if (avail < 0) { avail = 0; }
                store64(s + 48, load64(s + 48) + avail);
                g = g + 1;
            }
        }
        i = i + 1;
    }
    mutex_unlock(mtx);
    return s;
}

# --- queue.cyr ---

# majra/queue — multi-tier priority queue with managed lifecycle
#
# Replaces Rust's PriorityQueue<T>, ConcurrentPriorityQueue<T>, ManagedQueue<T>.
# All payloads are i64 (pointers to user-allocated data).

# Priority levels
enum Priority {
    PRIORITY_CRITICAL = 0;
    PRIORITY_HIGH = 1;
    PRIORITY_NORMAL = 2;
    PRIORITY_LOW = 3;
    PRIORITY_BACKGROUND = 4;
}

var NUM_PRIORITIES = 5;

# Job states
enum JobState {
    JOB_QUEUED = 0;
    JOB_RUNNING = 1;
    JOB_COMPLETED = 2;
    JOB_FAILED = 3;
    JOB_CANCELLED = 4;
}

fn job_state_name(s) {
    if (s == JOB_QUEUED) { return "queued"; }
    if (s == JOB_RUNNING) { return "running"; }
    if (s == JOB_COMPLETED) { return "completed"; }
    if (s == JOB_FAILED) { return "failed"; }
    if (s == JOB_CANCELLED) { return "cancelled"; }
    return "unknown";
}

# QueueItem struct (40 bytes):
#   offset  0: id_hi (i64)
#   offset  8: id_lo (i64)
#   offset 16: priority (i64)
#   offset 24: payload (i64) — pointer to user data
#   offset 32: job_key (i64) — Str ptr for ManagedQueue lookup (or 0)

fn queue_item_new(priority, payload) {
    var item = fl_alloc(40);
    var hi = uuid_generate();
    var lo = rethi();
    store64(item, hi);
    store64(item + 8, lo);
    store64(item + 16, priority);
    store64(item + 24, payload);
    store64(item + 32, 0);
    return item;
}

# Release a QueueItem. Only for items the caller owns outright — an item
# handed to mq_enqueue is owned by the queue until it terminates.
fn queue_item_free(item) {
    if (item != 0) { fl_free(item); }
    return 0;
}

fn queue_item_id_hi(item) { return load64(item); }
fn queue_item_id_lo(item) { return load64(item + 8); }
fn queue_item_priority(item) { return load64(item + 16); }
fn queue_item_payload(item) { return load64(item + 24); }
fn queue_item_key(item) { return load64(item + 32); }

# --- PriorityQueue ---
# 5 vecs (one per priority level), a total count, and a read head per tier.
# PriorityQueue struct (88 bytes):
#   offset  0-39: tiers[5] — vec ptrs (i64 each)
#   offset 40:    total (i64)
#   offset 48-87: heads[5] — read index into each tier (i64 each)
#
# ⚠ **The heads exist because popping used to be O(n).** `pq_dequeue` took the
# front with `vec_get(tier, 0)` + `vec_remove(tier, 0)`, and `vec_remove` shifts
# every remaining element down a slot — so one pop cost O(n) in the tier depth
# and draining a queue of n cost **O(n²)**. Measured before the fix, mean cost of
# a single pop while draining a tier of that depth:
#
#     2,000 items    2.00us      |   16,000 items   15.56us
#     4,000 items    4.02us      |  200,000 items  198.70us
#
# Doubling the depth doubled the per-pop cost, which is the signature of a linear
# pop rather than cache noise. At 200k the drain was ~40 seconds of memmove.
#
# That is not a pathological case for this structure — it is the DESIGN case.
# A priority queue exists so low-priority work is allowed to accumulate behind
# high-priority work, so the deep-tier path is the one that has to be cheap.
#
# The head is a read index: pops advance it instead of moving the survivors.
# `vec_push` still appends, so **FIFO within a tier is preserved** — which
# `queue_item_new`'s monotonic id and `ManagedQueue`'s semantics both rely on,
# and which is why swap-with-last (the other obvious O(1) trick) is not an
# option here.

fn pq_new() {
    var pq = fl_alloc(88);
    var i = 0;
    while (i < NUM_PRIORITIES) {
        store64(pq + i * 8, vec_new());
        store64(pq + 48 + i * 8, 0);
        i = i + 1;
    }
    store64(pq + 40, 0);
    return pq;
}

fn pq_enqueue(pq, item) {
    var pri = load64(item + 16);
    # ⚠ **Both ends, and the lower one was missing until 2.6.2.** The over-range
    # clamp has always been here; a NEGATIVE priority went straight through to
    # `load64(pq + pri * 8)` below, which for pri = -1 reads eight bytes BEFORE
    # the struct and then `vec_push`es onto whatever that decoded to. An
    # out-of-bounds read followed by a write through the result — not a wrong
    # answer, a memory-safety bug.
    #
    # It is reachable from anything that computes a priority rather than naming
    # one: `queue_item_new(priority, payload)` stores the caller's value
    # verbatim, and a consumer mapping its own enum onto this one (agnosai's
    # `agnosai_map_priority` is exactly that shape) is one arithmetic slip from
    # -1. Clamping to Normal matches what the over-range end already does, so
    # neither end can reach the indexing.
    if (pri < 0) { pri = PRIORITY_NORMAL; }
    if (pri >= NUM_PRIORITIES) { pri = PRIORITY_NORMAL; }
    var tier = load64(pq + pri * 8);
    vec_push(tier, item);
    store64(pq + 40, load64(pq + 40) + 1);
}

# Reclaim the consumed prefix of a tier.
#
# Called only when the head has passed the midpoint, so each surviving item is
# moved at most once per doubling of the head — **amortised O(1) per pop**. The
# fully-drained case is free: length and head both reset with nothing copied,
# which is the common shape for a queue that empties between bursts.
fn _pq_compact(pq, i, tier, head) {
    var len = vec_len(tier);
    if (head >= len) {
        vec_truncate(tier, 0);
        store64(pq + 48 + i * 8, 0);
        return 0;
    }
    var w = 0;
    var r = head;
    while (r < len) {
        vec_set(tier, w, vec_get(tier, r));
        w = w + 1;
        r = r + 1;
    }
    vec_truncate(tier, w);
    store64(pq + 48 + i * 8, 0);
    return 0;
}

# Dequeue highest priority item. Returns item ptr or 0.
fn pq_dequeue(pq) {
    var i = 0;
    while (i < NUM_PRIORITIES) {
        var tier = load64(pq + i * 8);
        var head = load64(pq + 48 + i * 8);
        if (vec_len(tier) > head) {
            var item = vec_get(tier, head);
            head = head + 1;
            store64(pq + 48 + i * 8, head);
            store64(pq + 40, load64(pq + 40) - 1);
            # Amortised reclaim — see `_pq_compact`. Without it the backing vec
            # of a tier that never fully empties would grow without bound.
            if (head * 2 >= vec_len(tier)) { _pq_compact(pq, i, tier, head); }
            return item;
        }
        i = i + 1;
    }
    return 0;
}

fn pq_len(pq) { return load64(pq + 40); }
fn pq_is_empty(pq) { return load64(pq + 40) == 0; }

# --- ConcurrentPriorityQueue ---
# Wraps PriorityQueue with mutex + futex for blocking dequeue.
# ConcurrentPQ struct (32 bytes):
#   offset  0: pq (i64)
#   offset  8: mutex (i64)
#   offset 16: waiters_flag (i64) — address for futex wait/wake
#   offset 24: total_enqueued (i64) — counter ptr

fn cpq_new() {
    var cpq = fl_alloc(32);
    store64(cpq, pq_new());
    store64(cpq + 8, mutex_new());
    store64(cpq + 16, 0);
    store64(cpq + 24, counter_new());
    return cpq;
}

fn cpq_enqueue(cpq, item) {
    var mtx = load64(cpq + 8);
    mutex_lock(mtx);
    pq_enqueue(load64(cpq), item);
    counter_inc(load64(cpq + 24));
    # Wake one waiter
    store64(cpq + 16, load64(cpq + 16) + 1);
    mutex_unlock(mtx);
    # agnos: no futex — the cooperative dequeue-waiter spin-yields, so wake is a no-op.
    #ifndef CYRIUS_TARGET_AGNOS
    syscall(SYS_FUTEX, cpq + 16, FUTEX_WAKE, 1, 0, 0, 0);
    #endif
}

fn cpq_dequeue(cpq) {
    var mtx = load64(cpq + 8);
    mutex_lock(mtx);
    var item = pq_dequeue(load64(cpq));
    mutex_unlock(mtx);
    return item;
}

# Blocking dequeue — waits until an item is available.
fn cpq_dequeue_wait(cpq) {
    while (1) {
        var mtx = load64(cpq + 8);
        mutex_lock(mtx);
        var item = pq_dequeue(load64(cpq));
        if (item != 0) {
            mutex_unlock(mtx);
            return item;
        }
        var val = load64(cpq + 16);
        mutex_unlock(mtx);
        # Wait for enqueue notification. agnos: no futex_wait — yield to the
        # cooperative scheduler and re-check (spin-yield replaces the park).
        #ifdef CYRIUS_TARGET_AGNOS
        sys_sched_yield();
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        syscall(SYS_FUTEX, cpq + 16, FUTEX_WAIT, val, 0, 0, 0);
        #endif
    }
}

fn cpq_len(cpq) {
    return pq_len(load64(cpq));
}

# --- ManagedQueue ---
# Job lifecycle: Queued -> Running -> Completed/Failed/Cancelled
#
# ManagedItem struct (72 bytes):
#   offset  0: id_hi
#   offset  8: id_lo
#   offset 16: priority
#   offset 24: payload
#   offset 32: state (JobState)
#   offset 40: enqueued_at_ns
#   offset 48: started_at_ns
#   offset 56: finished_at_ns
#   offset 64: max_concurrent (i64) — 0 = unlimited

# ManagedQueue struct (64 bytes):
#   offset  0: cpq (i64) — ConcurrentPriorityQueue ptr
#   offset  8: jobs (i64) — hashmap: id_str -> ManagedItem ptr
#   offset 16: mutex (i64)
#   offset 24: name (i64) — Str ptr
#   offset 32: running_count (i64)
#   offset 40: max_concurrent (i64) — 0 = unlimited
#   offset 48: metrics (i64) — metrics vtable ptr (or 0)
#   offset 56: total_completed (i64) — counter ptr

fn mq_new(name, max_concurrent) {
    var mq = fl_alloc(64);
    store64(mq, cpq_new());
    # map_new_str: keys are Str structs (_next_job_key returns str_from_int).
    # Cyrius 5.4.14+ fixed the collision bug where the legacy map_new()
    # cstr hash walked Str struct bytes as chars. See docs/development
    # /roadmap.md and cyrius/.../stdlib-hashmap-str-key-collision.md.
    store64(mq + 8, map_new_str());
    store64(mq + 16, mutex_new());
    store64(mq + 24, name);
    store64(mq + 32, 0);
    store64(mq + 40, max_concurrent);
    store64(mq + 48, 0);
    store64(mq + 56, counter_new());
    return mq;
}

fn mq_with_metrics(mq, metrics_vt) {
    store64(mq + 48, metrics_vt);
}

# Sequential job ID counter for stable map keys.
var _mq_next_job_id = 1;

fn _next_job_key() {
    var id = _mq_next_job_id;
    _mq_next_job_id = _mq_next_job_id + 1;
    return str_from_int(id);
}

# The queue mutex covers key generation and BOTH allocations, not just the
# map_set. Two concurrent enqueues previously raced twice over:
#   1. `_next_job_key()` increments the `_mq_next_job_id` global with a plain
#      read-modify-write, so both callers could take the same key and the
#      second map_set silently overwrote the first job.
#   2. `queue_item_new` / `fl_alloc(72)` pop lib/freelist.cyr's free list with
#      no lock (unlike `alloc`, which has a CAS spinlock), so both callers
#      could be handed the same block.
# Either way jobs vanished with no error: measured 788-796 of 800 surviving
# across concurrent enqueues before the fix. See CHANGELOG 2.5.3.
fn mq_enqueue(mq, priority, payload) {
    var mtx = load64(mq + 16);
    mutex_lock(mtx);

    var item = queue_item_new(priority, payload);
    var key = _next_job_key();
    store64(item + 32, key);

    # Create managed item
    var mi = fl_alloc(72);
    store64(mi, load64(item));
    store64(mi + 8, load64(item + 8));
    store64(mi + 16, priority);
    store64(mi + 24, payload);
    store64(mi + 32, JOB_QUEUED);
    store64(mi + 40, time_now_ns());
    store64(mi + 48, 0);
    store64(mi + 56, 0);
    store64(mi + 64, 0);

    map_set(load64(mq + 8), key, mi);
    mutex_unlock(mtx);

    cpq_enqueue(load64(mq), item);

    var vt = load64(mq + 48);
    if (vt != 0) {
        metrics_queue_enqueued(vt, load64(mq + 24), priority);
    }

    return item;
}

# Dequeue next job and mark it Running. Returns 0 if the queue is empty or
# the concurrency cap is reached.
#
# Two defects fixed at 2.6.9:
#
# 1. The cap was ADVISORY. running_count was compared against max_concurrent
#    in one critical section and incremented in a different one, so N threads
#    could all observe running_count == max_c - 1, all pass the check, and all
#    increment — a queue capped at 1 ran the whole pool concurrently. The
#    check and the increment are now the same critical section.
#
# 2. mq_cancel had NO EFFECT on delivery. Dequeue overwrote the job's state
#    with JOB_RUNNING unconditionally, so a job cancelled while queued was
#    still handed to a worker, with its CANCELLED state silently overwritten.
#    A cancelled job is now skipped and the search continues.
fn mq_dequeue(mq) {
    var mtx = load64(mq + 16);
    var max_c = load64(mq + 40);
    var jobs = load64(mq + 8);

    var out = 0;
    var searching = 1;
    while (searching == 1) {
        mutex_lock(mtx);
        if (max_c > 0 && load64(mq + 32) >= max_c) {
            mutex_unlock(mtx);
            searching = 0;
        } else {
            var item = cpq_dequeue(load64(mq));
            if (item == 0) {
                mutex_unlock(mtx);
                searching = 0;
            } else {
                var key = load64(item + 32);
                var mi = map_get(jobs, key);
                if (mi != 0 && load64(mi + 32) == JOB_CANCELLED) {
                    # Cancelled while queued: drop it and keep looking. The
                    # slot is released here since no worker will complete it.
                    map_delete(jobs, key);
                    fl_free(mi);
                    mutex_unlock(mtx);
                } else {
                    # The increment stays INSIDE the mi guard. 2.6.9 moved it
                    # out, but both decrement sites (mq_complete, mq_fail)
                    # still require mi != 0 — so delivering a job whose
                    # tracking entry was already removed consumed a
                    # concurrency slot that nothing could ever give back, and
                    # the queue ratcheted toward its cap and stopped
                    # dequeuing. Skip such an item rather than deliver it: it
                    # has no tracking entry, so it can never be completed.
                    if (mi != 0) {
                        store64(mi + 32, JOB_RUNNING);
                        store64(mi + 48, time_now_ns());
                        store64(mq + 32, load64(mq + 32) + 1);
                        mutex_unlock(mtx);
                        out = item;
                        searching = 0;
                    } else {
                        mutex_unlock(mtx);
                        queue_item_free(item);
                    }
                }
            }
        }
    }

    if (out == 0) { return 0; }

    var vt = load64(mq + 48);
    if (vt != 0) {
        metrics_queue_dequeued(vt, load64(mq + 24), load64(out + 16));
    }
    return out;
}

# Remove the next QUEUED job without treating it as an execution.
#
# Returns the QueueItem, or 0 if nothing is queued. The caller owns the item
# and should release it with queue_item_free once it has copied what it needs.
#
# This exists because a steal or a drain is NOT a dequeue. `mq_dequeue` marks
# the job RUNNING, increments running_count, and — critically — REFUSES once
# running_count reaches max_concurrent. Using it to move work therefore
# (a) inflated the source's running_count, and (b) silently gave up on a queue
# whose jobs were already at the cap, which is precisely the state a rebalance
# or a deregister needs to act on. fleet.cyr used mq_dequeue + a compensating
# mq_fail for both; this is the primitive it actually wanted.
#
# Cancelled jobs are dropped rather than handed back, matching mq_dequeue.
fn mq_take_queued(mq) {
    var mtx = load64(mq + 16);
    var jobs = load64(mq + 8);

    var out = 0;
    var searching = 1;
    while (searching == 1) {
        mutex_lock(mtx);
        var item = cpq_dequeue(load64(mq));
        if (item == 0) {
            mutex_unlock(mtx);
            searching = 0;
        } else {
            var key = load64(item + 32);
            var mi = map_get(jobs, key);
            var cancelled = 0;
            if (mi != 0 && load64(mi + 32) == JOB_CANCELLED) { cancelled = 1; }
            if (mi != 0) {
                map_delete(jobs, key);
                fl_free(mi);
            }
            mutex_unlock(mtx);
            if (cancelled == 1) {
                queue_item_free(item);
            } else {
                out = item;
                searching = 0;
            }
        }
    }
    return out;
}

# Mark a job as completed.
# Terminal transitions only decrement running_count when the job was actually
# RUNNING. Previously any resolvable key decremented, so mq_complete followed
# by mq_fail on the same item (or a double mq_complete) drove running_count
# NEGATIVE — and a negative count sits permanently below max_concurrent, which
# disables the concurrency cap for the life of the queue.
#
# The map entry is also released here. mq_enqueue inserted a ManagedItem per
# job and nothing ever removed one, so a long-lived queue grew until the
# process died. Terminal states are where a job stops being interesting.
fn mq_complete(mq, item) {
    var key = load64(item + 32);
    var mtx = load64(mq + 16);
    var jobs = load64(mq + 8);

    mutex_lock(mtx);
    var mi = map_get(jobs, key);
    # Only a job that actually reached RUNNING is terminated here. 2.6.9
    # deleted and freed the ManagedItem for ANY resolvable key, including one
    # still JOB_QUEUED — leaving its QueueItem sitting in the priority queue
    # with no tracking entry, which mq_dequeue would later pop and (before the
    # guard above) hand out as an untrackable job.
    if (mi != 0 && load64(mi + 32) == JOB_RUNNING) {
        store64(mq + 32, load64(mq + 32) - 1);
        store64(mi + 32, JOB_COMPLETED);
        store64(mi + 56, time_now_ns());
        counter_inc(load64(mq + 56));
        map_delete(jobs, key);
        fl_free(mi);
    }
    mutex_unlock(mtx);
}

# Mark a job as failed.
fn mq_fail(mq, item) {
    var key = load64(item + 32);
    var mtx = load64(mq + 16);
    var jobs = load64(mq + 8);

    mutex_lock(mtx);
    var mi = map_get(jobs, key);
    if (mi != 0 && load64(mi + 32) == JOB_RUNNING) {
        store64(mq + 32, load64(mq + 32) - 1);
        store64(mi + 32, JOB_FAILED);
        store64(mi + 56, time_now_ns());
        map_delete(jobs, key);
        fl_free(mi);
    }
    mutex_unlock(mtx);
}

# Cancel a queued job (only from QUEUED state).
fn mq_cancel(mq, item) {
    var key = load64(item + 32);
    var mtx = load64(mq + 16);

    mutex_lock(mtx);
    var mi = map_get(load64(mq + 8), key);
    if (mi != 0) {
        if (load64(mi + 32) == JOB_QUEUED) {
            store64(mi + 32, JOB_CANCELLED);
            store64(mi + 56, time_now_ns());
        }
    }
    mutex_unlock(mtx);
}

fn mq_queued_count(mq) { return cpq_len(load64(mq)); }
fn mq_running_count(mq) { return load64(mq + 32); }
fn mq_total_completed(mq) { return counter_get(load64(mq + 56)); }
fn mq_job_count(mq) { return map_size(load64(mq + 8)); }

# --- pubsub.cyr ---

# majra/pubsub — pub/sub with MQTT-style wildcard matching
#
# Three tiers:
#   DirectChannel — single MPSC channel, no routing
#   HashedChannel — hashed topic routing, O(1) lookup
#   PubSub — topic/pattern matching with wildcards

# --- MQTT pattern matching ---
# Supports + (single level) and # (multi-level) wildcards.
# Topics are / delimited.

fn matches_pattern(topic, pattern) {
    var td = topic;
    var tlen = strlen(topic);
    var pd = pattern;
    var plen = strlen(pattern);
    var ti = 0;
    var pi = 0;

    while (pi < plen) {
        var pc = load8(pd + pi);

        # A wildcard is only a wildcard when it occupies a WHOLE level — i.e. it
        # sits at the start of the pattern or directly after a '/'. Without this
        # check '#'/'+' were honored mid-token, so "tenant-a#" matched
        # "tenant-a-evil/secret" and "sensors/temp+" matched "sensors/temperature"
        # — a namespace-isolation bypass, since namespace_wildcard() builds
        # exactly "<prefix>/#". See CHANGELOG 2.5.3.
        #
        # Alignment is checked INSIDE each wildcard branch rather than in a
        # combined `pc == 35 || pc == 43` guard, so a literal byte still costs
        # exactly the two comparisons it cost before 2.5.3 (the combined guard
        # measured ~15% on pattern_exact; the flat per-char version ~110%).

        # '#' — multi-level wildcard. MQTT-3.1.1 §4.7.1.2 requires it to be the
        # LAST character of the pattern; anywhere else it is a literal byte.
        if (pc == 35) {
            var hash_aligned = 0;
            if (pi == 0) { hash_aligned = 1; }
            if (pi > 0 && load8(pd + pi - 1) == 47) { hash_aligned = 1; }
            if (hash_aligned == 1 && pi + 1 == plen) {
                return 1;
            }
        }

        # '+' — single-level wildcard: must occupy a whole level, so the next
        # byte has to be '/' or end-of-pattern.
        if (pc == 43) {
            var plus_aligned = 0;
            if (pi == 0) { plus_aligned = 1; }
            if (pi > 0 && load8(pd + pi - 1) == 47) { plus_aligned = 1; }

            var plus_ok = 0;
            if (plus_aligned == 1) {
                if (pi + 1 == plen) { plus_ok = 1; }
                if (pi + 1 < plen && load8(pd + pi + 1) == 47) { plus_ok = 1; }
            }
            if (plus_ok == 1) {
                # '+' matches one level (up to next /)
                while (ti < tlen) {
                    if (load8(td + ti) == 47) { break; }
                    ti = ti + 1;
                }
                pi = pi + 1;
                # Skip matching / in both
                if (pi < plen && ti < tlen) {
                    if (load8(pd + pi) == 47 && load8(td + ti) == 47) {
                        pi = pi + 1;
                        ti = ti + 1;
                    }
                }
                continue;
            }
        }

        if (ti >= tlen) {
            # Parent level: "<prefix>/#" also matches the bare topic "<prefix>",
            # because '#' includes the parent level (MQTT-3.1.1 §4.7.1.2 —
            # "sport/# also matches the singular sport"). Folded into the
            # existing exhausted-topic branch so it costs nothing until the
            # topic actually runs out.
            if (pc == 47 && pi + 2 == plen && load8(pd + pi + 1) == 35) {
                return 1;
            }
            return 0;
        }
        if (pc != load8(td + ti)) { return 0; }
        pi = pi + 1;
        ti = ti + 1;
    }

    return ti >= tlen;
}

# --- Subscriber ---
# A subscriber has a channel and an optional filter function pointer.
# Subscriber struct (16 bytes):
#   offset 0: chan (i64) — MPSC channel ptr
#   offset 8: filter_fn (i64) — function ptr or 0

fn _sub_new(chan, filter_fn) {
    var s = fl_alloc(16);
    store64(s, chan);
    store64(s + 8, filter_fn);
    return s;
}

# --- PubSub Hub ---
# PubSub struct (32 bytes):
#   offset  0: exact_subs (i64) — hashmap: topic_str -> vec of subscriber ptrs
#   offset  8: pattern_subs (i64) — hashmap: pattern_str -> vec of subscriber ptrs
#   offset 16: mutex (i64)
#   offset 24: total_published (i64) — counter ptr

fn pubsub_new() {
    var ps = fl_alloc(32);
    store64(ps, map_new());
    store64(ps + 8, map_new());
    store64(ps + 16, mutex_new());
    store64(ps + 24, counter_new());
    return ps;
}

# Subscribe to an exact topic. Returns a channel to recv from.
fn pubsub_subscribe(ps, topic) {
    # The hub mutex is taken BEFORE chan_new/_sub_new, not after. `fl_alloc`
    # (lib/freelist.cyr) pops its size-class free list with a plain
    # load/store pair and carries no lock — unlike `alloc`, which has a CAS
    # spinlock — so two concurrent subscribers could be handed the SAME
    # 16-byte subscriber block. Both then wrote it, the vec got the same
    # pointer twice, and one caller walked away with a channel that was never
    # registered: its chan_recv blocks forever while `delivered` counts it.
    # Measured before the fix: 1-7 orphaned channels per 800 concurrent
    # subscribes. See CHANGELOG 2.5.3 and cyrius-quirks.md §8.
    var mtx = load64(ps + 16);
    mutex_lock(mtx);
    var ch = chan_new(64);
    var sub = _sub_new(ch, 0);
    var exact = load64(ps);
    var subs = map_get(exact, topic);
    if (subs == 0) {
        subs = vec_new();
        map_set(exact, topic, subs);
    }
    vec_push(subs, sub);
    mutex_unlock(mtx);
    return ch;
}

# Subscribe to a wildcard pattern. Returns a channel to recv from.
fn pubsub_subscribe_pattern(ps, pattern) {
    # Lock before allocating — see pubsub_subscribe for why.
    var mtx = load64(ps + 16);
    mutex_lock(mtx);
    var ch = chan_new(64);
    var sub = _sub_new(ch, 0);
    var patterns = load64(ps + 8);
    var subs = map_get(patterns, pattern);
    if (subs == 0) {
        subs = vec_new();
        map_set(patterns, pattern, subs);
    }
    vec_push(subs, sub);
    mutex_unlock(mtx);
    return ch;
}

# Subscribe with a filter function. filter_fn(payload) should return 1 to accept.
fn pubsub_subscribe_filtered(ps, topic, filter_fn) {
    # Lock before allocating — see pubsub_subscribe for why.
    var mtx = load64(ps + 16);
    mutex_lock(mtx);
    var ch = chan_new(64);
    var sub = _sub_new(ch, filter_fn);
    var exact = load64(ps);
    var subs = map_get(exact, topic);
    if (subs == 0) {
        subs = vec_new();
        map_set(exact, topic, subs);
    }
    vec_push(subs, sub);
    mutex_unlock(mtx);
    return ch;
}

# Publish to a topic. Delivers to exact and pattern subscribers.
# Returns number of subscribers delivered to.
# The hub mutex is NEVER held across a chan_send. A subscriber channel is
# bounded (64 slots) and chan_send BLOCKS when full (lib/thread.cyr) — holding
# the hub lock across that block parked the publisher inside the critical
# section, so one lagging consumer stalled publishes to every *other* topic and
# blocked pubsub_subscribe outright. Measured before the fix: publish latency on
# an unrelated, always-empty topic went 4.7us -> 10.7ms avg / 213ms worst behind
# a single slow-but-well-behaved consumer. See CHANGELOG 2.5.3.
#
# Each subscriber list is snapshotted as a (data, len) pair under one short
# lock, then walked unlocked. That is safe because vec_push grows by allocating
# a NEW backing buffer through the bump allocator and never frees the old one
# (lib/vec.cyr `vec_push_a`), and because pushes only append — so the snapshot
# stays valid memory and its first `len` entries never change. A concurrent
# subscribe is simply not seen by an already-started publish, which is the same
# ordering the old whole-publish lock gave. Snapshotting also keeps the string
# hash out of the loop: a map_get per iteration cost ~40% on publish.
fn pubsub_publish(ps, topic, payload) {
    # ⚠ FAN-OUT IS BLOCKING, BY DESIGN — this is a backpressure contract, not
    # an oversight, and it differs from relay (which switched to a
    # non-blocking chan_try_send at 2.6.6 to match tokio broadcast semantics).
    #
    # A subscriber whose 64-slot ring is full parks THIS publish call until the
    # consumer drains. 2.5.3 bounded the blast radius by releasing the hub
    # mutex before sending, so a lagging consumer no longer freezes unrelated
    # topics or blocks pubsub_subscribe — verified by
    # test_pubsub_no_head_of_line_block, which asserts a parked publisher
    # resumes once its channel drains.
    #
    # The residual risk is real and accepted: majra has no pubsub unsubscribe,
    # so a subscriber that is ABANDONED without draining wedges any publish to
    # its topic permanently. Dropping instead would trade that for silent
    # message loss, which is the worse failure for a queue engine. Consumers
    # must drain or exit the process. Tracked as a roadmap item (unsubscribe +
    # a per-subscriber lag policy).
    var mtx = load64(ps + 16);
    var delivered = 0;

    # --- Exact subscribers ---
    mutex_lock(mtx);
    var exact = load64(ps);
    var subs = map_get(exact, topic);
    var sdata = 0;
    var slen = 0;
    if (subs != 0) {
        sdata = load64(subs);
        slen = load64(subs + 8);
    }
    var patterns = load64(ps + 8);
    # Snapshot the pattern slot array under the lock instead of calling
    # map_keys, which allocates a vec from the BUMP allocator on EVERY publish
    # and can never be freed. The slot array itself is stable while the lock is
    # held; the loop below re-locks per pattern to read its subscriber list, so
    # a concurrent subscribe that rehashes is picked up on the next publish.
    var pat_entries = map_entries(patterns);
    var pat_cap = map_cap(patterns);
    mutex_unlock(mtx);

    var i = 0;
    while (i < slen) {
        var sub = load64(sdata + i * 8);
        var filter = load64(sub + 8);
        if (filter == 0 || fncall1(filter, payload) == 1) {
            # chan_send is BLOCKING, and deliberately so — see the note above
            # pubsub_publish. chan_send returns -1 on a closed channel; only
            # count a real delivery so the return value can't over-report.
            if (chan_send(load64(sub), payload) == 0) {
                delivered = delivered + 1;
            }
        }
        i = i + 1;
    }

    # --- Pattern subscribers ---
    var j = 0;
    while (j < pat_cap) {
        var pep = pat_entries + j * 24;
        var pat = 0;
        if (load64(pep + 16) == 1) { pat = load64(pep); }
        if (pat != 0 && matches_pattern(topic, pat) == 1) {
            mutex_lock(mtx);
            var psubs = map_get(patterns, pat);
            var pdata = 0;
            var pnlen = 0;
            if (psubs != 0) {
                pdata = load64(psubs);
                pnlen = load64(psubs + 8);
            }
            mutex_unlock(mtx);

            var k = 0;
            while (k < pnlen) {
                var psub = load64(pdata + k * 8);
                var pfilter = load64(psub + 8);
                if (pfilter == 0 || fncall1(pfilter, payload) == 1) {
                    if (chan_send(load64(psub), payload) == 0) {
                        delivered = delivered + 1;
                    }
                }
                k = k + 1;
            }
        }
        j = j + 1;
    }

    counter_inc(load64(ps + 24));
    return delivered;
}

fn pubsub_total_published(ps) {
    return counter_get(load64(ps + 24));
}

# --- DirectChannel ---
# Zero-overhead point-to-point channel (no topic routing).
# Just a thin wrapper around an MPSC channel.

fn direct_channel_new(capacity) {
    return chan_new(capacity);
}

fn direct_channel_send(ch, payload) {
    return chan_send(ch, payload);
}

fn direct_channel_recv(ch) {
    return chan_recv(ch);
}

# --- HashedChannel ---
# Sharded by topic hash. O(1) lookup.
# HashedChannel struct (16 bytes):
#   offset 0: channels (i64) — hashmap: topic_str -> channel ptr
#   offset 8: mutex (i64)

fn hashed_channel_new() {
    var hc = fl_alloc(16);
    store64(hc, map_new());
    store64(hc + 8, mutex_new());
    return hc;
}

# Get or create channel for a topic.
fn _hc_get_or_create(hc, topic) {
    var chans = load64(hc);
    var ch = map_get(chans, topic);
    if (ch == 0) {
        ch = chan_new(64);
        map_set(chans, topic, ch);
    }
    return ch;
}

fn hashed_channel_send(hc, topic, payload) {
    # Resolve the shard under the lock, send outside it — same bounded-channel
    # reasoning as pubsub_publish: chan_send blocks when the channel is full,
    # and holding `hc`'s mutex across that block stalls every other topic's
    # send and every hashed_channel_subscribe. See CHANGELOG 2.5.3.
    var mtx = load64(hc + 8);
    mutex_lock(mtx);
    var ch = _hc_get_or_create(hc, topic);
    mutex_unlock(mtx);
    return chan_send(ch, payload);
}

fn hashed_channel_subscribe(hc, topic) {
    var mtx = load64(hc + 8);
    mutex_lock(mtx);
    var ch = _hc_get_or_create(hc, topic);
    mutex_unlock(mtx);
    return ch;
}

# --- relay.cyr ---

# majra/relay — sequenced, deduplicated inter-node message relay
#
# Each node gets a sequence counter. Receivers track the last seen
# sequence per sender, dropping duplicates and out-of-order messages.

# RelayMessage struct (64 bytes, 8 fields):
#   offset  0: seq (i64)
#   offset  8: from_str (i64) — Str ptr
#   offset 16: to_str (i64) — Str ptr (0 or empty = broadcast)
#   offset 24: topic_str (i64) — Str ptr
#   offset 32: payload (i64) — ptr to payload data
#   offset 40: timestamp_ns (i64) — WALL CLOCK (epoch ns), not monotonic
#   offset 48: correlation_id (i64) — Str ptr or 0
#   offset 56: is_reply (i64) — 0 or 1

# Build a RelayMessage. `to` of 0 or "" marks it a broadcast.
fn relay_msg_new(seq, from, to, topic, payload) {
    var m = fl_alloc(64);
    store64(m, seq);
    store64(m + 8, from);
    store64(m + 16, to);
    store64(m + 24, topic);
    store64(m + 32, payload);
    # ⚠ **Wall clock, not `time_now_ns()`.** A RelayMessage is serialised and
    # sent to another node, and Rust stamps it `DateTime<Utc>` — a portable
    # instant. `time_now_ns()` is CLOCK_MONOTONIC, whose zero is an arbitrary
    # per-boot point, so the number this carried was meaningless outside the
    # emitting process: two nodes could not order each other's messages by it,
    # and a persisted one could not be read back after a reboot. Reported by
    # agnosai 2026-08-13 while porting `fleet/relay`.
    #
    # Nothing in this module compares timestamps — dedup and ordering are by
    # `seq`, not by time — so this changes what the field MEANS without changing
    # any decision made inside majra.
    #
    # ⚠ `time_epoch_ns` is majra's OWN (`src/envelope.cyr`), not the stdlib's
    # `clock_epoch_ns` — `chrono` is not among the modules a `--no-deps` build
    # prepends, and `--no-deps` is what CI runs, so the stdlib call compiled
    # locally and failed there with `undefined function`.
    store64(m + 40, time_epoch_ns());
    store64(m + 48, 0);
    store64(m + 56, 0);
    return m;
}

# The message's wall-clock stamp, in epoch nanoseconds (2.6.5 — it was
# CLOCK_MONOTONIC before, which is not portable across processes).
fn relay_msg_timestamp(m) {
    return load64(m + 40);
}

# DedupEntry struct (16 bytes):
#   offset 0: last_seq (i64)
#   offset 8: last_seen_ns (i64)

# Relay struct (64 bytes):
#   offset  0: node_id (i64) — Str ptr
#   offset  8: next_seq (i64)
#   offset 16: seen (i64) — hashmap: node_id_str -> DedupEntry ptr
#   offset 24: subscribers (i64) — vec of channel ptrs
#   offset 32: pending_requests (i64) — hashmap: correlation_id -> channel ptr
#   offset 40: mutex (i64)
#   offset 48: messages_sent (i64) — counter ptr
#   offset 56: messages_received (i64) — counter ptr
#   offset 64: duplicates_dropped (i64) — counter ptr
#   offset 72: dedup_evicted (i64) — counter ptr
#   offset 80: max_dedup (i64) — 0 = unbounded (the default)
#   offset 88: sequence_gaps (i64) — counter ptr  (2.6.0)
#   offset 96: capacity (i64) — subscriber channel depth (2.6.5)

# The subscriber channel depth `relay_subscribe` hands out when none is asked
# for. Rust's `Relay::with_defaults`, and what every caller got before 2.6.5.
var RELAY_DEFAULT_CAPACITY = 256;

# Create a relay for `node_id` with the default subscriber depth of 256.
#
# Dedup is unbounded by default; see `relay_set_max_dedup` before changing that.
fn relay_new(node_id) {
    return relay_with_capacity(node_id, RELAY_DEFAULT_CAPACITY);
}

# Create a relay whose subscriber channels hold `capacity` messages.
#
# ⚠ **`relay_subscribe` used to hardcode `chan_new(256)`**, so a caller asking
# for 4 and a caller asking for 4096 got byte-identical behaviour — the
# parameter Rust's `broadcast::channel(capacity)` honours was accepted upstream
# and silently discarded here. agnosai recorded it in `fleet/relay.cyr` as "owed
# to majra"; this is that debt. A `capacity <= 0` falls back to the default
# rather than building a zero-depth channel nothing could ever be sent through.
fn relay_with_capacity(node_id, capacity) {
    var r = fl_alloc(104);
    store64(r, node_id);
    store64(r + 8, 1);
    store64(r + 16, map_new());
    store64(r + 24, vec_new());
    store64(r + 32, map_new());
    store64(r + 40, mutex_new());
    store64(r + 48, counter_new());
    store64(r + 56, counter_new());
    store64(r + 64, counter_new());
    store64(r + 72, counter_new());
    store64(r + 80, 0);
    store64(r + 88, counter_new());
    if (capacity <= 0) { capacity = RELAY_DEFAULT_CAPACITY; }
    store64(r + 96, capacity);
    return r;
}

# Bound the dedup table to `max` senders, evicting the least-recently-seen when
# it overflows. `0` (the default) means unbounded and is what `relay_new` sets.
#
# ⚠ **Enabling this opens a replay window, by construction.** Evicting a sender
# forgets its last-seen sequence number, so that sender's already-delivered
# messages become acceptable again — `relay_receive` will pass them through and
# fan them out a second time. Unbounded is the safe default and the one that
# matches a strict "deliver each sequence once" contract; bound it only when an
# unbounded sender population is the bigger risk, and size `max` above the real
# peer count so eviction is a backstop rather than routine.
fn relay_set_max_dedup(r, max) {
    store64(r + 80, max);
}

# This relay's own node id.
fn relay_node_id(r) {
    return load64(r);
}

# Send a message to a specific node. Returns sequence number.
fn relay_send(r, to, topic, payload) {
    var mtx = load64(r + 40);
    # The whole send is one critical section.
    #
    # The sequence number used to be claimed under the mutex and the fan-out
    # done after releasing it, so two concurrent senders could interleave:
    # thread A takes seq 1, thread B takes seq 2, B fans out first, and every
    # subscriber sees 2 before 1. Subscribers use the sequence for ordering and
    # dedup, so an out-of-order pair is indistinguishable from a replay.
    #
    # Holding the lock across the fan-out is safe precisely BECAUSE the fan-out
    # is chan_try_send (see below) — it never blocks, so this cannot reproduce
    # the head-of-line class 2.5.3 fixed in pubsub.
    #
    # The subscriber vec is also read under the lock now; relay_subscribe
    # mutates it under the same mutex, so iterating it unlocked could observe a
    # reallocated backing buffer mid-push.
    mutex_lock(mtx);
    var seq = load64(r + 8);
    store64(r + 8, seq + 1);

    var msg = relay_msg_new(seq, load64(r), to, topic, payload);

    # Broadcast to all subscribers
    var subs = load64(r + 24);
    var i = 0;
    var len = vec_len(subs);
    # ⚠ **`chan_try_send`, NEVER `chan_send`.** Rust's `Relay` is a
    # `tokio::sync::broadcast` and `Relay::send` is `let _ = self.tx.send(..)`
    # (`fleet/relay.rs:133`) — it never blocks: a full ring overwrites its oldest
    # slot and the lagging receiver observes `RecvError::Lagged`. `chan_send`
    # futex-waits for space instead, so a subscriber that stops draining wedges
    # the SENDER forever, and majra has no unsubscribe to break the wedge.
    #
    # ⚠ This was latent until 2.6.5. Every subscriber channel was 256 deep
    # regardless of the capacity asked for, so the block needed 256 undrained
    # messages; honouring the capacity made it reachable at whatever depth the
    # caller names — `relay_with_capacity(id, 2)` deadlocks on the third send.
    # Dropping when full is the behaviour that matches the oracle.
    while (i < len) {
        chan_try_send(vec_get(subs, i), msg);
        i = i + 1;
    }
    mutex_unlock(mtx);

    counter_inc(load64(r + 48));
    return seq;
}

# Broadcast to all nodes.
fn relay_broadcast(r, topic, payload) {
    return relay_send(r, 0, topic, payload);
}

# Subscribe to inbound messages. Returns a channel.
# The configured depth for this relay's subscribers.
fn relay_capacity(r) {
    return load64(r + 96);
}

fn relay_subscribe(r) {
    var ch = chan_new(load64(r + 96));
    var mtx = load64(r + 40);
    mutex_lock(mtx);
    vec_push(load64(r + 24), ch);
    mutex_unlock(mtx);
    return ch;
}

# Allocate a dedup entry for a new sender.
#
# ⚠ 2.6.0: this took its three inputs from FILE-SCOPE globals until now, as did
# `relay_receive` itself. The comment they carried said they "predate cc5" and
# were a cc3 local-clobbering workaround kept because removing them "would
# require a structural refactor". That refactor is this: they are parameters.
# The globals made `relay_receive` **non-reentrant**, so two threads receiving
# concurrently corrupted each other's dedup decision — reported by agnosai,
# whose sandhi pool runs 100 workers.
fn _relay_alloc_dedup_entry(dmap, key, seq) {
    var entry = fl_alloc(16);
    store64(entry, seq);
    store64(entry + 8, time_now_ns());
    map_set(dmap, key, entry);
    return entry;
}

# Whether `msg` was sent by this relay itself.
fn _recv_skip_own(r, msg) {
    var from = load64(msg + 8);
    var nid = load64(r);
    if (from != 0 && nid != 0 && streq(from, nid) == 1) { return 1; }
    return 0;
}

# 1 = broadcast, 0 = addressed to this node, 2 = addressed elsewhere.
fn _recv_check_target(r, msg) {
    var to = load64(msg + 16);
    var nid = load64(r);
    if (to == 0 || strlen(to) == 0) { return 1; }
    if (streq(to, nid) == 1) { return 0; }
    return 2;
}

# IncomingMessage struct (16 bytes), returned by `relay_receive_ex`:
#   offset 0: is_broadcast (i64) — 1 if the message carried no explicit target
#   offset 8: msg (i64) — the RelayMessage ptr
#
# 2.6.0. Before it, `relay_receive` computed `is_broadcast` and then threw it
# away — a consumer could not tell a broadcast from a direct message without
# re-inspecting the envelope, which is what agnosai's port needed.
fn incoming_is_broadcast(inc) {
    return load64(inc);
}

# The RelayMessage carried by an IncomingMessage.
fn incoming_msg(inc) {
    return load64(inc + 8);
}

# The last sequence number seen from `from`, or -1 if that sender is unknown.
#
# 2.6.0. Exposed so a caller can implement its own gap policy; `relay_stats`'s
# `sequence_gaps` counter is the built-in one.
fn relay_last_seq(r, from) {
    var mtx = load64(r + 40);
    mutex_lock(mtx);
    var entry = map_get(load64(r + 16), from);
    var out = 0 - 1;
    if (entry != 0) { out = load64(entry); }
    mutex_unlock(mtx);
    return out;
}

# Process an incoming message. Returns an IncomingMessage ptr, or 0 if the
# message was skipped (ours, addressed elsewhere, or a duplicate).
#
# ⚠ 2.6.0 made this REENTRANT. It previously stashed its arguments and dedup
# state in file-scope globals AND took no lock at all, while every other mutating
# entry point (`relay_send`, `relay_subscribe`, `relay_evict_stale_dedup`) locked
# `r + 40`. Two threads receiving concurrently therefore raced both the globals
# and the `seen` map. Reported by agnosai, whose sandhi pool runs 100 workers.
#
# The lock is held across the dedup decision, the eviction sweep and the counter
# updates, then released BEFORE the subscriber fan-out — the same shape majra
# 2.5.3 gave `pubsub_publish`, so a slow or full subscriber channel cannot block
# an unrelated receive.
fn relay_receive_ex(r, msg) {
    if (_recv_skip_own(r, msg) == 1) { return 0; }

    var target_check = _recv_check_target(r, msg);
    if (target_check == 2) { return 0; }
    var is_broadcast = target_check;

    var mtx = load64(r + 40);
    mutex_lock(mtx);

    var seen = load64(r + 16);
    var sender = load64(msg + 8);
    var seq = load64(msg);

    var entry = map_get(seen, sender);
    if (entry != 0) {
        var last = load64(entry);
        if (seq <= last) {
            counter_inc(load64(r + 64));
            mutex_unlock(mtx);
            return 0;
        }
        # A sequence gap means at least one message from this sender was lost in
        # transit. Not an error — the message is still delivered — but it is the
        # signal a caller needs to request a resend or raise an alarm.
        if (seq != last + 1) { counter_inc(load64(r + 88)); }
        store64(entry, seq);
        store64(entry + 8, time_now_ns());
    } else {
        # A first message whose sequence is not 1 also skipped messages.
        if (seq != 1) { counter_inc(load64(r + 88)); }
        _relay_alloc_dedup_entry(seen, sender, seq);
    }

    # Enforce the dedup table bound, if one was set. See relay_set_max_dedup for
    # why this is off by default.
    var max_dedup = load64(r + 80);
    if (max_dedup > 0 && map_size(seen) > max_dedup) {
        # Iterate the slot array rather than map_keys, which allocates a vec
        # from the never-freeing bump allocator on every eviction pass.
        var dent = map_entries(seen);
        var dcap = map_cap(seen);
        var oldest_key = 0;
        var oldest_entry = 0;
        var oldest_time = 0;
        var i = 0;
        while (i < dcap) {
            var sp = dent + i * 24;
            if (load64(sp + 16) == 1) {
                var e = load64(sp + 8);
                var t = load64(e + 8);
                if (oldest_key == 0 || t < oldest_time) {
                    oldest_key = load64(sp);
                    oldest_entry = e;
                    oldest_time = t;
                }
            }
            i = i + 1;
        }
        if (oldest_key != 0) {
            map_delete(seen, oldest_key);
            # The DedupEntry block itself was never released, so the mechanism
            # added to BOUND the dedup table's memory leaked one block per
            # eviction — it bounded the map and not the memory.
            if (oldest_entry != 0) { fl_free(oldest_entry); }
            counter_inc(load64(r + 72));
        }
    }

    counter_inc(load64(r + 56));

    # The fan-out happens UNDER the lock and walks the subscriber vec directly.
    #
    # This used to build a per-message `vec_new()` snapshot so the walk could
    # happen unlocked. The snapshot came from the BUMP allocator, which never
    # reclaims, so the relay's hot path leaked a vec per received message —
    # agnosai drives this from a 100-worker pool. Walking under the lock is
    # safe here for the same reason as relay_send: the fan-out is
    # chan_try_send and never blocks.
    var subs = load64(r + 24);

    # ✅ The result struct is allocated AFTER the unlock, which is where it
    # belongs — the block is private to this call and nothing under the lock
    # reads it.
    #
    # ⚠ It was deliberately allocated **under** the lock from 2.6.1 to 2.6.2,
    # and that is worth recording rather than re-deriving. `fl_alloc` was not
    # thread-safe: `lib/freelist.cyr` read and wrote the global `_fl_heads` free
    # lists with plain loads and stores, no mutex and no atomics, so two threads
    # in `relay_receive` concurrently could be handed the SAME block. Not
    # theoretical — it corrupted the dedup table (a message arriving under
    # another sender's sequence, then rejected as a duplicate) and, under real
    # contention, faulted. Pulling the allocation inside the critical section
    # serialised majra against itself as a stopgap.
    #
    # **cyrius 6.5.19 makes `fl_alloc` thread-safe** (a process-wide CAS
    # spinlock over the free-list splice, the arena bump and the arena refill),
    # so the stopgap is retired. It was never a complete fix anyway — it
    # serialised majra against majra while any other thread in the process
    # calling `fl_alloc` still raced it, which is why the real fix had to be
    # upstream. Shortening the critical section back is the point of undoing it:
    # this lock is held across a subscriber-list walk on a hot pub/sub path.
    var j = 0;
    var jlen = vec_len(subs);
    # Same never-block contract as `relay_send` — see the note there.
    while (j < jlen) {
        chan_try_send(vec_get(subs, j), msg);
        j = j + 1;
    }
    mutex_unlock(mtx);

    var inc = fl_alloc(16);
    if (inc == 0) { return 0; }
    store64(inc, is_broadcast);
    store64(inc + 8, msg);
    return inc;
}

# Release an IncomingMessage returned by relay_receive_ex.
fn incoming_msg_free(inc) {
    if (inc != 0) { fl_free(inc); }
    return 0;
}

# Process an incoming message. Returns the message if it passes dedup, or 0.
#
# Kept for backward compatibility: this is `relay_receive_ex` with the
# broadcast flag dropped. New code should prefer `relay_receive_ex`.
fn relay_receive(r, msg) {
    var inc = relay_receive_ex(r, msg);
    if (inc == 0) { return 0; }
    # The wrapper used to drop `inc` on the floor, leaking the freelist block
    # relay_receive_ex allocated for every received message.
    var m = incoming_msg(inc);
    fl_free(inc);
    return m;
}

# How many senders the dedup table currently tracks.
fn relay_dedup_table_size(r) {
    return map_size(load64(r + 16));
}

# Evict dedup entries idle longer than max_idle_ns. Returns count.
fn relay_evict_stale_dedup(r, max_idle_ns) {
    var now = time_now_ns();
    var mtx = load64(r + 40);
    mutex_lock(mtx);
    # Carries both defects 2.6.9 fixed in the sibling eviction path inside
    # relay_receive_ex and did not apply here: it built TWO bump-allocated vecs
    # per sweep (map_keys plus to_remove, neither reclaimable), and it deleted
    # DedupEntry blocks without freeing them — so the routine whose whole job
    # is bounding the dedup table's memory leaked a block per eviction.
    #
    # Now allocation-free, walking the slot array directly. Deleting during the
    # walk is safe because map_delete leaves a tombstone rather than
    # reshuffling: _map_find skips st == 2 and _map_grow_a rehashes only live
    # entries, so no slot this loop has yet to visit moves.
    var seen = load64(r + 16);
    var entries = map_entries(seen);
    var cap = map_cap(seen);
    var count = 0;
    var i = 0;
    while (i < cap) {
        var sp = entries + i * 24;
        if (load64(sp + 16) == 1) {
            var e = load64(sp + 8);
            if (now - load64(e + 8) > max_idle_ns) {
                var k = load64(sp);
                map_delete(seen, k);
                # Free strictly AFTER the delete, which needs the key to find
                # the entry — same ordering rule as ratelimit_evict_stale.
                fl_free(e);
                count = count + 1;
            }
        }
        i = i + 1;
    }
    if (count > 0) {
        counter_add(load64(r + 72), count);
    }
    mutex_unlock(mtx);
    return count;
}

# RelayStats struct (48 bytes):
#   offset  0: messages_sent
#   offset  8: messages_received
#   offset 16: duplicates_dropped
#   offset 24: dedup_evicted
#   offset 32: dedup_table_size
#   offset 40: sequence_gaps        (2.6.0 — APPENDED, so offsets 0..32 are
#                                    unchanged and existing readers still work)
fn relay_stats(r) {
    var s = fl_alloc(48);
    store64(s, counter_get(load64(r + 48)));
    store64(s + 8, counter_get(load64(r + 56)));
    store64(s + 16, counter_get(load64(r + 64)));
    store64(s + 24, counter_get(load64(r + 72)));
    store64(s + 32, map_size(load64(r + 16)));
    store64(s + 40, counter_get(load64(r + 88)));
    return s;
}

# --- barrier.cyr ---

# majra/barrier — N-way barrier synchronization with deadlock recovery
#
# A barrier waits for N participants to arrive before releasing all of them.
# Supports force() to unblock when a participant is known dead.

# BarrierResult values
enum BarrierResultKind {
    BARRIER_WAITING = 0;
    BARRIER_RELEASED = 1;
    BARRIER_UNKNOWN = 2;
}

# BarrierResult struct (24 bytes):
#   offset 0: kind (i64)
#   offset 8: arrived (i64)
#   offset 16: expected (i64)

fn _barrier_result(kind, arrived, expected) {
    var r = fl_alloc(24);
    store64(r, kind);
    store64(r + 8, arrived);
    store64(r + 16, expected);
    return r;
}

# --- Helper: vec-based string set ---
# Since we don't have HashSet, use a vec of strings with dedup.

fn _set_contains(v, s) {
    var i = 0;
    var len = vec_len(v);
    while (i < len) {
        if (streq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _set_add(v, s) {
    if (_set_contains(v, s) == 0) {
        vec_push(v, s);
    }
}

fn _set_remove(v, s) {
    var i = 0;
    var len = vec_len(v);
    while (i < len) {
        if (streq(vec_get(v, i), s) == 1) {
            vec_remove(v, i);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Check if arrived is a superset of expected
fn _set_is_superset(arrived, expected) {
    var i = 0;
    var len = vec_len(expected);
    while (i < len) {
        if (_set_contains(arrived, vec_get(expected, i)) == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

# BarrierState struct (24 bytes):
#   offset  0: expected (i64) — vec of participant name strings
#   offset  8: arrived (i64) — vec of participant name strings
#   offset 16: was_forced (i64)

# Takes a COPY of the participants vec.
#
# barrier_force mutates the expected set in place via _set_remove, so storing
# the caller's vec by reference let two barriers built from one shared list
# corrupt each other's membership, and silently modified the caller's own vec.
# 2.6.9 fixed exactly this in _cbarrier_state_new and left the non-concurrent
# twin alone.
fn _barrier_state_new(participants_vec) {
    var bs = fl_alloc(24);
    var owned = vec_new();
    var pi = 0;
    var pn = 0;
    if (participants_vec != 0) { pn = vec_len(participants_vec); }
    while (pi < pn) {
        vec_push(owned, vec_get(participants_vec, pi));
        pi = pi + 1;
    }
    store64(bs, owned);
    store64(bs + 8, vec_new());
    store64(bs + 16, 0);
    return bs;
}

fn _check_barrier(bs) {
    var arrived = load64(bs + 8);
    var expected = load64(bs);
    if (_set_is_superset(arrived, expected) == 1) {
        return _barrier_result(BARRIER_RELEASED, vec_len(arrived), vec_len(expected));
    }
    return _barrier_result(BARRIER_WAITING, vec_len(arrived), vec_len(expected));
}

# --- BarrierSet (single-threaded) ---
# BarrierSet struct (8 bytes):
#   offset 0: barriers (i64) — hashmap: name_str -> BarrierState ptr

fn barrier_set_new() {
    var bs = fl_alloc(8);
    store64(bs, map_new());
    return bs;
}

# Create a barrier. participants is a vec of name strings.
fn barrier_create(bs, name, participants) {
    var barriers = load64(bs);
    var existed = map_has(barriers, name);
    map_set(barriers, name, _barrier_state_new(participants));
    return existed == 0;
}

fn barrier_arrive(bs, name, participant) {
    var state = map_get(load64(bs), name);
    if (state == 0) {
        return _barrier_result(BARRIER_UNKNOWN, 0, 0);
    }
    _set_add(load64(state + 8), participant);
    return _check_barrier(state);
}

fn barrier_force(bs, name, dead_participant) {
    var state = map_get(load64(bs), name);
    if (state == 0) {
        return _barrier_result(BARRIER_UNKNOWN, 0, 0);
    }
    _set_remove(load64(state), dead_participant);
    _set_remove(load64(state + 8), dead_participant);
    store64(state + 16, 1);
    return _check_barrier(state);
}

# Complete and remove a barrier. Returns 1 if found, 0 otherwise.
fn barrier_complete(bs, name) {
    return map_delete(load64(bs), name);
}

fn barrier_set_len(bs) {
    return map_size(load64(bs));
}

fn barrier_set_is_empty(bs) {
    return map_size(load64(bs)) == 0;
}

# --- ConcurrentBarrierSet (thread-safe) ---
# Adds a mutex + futex-based notification for arrive_and_wait.
# ConcurrentBarrierState extends BarrierState:
#   offset  0: expected vec
#   offset  8: arrived vec
#   offset 16: was_forced
#   offset 24: released_flag (i64) — 0 or 1
#   offset 32: futex_addr (i64) — address for futex wait/wake

# Takes a COPY of the participants vec.
#
# The caller's vec used to be stored by reference, and cbarrier_force mutates
# it in place via _set_remove — so two barriers created from one shared
# participant list corrupted each other's expected set, and the caller's own
# vec was silently modified out from under it. A barrier's membership must not
# depend on what the caller does with its list afterwards.
fn _cbarrier_state_new(participants) {
    var cbs = fl_alloc(40);
    var owned = vec_new();
    var i = 0;
    var n = 0;
    if (participants != 0) { n = vec_len(participants); }
    while (i < n) {
        vec_push(owned, vec_get(participants, i));
        i = i + 1;
    }
    store64(cbs, owned);
    store64(cbs + 8, vec_new());
    store64(cbs + 16, 0);
    store64(cbs + 24, 0);
    store64(cbs + 32, 0);
    return cbs;
}

fn _cbarrier_check_release(state) {
    var arrived = load64(state + 8);
    var expected = load64(state);
    if (_set_is_superset(arrived, expected) == 1) {
        store64(state + 24, 1);
        store64(state + 32, load64(state + 32) + 1);
        # agnos: no futex — cooperative waiters spin on the released flag +
        # sched_yield, so the wake is a no-op (nothing parked to wake).
        #ifndef CYRIUS_TARGET_AGNOS
        syscall(SYS_FUTEX, state + 32, FUTEX_WAKE, 1000, 0, 0, 0);
        #endif
        return 1;
    }
    return 0;
}

# ConcurrentBarrierSet struct (16 bytes):
#   offset 0: barriers (i64) — hashmap
#   offset 8: mutex (i64)

fn cbarrier_set_new() {
    var cbs = fl_alloc(16);
    store64(cbs, map_new());
    store64(cbs + 8, mutex_new());
    return cbs;
}

fn cbarrier_create(cbs, name, participants) {
    var mtx = load64(cbs + 8);
    mutex_lock(mtx);
    var barriers = load64(cbs);
    var existed = map_has(barriers, name);
    map_set(barriers, name, _cbarrier_state_new(participants));
    mutex_unlock(mtx);
    return existed == 0;
}

fn cbarrier_arrive(cbs, name, participant) {
    var mtx = load64(cbs + 8);
    mutex_lock(mtx);
    var state = map_get(load64(cbs), name);
    if (state == 0) {
        mutex_unlock(mtx);
        return _barrier_result(BARRIER_UNKNOWN, 0, 0);
    }
    _set_add(load64(state + 8), participant);

    if (_cbarrier_check_release(state) == 1) {
        mutex_unlock(mtx);
        return _barrier_result(BARRIER_RELEASED, vec_len(load64(state + 8)), vec_len(load64(state)));
    }
    var arrived = vec_len(load64(state + 8));
    var expected = vec_len(load64(state));
    mutex_unlock(mtx);
    return _barrier_result(BARRIER_WAITING, arrived, expected);
}

# Globals for arrive_and_wait — avoids local clobbering across function calls
# _cbarrier_do_arrive writes its two results into a CALLER-PROVIDED buffer:
#   out[0..7]  = state ptr
#   out[8..15] = result code
#
# These used to be the file-scope globals _aaw_result_state/_aaw_result_code.
# They were serialised only by the PER-SET mutex, so two threads working on two
# DIFFERENT ConcurrentBarrierSets held different locks and clobbered each
# other's result — thread A could read B's state pointer and then futex-wait on
# a barrier it never joined, or read B's error code and return it as its own.
# agnosai runs one barrier set per workflow, so concurrent sets are the normal
# case, not an edge case.
fn _cbarrier_do_arrive(cbs_ptr, name, participant, out) {
    var barriers = load64(cbs_ptr);
    var state = map_get(barriers, name);
    if (state == 0) {
        store64(out, 0);
        store64(out + 8, ERR_BARRIER);
        return 0;
    }
    _set_add(load64(state + 8), participant);
    if (_cbarrier_check_release(state) == 1) {
        store64(out, 0);
        store64(out + 8, 0);
        return 0;
    }
    store64(out, state);
    store64(out + 8, 1);
    return 0;
}

# Blocking arrive — waits until the barrier releases.
fn cbarrier_arrive_and_wait(cbs, name, participant) {
    var mtx = load64(cbs + 8);
    var res[16];
    mutex_lock(mtx);
    _cbarrier_do_arrive(load64(cbs), name, participant, &res);

    if (load64(&res + 8) != 1) {
        mutex_unlock(mtx);
        return load64(&res + 8);
    }

    var state = load64(&res);
    var futex_addr = state + 32;
    var released_addr = state + 24;
    var val = load64(futex_addr);
    mutex_unlock(mtx);

    while (1) {
        if (load64(released_addr) == 1) { return 0; }
        # agnos: no futex_wait — yield to the cooperative scheduler and
        # re-check the released flag (spin-yield replaces the parked wait).
        #ifdef CYRIUS_TARGET_AGNOS
        sys_sched_yield();
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        syscall(SYS_FUTEX, futex_addr, FUTEX_WAIT, val, 0, 0, 0);
        #endif
        if (load64(released_addr) == 1) { return 0; }
        val = load64(futex_addr);
    }
}

fn cbarrier_force(cbs, name, dead_participant) {
    var mtx = load64(cbs + 8);
    mutex_lock(mtx);
    var state = map_get(load64(cbs), name);
    if (state == 0) {
        mutex_unlock(mtx);
        return _barrier_result(BARRIER_UNKNOWN, 0, 0);
    }
    _set_remove(load64(state), dead_participant);
    _set_remove(load64(state + 8), dead_participant);
    store64(state + 16, 1);

    if (_cbarrier_check_release(state) == 1) {
        mutex_unlock(mtx);
        return _barrier_result(BARRIER_RELEASED, vec_len(load64(state + 8)), vec_len(load64(state)));
    }
    var arrived = vec_len(load64(state + 8));
    var expected = vec_len(load64(state));
    mutex_unlock(mtx);
    return _barrier_result(BARRIER_WAITING, arrived, expected);
}

fn cbarrier_complete(cbs, name) {
    var mtx = load64(cbs + 8);
    mutex_lock(mtx);
    var r = map_delete(load64(cbs), name);
    mutex_unlock(mtx);
    return r;
}

fn cbarrier_len(cbs) { return map_size(load64(cbs)); }
fn cbarrier_is_empty(cbs) { return map_size(load64(cbs)) == 0; }

# --- ipc.cyr ---

# majra/ipc — Unix domain socket IPC with length-prefixed framing
#
# Protocol: 4-byte big-endian length prefix + payload bytes.
# Blocking I/O (no async). Frames are capped at IPC_MAX_FRAME both ways.
#
# ⚠ ACCESS CONTROL: the bound socket's mode is set to 0600 (owner only) so a
# co-tenant local user cannot connect. It was previously left to the ambient
# umask, which on a typical 022 process yields a world-connectable socket —
# and majra performs no peer-credential check, so connecting IS authenticating.
# A caller needing group access must widen the mode itself after ipc_bind.

# Linux x86_64 syscall numbers for networking
var _SYS_SOCKET = 41;
var _SYS_CONNECT = 42;
var _SYS_ACCEPT = 43;
var _SYS_BIND = 49;
var _SYS_LISTEN = 50;
var _SOCK_STREAM = 1;
var _AF_UNIX = 1;
var _SYS_FCHMOD = 91;

# Largest frame either direction will accept or emit. The receive side always
# had this cap; the send side did not, so majra could emit a frame that every
# majra receiver rejects.
var IPC_MAX_FRAME = 1048576;
# sockaddr_un.sun_path is 108 bytes including the NUL.
var IPC_MAX_PATH = 107;

# Parse a dotted-quad IPv4 literal into the little-endian packed form
# store32() expects (matching INADDR_LOOPBACK()'s 0x0100007F). Returns -1 if
# `host` is not a bare dotted quad.
fn majra_parse_ipv4(host) {
    var acc = 0;
    var octet = 0;
    var digits = 0;
    var shift = 0;
    var i = 0;
    var n = strlen(host);
    while (i <= n) {
        var ch = 0;
        if (i < n) { ch = load8(host + i); }
        if (i == n || ch == 46) {
            if (digits == 0 || octet > 255) { return -1; }
            if (shift > 24) { return -1; }
            acc = acc | (octet << shift);
            shift = shift + 8;
            octet = 0;
            digits = 0;
        } elif (ch >= 48 && ch <= 57) {
            octet = octet * 10 + (ch - 48);
            digits = digits + 1;
            if (digits > 3) { return -1; }
        } else {
            return -1;
        }
        i = i + 1;
    }
    if (shift != 32) { return -1; }
    return acc;
}

# Build a sockaddr_un. Returns 0 for a path that is empty or too long.
#
# This used to CLAMP an over-long path to 107 bytes rather than fail, so two
# distinct service paths sharing a 107-byte prefix silently resolved to the
# same socket — a client could reach a service it did not ask for. An empty
# path was also accepted, which binds into the ABSTRACT namespace under
# whatever bytes the uninitialised block happened to hold (fl_alloc does not
# zero a recycled block).
fn _sockaddr_un(path) {
    if (path == 0) { return 0; }
    var plen = strlen(path);
    if (plen == 0 || plen > IPC_MAX_PATH) { return 0; }
    var sa = fl_alloc(112);
    if (sa == 0) { return 0; }
    memset(sa, 0, 112);
    store8(sa, _AF_UNIX);
    store8(sa + 1, 0);
    memcpy(sa + 2, path, plen);
    store8(sa + 2 + plen, 0);
    return sa;
}

# Actual addrlen for a sockaddr_un carrying `path`: family (2) + path + NUL.
# Passing a hardcoded 110 made the kernel read past the path into whatever the
# block held.
fn _sockaddr_un_len(path) {
    return 2 + strlen(path) + 1;
}

# IPC Server: bind to a Unix socket path, listen.
# agnos has no AF_UNIX domain sockets — the whole ipc transport fail-closes
# there (callers fall back to an in-process or network path). Guarding the
# three connection-establishing fns keeps the raw Linux socket numbers
# (41/42/43/49/50, which mean sleep_ms/kbscan/spawn_path/... on agnos) off
# the agnos target.
fn ipc_bind(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(ERR_IPC);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sa = _sockaddr_un(path);
    if (sa == 0) { return Err(ERR_IPC); }
    var fd = syscall(_SYS_SOCKET, _AF_UNIX, _SOCK_STREAM, 0);
    if (fd < 0) { fl_free(sa); return Err(ERR_IPC); }

    # ⚠ fchmod MUST happen BEFORE bind, and 2.6.9 had it after.
    #
    # bind(2) on AF_UNIX creates the filesystem inode from the SOCKFS inode's
    # mode masked by the ambient umask, and connect(2) permission-checks THAT
    # inode. fchmod after bind changes only the sockfs inode, which nothing
    # consults again — it returns success and accomplishes nothing. Verified on
    # this machine under umask 022: fchmod-after-bind leaves the path at 0755
    # (world-connectable) while fstat on the fd reports 0600; fchmod-before-bind
    # yields 0600 on the path.
    #
    # That made 2.6.9 strictly worse than the gap it replaced: the module header
    # began promising owner-only access, and majra performs no peer-credential
    # check, so a consumer trusting that promise got a world-connectable
    # endpoint where connecting IS authenticating.
    if (syscall(_SYS_FCHMOD, fd, 384) < 0) {
        syscall(SYS_CLOSE, fd);
        fl_free(sa);
        return Err(ERR_IPC);
    }

    sys_unlink(path);
    var ret = syscall(_SYS_BIND, fd, sa, _sockaddr_un_len(path));
    fl_free(sa);
    # Every one of these paths used to leak both the fd and the sockaddr.
    if (ret < 0) { syscall(SYS_CLOSE, fd); return Err(ERR_IPC); }
    ret = syscall(_SYS_LISTEN, fd, 128);
    if (ret < 0) { syscall(SYS_CLOSE, fd); sys_unlink(path); return Err(ERR_IPC); }
    return Ok(fd);
    #endif
}

# Accept a connection. Returns client fd.
fn ipc_accept(server_fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(ERR_IPC);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = syscall(_SYS_ACCEPT, server_fd, 0, 0);
    if (fd < 0) { return Err(ERR_IPC); }
    return Ok(fd);
    #endif
}

# Connect to a Unix socket path. Returns fd.
fn ipc_connect(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(ERR_IPC);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sa = _sockaddr_un(path);
    if (sa == 0) { return Err(ERR_IPC); }
    var fd = syscall(_SYS_SOCKET, _AF_UNIX, _SOCK_STREAM, 0);
    if (fd < 0) { fl_free(sa); return Err(ERR_IPC); }
    var ret = syscall(_SYS_CONNECT, fd, sa, _sockaddr_un_len(path));
    fl_free(sa);
    if (ret < 0) { syscall(SYS_CLOSE, fd); return Err(ERR_IPC); }
    return Ok(fd);
    #endif
}

# Write exactly `len` bytes, retrying on EINTR (-4) and on short writes.
# A signal used to tear down the connection mid-frame.
fn _ipc_write_full(fd, buf, len) {
    var total = 0;
    while (total < len) {
        var w = syscall(SYS_WRITE, fd, buf + total, len - total);
        if (w == -4) { w = 0; }
        elif (w <= 0) { return -1; }
        total = total + w;
    }
    return total;
}

# Read exactly `want` bytes, retrying on EINTR (-4) and on short reads.
# Returns -1 on error, -2 if the peer closed before any byte arrived.
fn _ipc_read_full(fd, buf, want) {
    var total = 0;
    while (total < want) {
        var r = syscall(SYS_READ, fd, buf + total, want - total);
        if (r == -4) { r = 0; }
        elif (r == 0) {
            if (total == 0) { return -2; }
            return -1;
        }
        elif (r < 0) { return -1; }
        total = total + r;
    }
    return total;
}

# Send a length-prefixed frame.
fn ipc_send_frame(fd, data, len) {
    # The receive side has always capped frames at 1 MiB; the send side did
    # not, so majra could emit a frame every majra receiver rejects. Cap both.
    if (len < 0 || len > IPC_MAX_FRAME) { return Err(ERR_IPC_FRAME_TOO_LARGE); }
    var hdr[4];
    store8(&hdr, (len >> 24) & 0xFF);
    store8(&hdr + 1, (len >> 16) & 0xFF);
    store8(&hdr + 2, (len >> 8) & 0xFF);
    store8(&hdr + 3, len & 0xFF);
    if (_ipc_write_full(fd, &hdr, 4) < 0) { return Err(ERR_IPC); }
    if (len > 0) {
        if (_ipc_write_full(fd, data, len) < 0) { return Err(ERR_IPC); }
    }
    return Ok(0);
}

# Receive a length-prefixed frame.
fn ipc_recv_frame(fd) {
    var hdr[4];
    var r = _ipc_read_full(fd, &hdr, 4);
    if (r == -2) { return Err(ERR_IPC_CONN_CLOSED); }
    if (r < 0) { return Err(ERR_IPC); }
    var len = load8(&hdr) * 16777216 + load8(&hdr + 1) * 65536 + load8(&hdr + 2) * 256 + load8(&hdr + 3);
    if (len > IPC_MAX_FRAME) {
        # ⚠ TERMINAL. The declared body is still queued on the socket, so the
        # next ipc_recv_frame would read four bytes of the peer's payload as
        # the next length prefix and the peer would choose every subsequent
        # frame boundary. **The caller MUST close this fd and stop using the
        # connection** — this function does not, because the fd belongs to the
        # caller.
        #
        # 2.6.9 closed it here, which was worse than the desync it prevented:
        # the caller's struct kept the now-stale descriptor number, and the
        # kernel is free to reassign it to any file or socket opened afterwards
        # by any thread. Subsequent sends then wrote encrypted frames into an
        # unrelated descriptor, and the eventual ipc_close double-closed a
        # number that no longer belonged to majra.
        return Err(ERR_IPC_FRAME_TOO_LARGE);
    }
    var buf = fl_alloc(len + 1);
    if (buf == 0) { return Err(ERR_IPC); }
    if (len > 0) {
        if (_ipc_read_full(fd, buf, len) < 0) {
            fl_free(buf);
            return Err(ERR_IPC);
        }
    }
    store8(buf + len, 0);
    var frame = fl_alloc(16);
    if (frame == 0) { fl_free(buf); return Err(ERR_IPC); }
    store64(frame, len);
    store64(frame + 8, buf);
    return Ok(frame);
}

# Release a frame returned by ipc_recv_frame.
fn ipc_frame_free(f) {
    if (f == 0) { return 0; }
    var b = load64(f + 8);
    if (b != 0) { fl_free(b); }
    fl_free(f);
    return 0;
}

# Close an IPC connection.
fn ipc_close(fd) {
    syscall(SYS_CLOSE, fd);
}

# --- transport.cyr ---

# majra/transport — transport vtable + connection pool + circuit breaker
#
# Replaces Rust's Transport trait, TransportFactory trait, ConnectionPool,
# and CircuitBreaker with function-pointer vtables.

# Transport vtable (32 bytes):
#   offset  0: send_fn(self, data, len)
#   offset  8: recv_fn(self, buf, buf_len)
#   offset 16: is_connected_fn(self)
#   offset 24: close_fn(self)

fn transport_send(vt, self_ptr, data, len) {
    return fncall3(load64(vt), self_ptr, data, len);
}

fn transport_recv(vt, self_ptr, buf, buf_len) {
    return fncall3(load64(vt + 8), self_ptr, buf, buf_len);
}

fn transport_is_connected(vt, self_ptr) {
    return fncall1(load64(vt + 16), self_ptr);
}

fn transport_close(vt, self_ptr) {
    return fncall1(load64(vt + 24), self_ptr);
}

# Circuit breaker states
enum CircuitState {
    CIRCUIT_CLOSED = 0;
    CIRCUIT_OPEN = 1;
    CIRCUIT_HALF_OPEN = 2;
}

# CircuitBreaker struct (48 bytes):
#   offset  0: consecutive_failures (i64)
#   offset  8: tripped_at_ns (i64)
#   offset 16: failure_threshold (i64)
#   offset 24: cooldown_ns (i64)
#   offset 32: mutex (i64)
#   offset 40: probe_at_ns (i64) — when the outstanding half-open probe was issued (0 = none)
#
# The mutex and probe_inflight slots were added at 2.6.9. Before them
# `circuit_record_failure` did an unsynchronised read-modify-write on the
# failure counter, so concurrent failures were lost and a breaker driven by a
# worker pool could sit below its threshold forever; and `circuit_state`
# returned CIRCUIT_HALF_OPEN to *every* caller once the cooldown elapsed, which
# is a thundering herd onto the endpoint the breaker exists to protect.

fn circuit_breaker_new(failure_threshold, cooldown_ns) {
    var cb = fl_alloc(48);
    store64(cb, 0);
    store64(cb + 8, 0);
    store64(cb + 16, failure_threshold);
    store64(cb + 24, cooldown_ns);
    store64(cb + 32, mutex_new());
    store64(cb + 40, 0);
    return cb;
}

# Half-open admits exactly ONE probe per cooldown window. The first caller
# after the cooldown elapses gets CIRCUIT_HALF_OPEN and claims the probe;
# everyone else keeps seeing CIRCUIT_OPEN until that probe reports back via
# circuit_record_success / circuit_record_failure.
fn circuit_state(cb) {
    # FAST PATH, no lock: a breaker below its failure threshold is CLOSED.
    #
    # Taking the mutex unconditionally cost 2ns -> 49ns on a check that runs
    # per request. A racy read of `failures` here is harmless: the only
    # consequence is observing the count one increment stale, which delays the
    # trip by a single request — and circuit_record_failure re-reads under the
    # lock, so the trip itself is never lost. The lock is only needed once the
    # breaker is already degraded, where the probe handout must be exclusive.
    var threshold = load64(cb + 16);
    if (load64(cb) < threshold) { return CIRCUIT_CLOSED; }

    var mtx = load64(cb + 32);
    mutex_lock(mtx);
    var failures = load64(cb);
    if (failures < threshold) {
        mutex_unlock(mtx);
        return CIRCUIT_CLOSED;
    }
    var elapsed = time_now_ns() - load64(cb + 8);
    if (elapsed >= load64(cb + 24)) {
        # A probe is only allowed to hold the gate for one cooldown window.
        #
        # 2.6.9 stored a bare in-flight FLAG, cleared only by
        # circuit_record_success / _failure / _reset. A caller that took a
        # probe and then never reported — it crashed, it was cancelled, it
        # simply forgot — left the flag set forever, so circuit_state returned
        # CIRCUIT_OPEN for the life of the process even after the endpoint
        # recovered. The breaker latched open, which is the same availability
        # failure it exists to prevent, just inverted.
        var probe_at = load64(cb + 40);
        if (probe_at == 0 || time_now_ns() - probe_at >= load64(cb + 24)) {
            store64(cb + 40, time_now_ns());
            mutex_unlock(mtx);
            return CIRCUIT_HALF_OPEN;
        }
    }
    mutex_unlock(mtx);
    return CIRCUIT_OPEN;
}

fn circuit_record_success(cb) {
    var mtx = load64(cb + 32);
    mutex_lock(mtx);
    store64(cb, 0);
    store64(cb + 8, 0);
    store64(cb + 40, 0);
    mutex_unlock(mtx);
}

fn circuit_record_failure(cb) {
    var mtx = load64(cb + 32);
    mutex_lock(mtx);
    var f = load64(cb) + 1;
    store64(cb, f);
    if (f >= load64(cb + 16)) {
        store64(cb + 8, time_now_ns());
    }
    # A failed probe re-arms the cooldown rather than leaving the gate open.
    store64(cb + 40, 0);
    mutex_unlock(mtx);
}

fn circuit_reset(cb) {
    var mtx = load64(cb + 32);
    mutex_lock(mtx);
    store64(cb, 0);
    store64(cb + 8, 0);
    store64(cb + 40, 0);
    mutex_unlock(mtx);
}

# ConnectionPool struct (24 bytes):
#   offset  0: connections (i64) — hashmap: endpoint_str -> vec of transport ptrs
#   offset  8: circuit_breakers (i64) — hashmap: endpoint_str -> CircuitBreaker ptr
#   offset 16: mutex (i64)

fn conn_pool_new() {
    var p = fl_alloc(24);
    store64(p, map_new());
    store64(p + 8, map_new());
    store64(p + 16, mutex_new());
    return p;
}

fn conn_pool_with_circuit_breaker(pool, endpoint, threshold, cooldown_ns) {
    var cb = circuit_breaker_new(threshold, cooldown_ns);
    var mtx = load64(pool + 16);
    mutex_lock(mtx);
    map_set(load64(pool + 8), endpoint, cb);
    mutex_unlock(mtx);
}

fn conn_pool_circuit_state(pool, endpoint) {
    var mtx = load64(pool + 16);
    mutex_lock(mtx);
    var cb = map_get(load64(pool + 8), endpoint);
    mutex_unlock(mtx);
    if (cb == 0) { return CIRCUIT_CLOSED; }
    # circuit_state takes the breaker's own mutex; don't nest it under the
    # pool mutex (lock-ordering hazard for no benefit — the breaker pointer
    # is stable once published).
    return circuit_state(cb);
}

fn conn_pool_reset_circuit(pool, endpoint) {
    var mtx = load64(pool + 16);
    mutex_lock(mtx);
    var cb = map_get(load64(pool + 8), endpoint);
    mutex_unlock(mtx);
    if (cb != 0) { circuit_reset(cb); }
}

# Number of endpoints that have a circuit breaker registered.
#
# This reads the `circuit_breakers` map at offset 8, NOT the `connections` map
# at offset 0. Nothing in majra ever inserts into `connections` — there is no
# acquire/release API — so counting it always returned 0 regardless of how many
# endpoints were registered. Corrected at 2.6.9.
fn conn_pool_endpoint_count(pool) {
    var mtx = load64(pool + 16);
    mutex_lock(mtx);
    var n = map_size(load64(pool + 8));
    mutex_unlock(mtx);
    return n;
}

# --- fleet.cyr ---

# majra/fleet — distributed job queue with work-stealing
#
# Wraps ManagedQueue to provide per-node job assignment and rebalancing.

# FleetQueueConfig struct (24 bytes):
#   offset  0: steal_threshold (i64) — min items before stealing from a node
#   offset  8: max_steal_batch (i64) — max items to steal per rebalance
#   offset 16: max_concurrent (i64) — per-node concurrency limit

fn fleet_config_new(steal_threshold, max_steal_batch, max_concurrent) {
    var cfg = fl_alloc(24);
    store64(cfg, steal_threshold);
    store64(cfg + 8, max_steal_batch);
    store64(cfg + 16, max_concurrent);
    return cfg;
}

# FleetQueue struct (24 bytes):
#   offset  0: nodes (i64) — hashmap: node_id_str -> ManagedQueue ptr
#   offset  8: config (i64) — FleetQueueConfig ptr
#   offset 16: mutex (i64)

fn fleet_new(config) {
    var fq = fl_alloc(24);
    store64(fq, map_new());
    store64(fq + 8, config);
    store64(fq + 16, mutex_new());
    return fq;
}

# Register a node. Creates a per-node ManagedQueue.
#
# Re-registering an existing node_id is now a NO-OP that returns 0. It used to
# map_set a fresh ManagedQueue over the existing entry, silently discarding
# every job already queued or running on that node and leaking the old queue —
# and a re-register on reconnect is exactly what a flapping node does.
# Returns 1 if a node was created, 0 if it already existed.
fn fleet_register_node(fq, node_id) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    if (map_get(load64(fq), node_id) != 0) {
        mutex_unlock(mtx);
        return 0;
    }
    var cfg = load64(fq + 8);
    var mq = mq_new(node_id, load64(cfg + 16));
    map_set(load64(fq), node_id, mq);
    mutex_unlock(mtx);
    return 1;
}

# Deregister a node, redistributing whatever it still holds.
#
# This used to drop the map entry and walk away, discarding every queued job on
# that node and leaking the ManagedQueue. Queued work is now moved to the
# least-loaded remaining node; if the node was the last one, the jobs are
# genuinely undeliverable and the count is returned so the caller can react.
# Returns the number of jobs that could NOT be rehomed.
fn fleet_deregister_node(fq, node_id) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var nodes = load64(fq);
    var mq = map_get(nodes, node_id);
    if (mq == 0) { mutex_unlock(mtx); return 0; }
    map_delete(nodes, node_id);

    # mq_take_queued, NOT mq_dequeue. mq_dequeue refuses once running_count
    # reaches max_concurrent, so a node with jobs already running would have
    # dropped out of this loop immediately and discarded every QUEUED job —
    # the same silent job loss deregister was supposed to stop.
    var orphaned = 0;
    var draining = 1;
    while (draining == 1) {
        var item = mq_take_queued(mq);
        if (item == 0) { draining = 0; }
        else {
            var tid = _fleet_select_node(fq);
            if (tid == 0) { orphaned = orphaned + 1; }
            else {
                mq_enqueue(map_get(nodes, tid), queue_item_priority(item), queue_item_payload(item));
            }
            queue_item_free(item);
        }
    }
    mutex_unlock(mtx);
    return orphaned;
}

# Get the ManagedQueue for a node.
#
# Reads of the node map now take the mutex. fleet_node_queue and fleet_stats
# read it while register/deregister mutate it under the lock, so a concurrent
# rehash could hand back a stale bucket pointer.
fn fleet_node_queue(fq, node_id) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var mq = map_get(load64(fq), node_id);
    mutex_unlock(mtx);
    return mq;
}

# Select the least-loaded node. Returns node_id string or 0.
#
# Iterates the hashmap slot array directly (24-byte slots: key@0, value@8,
# occupied@16) rather than calling map_keys. map_keys builds a vec from the
# BUMP allocator, which never reclaims — and this runs on every fleet_submit,
# so a long-lived fleet leaked a vec per submitted job. Same change in
# fleet_rebalance and fleet_stats.
#
# Caller must hold the fleet mutex.
fn _fleet_select_node(fq) {
    var nodes = load64(fq);
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var best_id = 0;
    var best_load = 0;
    var ki = 0;
    while (ki < cap) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) == 1) {
            var mq = load64(ep + 8);
            var load = mq_queued_count(mq) + mq_running_count(mq);
            if (best_id == 0 || load < best_load) {
                best_load = load;
                best_id = load64(ep);
            }
        }
        ki = ki + 1;
    }
    return best_id;
}

# Submit a job to the least-loaded node. Returns the QueueItem or 0.
fn fleet_submit(fq, priority, payload) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var node_id = _fleet_select_node(fq);
    if (node_id == 0) {
        mutex_unlock(mtx);
        return 0;
    }
    var mq = map_get(load64(fq), node_id);
    mutex_unlock(mtx);
    return mq_enqueue(mq, priority, payload);
}

# Rebalance: steal from overloaded nodes and assign to underloaded.
# Returns number of jobs stolen.
fn fleet_rebalance(fq) {
    var cfg = load64(fq + 8);
    var threshold = load64(cfg);
    var max_batch = load64(cfg + 8);
    var mtx = load64(fq + 16);
    mutex_lock(mtx);

    var nodes = load64(fq);
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var stolen = 0;

    # Find overloaded and underloaded nodes
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var mq = load64(ep + 8);
            var queued = mq_queued_count(mq);

            if (queued > threshold) {
                # This node is overloaded — try to steal
                var to_steal = queued - threshold;
                if (to_steal > max_batch) { to_steal = max_batch; }

                # Find underloaded targets
                var j = 0;
                while (j < cap && to_steal > 0) {
                    var tp = entries + j * 24;
                    if (j != i && load64(tp + 16) == 1) {
                        var tmq = load64(tp + 8);
                        # Steal as many as this target can take, rather than
                        # one per (source, target) pair. The target index used
                        # to advance after every steal, so with two nodes
                        # max_steal_batch could never exceed 1 however it was
                        # configured.
                        var taking = 1;
                        while (taking == 1 && to_steal > 0 && mq_queued_count(tmq) < threshold) {
                            # mq_take_queued, NOT mq_dequeue. A steal is not an
                            # execution: mq_dequeue would mark the job RUNNING,
                            # inflate the source's running_count, and — worse —
                            # REFUSE outright once that count hit
                            # max_concurrent, which is exactly the saturated
                            # node a rebalance most needs to relieve.
                            var item = mq_take_queued(mq);
                            if (item == 0) { taking = 0; }
                            else {
                                mq_enqueue(tmq, queue_item_priority(item), queue_item_payload(item));
                                queue_item_free(item);
                                stolen = stolen + 1;
                                to_steal = to_steal - 1;
                            }
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }

    mutex_unlock(mtx);
    return stolen;
}

fn fleet_node_count(fq) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var n = map_size(load64(fq));
    mutex_unlock(mtx);
    return n;
}

# FleetQueueStats struct (32 bytes):
#   offset  0: total_nodes
#   offset  8: total_queued
#   offset 16: total_running
#   offset 24: total_completed
fn fleet_stats(fq) {
    var s = fl_alloc(32);
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var nodes = load64(fq);
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var total_q = 0;
    var total_r = 0;
    var total_c = 0;
    var n = 0;
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var mq = load64(ep + 8);
            total_q = total_q + mq_queued_count(mq);
            total_r = total_r + mq_running_count(mq);
            total_c = total_c + mq_total_completed(mq);
            n = n + 1;
        }
        i = i + 1;
    }
    store64(s, n);
    store64(s + 8, total_q);
    store64(s + 16, total_r);
    store64(s + 24, total_c);
    mutex_unlock(mtx);
    return s;
}

# --- dag.cyr ---

# majra/dag — DAG workflow engine with dependency-tier scheduling
#
# Replaces Rust's WorkflowEngine, WorkflowDefinition, WorkflowRun, etc.
# Steps are grouped into dependency tiers and executed SERIALLY within each
# tier. (This line previously claimed thread_create/join parallelism; dag.cyr
# calls neither. See the note on workflow_execute.)

# Workflow step status
enum StepStatus {
    STEP_PENDING = 0;
    STEP_RUNNING = 1;
    STEP_COMPLETED = 2;
    STEP_FAILED = 3;
    STEP_SKIPPED = 4;
}

# Workflow run status
enum RunStatus {
    RUN_PENDING = 0;
    RUN_RUNNING = 1;
    RUN_COMPLETED = 2;
    RUN_FAILED = 3;
    RUN_CANCELLED = 4;
}

# Error policies
enum ErrorPolicy {
    POLICY_FAIL = 0;
    POLICY_CONTINUE = 1;
    POLICY_SKIP = 2;
}

# Trigger modes
enum TriggerMode {
    TRIGGER_ALL = 0;
    TRIGGER_ANY = 1;
}

# WorkflowStep struct (48 bytes):
#   offset  0: id (i64) — C string
#   offset  8: name (i64) — C string
#   offset 16: depends_on (i64) — vec of step id strings
#   offset 24: trigger_mode (i64) — TRIGGER_ALL or TRIGGER_ANY
#   offset 32: error_policy (i64)
#   offset 40: retry_max (i64)

fn workflow_step_new(id, name) {
    var s = fl_alloc(48);
    store64(s, id);
    store64(s + 8, name);
    store64(s + 16, vec_new());
    store64(s + 24, TRIGGER_ALL);
    store64(s + 32, POLICY_FAIL);
    store64(s + 40, 0);
    return s;
}

fn step_add_dep(step, dep_id) {
    vec_push(load64(step + 16), dep_id);
}

fn step_set_retry(step, max_retries) {
    store64(step + 40, max_retries);
}

fn step_set_error_policy(step, policy) {
    store64(step + 32, policy);
}

fn step_set_trigger_mode(step, mode) {
    store64(step + 24, mode);
}

# WorkflowDefinition struct (32 bytes):
#   offset  0: id (i64) — C string
#   offset  8: name (i64) — C string
#   offset 16: steps (i64) — vec of WorkflowStep ptrs
#   offset 24: enabled (i64) — 0 or 1

fn workflow_def_new(id, name) {
    var d = fl_alloc(32);
    store64(d, id);
    store64(d + 8, name);
    store64(d + 16, vec_new());
    store64(d + 24, 1);
    return d;
}

fn workflow_def_add_step(def, step) {
    vec_push(load64(def + 16), step);
}

# StepResult struct (24 bytes):
#   offset  0: status (i64)
#   offset  8: output (i64) — arbitrary result data
#   offset 16: error_msg (i64) — C string or 0

fn step_result_new(status, output, error_msg) {
    var sr = fl_alloc(24);
    store64(sr, status);
    store64(sr + 8, output);
    store64(sr + 16, error_msg);
    return sr;
}

# StepExecutor vtable (8 bytes):
#   offset 0: execute_fn(step_ptr, context_ptr) -> StepResult ptr

# WorkflowContext struct (16 bytes):
#   offset  0: step_results (i64) — hashmap: step_id -> StepResult ptr
#   offset  8: input (i64) — workflow input data

fn workflow_context_new(input) {
    var ctx = fl_alloc(16);
    store64(ctx, map_new());
    store64(ctx + 8, input);
    return ctx;
}

fn context_get_step_result(ctx, step_id) {
    return map_get(load64(ctx), step_id);
}

fn context_set_step_result(ctx, step_id, result) {
    map_set(load64(ctx), step_id, result);
}

# Check if a step's dependencies are satisfied.
fn _deps_satisfied(step, ctx) {
    var deps = load64(step + 16);
    var mode = load64(step + 24);
    var dep_count = vec_len(deps);
    if (dep_count == 0) { return 1; }

    var satisfied = 0;
    var i = 0;
    while (i < dep_count) {
        var dep_id = vec_get(deps, i);
        var result = context_get_step_result(ctx, dep_id);
        if (result != 0 && load64(result) == STEP_COMPLETED) {
            satisfied = satisfied + 1;
        }
        i = i + 1;
    }

    if (mode == TRIGGER_ALL) {
        return satisfied == dep_count;
    }
    # TRIGGER_ANY
    return satisfied > 0;
}

# Topological sort into tiers (Kahn's algorithm).
# Returns a vec of vecs (each inner vec is a tier of step pointers).
fn _compute_tiers(def) {
    var steps = load64(def + 16);
    var num_steps = vec_len(steps);
    var tiers = vec_new();

    # Build in-degree map: step_id -> count of dependencies.
    #
    # In-degree state is keyed by step id, so two steps sharing an id collapse
    # into ONE map entry and every duplicate after the first is silently
    # dropped from the schedule. Detect it and refuse the workflow instead:
    # returning a partial DAG that looks complete is the worse failure.
    var in_degree = map_new();
    var i = 0;
    while (i < num_steps) {
        var s = vec_get(steps, i);
        var sid = load64(s);
        if (map_has(in_degree, sid) == 1) { return 0; }
        map_set(in_degree, sid, vec_len(load64(s + 16)));
        i = i + 1;
    }

    # Iteratively collect steps with 0 in-degree
    var remaining = num_steps;
    while (remaining > 0) {
        var tier = vec_new();
        i = 0;
        while (i < num_steps) {
            var s = vec_get(steps, i);
            var sid = load64(s);
            if (map_get(in_degree, sid) == 0) {
                vec_push(tier, s);
                map_set(in_degree, sid, -1);
            }
            i = i + 1;
        }
        if (vec_len(tier) == 0) {
            # Kahn's algorithm cannot make progress: the remaining steps form a
            # CYCLE, or one depends on an id that is not in this workflow.
            #
            # This used to `break` and hand back the acyclic PREFIX, so
            # workflow_execute ran part of the DAG and reported success — a
            # workflow silently missing its tail. Return 0 so the caller can
            # tell a malformed DAG from a completed one.
            return 0;
        }
        # Reduce in-degree for dependents
        var j = 0;
        var tlen = vec_len(tier);
        while (j < tlen) {
            var done_step = vec_get(tier, j);
            var done_id = load64(done_step);
            # For each step, check if it depends on done_id
            i = 0;
            while (i < num_steps) {
                var s = vec_get(steps, i);
                var deps = load64(s + 16);
                var k = 0;
                var dlen = vec_len(deps);
                while (k < dlen) {
                    if (streq(vec_get(deps, k), done_id) == 1) {
                        var sid = load64(s);
                        var cur = map_get(in_degree, sid);
                        if (cur > 0) {
                            map_set(in_degree, sid, cur - 1);
                        }
                    }
                    k = k + 1;
                }
                i = i + 1;
            }
            j = j + 1;
        }
        remaining = remaining - vec_len(tier);
        vec_push(tiers, tier);
    }

    return tiers;
}

# Release a workflow context.
#
# workflow_execute still leaks its tier vecs and StepResults (both from the
# bump allocator, which cannot free), so this is not a complete teardown — it
# covers the context block itself, which is the one thing the malformed-DAG
# early return can cleanly reclaim. Full run teardown needs the tier
# structures to move off the bump allocator; tracked on the roadmap.
fn workflow_context_free(ctx) {
    if (ctx != 0) { fl_free(ctx); }
    return 0;
}

# Execute a workflow definition with a given executor function and input.
# executor_fn(step_ptr, ctx_ptr) -> StepResult ptr
# Returns: RUN_COMPLETED, or RUN_FAILED (including for a malformed DAG).
#
# ⚠ Steps within a tier execute SERIALLY. The module header used to claim
# parallel within-tier execution via thread_create/join; dag.cyr calls
# neither, and never has. Tiers are a dependency-ordering construct here, not
# a concurrency one. Parallel tier execution is a roadmap item.
fn workflow_execute(def, executor_fn, input) {
    var ctx = workflow_context_new(input);
    var tiers = _compute_tiers(def);
    # _compute_tiers returns 0 for a malformed DAG (a dependency cycle, a
    # dangling dependency id, or duplicate step ids). Running the schedulable
    # prefix and reporting success is exactly the failure this guards.
    if (tiers == 0) {
        # The context was allocated above; release it rather than abandon it on
        # the one path that returns before the run starts.
        workflow_context_free(ctx);
        return RUN_FAILED;
    }
    var num_tiers = vec_len(tiers);
    var final_status = RUN_COMPLETED;

    var t = 0;
    while (t < num_tiers) {
        var tier = vec_get(tiers, t);
        var tier_len = vec_len(tier);

        # Execute all steps in this tier
        var s = 0;
        while (s < tier_len) {
            var step = vec_get(tier, s);
            var step_id = load64(step);

            # Check dependencies
            if (_deps_satisfied(step, ctx) == 0) {
                context_set_step_result(ctx, step_id, step_result_new(STEP_SKIPPED, 0, 0));
                s = s + 1;
                continue;
            }

            # Execute with retry
            var max_retries = load64(step + 40);
            var attempt = 0;
            var result = 0;
            while (attempt <= max_retries) {
                result = fncall2(executor_fn, step, ctx);
                if (result != 0 && load64(result) == STEP_COMPLETED) {
                    break;
                }
                attempt = attempt + 1;
                if (attempt <= max_retries) {
                    # Backoff: sleep attempt * 10ms
                    #ifdef CYRIUS_TARGET_AGNOS
                    sys_sleep_ms(attempt * 10);
                    #endif
                    #ifndef CYRIUS_TARGET_AGNOS
                    # tv_nsec MUST be in [0, 999999999]. attempt * 10ms
                    # exceeds a second at attempt 100 and nanosleep then
                    # returns EINVAL immediately — the backoff silently stops
                    # backing off and the retry loop becomes a tight spin.
                    # Split into whole seconds + remainder, and retry on EINTR
                    # (-4) so a signal does not shorten the wait.
                    var total_ns = attempt * 10000000;
                    var ts[16];   # struct timespec = 2×i64 = 16 bytes (local = N bytes)
                    var rem[16];
                    store64(&ts, total_ns / 1000000000);
                    store64(&ts + 8, total_ns - (total_ns / 1000000000) * 1000000000);
                    var sr = syscall(35, &ts, &rem);
                    while (sr == -4) {
                        store64(&ts, load64(&rem));
                        store64(&ts + 8, load64(&rem + 8));
                        sr = syscall(35, &ts, &rem);
                    }
                    #endif
                }
            }

            if (result == 0) {
                result = step_result_new(STEP_FAILED, 0, "executor returned null");
            }

            context_set_step_result(ctx, step_id, result);

            # Handle failure based on error policy
            if (load64(result) == STEP_FAILED) {
                var policy = load64(step + 32);
                if (policy == POLICY_FAIL) {
                    final_status = RUN_FAILED;
                    return final_status;
                }
                if (policy == POLICY_SKIP) {
                    context_set_step_result(ctx, step_id, step_result_new(STEP_SKIPPED, 0, 0));
                }
                # POLICY_CONTINUE: keep going
            }

            s = s + 1;
        }
        t = t + 1;
    }

    return final_status;
}

# InMemoryWorkflowStorage: hashmap-based storage for definitions and runs.
# WorkflowStorage struct (16 bytes):
#   offset 0: definitions (i64) — hashmap: id -> WorkflowDefinition ptr
#   offset 8: runs (i64) — hashmap: id -> run data ptr

fn workflow_storage_new() {
    var ws = fl_alloc(16);
    store64(ws, map_new());
    store64(ws + 8, map_new());
    return ws;
}

fn storage_save_def(ws, def) {
    map_set(load64(ws), load64(def), def);
}

fn storage_get_def(ws, id) {
    return map_get(load64(ws), id);
}

fn storage_delete_def(ws, id) {
    return map_delete(load64(ws), id);
}

fn storage_list_defs(ws) {
    return map_values(load64(ws));
}

# --- redis_backend.cyr ---

# majra/redis_backend — Redis RESP protocol over TCP
#
# Implements RESP (REdis Serialization Protocol) for cross-process
# pub/sub, priority queues, rate limiting, and heartbeat tracking.
#
# Wire format: RESP2 over TCP.
#   Simple string: +OK\r\n
#   Error:         -ERR msg\r\n
#   Integer:       :42\r\n
#   Bulk string:   $5\r\nhello\r\n
#   Array:         *2\r\n$3\r\nGET\r\n$3\r\nkey\r\n

# --- Limits ---
#
# Every one of these bounds a value taken straight off the wire. Without them a
# compromised or impersonated Redis endpoint controls an allocation size, a
# loop bound, or the recursion depth of the reply parser.
#
# Redis's own proto-max-bulk-len defaults to 512 MB; 64 MB is far above
# anything majra's own commands produce and can be raised if a consumer needs
# it.
var RESP_MAX_BULK = 67108864;
var RESP_MAX_ARRAY = 1048576;
var RESP_MAX_DEPTH = 8;

# --- RESP Protocol ---

# Append CRLF to a string builder.
fn _sb_crlf(sb) {
    str_builder_add_cstr(sb, "\r\n");
}

# Send a RESP command array over a TCP socket.
# cmd is a vec of C strings (command + arguments).
# Returns 0 on success, -1 on failure.
fn _resp_send_cmd(fd, cmd) {
    if (fd < 0) { return -1; }
    var sb = str_builder_new();
    # Array header
    str_builder_add_cstr(sb, "*");
    str_builder_add_int(sb, vec_len(cmd));
    _sb_crlf(sb);
    # Each element as bulk string
    var i = 0;
    var len = vec_len(cmd);
    while (i < len) {
        var arg = vec_get(cmd, i);
        var alen = strlen(arg);
        str_builder_add_cstr(sb, "$");
        str_builder_add_int(sb, alen);
        _sb_crlf(sb);
        str_builder_add_cstr(sb, arg);
        _sb_crlf(sb);
        i = i + 1;
    }
    var msg = str_builder_build(sb);
    # A short write used to count as success, which desynchronises the command
    # stream: the server parses a truncated command and every later reply is
    # misattributed.
    var data = str_data(msg);
    var mlen = str_len(msg);
    var total = 0;
    while (total < mlen) {
        var w = syscall(SYS_WRITE, fd, data + total, mlen - total);
        if (w <= 0) { return -1; }
        total = total + w;
    }
    return 0;
}

# Read a line from the socket (up to \r\n). Returns Str or 0.
var _resp_buf[512];
fn _resp_read_line(fd) {
    var pos = 0;
    while (pos < 4088) {
        var n = syscall(SYS_READ, fd, &_resp_buf + pos, 1);
        if (n <= 0) { return 0; }
        if (pos > 0 && load8(&_resp_buf + pos - 1) == 13 && load8(&_resp_buf + pos) == 10) {
            # Return an OWNED copy. _resp_buf is a module global, so handing
            # back a Str aliasing it meant every previously-returned simple
            # string, error and integer line was rewritten by the next read —
            # nested array replies clobbered their own earlier elements.
            var line_len = pos - 1;
            var copy = fl_alloc(line_len + 1);
            if (copy == 0) { return 0; }
            memcpy(copy, &_resp_buf, line_len);
            store8(copy + line_len, 0);
            return str_new(copy, line_len);
        }
        pos = pos + 1;
    }
    return 0;
}

# Read a RESP reply. Returns:
#   For simple strings/errors: Str
#   For integers: the integer value
#   For bulk strings: Str or 0 (nil)
#   For arrays: vec of reply values
# Takes the CONNECTION, not a bare fd, so it can poison a stream it can no
# longer parse.
#
# Every abort below — a cap exceeded, a read failure, an unrecognised type
# byte — leaves bytes the server already committed to sending sitting in the
# socket. Returning without marking the connection meant the next command read
# those leftovers as its own reply and every result from then on was
# misattributed, silently. A caller cannot detect that; the only safe move is
# to make the connection unusable so it fails loudly instead.
#
# A nil bulk string (`$-1`) and the integer `:0` are NOT failures — they also
# return 0, which is why the connection state, not the return value, is what
# distinguishes them.
fn _resp_read_reply(rc) {
    return _resp_read_reply_d(rc, 0);
}

# Mark a connection's framing untrustworthy. Subsequent commands fail fast.
fn _resp_poison(rc) {
    if (rc == 0) { return 0; }
    var fd = load64(rc);
    if (fd >= 0) { syscall(SYS_CLOSE, fd); }
    store64(rc, -1);
    return 0;
}

fn redis_is_alive(rc) {
    if (rc == 0) { return 0; }
    if (load64(rc) < 0) { return 0; }
    return 1;
}

fn _resp_read_reply_d(rc, depth) {
    if (rc == 0) { return 0; }
    var fd = load64(rc);
    if (fd < 0) { return 0; }
    if (depth > RESP_MAX_DEPTH) { _resp_poison(rc); return 0; }
    var line = _resp_read_line(fd);
    if (line == 0) { _resp_poison(rc); return 0; }
    var data = str_data(line);
    var type_byte = load8(data);

    # NOTE ON OWNERSHIP: `line` borrows an fl_alloc'd copy made by
    # _resp_read_line. The simple-string and error cases hand a Str over it
    # back to the caller, so those must NOT free it — the caller owns it and
    # releases it with resp_reply_free. The integer and length-header cases
    # consume it here and free it.
    if (type_byte == 43) {
        # +simple string — caller owns the buffer
        return str_new(data + 1, str_len(line) - 1);
    }
    if (type_byte == 45) {
        # -error — caller owns the buffer
        return str_new(data + 1, str_len(line) - 1);
    }
    if (type_byte == 58) {
        # :integer — the line is fully consumed here
        var iv = str_to_int(str_new(data + 1, str_len(line) - 1));
        fl_free(data);
        return iv;
    }
    if (type_byte == 36) {
        # $bulk string
        var blen = str_to_int(str_new(data + 1, str_len(line) - 1));
        if (blen < 0) { fl_free(data); return 0; }
        # Without this cap, `$9223372036854775807` makes `blen + 2` WRAP
        # NEGATIVE; _fl_class sends any negative size down the size<=16 path,
        # so fl_alloc hands back a 16-byte block which str_new then labels
        # with a length of INT64_MAX. The first str_eq on that reply walks the
        # entire address space.
        fl_free(data);
        if (blen > RESP_MAX_BULK) { _resp_poison(rc); return 0; }
        var buf = fl_alloc(blen + 2);
        if (buf == 0) { return 0; }
        var total = 0;
        while (total < blen + 2) {
            var n = syscall(SYS_READ, fd, buf + total, blen + 2 - total);
            if (n <= 0) { fl_free(buf); _resp_poison(rc); return 0; }
            total = total + n;
        }
        return str_new(buf, blen);
    }
    if (type_byte == 42) {
        # *array
        var count = str_to_int(str_new(data + 1, str_len(line) - 1));
        fl_free(data);
        if (count < 0) { return 0; }
        # An oversized count spins this loop growing `arr` long after the
        # socket has stopped producing, and unbounded nesting turns
        # server-controlled depth into call-stack depth.
        if (count > RESP_MAX_ARRAY) { _resp_poison(rc); return 0; }
        var arr = vec_new();
        var j = 0;
        while (j < count) {
            # ⚠ Do NOT treat a 0 element as a parse failure.
            #
            # 2.6.9 added `if (elem == 0) { return arr; }` here, but this
            # function returns 0 for THREE different things: a read failure, a
            # nil bulk string (`$-1`, which this module's own doc comment
            # documents as 0), and an integer reply of `:0`. So an ordinary
            # Redis reply — a rate-limiter Lua script returning
            # `*2\r\n:0\r\n:1\r\n`, or an MGET with a missing key — was
            # truncated to an empty array, and the elements it did not consume
            # stayed queued on the socket. The next command on that connection
            # then read the leftovers as its own reply and the stream was
            # permanently offset by one. Push every element; a genuine socket
            # failure is caught by the read loop above, which cannot produce
            # more elements anyway.
            vec_push(arr, _resp_read_reply_d(rc, depth + 1));
            j = j + 1;
        }
        return arr;
    }
    # Unrecognised type byte — nothing else will consume the line, and we no
    # longer know where the next reply starts.
    fl_free(data);
    _resp_poison(rc);
    return 0;
}

# Release a Str reply returned by _resp_read_reply for a simple string, an
# error, or a bulk string. Integers are values, arrays are vecs from the bump
# allocator; neither needs this.
fn resp_reply_free(reply) {
    if (reply != 0) { fl_free(str_data(reply)); }
    return 0;
}

# --- Redis Connection ---

# RedisConn struct (16 bytes):
#   offset 0: fd (i64)
#   offset 8: prefix (i64) — C string for key namespacing

fn redis_connect(host, port) {
    # `host` was accepted and then ignored — every connection went to
    # INADDR_LOOPBACK() regardless, so redis_connect("10.0.0.5", 6379) silently
    # talked to localhost. Now parsed; a non-dotted-quad host fails rather than
    # redirecting. (No resolver in the stdlib: pass an IPv4 literal.)
    var addr = INADDR_LOOPBACK();
    if (host != 0 && strlen(host) > 0) {
        addr = majra_parse_ipv4(host);
        if (addr < 0) { return 0; }
    }
    var fd = syscall(41, AF_INET, SOCK_STREAM, 0);
    if (fd < 0) { return 0; }
    var sa = sockaddr_in(addr, port);
    var ret = syscall(42, fd, sa, 16);
    if (ret < 0) {
        syscall(SYS_CLOSE, fd);
        return 0;
    }
    var rc = fl_alloc(16);
    store64(rc, fd);
    store64(rc + 8, "");
    return rc;
}

fn redis_connect_default() {
    return redis_connect("127.0.0.1", 6379);
}

fn redis_set_prefix(rc, prefix) {
    store64(rc + 8, prefix);
}

# Closes the socket and releases the handle. The handle is INVALID afterwards —
# do not call anything else with it.
#
# 2.6.9's comment claimed the `store64(rc, -1)` poison made a second close
# safe. It did not: the very next line frees the block, so the poison survives
# only until the freelist reuses those bytes, and a double close would then
# read whatever the new owner wrote. The poison is kept for the window before
# the free, but the real contract is the one stated above.
fn redis_close(rc) {
    if (rc == 0) { return 0; }
    var fd = load64(rc);
    if (fd >= 0) { syscall(SYS_CLOSE, fd); }
    store64(rc, -1);
    fl_free(rc);
    return 0;
}

# Build prefixed key
fn _redis_pkey(rc, key) {
    var prefix = load64(rc + 8);
    if (strlen(prefix) == 0) { return key; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_cstr(sb, key);
    return str_data(str_builder_build(sb));
}

# --- Basic Commands ---

fn redis_set(rc, key, value) {
    var cmd = vec_new();
    vec_push(cmd, "SET");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, value);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_get(rc, key) {
    var cmd = vec_new();
    vec_push(cmd, "GET");
    vec_push(cmd, _redis_pkey(rc, key));
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_del(rc, key) {
    var cmd = vec_new();
    vec_push(cmd, "DEL");
    vec_push(cmd, _redis_pkey(rc, key));
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_exists(rc, key) {
    var cmd = vec_new();
    vec_push(cmd, "EXISTS");
    vec_push(cmd, _redis_pkey(rc, key));
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# SET with EX (expire in seconds)
fn redis_setex(rc, key, value, ttl_secs) {
    var cmd = vec_new();
    vec_push(cmd, "SET");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, value);
    vec_push(cmd, "EX");
    var ttl_str = str_data(str_from_int(ttl_secs));
    vec_push(cmd, ttl_str);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- Sorted Set (Queue) ---

fn redis_zadd(rc, key, member, score) {
    var cmd = vec_new();
    vec_push(cmd, "ZADD");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, str_data(str_from_int(score)));
    vec_push(cmd, member);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_zpopmin(rc, key) {
    var cmd = vec_new();
    vec_push(cmd, "ZPOPMIN");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, "1");
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_zcard(rc, key) {
    var cmd = vec_new();
    vec_push(cmd, "ZCARD");
    vec_push(cmd, _redis_pkey(rc, key));
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- Pub/Sub (publish only — subscribe requires dedicated connection) ---

fn redis_publish(rc, channel, message) {
    var cmd = vec_new();
    vec_push(cmd, "PUBLISH");
    vec_push(cmd, _redis_pkey(rc, channel));
    vec_push(cmd, message);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- Hash (for rate limiter) ---

fn redis_hset(rc, key, field, value) {
    var cmd = vec_new();
    vec_push(cmd, "HSET");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, field);
    vec_push(cmd, value);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_hget(rc, key, field) {
    var cmd = vec_new();
    vec_push(cmd, "HGET");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, field);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

fn redis_expire(rc, key, seconds) {
    var cmd = vec_new();
    vec_push(cmd, "EXPIRE");
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, str_data(str_from_int(seconds)));
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- KEYS (for heartbeat list_online) ---

fn redis_keys(rc, pattern) {
    var cmd = vec_new();
    vec_push(cmd, "KEYS");
    vec_push(cmd, _redis_pkey(rc, pattern));
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- EVAL (for rate limiter Lua script) ---

fn redis_eval(rc, script, num_keys, key, arg1, arg2, arg3) {
    var cmd = vec_new();
    vec_push(cmd, "EVAL");
    vec_push(cmd, script);
    vec_push(cmd, str_data(str_from_int(num_keys)));
    vec_push(cmd, _redis_pkey(rc, key));
    vec_push(cmd, arg1);
    vec_push(cmd, arg2);
    vec_push(cmd, arg3);
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- PING (connection test) ---

fn redis_ping(rc) {
    var cmd = vec_new();
    vec_push(cmd, "PING");
    _resp_send_cmd(load64(rc), cmd);
    return _resp_read_reply(rc);
}

# --- postgres_backend.cyr ---

# majra/postgres_backend — PostgreSQL wire protocol for workflow storage
#
# Implements the PostgreSQL frontend/backend protocol (v3) over TCP.
# Supports startup, simple query, and parameterized query.
#
# Wire format:
#   Frontend -> Backend: [1B type][4B length][payload]
#   Backend -> Frontend: [1B type][4B length][payload]
#   Startup message has no type byte: [4B length][4B protocol][params...]
#
# ⚠ SECURITY — TRANSPORT AND AUTHENTICATION LIMITS
#
# This client speaks PLAINTEXT PostgreSQL. It sends no SSLRequest and performs
# no TLS handshake, and the only authentication method it implements is
# AuthenticationCleartextPassword (type 3) — so the password crosses the wire
# in the clear along with every query and result row.
#
# PostgreSQL has defaulted to scram-sha-256 since v14; a server configured that
# way sends auth type 10 and majra fails the connect closed rather than
# downgrading. Reaching a modern server therefore requires `password` in
# pg_hba.conf, which is exactly the weakening this note is warning about.
#
# Use this ONLY over loopback or an already-confidential channel (a unix-socket
# proxy, a TLS-terminating sidecar, a WireGuard/VPN link). Do NOT point it at a
# PostgreSQL server across an untrusted network. Tracked as a roadmap item:
# SCRAM-SHA-256 + SSLRequest via sigil.

# --- PostgreSQL Wire Protocol Constants ---

# Message types (frontend -> backend)
var PG_MSG_QUERY = 81;
var PG_MSG_TERMINATE = 88;
var PG_MSG_PASSWORD = 112;

# Message types (backend -> frontend)
var PG_MSG_AUTH = 82;
var PG_MSG_READY = 90;
var PG_MSG_ROW_DESC = 84;
var PG_MSG_DATA_ROW = 68;
var PG_MSG_CMD_COMPLETE = 67;
var PG_MSG_ERROR = 69;
var PG_MSG_NOTICE = 78;

# Auth types
var PG_AUTH_OK = 0;
var PG_AUTH_CLEARTEXT = 3;

# Largest backend message majra will allocate for. The wire length field is a
# signed int32, so without a cap a peer can request ~2 GB with a five-byte
# header. 16 MiB is far above any DataRow majra's own schema produces.
var PG_MAX_MSG = 16777216;

# --- Connection ---

# PgConn struct (16 bytes):
#   offset 0: fd (i64)
#   offset 8: ready (i64) — 1 if ready for query

fn _pg_write_be32(buf, offset, val) {
    store8(buf + offset, (val >> 24) & 0xFF);
    store8(buf + offset + 1, (val >> 16) & 0xFF);
    store8(buf + offset + 2, (val >> 8) & 0xFF);
    store8(buf + offset + 3, val & 0xFF);
}

fn _pg_read_be32(buf, offset) {
    return (load8(buf+offset) << 24) | (load8(buf+offset+1) << 16) | (load8(buf+offset+2) << 8) | load8(buf+offset+3);
}

fn _pg_read_be16(buf, offset) {
    return (load8(buf+offset) << 8) | load8(buf+offset+1);
}

# SIGNED big-endian int32.
#
# `_pg_read_be32` composes four ZERO-EXTENDED load8 results, so it can never
# return a negative number: the PostgreSQL NULL sentinel (int32 -1, on the wire
# as FF FF FF FF) came back as 4294967295. Every `< 0` test against it was
# therefore dead code. Use this reader for any wire field PostgreSQL may send
# negative — today that is the DataRow column length.
fn _pg_read_i32(buf, offset) {
    var v = _pg_read_be32(buf, offset);
    if (v >= 0x80000000) { return v - 0x100000000; }
    return v;
}

# Read exactly `want` bytes, looping over short reads. Returns the byte count,
# or -1 if the peer closed or errored before `want` bytes arrived. A blocking
# TCP socket is entitled to return fewer bytes than requested; treating that as
# fatal (as this file did) drops legitimate traffic.
fn _pg_read_full(fd, buf, want) {
    var total = 0;
    while (total < want) {
        var r = syscall(SYS_READ, fd, buf + total, want - total);
        # EINTR (-4) retries; see the note in src/ws.cyr's _ws_read_full.
        if (r == -4) { r = 0; }
        elif (r <= 0) { return -1; }
        total = total + r;
    }
    return total;
}

# Write exactly `len` bytes, looping over short writes.
fn _pg_write_full(fd, buf, len) {
    var total = 0;
    while (total < len) {
        var w = syscall(SYS_WRITE, fd, buf + total, len - total);
        if (w == -4) { w = 0; }
        elif (w <= 0) { return -1; }
        total = total + w;
    }
    return total;
}

# Globals for PG startup to avoid local clobbering.
#
# These are process-wide and live across the whole blocking handshake, so two
# threads calling pg_connect concurrently used to overwrite each other's fd and
# credentials — thread A could complete the handshake against thread B's socket
# using thread B's password. `_pg_connect_mtx` serialises the entire connect
# path. Connections themselves are independent once returned; only the
# handshake is serialised.
var _pg_fd_g = 0;
var _pg_user_g = 0;
var _pg_db_g = 0;
var _pg_pw_g = 0;
var _pg_connect_mtx = 0;

# Initialised eagerly at module load rather than lazily.
#
# The lazy `if (_pg_connect_mtx == 0) { _pg_connect_mtx = mutex_new(); }` was
# itself unsynchronised, so the first two concurrent pg_connect calls could
# each observe 0, each build a mutex, and each lock a DIFFERENT one — leaving
# the connect globals unprotected in exactly the window the mutex exists for.
var _pg_connect_mtx_init = _pg_connect_mtx_bootstrap();

fn _pg_connect_mtx_bootstrap() {
    _pg_connect_mtx = mutex_new();
    return 1;
}

fn _pg_connect_lock() {
    mutex_lock(_pg_connect_mtx);
    return 0;
}

# Release a message struct returned by _pg_read_msg, and its body.
#
# Nothing freed these: pg_query's main loop, pg_connect's handshake and its
# ReadyForQuery loop, and the ErrorResponse drain all dropped both the 24-byte
# descriptor and its body on the floor. A long-lived connection leaked one of
# each per message received, which for a query returning many DataRows is per
# row.
fn _pg_msg_free(m) {
    if (m == 0) { return 0; }
    var d = load64(m + 8);
    if (d != 0) { fl_free(d); }
    fl_free(m);
    return 0;
}

# Send startup message: protocol version 3.0, user, database
fn _pg_startup() {
    var user = _pg_user_g;
    var database = _pg_db_g;
    var fd = _pg_fd_g;
    var user_len = strlen(user);
    var db_len = strlen(database);
    # [4B len][4B protocol][user\0name\0database\0name\0\0]
    var payload_len = 4 + 5 + user_len + 1 + 9 + db_len + 1 + 1;
    var msg_len = 4 + payload_len;
    var msg = fl_alloc(msg_len);
    _pg_write_be32(msg, 0, msg_len);
    _pg_write_be32(msg, 4, 196608);
    var pos = 8;
    memcpy(msg + pos, "user", 4); pos = pos + 4; store8(msg + pos, 0); pos = pos + 1;
    memcpy(msg + pos, user, user_len); pos = pos + user_len; store8(msg + pos, 0); pos = pos + 1;
    memcpy(msg + pos, "database", 8); pos = pos + 8; store8(msg + pos, 0); pos = pos + 1;
    memcpy(msg + pos, database, db_len); pos = pos + db_len; store8(msg + pos, 0); pos = pos + 1;
    store8(msg + pos, 0);
    var rc = _pg_write_full(fd, msg, msg_len);
    fl_free(msg);
    return rc;
}

# Read a single backend message. Returns {type, data_ptr, data_len} or 0.
fn _pg_read_msg(fd) {
    var hdr[8];
    if (_pg_read_full(fd, &hdr, 5) < 0) { return 0; }
    var msg_type = load8(&hdr);
    var msg_len = _pg_read_be32(&hdr, 1);
    # The length covers itself, so anything below 4 is malformed; the upper
    # bound stops a peer requesting a multi-gigabyte allocation from a
    # five-byte header.
    if (msg_len < 4 || msg_len > PG_MAX_MSG) { return 0; }
    var data_len = msg_len - 4;
    var data = 0;
    if (data_len > 0) {
        data = fl_alloc(data_len + 1);
        if (data == 0) { return 0; }
        if (_pg_read_full(fd, data, data_len) < 0) {
            fl_free(data);
            return 0;
        }
        store8(data + data_len, 0);
    }
    var result = fl_alloc(24);
    store64(result, msg_type);
    store64(result + 8, data);
    store64(result + 16, data_len);
    return result;
}

# Append `s` to `sb` as a QUOTED, ESCAPED SQL string literal, including the
# surrounding single quotes.
#
# majra's PostgreSQL client speaks the simple query protocol and implements no
# prepared statements, so every value reaches the server inside a literal and
# escaping is the only defence available. Standard SQL: a single quote inside a
# literal is written twice. PostgreSQL has defaulted standard_conforming_strings
# to on since 9.1, so a backslash is an ordinary character and needs no
# treatment; majra never emits E'' strings, where that would not hold.
#
# Returns 0 on success, -1 if `s` is null.
fn _pg_add_literal(sb, s) {
    if (s == 0) { return -1; }
    str_builder_add_cstr(sb, "'");
    var n = strlen(s);
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 39) { str_builder_add_cstr(sb, "''"); }
        else {
            var one[2];
            store8(&one, c);
            store8(&one + 1, 0);
            str_builder_add_cstr(sb, &one);
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "'");
    return 0;
}

# Send a simple query
fn _pg_send_query(fd, sql) {
    var sql_len = strlen(sql);
    var msg_len = 4 + sql_len + 1;
    var msg = fl_alloc(1 + msg_len);
    store8(msg, PG_MSG_QUERY);
    _pg_write_be32(msg, 1, msg_len);
    memcpy(msg + 5, sql, sql_len);
    store8(msg + 5 + sql_len, 0);
    var rc = _pg_write_full(fd, msg, 1 + msg_len);
    fl_free(msg);
    return rc;
}

# Send password message (cleartext)
fn _pg_send_password(fd, password) {
    var pw_len = strlen(password);
    var msg_len = 4 + pw_len + 1;
    var msg = fl_alloc(1 + msg_len);
    store8(msg, PG_MSG_PASSWORD);
    _pg_write_be32(msg, 1, msg_len);
    memcpy(msg + 5, password, pw_len);
    store8(msg + 5 + pw_len, 0);
    var rc = _pg_write_full(fd, msg, 1 + msg_len);
    # Do not leave the plaintext password sitting in a freed heap block.
    memset(msg, 0, 1 + msg_len);
    fl_free(msg);
    return rc;
}

# Send terminate message
fn _pg_terminate(fd) {
    var msg[8];
    store8(&msg, PG_MSG_TERMINATE);
    _pg_write_be32(&msg, 1, 4);
    syscall(SYS_WRITE, fd, &msg, 5);
}

# Connect to PostgreSQL. Returns PgConn or 0.
fn pg_connect(host, port, user, database, password) {
    # `host` used to be accepted and then ignored — every connection went to
    # INADDR_LOOPBACK() no matter what the caller asked for. Now parsed; a
    # non-dotted-quad host is a hard failure rather than a silent redirect to
    # localhost. (No resolver in the stdlib: pass an IPv4 literal.)
    var addr = INADDR_LOOPBACK();
    if (host != 0 && strlen(host) > 0) {
        addr = majra_parse_ipv4(host);
        if (addr < 0) { return 0; }
    }
    _pg_connect_lock();
    _pg_fd_g = syscall(41, AF_INET, SOCK_STREAM, 0);
    if (_pg_fd_g < 0) { mutex_unlock(_pg_connect_mtx); return 0; }
    var sa = sockaddr_in(addr, port);
    if (syscall(42, _pg_fd_g, sa, 16) < 0) {
        syscall(SYS_CLOSE, _pg_fd_g);
        mutex_unlock(_pg_connect_mtx);
        return 0;
    }
    _pg_user_g = user;
    _pg_db_g = database;
    _pg_pw_g = password;

    _pg_startup();
    var fd = _pg_fd_g;

    # Read auth response
    var msg = _pg_read_msg(fd);
    if (msg == 0) { syscall(SYS_CLOSE, fd); mutex_unlock(_pg_connect_mtx); return 0; }

    var msg_type = load64(msg);
    if (msg_type == PG_MSG_AUTH) {
        # A message whose declared length is exactly 4 carries no body, so
        # load64(msg + 8) is 0 — reading the auth type straight off it was a
        # null dereference on a malformed (or hostile) server reply.
        if (load64(msg + 16) < 4) { _pg_msg_free(msg); syscall(SYS_CLOSE, fd); mutex_unlock(_pg_connect_mtx); return 0; }
        var auth_type = _pg_read_be32(load64(msg + 8), 0);
        if (auth_type == PG_AUTH_CLEARTEXT) {
            _pg_msg_free(msg);
            if (_pg_send_password(fd, _pg_pw_g) < 0) { syscall(SYS_CLOSE, fd); mutex_unlock(_pg_connect_mtx); return 0; }
            msg = _pg_read_msg(fd);
            if (msg == 0) { syscall(SYS_CLOSE, fd); mutex_unlock(_pg_connect_mtx); return 0; }
            if (load64(msg + 16) < 4) { _pg_msg_free(msg); syscall(SYS_CLOSE, fd); mutex_unlock(_pg_connect_mtx); return 0; }
            auth_type = _pg_read_be32(load64(msg + 8), 0);
        }
        _pg_msg_free(msg);
        if (auth_type != PG_AUTH_OK) {
            # Includes SASL/SCRAM-SHA-256 (type 10), which majra does not
            # implement — fail closed rather than proceed unauthenticated.
            syscall(SYS_CLOSE, fd);
            mutex_unlock(_pg_connect_mtx);
            return 0;
        }
    } else {
        _pg_msg_free(msg);
    }

    # Read until ReadyForQuery. A _pg_read_msg failure is NOT equivalent to
    # ReadyForQuery: treating it as such handed back a fully-formed connection
    # struct for a socket that had already failed or closed, and every later
    # pg_query on it returned an empty row set indistinguishable from "no
    # rows". Fail the connect instead.
    var done = 0;
    while (done == 0) {
        msg = _pg_read_msg(fd);
        if (msg == 0) {
            syscall(SYS_CLOSE, fd);
            mutex_unlock(_pg_connect_mtx);
            return 0;
        }
        if (load64(msg) == PG_MSG_READY) { done = 1; }
        _pg_msg_free(msg);
    }

    var conn = fl_alloc(16);
    store64(conn, fd);
    store64(conn + 8, 1);
    mutex_unlock(_pg_connect_mtx);
    return conn;
}

fn pg_close(conn) {
    _pg_terminate(load64(conn));
    syscall(SYS_CLOSE, load64(conn));
}

# Execute a SQL query. Returns vec of rows, where each row is a vec of column values (C strings).
fn pg_query(conn, sql) {
    var fd = load64(conn);
    _pg_send_query(fd, sql);

    var rows = vec_new();
    var num_cols = 0;

    while (1) {
        var msg = _pg_read_msg(fd);
        if (msg == 0) { break; }
        var mtype = load64(msg);
        var stop = 0;

        if (mtype == PG_MSG_ROW_DESC) {
            if (load64(msg + 8) == 0 || load64(msg + 16) < 2) { _pg_msg_free(msg); break; }
            num_cols = _pg_read_be16(load64(msg + 8), 0);
        }
        elif (mtype == PG_MSG_DATA_ROW) {
            var data = load64(msg + 8);
            var data_len = load64(msg + 16);
            # Every offset below is derived from the wire, so each one is
            # bounded against the message body the server actually sent.
            if (data == 0 || data_len < 2) { _pg_msg_free(msg); break; }
            var col_count = _pg_read_be16(data, 0);
            # Each column costs at least its own 4-byte length prefix.
            if (col_count > (data_len - 2) / 4) { _pg_msg_free(msg); break; }
            var row = vec_new();
            var pos = 2;
            var ci = 0;
            var bad = 0;
            while (ci < col_count) {
                if (pos + 4 > data_len) { bad = 1; ci = col_count; }
                else {
                    # SIGNED read: PostgreSQL encodes NULL as length -1, and
                    # the zero-extending _pg_read_be32 turned that into
                    # 4294967295 — a 4 GiB alloc + 4 GiB memcpy on any NULL.
                    var col_len = _pg_read_i32(data, pos);
                    pos = pos + 4;
                    if (col_len < 0) {
                        vec_push(row, 0);
                    } elif (col_len > data_len - pos) {
                        bad = 1;
                        ci = col_count;
                    } else {
                        var val = fl_alloc(col_len + 1);
                        if (val == 0) { bad = 1; ci = col_count; }
                        else {
                            memcpy(val, data + pos, col_len);
                            store8(val + col_len, 0);
                            vec_push(row, val);
                            pos = pos + col_len;
                        }
                    }
                    ci = ci + 1;
                }
            }
            if (bad == 1) { _pg_msg_free(msg); break; }
            vec_push(rows, row);
        }
        elif (mtype == PG_MSG_CMD_COMPLETE) {
            # Command completed
        }
        elif (mtype == PG_MSG_ERROR) {
            # PostgreSQL ALWAYS sends ReadyForQuery after ErrorResponse.
            # Breaking here left it queued, so the next pg_query read the
            # previous query's ReadyForQuery as its own first message and
            # every subsequent result was offset by one. Drain to the real
            # sync point before returning.
            var draining = 1;
            while (draining == 1) {
                var m2 = _pg_read_msg(fd);
                if (m2 == 0) { draining = 0; }
                else {
                    if (load64(m2) == PG_MSG_READY) { draining = 0; }
                    _pg_msg_free(m2);
                }
            }
            stop = 1;
        }
        elif (mtype == PG_MSG_READY) {
            stop = 1;
        }
        _pg_msg_free(msg);
        if (stop == 1) { break; }
    }

    return rows;
}

# Execute a SQL statement (no result rows expected).
fn pg_exec(conn, sql) {
    pg_query(conn, sql);
}

# --- Workflow Storage over PostgreSQL ---

# Initialize tables for workflow storage.
fn pg_init_workflow_tables(conn) {
    {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "CREATE TABLE IF NOT EXISTS majra_workflow_definitions (id TEXT PRIMARY KEY, ");
        str_builder_add_cstr(sb, "name TEXT NOT NULL, description TEXT, steps_json TEXT NOT NULL DEFAULT '[]', ");
        str_builder_add_cstr(sb, "enabled BOOLEAN NOT NULL DEFAULT TRUE, version INTEGER NOT NULL DEFAULT 1, ");
        str_builder_add_cstr(sb, "created_by TEXT NOT NULL DEFAULT 'system', created_at BIGINT NOT NULL, ");
        str_builder_add_cstr(sb, "updated_at BIGINT NOT NULL)");
        pg_exec(conn, str_data(str_builder_build(sb)));
    }
    {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "CREATE TABLE IF NOT EXISTS majra_workflow_runs (id TEXT PRIMARY KEY, ");
        str_builder_add_cstr(sb, "workflow_id TEXT NOT NULL, workflow_name TEXT NOT NULL, ");
        str_builder_add_cstr(sb, "status TEXT NOT NULL DEFAULT 'pending', input_json TEXT, output_json TEXT, ");
        str_builder_add_cstr(sb, "error TEXT, triggered_by TEXT NOT NULL DEFAULT 'manual', ");
        str_builder_add_cstr(sb, "created_at BIGINT NOT NULL, ");
        str_builder_add_cstr(sb, "started_at BIGINT, completed_at BIGINT)");
        pg_exec(conn, str_data(str_builder_build(sb)));
    }
    {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "CREATE TABLE IF NOT EXISTS majra_workflow_step_runs (id TEXT PRIMARY KEY, ");
        str_builder_add_cstr(sb, "run_id TEXT NOT NULL, step_id TEXT NOT NULL, step_name TEXT NOT NULL, ");
        str_builder_add_cstr(sb, "status TEXT NOT NULL DEFAULT 'pending', input_json TEXT, output_json TEXT, ");
        str_builder_add_cstr(sb, "error TEXT, attempt INTEGER NOT NULL DEFAULT 1, started_at BIGINT, ");
        str_builder_add_cstr(sb, "completed_at BIGINT, duration_ms BIGINT)");
        pg_exec(conn, str_data(str_builder_build(sb)));
    }
    pg_exec(conn, "CREATE INDEX IF NOT EXISTS idx_majra_wf_runs_workflow ON majra_workflow_runs(workflow_id)");
    pg_exec(conn, "CREATE INDEX IF NOT EXISTS idx_majra_wf_step_runs_run ON majra_workflow_step_runs(run_id)");
}

# Save a workflow definition (upsert).
fn pg_save_workflow_def(conn, def_id, name, steps_json) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "INSERT INTO majra_workflow_definitions ");
    str_builder_add_cstr(sb, "(id, name, steps_json, created_at, updated_at) VALUES (");
    if (_pg_add_literal(sb, def_id) < 0) { return -1; }
    str_builder_add_cstr(sb, ", ");
    if (_pg_add_literal(sb, name) < 0) { return -1; }
    str_builder_add_cstr(sb, ", ");
    if (_pg_add_literal(sb, steps_json) < 0) { return -1; }
    var now = time_now_ns() / 1000000;
    str_builder_add_cstr(sb, ", ");
    str_builder_add_int(sb, now);
    str_builder_add_cstr(sb, ", ");
    str_builder_add_int(sb, now);
    str_builder_add_cstr(sb, ") ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, ");
    str_builder_add_cstr(sb, "steps_json = EXCLUDED.steps_json, updated_at = EXCLUDED.updated_at");
    pg_exec(conn, str_data(str_builder_build(sb)));
    return 0;
}

# Get a workflow definition by ID. Returns first row or 0.
fn pg_get_workflow_def(conn, def_id) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "SELECT id, name, steps_json FROM majra_workflow_definitions WHERE id = ");
    if (_pg_add_literal(sb, def_id) < 0) { return 0; }
    var rows = pg_query(conn, str_data(str_builder_build(sb)));
    if (vec_len(rows) == 0) { return 0; }
    return vec_get(rows, 0);
}

# Delete a workflow definition.
fn pg_delete_workflow_def(conn, def_id) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "DELETE FROM majra_workflow_definitions WHERE id = ");
    if (_pg_add_literal(sb, def_id) < 0) { return -1; }
    pg_exec(conn, str_data(str_builder_build(sb)));
    return 0;
}

# --- ipc_encrypted.cyr ---

# majra/ipc_encrypted — AES-256-GCM encrypted IPC channel
#
# Wraps ipc.cyr with symmetric encryption using a pre-shared 256-bit key.
# Each frame on the wire: [4B ipc length] [12B nonce] [N bytes ciphertext] [16B tag]
#
# Crypto is provided by sigil (see lib/sigil.cyr): aes_gcm_encrypt /
# aes_gcm_decrypt with the 96-bit-IV fast path. Constant-time tag
# verification, key zeroization, and the full FIPS-197 AES-256
# block cipher live in sigil — this module owns framing, nonce
# management, rekey policy, and connection lifecycle.

# --- AES-256-GCM constants ---
var AES_BLOCK_SIZE = 16;
var AES_256_KEY_SIZE = 32;
var AES_GCM_TAG_SIZE = 16;
var AES_GCM_NONCE_SIZE = 12;
# Warn at 2^31 frames, hard-fail at 2^32 — well below GCM's 2^32-2
# block-reuse ceiling per RFC 5116 §5.1.
var NONCE_WARN_THRESHOLD = 2147483648;
var NONCE_HARD_LIMIT = 4294967296;

# --- Base64 helpers ---
# Kept here (not moved to lib/base64.cyr) because ws.cyr's WebSocket
# accept-key path depends on majra_base64_encode being in scope via the
# include order established by tests/test_backends.tcyr. Trim carefully.
#
# The `majra_` prefix is load-bearing: lib/bayan.cyr also defines
# `base64_encode` / `base64_decode` (thin wrappers over `bayan_base64_*`)
# and the return contracts disagree — bayan's decode returns a scalar
# i64, ours returns a 16-byte {ptr, len} struct. Unprefixed, whichever
# definition the consumer's include order puts last silently wins, so a
# bayan-last consumer would have our own decode path misread the return
# value. Do not drop the prefix.

var _b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn _b64_encode_byte(idx) {
    return load8(_b64_chars + (idx & 63));
}

# Returns the 6-bit value for a base64 character, or -1 if `ch` is outside the
# alphabet. This used to fold every invalid byte to 0 — the value of 'A' — so
# corrupt or hostile input decoded silently to plausible-looking plaintext
# instead of being rejected.
fn _b64_decode_byte(ch) {
    if (ch >= 65 && ch <= 90) { return ch - 65; }
    if (ch >= 97 && ch <= 122) { return ch - 97 + 26; }
    if (ch >= 48 && ch <= 57) { return ch - 48 + 52; }
    if (ch == 43) { return 62; }
    if (ch == 47) { return 63; }
    if (ch == 61) { return 0; }
    return -1;
}

fn majra_base64_encode(data, len) {
    var out_len = ((len + 2) / 3) * 4;
    var out = fl_alloc(out_len + 1);
    var si = 0;
    var di = 0;
    while (si < len) {
        var b0 = load8(data + si);
        var b1 = 0;
        var b2 = 0;
        if (si + 1 < len) { b1 = load8(data + si + 1); }
        if (si + 2 < len) { b2 = load8(data + si + 2); }
        var triple = (b0 << 16) | (b1 << 8) | b2;
        store8(out + di, _b64_encode_byte(triple >> 18));
        store8(out + di + 1, _b64_encode_byte(triple >> 12));
        if (si + 1 < len) {
            store8(out + di + 2, _b64_encode_byte(triple >> 6));
        } else {
            store8(out + di + 2, 61);
        }
        if (si + 2 < len) {
            store8(out + di + 3, _b64_encode_byte(triple));
        } else {
            store8(out + di + 3, 61);
        }
        si = si + 3;
        di = di + 4;
    }
    store8(out + di, 0);
    return out;
}

fn majra_base64_decode(data, len) {
    # The loop consumes four input bytes per iteration while the output was
    # sized len/4*3, so a length that is not a multiple of 4 read past the end
    # of `data` AND wrote past the end of `out` on the final iteration.
    # Base64 is always a multiple of 4; anything else is malformed.
    if (len <= 0) { return 0; }
    if (len % 4 != 0) { return 0; }
    var out_len = len / 4 * 3;
    var out = fl_alloc(out_len + 1);
    if (out == 0) { return 0; }
    var si = 0;
    var di = 0;
    while (si < len) {
        var a = _b64_decode_byte(load8(data + si));
        var b = _b64_decode_byte(load8(data + si + 1));
        var c = _b64_decode_byte(load8(data + si + 2));
        var d = _b64_decode_byte(load8(data + si + 3));
        if (a < 0 || b < 0 || c < 0 || d < 0) { fl_free(out); return 0; }
        var triple = (a << 18) | (b << 12) | (c << 6) | d;
        store8(out + di, (triple >> 16) & 0xFF);
        if (load8(data + si + 2) != 61) {
            store8(out + di + 1, (triple >> 8) & 0xFF);
        }
        if (load8(data + si + 3) != 61) {
            store8(out + di + 2, triple & 0xFF);
        }
        si = si + 4;
        di = di + 3;
    }
    if (len > 0 && load8(data + len - 1) == 61) { di = di - 1; }
    if (len > 1 && load8(data + len - 2) == 61) { di = di - 1; }
    store8(out + di, 0);
    var result = fl_alloc(16);
    store64(result, out);
    store64(result + 8, di);
    return result;
}

# --- EncryptedIpcConnection ---

# Roles. BOTH ENDPOINTS OF A CHANNEL MUST PASS DIFFERENT ONES.
var ENCRYPTED_IPC_INITIATOR = 0;
var ENCRYPTED_IPC_RESPONDER = 1;

# EncryptedIpc struct (64 bytes):
#   offset  0: ipc_fd (i64) — underlying IPC file descriptor
#   offset  8: key (i64) — ptr to 32-byte key
#   offset 16: send_counter (i64) — nonce counter
#   offset 24: mutex (i64)
#   offset 32: needs_rekey (i64) — 0 or 1
#   offset 40: role (i64) — ENCRYPTED_IPC_INITIATOR | ENCRYPTED_IPC_RESPONDER
#   offset 48: peer_counter (i64) — highest peer counter accepted, -1 initially
#   offset 56: closed (i64) — 1 once encrypted_ipc_close has run
#   offset 64: recv_mutex (i64) — guards the receive half INDEPENDENTLY
#
# ⚠ TWO mutexes, deliberately. 2.6.9 put send and recv under ONE, then held it
# across ipc_recv_frame — a BLOCKING read(2). A receiver parked waiting for a
# peer that sends nothing therefore blocked every send on the same handle
# indefinitely, which for a request/response protocol is a self-deadlock: the
# reply can never arrive because the request can never be written. Splitting
# them keeps each half internally serialised (nonce counter and write ordering
# on one side, replay window and read ordering on the other) without coupling
# the two directions.
#
# ⚠ THE ROLE ARGUMENT IS LOAD-BEARING AES-GCM SAFETY, NOT BOOKKEEPING.
#
# Both endpoints share ONE pre-shared key. Before 2.6.9 each endpoint derived
# nonces from its own counter starting at 0, with nothing in the 12-byte nonce
# distinguishing the two directions — so the very first message each way used
# byte-identical (key, nonce). Under AES-GCM that is catastrophic: the
# keystreams are identical, so XORing the two ciphertexts yields the XOR of the
# two plaintexts, and a nonce collision also leaks the GHASH subkey, which lets
# an attacker forge tags for arbitrary messages. Every message pair at the same
# counter collided, not just the first.
#
# The role now occupies nonce byte 0, so the two directions occupy disjoint
# nonce spaces under the same key.
fn encrypted_ipc_new(ipc_fd, key_ptr, role) {
    if (role != ENCRYPTED_IPC_INITIATOR && role != ENCRYPTED_IPC_RESPONDER) { return 0; }
    aes_gcm_global_init();
    var e = fl_alloc(72);
    if (e == 0) { return 0; }
    store64(e, ipc_fd);
    var kcopy = fl_alloc(32);
    if (kcopy == 0) { fl_free(e); return 0; }
    memcpy(kcopy, key_ptr, 32);
    store64(e + 8, kcopy);
    store64(e + 16, 0);
    store64(e + 24, mutex_new());
    store64(e + 32, 0);
    store64(e + 40, role);
    store64(e + 48, -1);
    store64(e + 56, 0);
    store64(e + 64, mutex_new());
    return e;
}

fn encrypted_ipc_role(e) { return load64(e + 40); }

# Write a 12-byte nonce for (role, counter) into `out`.
#   byte  0   : role — separates the two directions' nonce spaces
#   bytes 1-3 : zero
#   bytes 4-11: big-endian counter
fn _write_nonce(out, role, counter) {
    memset(out, 0, 12);
    store8(out, role & 0xFF);
    store8(out + 4, (counter >> 56) & 0xFF);
    store8(out + 5, (counter >> 48) & 0xFF);
    store8(out + 6, (counter >> 40) & 0xFF);
    store8(out + 7, (counter >> 32) & 0xFF);
    store8(out + 8, (counter >> 24) & 0xFF);
    store8(out + 9, (counter >> 16) & 0xFF);
    store8(out + 10, (counter >> 8) & 0xFF);
    store8(out + 11, counter & 0xFF);
    return 0;
}

# Claim the next send counter. Caller must hold the mutex.
# Returns the counter, or -1 when the hard limit is reached.
#
# The counter is only consumed on success now; it used to be incremented
# before the limit check, so every refused call still advanced it and
# encrypted_ipc_messages_sent over-reported past the limit.
fn _next_counter(e) {
    var counter = load64(e + 16);
    if (counter >= NONCE_HARD_LIMIT) { return -1; }
    store64(e + 16, counter + 1);
    if (counter >= NONCE_WARN_THRESHOLD) {
        store64(e + 32, 1);
    }
    return counter;
}

fn encrypted_ipc_messages_sent(e) {
    return load64(e + 16);
}

fn encrypted_ipc_needs_rekey(e) {
    return load64(e + 32);
}

# Rekey: install new 32-byte key and reset counter.
# Install a new 32-byte key and restart the nonce sequence.
#
# Returns Ok(0), or Err(ERR_IPC) if the new key is byte-identical to the
# installed one. That check is load-bearing: resetting send_counter to 0 is
# only safe because the key changed. Re-installing the same key restarts the
# nonce sequence under it, which is exactly the (key, nonce) reuse AES-GCM
# cannot survive — and "rekey with the key I already have" is an easy caller
# mistake to make on a reconnect path.
fn encrypted_ipc_rekey(e, new_key_ptr) {
    if (e == 0 || new_key_ptr == 0) { return Err(ERR_IPC); }
    # Touches both halves (key, send counter, replay window), so it takes both
    # locks. Order is always send -> recv; nothing takes them the other way.
    var mtx = load64(e + 24);
    var rmtx = load64(e + 64);
    mutex_lock(mtx);
    mutex_lock(rmtx);
    if (load64(e + 56) == 1) {
        mutex_unlock(rmtx);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    var cur = load64(e + 8);
    if (cur == 0) {
        mutex_unlock(rmtx);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    if (ct_eq_bytes_lens(cur, AES_256_KEY_SIZE, new_key_ptr, AES_256_KEY_SIZE) == 1) {
        mutex_unlock(rmtx);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    memcpy(cur, new_key_ptr, 32);
    store64(e + 16, 0);
    store64(e + 32, 0);
    # The peer restarts its counter too, so the replay window must reopen or
    # every post-rekey frame would look like a replay.
    store64(e + 48, -1);
    mutex_unlock(rmtx);
    mutex_unlock(mtx);
    return Ok(0);
}

# --- Encrypt / Decrypt ---
# Wire format: [12B nonce] [N bytes ciphertext] [16B tag]
# aes_gcm_encrypt / aes_gcm_decrypt from sigil produce the ciphertext
# and tag separately; we concatenate them into the frame.

fn encrypted_ipc_send(e, data, len) {
    if (e == 0 || len < 0) { return Err(ERR_IPC); }
    var mtx = load64(e + 24);
    mutex_lock(mtx);
    if (load64(e + 56) == 1) { mutex_unlock(mtx); return Err(ERR_IPC); }

    var counter = _next_counter(e);
    if (counter < 0) {
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    var nonce[12];
    _write_nonce(&nonce, load64(e + 40), counter);

    var frame_len = AES_GCM_NONCE_SIZE + len + AES_GCM_TAG_SIZE;
    var frame = fl_alloc(frame_len);
    if (frame == 0) { mutex_unlock(mtx); return Err(ERR_IPC); }
    memcpy(frame, &nonce, AES_GCM_NONCE_SIZE);
    var ct_out = frame + AES_GCM_NONCE_SIZE;
    var tag_out = frame + AES_GCM_NONCE_SIZE + len;
    var erc = aes_gcm_encrypt(load64(e + 8), &nonce, 0, 0, data, len, ct_out, tag_out);
    if (erc != 0) {
        # Discarding this used to mean a sigil-side validation failure left
        # ct_out/tag_out untouched and majra transmitted the frame anyway.
        memset(frame, 0, frame_len);
        fl_free(frame);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }

    # The write stays UNDER the mutex. Releasing it first let two threads
    # sharing one connection interleave ipc_send_frame's 4-byte header and its
    # payload, so the peer read a header from one message and a body from
    # another — the stream never resynchronises.
    var rc = ipc_send_frame(load64(e), frame, frame_len);
    fl_free(frame);
    mutex_unlock(mtx);
    return rc;
}

# Tear down a connection whose framing can no longer be trusted. Caller must
# hold the mutex.
fn _encrypted_ipc_kill(e) {
    if (load64(e + 56) == 1) { return 0; }
    store64(e + 56, 1);
    var fd = load64(e);
    if (fd >= 0) { ipc_close(fd); }
    store64(e, -1);
    return 0;
}

fn encrypted_ipc_recv(e) {
    if (e == 0) { return Err(ERR_IPC); }
    # The RECEIVE mutex — never the send mutex. See the struct note.
    var mtx = load64(e + 64);
    mutex_lock(mtx);
    if (load64(e + 56) == 1) { mutex_unlock(mtx); return Err(ERR_IPC); }

    var frame_result = ipc_recv_frame(load64(e));
    if (is_err_result(frame_result) == 1) {
        # ERR_IPC_FRAME_TOO_LARGE is terminal: the oversized body is still
        # queued, so the framing can never resynchronise. We own the fd, so we
        # are the ones who close it — and we poison the handle so a later send
        # cannot write into a descriptor the kernel has since reassigned.
        if (err_code_of(frame_result) == ERR_IPC_FRAME_TOO_LARGE) {
            _encrypted_ipc_kill(e);
        }
        mutex_unlock(mtx);
        return frame_result;
    }
    var frame_ptr = payload(frame_result);
    var raw = load64(frame_ptr + 8);
    var raw_len = load64(frame_ptr);
    if (raw_len < AES_GCM_NONCE_SIZE + AES_GCM_TAG_SIZE) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    var nonce = raw;

    # --- Direction + replay checks, BEFORE spending a decryption ---
    #
    # AEAD gives integrity, not freshness: a captured frame replays and
    # decrypts cleanly forever. The peer's counter must strictly increase, and
    # its nonce must carry the peer's role — otherwise an attacker could
    # reflect our own frames back at us and they would authenticate.
    var peer_role = 1 - load64(e + 40);
    if (load8(nonce) != peer_role) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    var seen = (load8(nonce + 4) << 56) | (load8(nonce + 5) << 48)
             | (load8(nonce + 6) << 40) | (load8(nonce + 7) << 32)
             | (load8(nonce + 8) << 24) | (load8(nonce + 9) << 16)
             | (load8(nonce + 10) << 8) | load8(nonce + 11);
    if (seen <= load64(e + 48)) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }

    var ct = raw + AES_GCM_NONCE_SIZE;
    var ct_len = raw_len - AES_GCM_NONCE_SIZE - AES_GCM_TAG_SIZE;
    var tag = raw + AES_GCM_NONCE_SIZE + ct_len;
    var pt = fl_alloc(ct_len + 1);
    if (pt == 0) { fl_free(raw); fl_free(frame_ptr); mutex_unlock(mtx); return Err(ERR_IPC); }
    var rc = aes_gcm_decrypt(load64(e + 8), nonce, 0, 0, ct, ct_len, tag, pt);
    if (rc != 0) {
        # Tag mismatch — AEAD contract says do NOT leak plaintext.
        # aes_gcm_decrypt already zeroes pt on failure, but belt-and-braces:
        memset(pt, 0, ct_len);
        fl_free(pt);
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(mtx);
        return Err(ERR_IPC);
    }
    # Only advance the replay window once the tag has authenticated the frame,
    # so a forged nonce cannot burn counters and lock out the real peer.
    store64(e + 48, seen);
    store8(pt + ct_len, 0);

    fl_free(raw);
    fl_free(frame_ptr);
    mutex_unlock(mtx);

    var result = fl_alloc(16);
    store64(result, ct_len);
    store64(result + 8, pt);
    return Ok(result);
}

# Release a payload returned by encrypted_ipc_recv.
fn encrypted_ipc_payload_free(r) {
    if (r == 0) { return 0; }
    var p = load64(r + 8);
    if (p != 0) {
        memset(p, 0, load64(r));
        fl_free(p);
    }
    fl_free(r);
    return 0;
}

fn encrypted_ipc_close(e) {
    if (e == 0) { return 0; }
    var mtx = load64(e + 24);
    var rmtx = load64(e + 64);
    mutex_lock(mtx);
    mutex_lock(rmtx);
    if (load64(e + 56) == 1) { mutex_unlock(rmtx); mutex_unlock(mtx); return 0; }
    store64(e + 56, 1);
    # Zeroize the key buffer, then actually release it. Previously the key was
    # wiped but never freed and the handle stayed usable, so a post-close send
    # encrypted under an all-zero key and shipped it.
    var k = load64(e + 8);
    if (k != 0) {
        memset(k, 0, AES_256_KEY_SIZE);
        fl_free(k);
        store64(e + 8, 0);
    }
    # A poisoned fd (-1) means _encrypted_ipc_kill already closed it. Closing
    # again would hand SYS_CLOSE a number the kernel may have reassigned.
    var fd = load64(e);
    if (fd >= 0) { ipc_close(fd); }
    store64(e, -1);
    mutex_unlock(rmtx);
    mutex_unlock(mtx);
    return 0;
}

# Release the EncryptedIpc handle itself. Call AFTER encrypted_ipc_close —
# 2.6.9's close freed the key and closed the fd but never released the struct,
# and exported no teardown that did.
fn encrypted_ipc_free(e) {
    if (e == 0) { return 0; }
    fl_free(e);
    return 0;
}

# --- ws.cyr ---

# majra/ws — WebSocket framing primitives (RFC 6455) over TCP
#
# Provides:
#   - HTTP/1.1 upgrade handshake with SHA-1 + base64 (_ws_accept_upgrade)
#   - Frame read/write: text, binary, ping/pong, close
#
# ⚠ SCOPE — there is NO pub/sub bridge in this module.
#
# The header used to describe a four-step protocol ending "server forwards
# matching pub/sub messages as JSON text frames". No such loop exists: nothing
# reads the hub or max_connections stored by ws_bridge_new, and there is no
# accept/serve function. What ships here are the framing primitives; a
# consumer wanting fan-out drives ws_recv_frame / ws_send_text against its own
# accept loop and its own pubsub hub. ws_bridge_new is retained as a
# configuration holder with accessors, and wiring the loop is a roadmap item.
#
# Frames are read with server semantics: client frames MUST be masked
# (§5.1) and control frames MUST be <= 125 bytes and unfragmented (§5.5).

# --- SHA-1 Implementation (RFC 3174) ---
# Required for WebSocket handshake: SHA1(client_key + magic_guid)

var _sha1_h0 = 0x67452301;
var _sha1_h1 = 0xEFCDAB89;
var _sha1_h2 = 0x98BADCFE;
var _sha1_h3 = 0x10325476;
var _sha1_h4 = 0xC3D2E1F0;

fn _sha1_rotl32(x, n) {
    x = x & 0xFFFFFFFF;
    return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF;
}

# SHA-1 hash of data[0..len]. Returns ptr to 20-byte digest.
fn sha1(data, len) {
    var h0 = _sha1_h0;
    var h1 = _sha1_h1;
    var h2 = _sha1_h2;
    var h3 = _sha1_h3;
    var h4 = _sha1_h4;

    # Pad message: append 0x80, zeros, then 64-bit BE length
    var padded_len = ((len + 9 + 63) / 64) * 64;
    var padded = fl_alloc(padded_len);
    memset(padded, 0, padded_len);
    memcpy(padded, data, len);
    store8(padded + len, 0x80);
    # Store original length in bits as 64-bit BE at end
    var bit_len = len * 8;
    store8(padded + padded_len - 8, (bit_len >> 56) & 0xFF);
    store8(padded + padded_len - 7, (bit_len >> 48) & 0xFF);
    store8(padded + padded_len - 6, (bit_len >> 40) & 0xFF);
    store8(padded + padded_len - 5, (bit_len >> 32) & 0xFF);
    store8(padded + padded_len - 4, (bit_len >> 24) & 0xFF);
    store8(padded + padded_len - 3, (bit_len >> 16) & 0xFF);
    store8(padded + padded_len - 2, (bit_len >> 8) & 0xFF);
    store8(padded + padded_len - 1, bit_len & 0xFF);

    # Process each 64-byte block.
    #
    # The 80-entry message schedule comes from the FREELIST, per call.
    #
    # Originally it came from alloc() — the BUMP allocator, which never
    # reclaims — so every handshake leaked 640 bytes and an unauthenticated
    # peer could exhaust memory by reconnecting. 2.6.9 fixed that leak by
    # switching to a module-level scratch buffer, which fixed the leak and
    # broke REENTRANCY: sha1 is exported in all four dist bundles, so two
    # consumer threads hashing concurrently interleaved writes into one
    # schedule and both received a digest of neither message. fl_alloc fixes
    # both — it is per-call like the original, and reclaimable unlike alloc.
    var w = fl_alloc(640);
    if (w == 0) { fl_free(padded); return 0; }
    var block = 0;
    while (block < padded_len) {
        # Prepare message schedule (32-bit words stored in 64-bit slots)
        var wi = 0;
        while (wi < 16) {
            var off = block + wi * 4;
            var word = ((load8(padded+off) & 0xFF) << 24)
            | ((load8(padded+off+1) & 0xFF) << 16)
            | ((load8(padded+off+2) & 0xFF) << 8)
            | (load8(padded+off+3) & 0xFF);
            store64(w +wi * 8, word & 0xFFFFFFFF);
            wi = wi + 1;
        }
        while (wi < 80) {
            var xor_val = load64(w +(wi-3)*8) ^ load64(w +(wi-8)*8) ^ load64(w +(wi-14)*8) ^ load64(w +(wi-16)*8);
            store64(w +wi * 8, _sha1_rotl32(xor_val & 0xFFFFFFFF, 1));
            wi = wi + 1;
        }

        var a = h0;
        var b = h1;
        var c = h2;
        var d = h3;
        var e = h4;

        var ri = 0;
        while (ri < 80) {
            var f = 0;
            var k = 0;
            if (ri < 20) {
                f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
                k = 0x5A827999;
            } elif (ri < 40) {
                f = b ^ c ^ d;
                k = 0x6ED9EBA1;
            } elif (ri < 60) {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8F1BBCDC;
            } else {
                f = b ^ c ^ d;
                k = 0xCA62C1D6;
            }
            f = f & 0xFFFFFFFF;
            var temp = (_sha1_rotl32(a, 5) + f + e + k + load64(w +ri*8)) & 0xFFFFFFFF;
            e = d;
            d = c;
            c = _sha1_rotl32(b, 30);
            b = a;
            a = temp;
            ri = ri + 1;
        }

        h0 = (h0 + a) & 0xFFFFFFFF;
        h1 = (h1 + b) & 0xFFFFFFFF;
        h2 = (h2 + c) & 0xFFFFFFFF;
        h3 = (h3 + d) & 0xFFFFFFFF;
        h4 = (h4 + e) & 0xFFFFFFFF;
        block = block + 64;
    }

    fl_free(padded);
    fl_free(w);

    # Output 20-byte digest in big-endian
    var digest = fl_alloc(20);
    store8(digest, (h0>>24)&0xFF);
    store8(digest+1, (h0>>16)&0xFF);
    store8(digest+2, (h0>>8)&0xFF);
    store8(digest+3, h0&0xFF);
    store8(digest+4, (h1>>24)&0xFF);
    store8(digest+5, (h1>>16)&0xFF);
    store8(digest+6, (h1>>8)&0xFF);
    store8(digest+7, h1&0xFF);
    store8(digest+8, (h2>>24)&0xFF);
    store8(digest+9, (h2>>16)&0xFF);
    store8(digest+10, (h2>>8)&0xFF);
    store8(digest+11, h2&0xFF);
    store8(digest+12, (h3>>24)&0xFF);
    store8(digest+13, (h3>>16)&0xFF);
    store8(digest+14, (h3>>8)&0xFF);
    store8(digest+15, h3&0xFF);
    store8(digest+16, (h4>>24)&0xFF);
    store8(digest+17, (h4>>16)&0xFF);
    store8(digest+18, (h4>>8)&0xFF);
    store8(digest+19, h4&0xFF);
    return digest;
}

# --- WebSocket Constants ---
var WS_MAGIC_GUID = "258EAFA5-E914-47DA-95CA-5AB5DC11BE85";

# Largest frame payload majra will allocate for. RFC 6455 allows a 63-bit
# length; honouring that literally is the integer-overflow / memory-exhaustion
# class behind CVE-2026-54466 and CVE-2026-1528. 1 MiB matches the IPC frame
# cap in src/ipc.cyr.
var WS_MAX_PAYLOAD = 1048576;
# RFC 6455 §5.5: control frames carry at most 125 bytes and are never fragmented.
var WS_MAX_CONTROL_PAYLOAD = 125;

# Read exactly `want` bytes, looping over short reads. -1 if the peer closed
# or errored first. A blocking socket may legitimately return fewer bytes than
# asked for; the frame reader used to ignore these returns entirely and parse
# whatever stale bytes were on the stack.
fn _ws_read_full(fd, buf, want) {
    var total = 0;
    while (total < want) {
        var r = syscall(SYS_READ, fd, buf + total, want - total);
        # EINTR (-4) is a retry, not a failure. 2.6.9 taught _ipc_read_full
        # this and left the WebSocket and PostgreSQL helpers treating a signal
        # as a dead connection.
        if (r == -4) { r = 0; }
        elif (r <= 0) { return -1; }
        total = total + r;
    }
    return total;
}

# Write exactly `len` bytes, looping over short writes.
fn _ws_write_full(fd, buf, len) {
    var total = 0;
    while (total < len) {
        var w = syscall(SYS_WRITE, fd, buf + total, len - total);
        if (w == -4) { w = 0; }
        elif (w <= 0) { return -1; }
        total = total + w;
    }
    return total;
}

# WebSocket opcodes
enum WsOpcode {
    WS_TEXT = 1;
    WS_BINARY = 2;
    WS_CLOSE = 8;
    WS_PING = 9;
    WS_PONG = 10;
}

# --- WebSocket Handshake ---

# Compute Sec-WebSocket-Accept value from client key.
fn _ws_accept_key(client_key) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, client_key);
    str_builder_add_cstr(sb, WS_MAGIC_GUID);
    var combined = str_builder_build(sb);
    var digest = sha1(str_data(combined), str_len(combined));
    var accept = majra_base64_encode(digest, 20);
    fl_free(digest);
    return accept;
}

# --- WebSocket Frame ---

# Send a text frame (unmasked, server->client).
# Send a text frame (unmasked, server->client).
# Returns 0 on success, -1 on failure.
#
# The 127/64-bit length form is emitted for payloads >= 65536. Previously the
# if/elif chain had no else, so a payload of 65536 bytes or more was written to
# the socket with NO frame header at all — raw application bytes landing where
# the peer expects a header, which corrupts the stream for the rest of the
# connection.
fn ws_send_text(fd, data, len) {
    if (len < 0) { return -1; }
    if (len < 126) {
        var hdr[2];
        store8(&hdr, 0x81);
        store8(&hdr + 1, len);
        if (_ws_write_full(fd, &hdr, 2) < 0) { return -1; }
    } elif (len < 65536) {
        var hdr4[4];
        store8(&hdr4, 0x81);
        store8(&hdr4 + 1, 126);
        store8(&hdr4 + 2, (len >> 8) & 0xFF);
        store8(&hdr4 + 3, len & 0xFF);
        if (_ws_write_full(fd, &hdr4, 4) < 0) { return -1; }
    } else {
        var hdr10[10];
        store8(&hdr10, 0x81);
        store8(&hdr10 + 1, 127);
        store8(&hdr10 + 2, (len >> 56) & 0xFF);
        store8(&hdr10 + 3, (len >> 48) & 0xFF);
        store8(&hdr10 + 4, (len >> 40) & 0xFF);
        store8(&hdr10 + 5, (len >> 32) & 0xFF);
        store8(&hdr10 + 6, (len >> 24) & 0xFF);
        store8(&hdr10 + 7, (len >> 16) & 0xFF);
        store8(&hdr10 + 8, (len >> 8) & 0xFF);
        store8(&hdr10 + 9, len & 0xFF);
        if (_ws_write_full(fd, &hdr10, 10) < 0) { return -1; }
    }
    if (_ws_write_full(fd, data, len) < 0) { return -1; }
    return 0;
}

# Read a WebSocket frame. Returns {opcode, payload_ptr, payload_len, fin} or 0.
#
# Frame struct (32 bytes):
#   offset  0: opcode
#   offset  8: payload ptr
#   offset 16: payload len
#   offset 24: fin (0 or 1)
#
# RFC 6455 conformance repaired at 2.6.9. Previously this function:
#   - never implemented the 127 / 64-bit length form, so the sentinel 127 was
#     used as a LITERAL payload length. The eight big-endian length bytes were
#     then consumed as payload and the real payload was parsed as the next
#     frame header — a peer-controlled desync, not merely a wrong length.
#   - discarded the return of the extended-length and masking-key reads, so a
#     short read left uninitialised stack bytes driving the length and the
#     unmask.
#   - never bounded the payload length (the CVE-2026-54466 / CVE-2026-1528
#     class).
#   - accepted unmasked client frames, which §5.1 requires a server to reject.
#   - never enforced §5.5's 125-byte, non-fragmented control-frame rule.
#   - dropped RSV1-3 and FIN on the floor and never validated the opcode.
#   - leaked the payload buffer on a short read.
fn ws_recv_frame(fd) {
    var hdr[2];
    if (_ws_read_full(fd, &hdr, 2) < 0) { return 0; }

    var b0 = load8(&hdr);
    var b1 = load8(&hdr + 1);
    var fin = (b0 >> 7) & 1;
    var rsv = (b0 >> 4) & 7;
    var opcode = b0 & 0x0F;
    var masked = (b1 >> 7) & 1;
    var payload_len = b1 & 0x7F;

    # §5.2: RSV1-3 must be zero unless an extension negotiated them. majra
    # negotiates none, so a non-zero RSV is a protocol error.
    if (rsv != 0) { return 0; }

    # §5.2: opcodes 3-7 and 11-15 are reserved.
    if (opcode > 10) { return 0; }
    if (opcode > 2 && opcode < 8) { return 0; }

    var is_control = 0;
    if (opcode >= 8) { is_control = 1; }

    if (payload_len == 126) {
        var ext[2];
        if (_ws_read_full(fd, &ext, 2) < 0) { return 0; }
        payload_len = (load8(&ext) << 8) | load8(&ext + 1);
    } elif (payload_len == 127) {
        var ext8[8];
        if (_ws_read_full(fd, &ext8, 8) < 0) { return 0; }
        # Reject anything with the top 32 bits set before composing, so the
        # shift below cannot overflow into a negative i64.
        if (load8(&ext8) != 0 || load8(&ext8 + 1) != 0
          || load8(&ext8 + 2) != 0 || load8(&ext8 + 3) != 0) { return 0; }
        payload_len = (load8(&ext8 + 4) << 24) | (load8(&ext8 + 5) << 16)
                    | (load8(&ext8 + 6) << 8) | load8(&ext8 + 7);
    }

    if (payload_len < 0 || payload_len > WS_MAX_PAYLOAD) { return 0; }

    # §5.5: control frames are never fragmented and carry at most 125 bytes.
    if (is_control == 1) {
        if (fin == 0) { return 0; }
        if (payload_len > WS_MAX_CONTROL_PAYLOAD) { return 0; }
    }

    # §5.1: a server MUST reject an unmasked frame from a client. Masking is
    # what stops a hostile script steering an intermediary into treating frame
    # bytes as a second HTTP request (cache poisoning).
    if (masked != 1) { return 0; }

    var mask[4];
    if (_ws_read_full(fd, &mask, 4) < 0) { return 0; }

    var payload = fl_alloc(payload_len + 1);
    if (payload == 0) { return 0; }
    if (payload_len > 0) {
        if (_ws_read_full(fd, payload, payload_len) < 0) {
            fl_free(payload);
            return 0;
        }
    }

    var mi = 0;
    while (mi < payload_len) {
        store8(payload + mi, load8(payload + mi) ^ load8(&mask + (mi & 3)));
        mi = mi + 1;
    }
    store8(payload + payload_len, 0);

    var frame = fl_alloc(32);
    if (frame == 0) { fl_free(payload); return 0; }
    store64(frame, opcode);
    store64(frame + 8, payload);
    store64(frame + 16, payload_len);
    store64(frame + 24, fin);
    return frame;
}

fn ws_frame_opcode(f)  { return load64(f); }
fn ws_frame_payload(f) { return load64(f + 8); }
fn ws_frame_len(f)     { return load64(f + 16); }
fn ws_frame_fin(f)     { return load64(f + 24); }

# Release a frame returned by ws_recv_frame.
fn ws_frame_free(f) {
    if (f == 0) { return 0; }
    var p = load64(f + 8);
    if (p != 0) { fl_free(p); }
    fl_free(f);
    return 0;
}

# Send a close frame. Returns 0 on success, -1 on failure.
fn ws_send_close(fd) {
    var hdr[2];
    store8(&hdr, 0x88);
    store8(&hdr + 1, 0);
    if (_ws_write_full(fd, &hdr, 2) < 0) { return -1; }
    return 0;
}

# Send a pong frame. Returns 0 on success, -1 on failure.
#
# The length used to be written with store8 and no range check, so a len of
# 126 or more was truncated to its low 8 bits while the full payload was still
# written — a malformed control frame plus a desynced stream. RFC 6455 §5.5
# caps control payloads at 125, so an over-long pong is now refused outright.
fn ws_send_pong(fd, data, len) {
    if (len < 0 || len > WS_MAX_CONTROL_PAYLOAD) { return -1; }
    var hdr[2];
    store8(&hdr, 0x8A);
    store8(&hdr + 1, len);
    if (_ws_write_full(fd, &hdr, 2) < 0) { return -1; }
    if (len > 0) {
        if (_ws_write_full(fd, data, len) < 0) { return -1; }
    }
    return 0;
}

# --- WebSocket Server ---

# WsBridge struct (16 bytes):
#   offset 0: pubsub (i64) — PubSub hub ptr
#   offset 8: max_connections (i64)

fn ws_bridge_new(pubsub_hub, max_connections) {
    var b = fl_alloc(16);
    store64(b, pubsub_hub);
    store64(b + 8, max_connections);
    return b;
}

fn ws_bridge_pubsub(b)          { return load64(b); }
fn ws_bridge_max_connections(b) { return load64(b + 8); }

fn ws_bridge_free(b) {
    if (b != 0) { fl_free(b); }
    return 0;
}

# Accept a WebSocket upgrade from a raw TCP connection.
# Reads HTTP headers, extracts Sec-WebSocket-Key, sends 101 response.
# Returns 1 on success, 0 on failure.
fn _ws_accept_upgrade(fd) {
    # Read HTTP request (up to 4KB)
    var buf = fl_alloc(4096);
    if (buf == 0) { return 0; }
    var total = 0;
    # Read until we see \r\n\r\n
    while (total < 4090) {
        var n = syscall(SYS_READ, fd, buf + total, 1);
        if (n <= 0) { fl_free(buf); return 0; }
        total = total + 1;
        # CR LF CR LF — the end of the HTTP header block.
        if (total >= 4 && load8(buf+total-4) == 13 && load8(buf+total-3) == 10
          && load8(buf+total-2) == 13 && load8(buf+total-1) == 10) {
            break;
        }
    }
    store8(buf + total, 0);

    # §4.2.1: the handshake must be a GET. This used to send 101 Switching
    # Protocols to ANY request merely containing the substring
    # "Sec-WebSocket-Key: " — including a POST, or a request carrying it in a
    # body rather than a header.
    if (total < 4 || memeq(buf, "GET ", 4) != 1) { fl_free(buf); return 0; }

    # Find Sec-WebSocket-Key header
    var key_header = "Sec-WebSocket-Key: ";
    var key_pos = 0;
    var i = 0;
    while (i < total) {
        if (memeq(buf + i, key_header, 19) == 1) {
            key_pos = i + 19;
            break;
        }
        i = i + 1;
    }
    if (key_pos == 0) { fl_free(buf); return 0; }

    # Extract key value (until \r\n)
    var key_end = key_pos;
    while (key_end < total && load8(buf + key_end) != 13) {
        key_end = key_end + 1;
    }
    var key_len = key_end - key_pos;
    # A base64-encoded 16-byte nonce is 24 characters; anything wildly off is
    # not a conforming handshake.
    if (key_len < 1 || key_len > 128) { fl_free(buf); return 0; }
    var client_key = fl_alloc(key_len + 1);
    if (client_key == 0) { fl_free(buf); return 0; }
    memcpy(client_key, buf + key_pos, key_len);
    store8(client_key + key_len, 0);

    # Compute accept key
    var accept_key = _ws_accept_key(client_key);

    # Send 101 Switching Protocols
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "HTTP/1.1 101 Switching Protocols\r\n");
    str_builder_add_cstr(sb, "Upgrade: websocket\r\nConnection: Upgrade\r\n");
    str_builder_add_cstr(sb, "Sec-WebSocket-Accept: ");
    str_builder_add_cstr(sb, accept_key);
    str_builder_add_cstr(sb, "\r\n\r\n");
    var resp = str_builder_build(sb);
    var rc = _ws_write_full(fd, str_data(resp), str_len(resp));
    fl_free(client_key);
    fl_free(accept_key);
    fl_free(buf);
    if (rc < 0) { return 0; }
    return 1;
}

# --- admin.cyr ---

# majra/admin — HTTP admin/metrics endpoint
#
# Read-only observability surface over HTTP/1.1. Intended for
# localhost or reverse-proxied deployment; NO auth, NO mutation,
# NO write endpoints. Consumers who need mTLS or token auth should
# wrap this with a fronting proxy (nginx, sigil-TLS, etc.).
#
# Routes (all GET):
#   /health              → "ok" text/plain
#   /fleet               → JSON {total, online, offline, ...}
#   /ratelimit/:key      → JSON {allowed, rejected} or 404
#
# Uses the sandhi server surface (sandhi_server_*, folded into the
# cyrius stdlib). Blocking single-threaded accept loop; a request
# handler returns quickly.
# For high-throughput observability, front with Prometheus or a
# pull-scraping agent rather than making this multi-threaded.

# Tracker kinds. The admin endpoint MUST know which it holds.
var ADMIN_TRACKER_CONCURRENT = 0;
var ADMIN_TRACKER_BASIC = 1;

# MajraAdmin struct (32 bytes, 4 fields):
#   offset  0: fleet_tracker  (i64) — chb_tracker or hb_tracker (may be 0)
#   offset  8: ratelimiter    (i64) — ratelimiter ptr (may be 0)
#   offset 16: tracker_kind   (i64) — ADMIN_TRACKER_CONCURRENT | _BASIC
#   offset 24: reserved       (i64) — future: pubsub hub ref
#
# ⚠ tracker_kind is a MEMORY-SAFETY field, not bookkeeping.
#
# The struct comment used to say the tracker "may be hb_tracker or
# chb_tracker" while _admin_fleet_json unconditionally called
# chb_fleet_stats. hb_tracker is fl_alloc(16) — map@0, cfg@8, NO MUTEX —
# while chb_fleet_stats does load64(cht + 16) and mutex_lock()s the result.
# Handing it an hb_tracker therefore reads 8 bytes PAST the allocation and
# treats whatever is there as a mutex pointer, then atomically writes to it.
# The kind is now recorded and checked.

# ⚠ REQUIRES a CONCURRENT tracker (chb_tracker_new). Passing a basic
# hb_tracker here is a contract violation with a memory-safety consequence, not
# merely a wrong answer: chb_fleet_stats reads a mutex pointer at offset 16,
# which is 8 bytes PAST an hb_tracker's 16-byte allocation, and then locks it.
#
# Use majra_admin_new_ex(t, ADMIN_TRACKER_BASIC, rl) for a basic tracker; /fleet
# then returns an explanatory error instead of reading out of bounds.
#
# The tracker_kind field cannot be inferred, because the two tracker types are
# not distinguishable from their pointers — hb_tracker is fl_alloc(16) and
# chb_tracker fl_alloc(24), with no type tag in either. Making them
# distinguishable means adding a tag to both layouts, which is 2.7.0 work
# (roadmap § 2.7.0), not a patch. Until then this default trusts the
# documented contract: defaulting to BASIC instead would keep incorrect callers
# safe at the cost of silently removing /fleet from every CORRECT one.
fn majra_admin_new(fleet_tracker, ratelimiter) {
    return majra_admin_new_ex(fleet_tracker, ADMIN_TRACKER_CONCURRENT, ratelimiter);
}

fn majra_admin_new_ex(fleet_tracker, tracker_kind, ratelimiter) {
    var a = fl_alloc(32);
    store64(a, fleet_tracker);
    store64(a + 8, ratelimiter);
    store64(a + 16, tracker_kind);
    store64(a + 24, 0);
    return a;
}

fn majra_admin_tracker_kind(a) { return load64(a + 16); }

fn majra_admin_fleet_tracker(a) { return load64(a); }
fn majra_admin_ratelimiter(a)   { return load64(a + 8); }

# Build a JSON response body for fleet stats. Returns {ptr, len} via ret2.
# Uses chb_fleet_stats when a concurrent tracker is attached; the stats
# struct layout is {total_nodes, online, suspect, offline, total_gpus,
# total_vram, available_vram, evicted}.
fn _admin_fleet_json(a) {
    var t = load64(a);
    if (t == 0) {
        var empty = "{\"error\":\"no fleet tracker\"}";
        ret2(empty, strlen(empty));
    }
    # Only a concurrent tracker has the mutex chb_fleet_stats reads at +16.
    # A basic hb_tracker is 16 bytes, so calling it would read past the
    # allocation and lock whatever it found.
    if (load64(a + 16) != ADMIN_TRACKER_CONCURRENT) {
        var basic = "{\"error\":\"fleet stats require a concurrent tracker\"}";
        ret2(basic, strlen(basic));
    }
    var s = chb_fleet_stats(t);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"total\":");
    str_builder_add_int(sb, load64(s));
    str_builder_add_cstr(sb, ",\"online\":");
    str_builder_add_int(sb, load64(s + 8));
    str_builder_add_cstr(sb, ",\"suspect\":");
    str_builder_add_int(sb, load64(s + 16));
    str_builder_add_cstr(sb, ",\"offline\":");
    str_builder_add_int(sb, load64(s + 24));
    str_builder_add_cstr(sb, ",\"gpus\":");
    str_builder_add_int(sb, load64(s + 32));
    str_builder_add_cstr(sb, ",\"vram_total\":");
    str_builder_add_int(sb, load64(s + 40));
    str_builder_add_cstr(sb, ",\"vram_available\":");
    str_builder_add_int(sb, load64(s + 48));
    str_builder_add_cstr(sb, "}");
    var body = str_builder_build(sb);
    ret2(str_data(body), str_len(body));
}

# ⚠ `key` is accepted and NOT used for filtering — the response is the
# limiter's GLOBAL counters regardless of which key was asked for, while the
# route is documented as `/ratelimit/:key`. An operator reading
# /ratelimit?key=tenant-a sees fleet-wide totals and can easily read them as
# that tenant's. The key is echoed in the response so the answer is at least
# self-describing; real per-key stats need a ratelimit_stats_for_key helper
# (roadmap item, cross-referenced from CHANGELOG 2.6.9).
fn _admin_ratelimit_json(a, key) {
    var rl = load64(a + 8);
    if (rl == 0 || key == 0) {
        var empty = "{\"error\":\"no ratelimiter or key\"}";
        ret2(empty, strlen(empty));
    }
    var s = ratelimit_stats(rl);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"allowed\":");
    str_builder_add_int(sb, load64(s));
    str_builder_add_cstr(sb, ",\"rejected\":");
    str_builder_add_int(sb, load64(s + 8));
    str_builder_add_cstr(sb, ",\"active_keys\":");
    str_builder_add_int(sb, load64(s + 16));
    str_builder_add_cstr(sb, ",\"evicted\":");
    str_builder_add_int(sb, load64(s + 24));
    str_builder_add_cstr(sb, ",\"scope\":\"global\"}");
    var body = str_builder_build(sb);
    ret2(str_data(body), str_len(body));
}

# HTTP handler matching the sandhi_server_run handler signature:
#   fn handler(ctx, cfd, buf, blen)
# where ctx is the MajraAdmin pointer.
fn majra_admin_handler(ctx, cfd, buf, blen) {
    var path = sandhi_server_get_path(buf, blen);
    if (path == 0) {
        sandhi_server_send_status(cfd, HTTP_BAD_REQUEST, "bad request");
        return 0;
    }
    var route = sandhi_server_path_only(path);

    if (str_eq(route, str_from("/health")) == 1) {
        sandhi_server_send_response(cfd, HTTP_OK, "OK", "text/plain", "ok", 2, 0);
        return 0;
    }
    if (str_eq(route, str_from("/fleet")) == 1) {
        var body = _admin_fleet_json(ctx);
        var body_len = rethi();
        sandhi_server_send_response(cfd, HTTP_OK, "OK", "application/json", body, body_len, 0);
        return 0;
    }
    if (str_eq(route, str_from("/ratelimit")) == 1) {
        var key = sandhi_server_get_param(path, "key");
        var body = _admin_ratelimit_json(ctx, key);
        var body_len = rethi();
        sandhi_server_send_response(cfd, HTTP_OK, "OK", "application/json", body, body_len, 0);
        return 0;
    }

    sandhi_server_send_status(cfd, HTTP_NOT_FOUND, "not found");
    return 0;
}

# Run the admin endpoint in this thread. Blocks indefinitely.
#
# `addr` is a dotted-quad STRING — pass "127.0.0.1" for localhost-only, and
# "0.0.0.0" only behind a reverse proxy. Returns -1 for an unparseable address
# rather than binding somewhere unintended.
#
# ⚠ This used to forward `addr` straight to sandhi_server_run, which passes it
# to sock_bind -> sockaddr_in, where it is a PACKED INTEGER (0x0100007F for
# 127.0.0.1), not a string. So the documented "bind 127.0.0.1 for
# localhost-only" call actually stored the low 32 bits of a char* pointer as
# the bind address — the one guarantee this endpoint makes (it has no auth of
# its own) was decided by a pointer value.
fn majra_admin_serve(admin, addr, port) {
    var packed = majra_parse_ipv4(addr);
    if (packed < 0) { return -1; }
    return sandhi_server_run(packed, port, &majra_admin_handler, admin);
}

# --- patra_queue.cyr ---

# majra/patra_queue — durable job queue backed by patra
#
# Persistent alternative to `ManagedQueue` in src/queue.cyr. Trades the
# in-memory priority queue's nanosecond ops for durability: jobs
# survive a process restart. Backed by a single `jobs` table in a
# .patra file.
#
# Schema:
#   jobs(id INT, priority INT, payload TEXT, status INT, created_ns INT)
#
# ⚠ SCHEMA CHANGE AT 2.6.9: payload was STR, which patra caps at 255 bytes.
# Enqueue accepted any length and the rejection was discarded, so a longer
# payload (a JSON spec, a base64 blob) was silently dropped while enqueue
# reported success. TEXT is chain-page backed and uncapped. An existing
# .patra file keeps its old STR column — delete it, or migrate, to lift the cap.
#
# ⚠ All SQL is built with PREPARED STATEMENTS. Do not reintroduce string
# concatenation here: the payload is caller-supplied, and splicing it into a
# quoted literal let it close the literal and rewrite the columns after it.
#
# Status codes match the in-memory queue's JOB_* constants from queue.cyr:
#   0=queued, 1=running, 2=completed, 3=failed
#
# API:
#   var q = patra_queue_new("jobs.patra");
#   var id = patra_queue_enqueue(q, PRIORITY_HIGH, "payload");
#   var job = patra_queue_dequeue(q);   # returns fl_alloc'd {id, pri, pay} or 0
#   patra_queue_complete(q, id);
#   patra_queue_queued_count(q);
#   patra_queue_close(q);

# patra_queue struct (32 bytes):
#   offset  0: db (i64)       — patra_open handle
#   offset  8: next_id (i64)  — monotonic ID counter
#   offset 16: initialized (i64) — 1 once CREATE TABLE has run
#   offset 24: mutex (i64)    — guards next_id and the dequeue claim

fn _pq_create_sql() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "CREATE TABLE jobs (");
    str_builder_add_cstr(sb, "id INT, priority INT, payload TEXT, status INT, created_ns INT)");
    return str_cstr(str_builder_build(sb));
}

# Returns PATRA_OK when the table is usable, otherwise the patra error.
# This used to return 0 unconditionally and patra_queue_new discarded it, so an
# I/O error or a full store left a live handle pointing at no table.
fn _pq_ensure_table(pq) {
    if (load64(pq + 16) == 1) { return PATRA_OK; }
    var db = load64(pq);
    var r = patra_exec(db, _pq_create_sql());
    # PATRA_OK on first create, PATRA_ERR_EXISTS on reopen — both fine.
    if (r == PATRA_OK || r == PATRA_ERR_EXISTS) {
        store64(pq + 16, 1);
        return PATRA_OK;
    }
    return r;
}

# On open, find the max id in the existing jobs table so new IDs don't
# collide with durable ones. `MAX(id)` returns a single-row aggregate
# (`{count: 1, val: <max>}`) on a populated table, or `count: 0` on an
# empty one — the count==0 branch initialises next_id to 1.
fn _pq_load_next_id(pq) {
    var db = load64(pq);
    var rs = patra_query(db, "SELECT MAX(id) FROM jobs");
    var max_id = 0;
    if (rs != 0) {
        if (patra_result_count(rs) > 0) {
            max_id = patra_result_get_int(rs, 0, 0);
        }
        patra_result_free(rs);
    }
    store64(pq + 8, max_id + 1);
}

fn patra_queue_new(path) {
    patra_init();
    var db = patra_open(path);
    if (db == 0) { return 0; }
    var pq = fl_alloc(32);
    if (pq == 0) { patra_close(db); return 0; }
    store64(pq, db);
    store64(pq + 8, 1);
    store64(pq + 16, 0);
    store64(pq + 24, mutex_new());
    if (_pq_ensure_table(pq) != PATRA_OK) {
        patra_close(db);
        fl_free(pq);
        return 0;
    }
    _pq_load_next_id(pq);
    return pq;
}

fn patra_queue_close(pq) {
    if (pq == 0) { return 0; }
    patra_close(load64(pq));
    store64(pq, 0);
    fl_free(pq);
    return 0;
}

# Returns the new job id, or 0 if the INSERT did not commit.
#
# The payload used to be spliced into a single-quoted SQL literal, so a payload
# containing a quote closed the literal and rewrote the columns after it — an
# enqueue of "x', 2, 0) y '" set its own status and created_ns. patra_bind_text
# writes the bytes to the row without reparsing them as SQL.
#
# The return was also discarded, so a rejected INSERT was indistinguishable
# from a committed one and the caller got an id for a job that does not exist.
fn patra_queue_enqueue(pq, priority, payload) {
    if (pq == 0 || payload == 0) { return 0; }
    var db = load64(pq);
    var mtx = load64(pq + 24);
    mutex_lock(mtx);

    var stmt = patra_prepare(db, "INSERT INTO jobs VALUES (?, ?, ?, 0, ?)");
    if (stmt == 0) { mutex_unlock(mtx); return 0; }

    var id = load64(pq + 8);
    patra_bind_int(stmt, 0, id);
    patra_bind_int(stmt, 1, priority);
    patra_bind_text(stmt, 2, payload, strlen(payload));
    patra_bind_int(stmt, 3, time_now_ns());

    var rc = patra_exec_prepared(db, stmt);
    patra_finalize(stmt);
    if (rc != PATRA_OK) {
        mutex_unlock(mtx);
        return 0;
    }
    # Only consume the id once the row is durable.
    store64(pq + 8, id + 1);
    mutex_unlock(mtx);
    return id;
}

# Dequeue highest-priority queued job (and mark it running). Returns
# a 32-byte struct: {id, priority, payload_str_ptr, status} — or 0 if
# no queued jobs. Caller fl_free's the returned struct.
#
# Priority convention matches src/queue.cyr: lower numeric = higher
# priority (CRITICAL=0 is highest, BACKGROUND=4 is lowest). The
# server-side `ORDER BY priority ASC, id ASC LIMIT 1` returns the
# right row directly — no client-side scan + sort.
fn patra_queue_dequeue(pq) {
    if (pq == 0) { return 0; }
    var db = load64(pq);
    var mtx = load64(pq + 24);
    mutex_lock(mtx);

    # The claim is SELECT-then-conditional-UPDATE, and the UPDATE carries
    # `AND status = 0`. This used to be an unconditional
    # `UPDATE ... WHERE id = N` with no transaction, so two consumers that
    # both selected the same row both "claimed" it and the job ran twice.
    # Now the loser's UPDATE matches zero rows and it retries for another job.
    var job = 0;
    var searching = 1;
    while (searching == 1) {
        var rs = patra_query(db, "SELECT * FROM jobs WHERE status = 0 ORDER BY priority ASC, id ASC LIMIT 1");
        if (rs == 0) { searching = 0; }
        elif (patra_result_count(rs) == 0) {
            patra_result_free(rs);
            searching = 0;
        } else {
            # SELECT * order: id(0), priority(1), payload(2), status(3), created_ns(4)
            var best_id  = patra_result_get_int(rs, 0, 0);
            var best_pri = patra_result_get_int(rs, 0, 1);

            # Copy payload BEFORE freeing the result set (result rows are
            # owned by the rs buffer).
            #
            # payload is a TEXT column since 2.6.9, so it is stored as a
            # (page, len) reference rather than inline. patra_result_get_str
            # would hand back a pointer to that REFERENCE STRUCT, and strlen
            # over it walks raw page-pointer bytes — a garbage length driving
            # a garbage memcpy. TEXT needs the length/read pair.
            # patra_result_get_text_len returns -1 when the column is NOT
            # TEXT — which is exactly what a .patra file written before 2.6.9
            # has, since the payload column was STR then. 2.6.9 clamped that
            # -1 to 0, so every job in an existing file dequeued with an EMPTY
            # payload and was still marked running: silent, total data loss on
            # upgrade, for the one file format majra promises to persist.
            # Fall back to the STR reader so old files keep working.
            var pay_len = patra_result_get_text_len(rs, 0, 2);
            var is_text = 1;
            if (pay_len < 0) {
                is_text = 0;
                var legacy = patra_result_get_str(rs, 0, 2);
                pay_len = 0;
                if (legacy != 0) { pay_len = strlen(legacy); }
            }
            var pay_copy = fl_alloc(pay_len + 1);
            if (pay_copy == 0) { patra_result_free(rs); searching = 0; }
            else {
                if (pay_len > 0) {
                    if (is_text == 1) {
                        if (patra_result_read_text(db, rs, 0, 2, pay_copy) != PATRA_OK) {
                            fl_free(pay_copy);
                            patra_result_free(rs);
                            mutex_unlock(mtx);
                            return 0;
                        }
                    } else {
                        memcpy(pay_copy, patra_result_get_str(rs, 0, 2), pay_len);
                    }
                }
                store8(pay_copy + pay_len, 0);
                patra_result_free(rs);

                var stmt = patra_prepare(db, "UPDATE jobs SET status = 1 WHERE id = ? AND status = 0");
                if (stmt == 0) { fl_free(pay_copy); searching = 0; }
                else {
                    patra_bind_int(stmt, 0, best_id);
                    var affected[8];
                    store64(&affected, 0);
                    var rc = patra_exec_returning(db, stmt, &affected);
                    patra_finalize(stmt);
                    if (rc != PATRA_OK) { fl_free(pay_copy); searching = 0; }
                    elif (load64(&affected) == 0) {
                        # Another consumer claimed it between our SELECT and
                        # our UPDATE. Drop this one and look again.
                        fl_free(pay_copy);
                    } else {
                        job = fl_alloc(32);
                        if (job == 0) { fl_free(pay_copy); }
                        else {
                            store64(job, best_id);
                            store64(job + 8, best_pri);
                            store64(job + 16, pay_copy);
                            store64(job + 24, 1);
                        }
                        searching = 0;
                    }
                }
            }
        }
    }
    mutex_unlock(mtx);
    return job;
}

# Release a job struct returned by patra_queue_dequeue.
fn patra_job_free(j) {
    if (j == 0) { return 0; }
    var p = load64(j + 16);
    if (p != 0) { fl_free(p); }
    fl_free(j);
    return 0;
}

# Returns 1 if a row moved, 0 otherwise. The patra_exec return used to be
# discarded here too, so a failed status update looked exactly like a
# successful one.
fn _pq_update_status(pq, id, new_status) {
    if (pq == 0) { return 0; }
    var db = load64(pq);
    var stmt = patra_prepare(db, "UPDATE jobs SET status = ? WHERE id = ?");
    if (stmt == 0) { return 0; }
    patra_bind_int(stmt, 0, new_status);
    patra_bind_int(stmt, 1, id);
    var affected[8];
    store64(&affected, 0);
    var rc = patra_exec_returning(db, stmt, &affected);
    patra_finalize(stmt);
    if (rc != PATRA_OK) { return 0; }
    if (load64(&affected) > 0) { return 1; }
    return 0;
}

fn patra_queue_complete(pq, id) { return _pq_update_status(pq, id, 2); }
fn patra_queue_fail(pq, id)     { return _pq_update_status(pq, id, 3); }

# Count rows matching a status, server-side. `SELECT COUNT(*) WHERE ...`
# returns a single-row aggregate; pull the integer out of column 0.
fn _pq_count_where_status(pq, status) {
    if (pq == 0) { return 0; }
    var stmt = patra_prepare(load64(pq), "SELECT COUNT(*) FROM jobs WHERE status = ?");
    if (stmt == 0) { return 0; }
    patra_bind_int(stmt, 0, status);
    var rs = patra_query_prepared(load64(pq), stmt);
    patra_finalize(stmt);
    if (rs == 0) { return 0; }
    var n = 0;
    if (patra_result_count(rs) > 0) {
        n = patra_result_get_int(rs, 0, 0);
    }
    patra_result_free(rs);
    return n;
}

fn patra_queue_queued_count(pq)   { return _pq_count_where_status(pq, 0); }
fn patra_queue_running_count(pq)  { return _pq_count_where_status(pq, 1); }
fn patra_queue_completed_count(pq){ return _pq_count_where_status(pq, 2); }

# Accessors for the dequeued-job struct
fn patra_job_id(j)       { return load64(j); }
fn patra_job_priority(j) { return load64(j + 8); }
fn patra_job_payload(j)  { return load64(j + 16); }
