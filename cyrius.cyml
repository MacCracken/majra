[package]
name = "majra"
version = "${file:VERSION}"
description = "Distributed queue & multiplex engine — pub/sub, queues, relay, IPC, heartbeat, rate limiting"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/majra"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/majra"

# `cyrius distlib [<profile>]` bundles these into dist/majra[-<profile>].cyr.
# Order must match src/main.cyr's include order (single-pass compiler).
[lib]
modules = [
    "src/error.cyr",
    "src/counter.cyr",
    "src/envelope.cyr",
    "src/namespace.cyr",
    "src/metrics.cyr",
    "src/ratelimit.cyr",
    "src/heartbeat.cyr",
    "src/queue.cyr",
    "src/pubsub.cyr",
    "src/relay.cyr",
    "src/barrier.cyr",
    "src/ipc.cyr",
    "src/transport.cyr",
    "src/fleet.cyr",
    "src/dag.cyr",
]

[lib.backends]
modules = [
    "src/error.cyr",
    "src/counter.cyr",
    "src/envelope.cyr",
    "src/signed_envelope.cyr",
    "src/namespace.cyr",
    "src/metrics.cyr",
    "src/ratelimit.cyr",
    "src/heartbeat.cyr",
    "src/queue.cyr",
    "src/pubsub.cyr",
    "src/relay.cyr",
    "src/barrier.cyr",
    "src/ipc.cyr",
    "src/transport.cyr",
    "src/fleet.cyr",
    "src/dag.cyr",
    "src/redis_backend.cyr",
    "src/postgres_backend.cyr",
    "src/ipc_encrypted.cyr",
    "src/ws.cyr",
    "src/admin.cyr",
    "src/patra_queue.cyr",
]

[lib.admin]
modules = [
    "src/error.cyr",
    "src/counter.cyr",
    "src/envelope.cyr",
    "src/namespace.cyr",
    "src/metrics.cyr",
    "src/ratelimit.cyr",
    "src/heartbeat.cyr",
    "src/queue.cyr",
    "src/pubsub.cyr",
    "src/relay.cyr",
    "src/barrier.cyr",
    "src/ipc.cyr",
    "src/transport.cyr",
    "src/fleet.cyr",
    "src/dag.cyr",
    "src/admin.cyr",
]

[lib.signed]
modules = [
    "src/error.cyr",
    "src/counter.cyr",
    "src/envelope.cyr",
    "src/signed_envelope.cyr",
    "src/namespace.cyr",
    "src/metrics.cyr",
    "src/ratelimit.cyr",
    "src/heartbeat.cyr",
    "src/queue.cyr",
    "src/pubsub.cyr",
    "src/relay.cyr",
    "src/barrier.cyr",
    "src/ipc.cyr",
    "src/transport.cyr",
    "src/fleet.cyr",
    "src/dag.cyr",
]

# Load-bearing: auto-prepended by plain build/audit/bench and mirrored into dist/*.deps.
# Folded modules (sigil, sakshi, …) go here — never as [deps.<name>] git blocks.
# Why: docs/development/dependency-watch.md.
[deps]
stdlib = [
    "assert",
    "alloc",
    "freelist",
    "vec",
    "str",
    "string",
    "fmt",
    "syscalls",
    "hashmap",
    "tagged",
    "fnptr",
    "thread",
    "io",
    "chrono",
    "random",
    "net",
    "bench",
    "fs",
    "patra",
    "tls",
    "dynlib",
    "fdlopen",
    "async",
    "sandhi",
    "sakshi",
    "sys",
    "sigil",
]
