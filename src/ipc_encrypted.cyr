# majra/ipc_encrypted — AES-256-GCM encrypted IPC channel
#
# Wraps ipc.cyr with symmetric encryption using a pre-shared 256-bit key.
# Each frame on the wire: [4B ipc length] [12B nonce] [N bytes ciphertext] [16B tag]
#
# Crypto is provided by sigil (see lib/sigil.cyr): aes_gcm_encrypt /
# aes_gcm_decrypt with the 96-bit-IV fast path. Constant-time tag
# verification, key zeroization, and the full FIPS-197 AES-256
# block cipher live in sigil — this module owns framing, nonce
# management, rekey policy, and connection lifecycle.

# --- AES-256-GCM constants ---
var AES_BLOCK_SIZE = 16;
var AES_256_KEY_SIZE = 32;
var AES_GCM_TAG_SIZE = 16;
var AES_GCM_NONCE_SIZE = 12;
# Per-key FRAME limits: warn at 2^31, hard-fail at 2^32. The counter occupies
# nonce bytes 8-11, so 2^32 is also where it would stop fitting.
var NONCE_WARN_THRESHOLD = 2147483648;
var NONCE_HARD_LIMIT = 4294967296;
# Per-key VOLUME limits, counted in encrypted bytes (payload + one tag block per
# frame). A frame count alone let 1 MiB frames reach ~2^48 AES blocks under one
# key — far past the AEAD usage limits (SP 800-38D; draft-irtf-cfrg-aead-limits:
# confidentiality advantage ~ blocks^2 / 2^129). Warn at 2^34 blocks (2^38
# bytes), hard-fail at 2^36 blocks (2^40 bytes). Whichever limit trips first wins.
var _EIPC_VOLUME_WARN_BYTES = 274877906944;
var _EIPC_VOLUME_HARD_BYTES = 1099511627776;

# --- Base64 helpers ---
# Kept here (not moved to lib/base64.cyr) because ws.cyr's WebSocket
# accept-key path depends on majra_base64_encode being in scope via the
# include order established by tests/test_backends.tcyr. Trim carefully.
#
# The `majra_` prefix is load-bearing: lib/bayan.cyr also defines
# `base64_encode` / `base64_decode` (thin wrappers over `bayan_base64_*`)
# and the return contracts disagree — bayan's decode returns a scalar
# i64, ours returns a 16-byte {ptr, len} struct. Unprefixed, whichever
# definition the consumer's include order puts last silently wins, so a
# bayan-last consumer would have our own decode path misread the return
# value. Do not drop the prefix.

var _b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn _b64_encode_byte(idx) {
    return load8(_b64_chars + (idx & 63));
}

# Returns the 6-bit value for a base64 character, or -1 if `ch` is outside the
# alphabet. This used to fold every invalid byte to 0 — the value of 'A' — so
# corrupt or hostile input decoded silently to plausible-looking plaintext
# instead of being rejected.
#
# '=' is -1 here too: padding is positional, so majra_base64_decode handles it
# explicitly. Mapping it to 0 let '=' through in ANY position.
fn _b64_decode_byte(ch) {
    if (ch >= 65 && ch <= 90) { return ch - 65; }
    if (ch >= 97 && ch <= 122) { return ch - 97 + 26; }
    if (ch >= 48 && ch <= 57) { return ch - 48 + 52; }
    if (ch == 43) { return 62; }
    if (ch == 47) { return 63; }
    return -1;
}

fn majra_base64_encode(data, len) {
    var out_len = ((len + 2) / 3) * 4;
    var out = fl_alloc(out_len + 1);
    var si = 0;
    var di = 0;
    while (si < len) {
        var b0 = load8(data + si);
        var b1 = 0;
        var b2 = 0;
        if (si + 1 < len) { b1 = load8(data + si + 1); }
        if (si + 2 < len) { b2 = load8(data + si + 2); }
        var triple = (b0 << 16) | (b1 << 8) | b2;
        store8(out + di, _b64_encode_byte(triple >> 18));
        store8(out + di + 1, _b64_encode_byte(triple >> 12));
        if (si + 1 < len) {
            store8(out + di + 2, _b64_encode_byte(triple >> 6));
        } else {
            store8(out + di + 2, 61);
        }
        if (si + 2 < len) {
            store8(out + di + 3, _b64_encode_byte(triple));
        } else {
            store8(out + di + 3, 61);
        }
        si = si + 3;
        di = di + 4;
    }
    store8(out + di, 0);
    return out;
}

fn majra_base64_decode(data, len) {
    # The loop consumes four input bytes per iteration while the output was
    # sized len/4*3, so a length that is not a multiple of 4 read past the end
    # of `data` AND wrote past the end of `out` on the final iteration.
    # Base64 is always a multiple of 4; anything else is malformed.
    if (len <= 0) { return 0; }
    if (len % 4 != 0) { return 0; }
    var out_len = len / 4 * 3;
    var out = fl_alloc(out_len + 1);
    if (out == 0) { return 0; }
    # ⚠ '=' is legal ONLY in the final quantum, as "xx==" or "xxx=". This used
    # to accept it anywhere and simply skip writing the padded output bytes, so
    # "AA==AAAA" returned 6 bytes of which 2 were never written — stale heap
    # (fl_alloc does not zero a recycled block) handed back as decoded data.
    memset(out, 0, out_len + 1);
    var si = 0;
    var di = 0;
    while (si < len) {
        var pad = 0;
        if (load8(data + si + 3) == 61) {
            if (si + 4 != len) { fl_free(out); return 0; }
            pad = 1;
            if (load8(data + si + 2) == 61) { pad = 2; }
        }
        var a = _b64_decode_byte(load8(data + si));
        var b = _b64_decode_byte(load8(data + si + 1));
        var c = 0;
        var d = 0;
        if (pad < 2) { c = _b64_decode_byte(load8(data + si + 2)); }
        if (pad < 1) { d = _b64_decode_byte(load8(data + si + 3)); }
        if (a < 0 || b < 0 || c < 0 || d < 0) { fl_free(out); return 0; }
        var triple = (a << 18) | (b << 12) | (c << 6) | d;
        store8(out + di, (triple >> 16) & 0xFF);
        if (pad < 2) { store8(out + di + 1, (triple >> 8) & 0xFF); }
        if (pad < 1) { store8(out + di + 2, triple & 0xFF); }
        si = si + 4;
        di = di + 3 - pad;
    }
    store8(out + di, 0);
    var result = fl_alloc(16);
    store64(result, out);
    store64(result + 8, di);
    return result;
}

# --- EncryptedIpcConnection ---

# Roles. BOTH ENDPOINTS OF A CHANNEL MUST PASS DIFFERENT ONES.
var ENCRYPTED_IPC_INITIATOR = 0;
var ENCRYPTED_IPC_RESPONDER = 1;

# EncryptedIpc struct (72 bytes):
#   offset  0: ipc_fd (i64) — underlying IPC file descriptor
#   offset  8: key (i64) — ptr to the key block; its first 32 bytes are the key
#   offset 16: send_counter (i64) — nonce counter
#   offset 24: mutex (i64) — the send mutex
#   offset 32: needs_rekey (i64) — 0 or 1
#   offset 40: role (i64) — ENCRYPTED_IPC_INITIATOR | ENCRYPTED_IPC_RESPONDER
#   offset 48: peer_counter (i64) — highest peer counter accepted, -1 initially
#   offset 56: closed (i64) — 1 once encrypted_ipc_close or a fatal recv ran
#   offset 64: recv_mutex (i64) — guards the receive half INDEPENDENTLY
#
# Key block (_EIPC_KBLK_SIZE bytes, private — not part of the layout above):
#   +0  : 32-byte AES-256 key
#   +32 : nonce salt for this key epoch (see _write_nonce_salted)
#   +40 : bytes encrypted under this key (volume limit)
#   +48 : key lock (mutex) — guards the key bytes and peer_counter
#   +56 : scratch for a salt being drawn
#
# ⚠ THREE locks, deliberately. The send mutex serialises the nonce counter and
# write ordering; the recv mutex serialises read ordering and is held across
# ipc_recv_frame — a BLOCKING read(2). 2.6.9 put both halves under one mutex, so
# a receiver parked on a silent peer blocked every send: for request/response a
# self-deadlock. 2.6.10 split them but still had rekey and close take the recv
# mutex, which recreated the same wedge through those two calls. So: rekey takes
# send + key lock and NEVER the recv mutex; recv takes the key lock only around
# the replay check and decrypt, never across I/O; close shuts the socket down
# (waking the parked reader) before it takes the recv mutex. Lock order is
# send -> key, recv -> key, send -> recv; nothing takes them the other way.
#
# ⚠ THE ROLE ARGUMENT IS LOAD-BEARING AES-GCM SAFETY, NOT BOOKKEEPING.
#
# Both endpoints share ONE pre-shared key. Before 2.6.9 each endpoint derived
# nonces from its own counter starting at 0, with nothing in the 12-byte nonce
# distinguishing the two directions — so the very first message each way used
# byte-identical (key, nonce). Under AES-GCM that is catastrophic: the
# keystreams are identical, so XORing the two ciphertexts yields the XOR of the
# two plaintexts, and a nonce collision also leaks the GHASH subkey, which lets
# an attacker forge tags for arbitrary messages. Every message pair at the same
# counter collided, not just the first.
#
# The role now occupies nonce byte 0, so the two directions occupy disjoint
# nonce spaces under the same key. A random per-handle salt (bytes 1-7) keeps
# separate CONNECTIONS under one PSK apart too — see _write_nonce_salted.
#
# ⚠ REPLAY PROTECTION IS PER HANDLE AND PER KEY EPOCH. A fresh handle starts its
# window at -1, so frames recorded from one connection are accepted by a new
# connection under the same key. Closing that needs a per-session key agreed in
# a handshake, which is a wire-format change. Until then, give each connection
# its own key wherever cross-connection replay matters.
# Key block layout. Through 2.8.2 this held the working key, the nonce salt and
# the counters; 2.9.0 appends the session handshake state.
#   +0   working (session) key, 32 B — what AES-GCM uses
#   +32  nonce salt (8 B), +40 bytes encrypted, +48 key mutex, +56 salt scratch
#   +64  the caller's pre-shared key, 32 B — the HKDF input keying material
#   +96  this handle's 16-byte handshake salt
#   +112 the peer's 16-byte handshake salt
#   +128 handshake state: 0 = own hello not written yet, 1 = hello written,
#        2 = peer hello read and session key derived
var _EIPC_KBLK_SIZE = 136;

# Session handshake (2.9.0).
#
# ⚠ WIRE BREAK. Each side writes a 32-byte hello at construction and derives a
# per-connection key from BOTH salts, so a frame captured on one connection no
# longer decrypts on any later one under the same PSK — the cross-connection
# replay the 2.8.1 audit confirmed and could not fix inside a PATCH. A 2.9.0
# peer cannot talk to a 2.8.x peer: the hello arrives where 2.8.x expects a
# frame header. Both ends upgrade together.
#
# hello = "MJEIPCv1" (8) | role (1) | 7 zero bytes | salt (16)
var _EIPC_HELLO_MAGIC = "MJEIPCv1";
var _EIPC_HELLO_LEN = 32;
var _EIPC_HS_INFO = "majra-eipc-session-v1";

# Draw `n` bytes of CSPRNG into `dst`. Fails closed: a predictable salt is the
# (key, nonce) reuse this exists to prevent.
fn _eipc_draw_bytes(dst, n) {
    var got = 0;
    var attempts = 0;
    while (got < n && attempts < 8) {
        var r = sys_getrandom(dst + got, n - got, 0);
        if (r > 0) { got = got + r; }
        attempts = attempts + 1;
    }
    if (got < n) { return -1; }
    return 0;
}

# Write this handle's hello. Called once, from encrypted_ipc_new, before any
# frame: 32 bytes into a fresh socket never block in practice, and deferring
# the PEER hello to first use keeps construction I/O-free in the other
# direction (so both ends of a socketpair can be built in one thread).
fn _eipc_send_hello(fd, role, salt16) {
    var hello[32];
    memcpy(&hello, _EIPC_HELLO_MAGIC, 8);
    store8(&hello + 8, role);
    var i = 9;
    while (i < 16) { store8(&hello + i, 0); i = i + 1; }
    memcpy(&hello + 16, salt16, 16);
    if (_ipc_write_full(fd, &hello, _EIPC_HELLO_LEN) < 0) { return -1; }
    return 0;
}

# Read the peer hello and derive the session key. Caller holds the key mutex.
# Returns 0 on success, -1 on a malformed/absent hello or a role clash.
fn _eipc_derive_session(e) {
    var blk = load64(e + 8);
    if (load64(blk + 128) == 2) { return 0; }
    # The hello is written at construction; retry here if that write failed
    # (a handle built on a descriptor that was not yet a socket, say).
    if (load64(blk + 128) == 0) {
        if (_eipc_send_hello(load64(e), load64(e + 40), blk + 96) != 0) { return -1; }
        store64(blk + 128, 1);
    }
    var hello[32];
    if (_ipc_read_full(load64(e), &hello, _EIPC_HELLO_LEN) < 0) { return -1; }
    if (memeq(&hello, _EIPC_HELLO_MAGIC, 8) != 1) { return -1; }
    var own_role = load64(e + 40);
    # Both ends built with the same role would collide their nonce spaces. The
    # clash is caught HERE now, before a single frame goes out (2.9.0); -2 so
    # the caller can report MAJRA_ERR_IPC_ROLE rather than a generic failure.
    if (load8(&hello + 8) == own_role) { return 0 - 2; }
    if (load8(&hello + 8) != 1 - own_role) { return -1; }
    memcpy(blk + 112, &hello + 16, 16);

    # salt = initiator salt || responder salt, so both ends feed HKDF the same
    # 32 bytes regardless of which side derives first (see _eipc_derive_key).
    if (_eipc_derive_key(e) != 0) { return -1; }
    store64(blk + 128, 2);
    return 0;
}

# Derive the working key from the PSK and the two exchanged salts. Called once
# per handshake and again on every rekey — a rekey changes the input keying
# material, not the salts, so it needs NO second exchange (2.9.0). That matters
# for more than tidiness: a reader parked in read(2) owns the receive side, so
# a rekey that tried to read a hello from the send path would deadlock against
# it.
fn _eipc_derive_key(e) {
    var blk = load64(e + 8);
    var salt[32];
    if (load64(e + 40) == ENCRYPTED_IPC_INITIATOR) {
        memcpy(&salt, blk + 96, 16);
        memcpy(&salt + 16, blk + 112, 16);
    } else {
        memcpy(&salt, blk + 112, 16);
        memcpy(&salt + 16, blk + 96, 16);
    }
    return hkdf(&salt, 32, blk + 64, 32, _EIPC_HS_INFO, strlen(_EIPC_HS_INFO), blk, 32);
}

# Ensure the session key exists. Takes the key mutex itself, so exactly one
# caller consumes the 32 hello bytes and no frame read can interleave with it.
fn _eipc_ensure_session(e) {
    var blk = load64(e + 8);
    if (load64(blk + 128) == 2) { return 0; }
    var kmtx = load64(blk + 48);
    mutex_lock(kmtx);
    var rc = _eipc_derive_session(e);
    mutex_unlock(kmtx);
    if (rc != 0) { _encrypted_ipc_kill(e); }
    return rc;
}
# Salt bits: nonce bytes 1-7, with byte 4's top bit clear so the receiver's
# 64-bit view of bytes 4-11 stays positive.
var _EIPC_SALT_MASK = 0x00FFFFFF7FFFFFFF;

# Draw a fresh salt from the kernel CSPRNG into the key block's scratch slot.
# Returns 0, or -1 when entropy is unavailable — callers FAIL CLOSED, because a
# predictable salt is exactly the (key, nonce) reuse it exists to prevent.
fn _eipc_draw_salt(blk) {
    store64(blk + 56, 0);
    var got = 0;
    var attempts = 0;
    while (got < 8 && attempts < 8) {
        var n = sys_getrandom(blk + 56 + got, 8 - got, 0);
        if (n > 0) { got = got + n; }
        attempts = attempts + 1;
    }
    if (got < 8) { store64(blk + 56, 0); return -1; }
    store64(blk + 56, load64(blk + 56) & _EIPC_SALT_MASK);
    return 0;
}

fn encrypted_ipc_new(ipc_fd, key_ptr, role) {
    if (role != ENCRYPTED_IPC_INITIATOR && role != ENCRYPTED_IPC_RESPONDER) { return 0; }
    aes_gcm_global_init();
    var e = fl_alloc(72);
    if (e == 0) { return 0; }
    var blk = fl_alloc(_EIPC_KBLK_SIZE);
    if (blk == 0) { fl_free(e); return 0; }
    memset(blk, 0, _EIPC_KBLK_SIZE);
    if (_eipc_draw_salt(blk) != 0) { fl_free(blk); fl_free(e); return 0; }
    # The PSK is the HKDF input now, not the working key: the working key at
    # +0 stays zero until the handshake derives it (2.9.0).
    memcpy(blk + 64, key_ptr, 32);
    if (_eipc_draw_bytes(blk + 96, 16) != 0) { fl_free(blk); fl_free(e); return 0; }
    store64(blk + 32, load64(blk + 56));
    store64(blk + 56, 0);
    store64(blk + 48, mutex_new());
    # A failed hello here is not fatal: the handle may be an accessor-only one
    # (no socket behind it yet), and the first send/recv retries the write.
    store64(blk + 128, 0);
    if (_eipc_send_hello(ipc_fd, role, blk + 96) == 0) { store64(blk + 128, 1); }
    store64(e, ipc_fd);
    store64(e + 8, blk);
    store64(e + 16, 0);
    store64(e + 24, mutex_new());
    store64(e + 32, 0);
    store64(e + 40, role);
    store64(e + 48, -1);
    store64(e + 56, 0);
    store64(e + 64, mutex_new());
    return e;
}

fn encrypted_ipc_role(e) { return load64(e + 40); }

# Write a 12-byte nonce for (role, counter) into `out` — the unsalted layout.
#   byte  0   : role — separates the two directions' nonce spaces
#   bytes 1-3 : zero
#   bytes 4-11: big-endian counter
fn _write_nonce(out, role, counter) {
    memset(out, 0, 12);
    store8(out, role & 0xFF);
    store8(out + 4, (counter >> 56) & 0xFF);
    store8(out + 5, (counter >> 48) & 0xFF);
    store8(out + 6, (counter >> 40) & 0xFF);
    store8(out + 7, (counter >> 32) & 0xFF);
    store8(out + 8, (counter >> 24) & 0xFF);
    store8(out + 9, (counter >> 16) & 0xFF);
    store8(out + 10, (counter >> 8) & 0xFF);
    store8(out + 11, counter & 0xFF);
    return 0;
}

# The nonce encrypted_ipc_send actually emits:
#   byte  0    : role
#   bytes 1-7  : salt (_EIPC_SALT_MASK bits) — random per handle and per rekey
#   bytes 8-11 : big-endian counter (< 2^32 by NONCE_HARD_LIMIT)
#
# ⚠ Unsalted, every connection under one PSK restarted at (role, 0), so a
# reconnect or a second client reused (key, nonce) — identical keystream and a
# GHASH-subkey leak that forges tags for every later session under that key.
# Redrawing on rekey also stops a rekey BACK to an earlier key (A -> B -> A)
# recreating a nonce already used under it. Wire-compatible: receivers check
# byte 0 and read bytes 4-11 as the counter, which the constant salt keeps
# strictly increasing within a key epoch.
fn _write_nonce_salted(out, role, salt, counter) {
    _write_nonce(out, role, counter & 0xFFFFFFFF);
    store8(out + 1, (salt >> 48) & 0xFF);
    store8(out + 2, (salt >> 40) & 0xFF);
    store8(out + 3, (salt >> 32) & 0xFF);
    store8(out + 4, (salt >> 24) & 0xFF);
    store8(out + 5, (salt >> 16) & 0xFF);
    store8(out + 6, (salt >> 8) & 0xFF);
    store8(out + 7, salt & 0xFF);
    return 0;
}

# Claim the next send counter. Caller must hold the mutex.
# Returns the counter, or -1 when the hard limit is reached.
#
# The counter is only consumed on success now; it used to be incremented
# before the limit check, so every refused call still advanced it and
# encrypted_ipc_messages_sent over-reported past the limit.
fn _next_counter(e) {
    var counter = load64(e + 16);
    if (counter >= NONCE_HARD_LIMIT) { return -1; }
    store64(e + 16, counter + 1);
    if (counter >= NONCE_WARN_THRESHOLD) {
        store64(e + 32, 1);
    }
    return counter;
}

fn encrypted_ipc_messages_sent(e) {
    return load64(e + 16);
}

fn encrypted_ipc_needs_rekey(e) {
    return load64(e + 32);
}

# Install a new 32-byte key and restart the nonce sequence under a fresh salt.
#
# Returns Ok(0), or Err(MAJRA_ERR_IPC) if the new key is byte-identical to the
# installed one, the handle is closed, or no entropy is available for the salt.
# The identical-key check is load-bearing: re-installing the same key restarts
# the counter under it, and "rekey with the key I already have" is an easy
# caller mistake on a reconnect path. The salt redraw covers the earlier-key case.
fn encrypted_ipc_rekey(e, new_key_ptr) {
    if (e == 0 || new_key_ptr == 0) { return Err(MAJRA_ERR_IPC); }
    # Send mutex + key lock — NEVER the recv mutex (see the struct note).
    var mtx = load64(e + 24);
    mutex_lock(mtx);
    var blk = load64(e + 8);
    if (load64(e + 56) == 1 || blk == 0) {
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    # Compare against the PRE-SHARED key at +64, not the derived session key at
    # +0 (2.9.0): resetting the counter is safe only because the input keying
    # material changed.
    if (ct_eq_bytes_lens(blk + 64, AES_256_KEY_SIZE, new_key_ptr, AES_256_KEY_SIZE) == 1) {
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    if (_eipc_draw_salt(blk) != 0) {
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    var kmtx = load64(blk + 48);
    mutex_lock(kmtx);
    # 2.9.0: a rekey is a fresh handshake. The new PSK goes in, a new salt is
    # drawn and announced, and the session key is re-derived from both sides'
    # new salts on the next send or recv. Both peers rekey in lockstep, as they
    # always had to — each one's hello is waiting for the other.
    # 2.9.0: install the new PSK and re-derive over the salts this connection
    # already exchanged. No second hello — see _eipc_derive_key.
    memcpy(blk + 64, new_key_ptr, 32);
    if (load64(blk + 128) == 2) {
        if (_eipc_derive_key(e) != 0) {
            mutex_unlock(kmtx);
            mutex_unlock(mtx);
            return Err(MAJRA_ERR_IPC);
        }
    } else {
        memset(blk, 0, 32);
    }
    store64(blk + 32, load64(blk + 56));
    store64(blk + 56, 0);
    store64(blk + 40, 0);
    store64(e + 16, 0);
    store64(e + 32, 0);
    # The peer restarts its counter too, so the replay window must reopen or
    # every post-rekey frame would look like a replay.
    store64(e + 48, -1);
    mutex_unlock(kmtx);
    mutex_unlock(mtx);
    return Ok(0);
}

# --- Encrypt / Decrypt ---
# Wire format: [12B nonce] [N bytes ciphertext] [16B tag]
# aes_gcm_encrypt / aes_gcm_decrypt from sigil produce the ciphertext
# and tag separately; we concatenate them into the frame.

fn encrypted_ipc_send(e, data, len) {
    if (e == 0 || len < 0) { return Err(MAJRA_ERR_IPC); }
    var mtx = load64(e + 24);
    mutex_lock(mtx);
    var blk = load64(e + 8);
    if (load64(e + 56) == 1 || blk == 0) { mutex_unlock(mtx); return Err(MAJRA_ERR_IPC); }
    # 2.9.0: no frame goes out before the session key exists.
    var hs = _eipc_ensure_session(e);
    if (hs != 0) {
        mutex_unlock(mtx);
        if (hs == 0 - 2) { return Err(MAJRA_ERR_IPC_ROLE); }
        return Err(MAJRA_ERR_IPC);
    }

    var used = load64(blk + 40) + len + AES_BLOCK_SIZE;
    if (used > _EIPC_VOLUME_HARD_BYTES) { mutex_unlock(mtx); return Err(MAJRA_ERR_IPC); }
    var counter = _next_counter(e);
    if (counter < 0) {
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    var nonce[12];
    _write_nonce_salted(&nonce, load64(e + 40), load64(blk + 32), counter);

    var frame_len = AES_GCM_NONCE_SIZE + len + AES_GCM_TAG_SIZE;
    var frame = fl_alloc(frame_len);
    if (frame == 0) { mutex_unlock(mtx); return Err(MAJRA_ERR_IPC); }
    memcpy(frame, &nonce, AES_GCM_NONCE_SIZE);
    var ct_out = frame + AES_GCM_NONCE_SIZE;
    var tag_out = frame + AES_GCM_NONCE_SIZE + len;
    var erc = aes_gcm_encrypt(blk, &nonce, 0, 0, data, len, ct_out, tag_out);
    if (erc != 0) {
        # Discarding this used to mean a sigil-side validation failure left
        # ct_out/tag_out untouched and majra transmitted the frame anyway.
        memset(frame, 0, frame_len);
        fl_free(frame);
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    # The keystream is spent once encryption ran, whether or not the write lands.
    store64(blk + 40, used);
    if (used >= _EIPC_VOLUME_WARN_BYTES) { store64(e + 32, 1); }

    # The write stays UNDER the mutex. Releasing it first let two threads
    # sharing one connection interleave ipc_send_frame's 4-byte header and its
    # payload, so the peer read a header from one message and a body from
    # another — the stream never resynchronises.
    var rc_t, rc_v = ipc_send_frame(load64(e), frame, frame_len);
    fl_free(frame);
    mutex_unlock(mtx);
    if (is_err_result(rc_t) == 1) { return Err(rc_v); }
    return Ok(rc_v);
}

# Tear down a connection whose framing or peer can no longer be trusted.
# Caller must hold the recv mutex.
#
# ⚠ shutdown(2), NOT close(2). This runs without the send mutex, so a concurrent
# encrypted_ipc_send may already hold the fd number and be blocked mid-write —
# timing a hostile peer controls. close() freed the number for the next
# open/accept anywhere in the process, and the stalled write then delivered the
# frame body into that unrelated descriptor. shutdown fails the in-flight and
# every later write (EPIPE; no SIGPIPE, see _ipc_write_full) while the number
# stays allocated. encrypted_ipc_close, holding both mutexes, does the close(2)
# and wipes the key.
fn _encrypted_ipc_kill(e) {
    if (load64(e + 56) == 1) { return 0; }
    store64(e + 56, 1);
    _ipc_shutdown(load64(e));
    return 0;
}

fn encrypted_ipc_recv(e) {
    if (e == 0) { return Err(MAJRA_ERR_IPC); }
    # The RECEIVE mutex — never the send mutex. See the struct note.
    var mtx = load64(e + 64);
    mutex_lock(mtx);
    if (load64(e + 56) == 1) { mutex_unlock(mtx); return Err(MAJRA_ERR_IPC); }
    # 2.9.0: consume the peer hello before the first frame read, so the two
    # never interleave on the socket.
    var rhs = _eipc_ensure_session(e);
    if (rhs != 0) {
        mutex_unlock(mtx);
        if (rhs == 0 - 2) { return Err(MAJRA_ERR_IPC_ROLE); }
        return Err(MAJRA_ERR_IPC);
    }

    var frame_t, frame_v = ipc_recv_frame(load64(e));
    if (is_err_result(frame_t) == 1) {
        # MAJRA_ERR_IPC_FRAME_TOO_LARGE is terminal: the oversized body is still
        # queued, so the framing can never resynchronise. Poison the handle and
        # shut the socket down; the caller's encrypted_ipc_close releases it.
        if (err_code_of(frame_t, frame_v) == MAJRA_ERR_IPC_FRAME_TOO_LARGE) {
            _encrypted_ipc_kill(e);
        }
        mutex_unlock(mtx);
        return Err(frame_v);
    }
    var frame_ptr = frame_v;
    var raw = load64(frame_ptr + 8);
    var raw_len = load64(frame_ptr);
    if (raw_len < AES_GCM_NONCE_SIZE + AES_GCM_TAG_SIZE) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    var nonce = raw;

    # Holding the recv mutex keeps encrypted_ipc_close from freeing the key
    # block; the key lock keeps a concurrent rekey out of the key and window.
    var blk = load64(e + 8);
    var kmtx = load64(blk + 48);
    mutex_lock(kmtx);
    # close sets `closed` and shuts the socket down BEFORE it can take the recv
    # mutex, so a frame that arrived in that window must not be delivered.
    if (load64(e + 56) == 1) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(kmtx);
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }

    # --- Direction + replay checks, BEFORE spending a decryption ---
    #
    # AEAD gives integrity, not freshness: a captured frame replays and
    # decrypts cleanly forever. The peer's counter must strictly increase, and
    # its nonce must carry the peer's role — otherwise an attacker could
    # reflect our own frames back at us and they would authenticate.
    var own_role = load64(e + 40);
    if (load8(nonce) != 1 - own_role) {
        # ⚠ Our OWN role on an inbound frame means both endpoints were built with
        # the same role — every counter then collides across the two directions
        # under one key — or a reflection. Dropping just the frame kept both
        # sides sending colliding nonces, so tear the connection down.
        var role_err = MAJRA_ERR_IPC;
        if (load8(nonce) == own_role) {
            _encrypted_ipc_kill(e);
            # 2.9.0: its own code, so a caller can tell a misconfigured peer
            # (both ends built with the same role) from ordinary frame trouble.
            role_err = MAJRA_ERR_IPC_ROLE;
        }
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(kmtx);
        mutex_unlock(mtx);
        return Err(role_err);
    }
    var seen = (load8(nonce + 4) << 56) | (load8(nonce + 5) << 48)
    | (load8(nonce + 6) << 40) | (load8(nonce + 7) << 32)
    | (load8(nonce + 8) << 24) | (load8(nonce + 9) << 16)
    | (load8(nonce + 10) << 8) | load8(nonce + 11);
    if (seen <= load64(e + 48)) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(kmtx);
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }

    var ct = raw + AES_GCM_NONCE_SIZE;
    var ct_len = raw_len - AES_GCM_NONCE_SIZE - AES_GCM_TAG_SIZE;
    var tag = raw + AES_GCM_NONCE_SIZE + ct_len;
    var pt = fl_alloc(ct_len + 1);
    if (pt == 0) {
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(kmtx);
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    var rc = aes_gcm_decrypt(blk, nonce, 0, 0, ct, ct_len, tag, pt);
    if (rc != 0) {
        # Tag mismatch — AEAD contract says do NOT leak plaintext.
        # aes_gcm_decrypt already zeroes pt on failure, but belt-and-braces:
        memset(pt, 0, ct_len);
        fl_free(pt);
        fl_free(raw);
        fl_free(frame_ptr);
        mutex_unlock(kmtx);
        mutex_unlock(mtx);
        return Err(MAJRA_ERR_IPC);
    }
    # Only advance the replay window once the tag has authenticated the frame,
    # so a forged nonce cannot burn counters and lock out the real peer.
    store64(e + 48, seen);
    mutex_unlock(kmtx);
    store8(pt + ct_len, 0);

    fl_free(raw);
    fl_free(frame_ptr);
    mutex_unlock(mtx);

    var result = fl_alloc(16);
    store64(result, ct_len);
    store64(result + 8, pt);
    return Ok(result);
}

# Release a payload returned by encrypted_ipc_recv.
fn encrypted_ipc_payload_free(r) {
    if (r == 0) { return 0; }
    var p = load64(r + 8);
    if (p != 0) {
        memset(p, 0, load64(r));
        fl_free(p);
    }
    fl_free(r);
    return 0;
}

fn encrypted_ipc_close(e) {
    if (e == 0) { return 0; }
    var mtx = load64(e + 24);
    var rmtx = load64(e + 64);
    mutex_lock(mtx);
    store64(e + 56, 1);
    # ⚠ Shut down BEFORE taking the recv mutex. encrypted_ipc_recv holds that
    # mutex across a blocking read(2); locking it first meant closing a handle
    # whose reader waited on a silent peer — the usual way to unblock that
    # reader — blocked forever while holding the send mutex. shutdown makes the
    # parked read return, and the reader releases the lock.
    _ipc_shutdown(load64(e));
    mutex_lock(rmtx);
    # ⚠ No early return on `closed`: _encrypted_ipc_kill sets it but leaves the
    # key and the fd, and returning here left the PSK copy in cleartext on the
    # heap for the life of the process. The two checks below make close
    # idempotent. Zeroize the key block, then actually release it — a post-close
    # send used to encrypt under an all-zero key and ship it.
    var blk = load64(e + 8);
    if (blk != 0) {
        memset(blk, 0, _EIPC_KBLK_SIZE);
        fl_free(blk);
        store64(e + 8, 0);
    }
    var fd = load64(e);
    if (fd >= 0) { ipc_close(fd); }
    store64(e, -1);
    mutex_unlock(rmtx);
    mutex_unlock(mtx);
    return 0;
}

# Release the EncryptedIpc handle itself. Call AFTER encrypted_ipc_close —
# 2.6.9's close freed the key and closed the fd but never released the struct,
# and exported no teardown that did.
fn encrypted_ipc_free(e) {
    if (e == 0) { return 0; }
    fl_free(e);
    return 0;
}
