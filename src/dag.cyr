# majra/dag — DAG workflow engine with dependency-tier scheduling
#
# Replaces Rust's WorkflowEngine, WorkflowDefinition, WorkflowRun, etc.
# Steps are grouped into dependency tiers. Within a tier they run serially by
# default, or in bounded batches of detached worker threads when opted in via
# workflow_def_set_parallel. See the note on workflow_execute.

# Workflow step status
enum StepStatus {
    STEP_PENDING = 0;
    STEP_RUNNING = 1;
    STEP_COMPLETED = 2;
    STEP_FAILED = 3;
    STEP_SKIPPED = 4;
}

# Workflow run status
enum RunStatus {
    RUN_PENDING = 0;
    RUN_RUNNING = 1;
    RUN_COMPLETED = 2;
    RUN_FAILED = 3;
    RUN_CANCELLED = 4;
}

# Error policies
enum ErrorPolicy {
    POLICY_FAIL = 0;
    POLICY_CONTINUE = 1;
    POLICY_SKIP = 2;
}

# Trigger modes
enum TriggerMode {
    TRIGGER_ALL = 0;
    TRIGGER_ANY = 1;
}

# WorkflowStep struct (48 bytes):
#   offset  0: id (i64) — C string
#   offset  8: name (i64) — C string
#   offset 16: depends_on (i64) — vec of step id strings
#   offset 24: trigger_mode (i64) — TRIGGER_ALL or TRIGGER_ANY
#   offset 32: error_policy (i64)
#   offset 40: retry_max (i64)

fn workflow_step_new(id, name) {
    var s = fl_alloc(48);
    store64(s, id);
    store64(s + 8, name);
    store64(s + 16, vec_new());
    store64(s + 24, TRIGGER_ALL);
    store64(s + 32, POLICY_FAIL);
    store64(s + 40, 0);
    return s;
}

fn step_add_dep(step, dep_id) {
    vec_push(load64(step + 16), dep_id);
}

fn step_set_retry(step, max_retries) {
    store64(step + 40, max_retries);
}

fn step_set_error_policy(step, policy) {
    store64(step + 32, policy);
}

fn step_set_trigger_mode(step, mode) {
    store64(step + 24, mode);
}

# WorkflowDefinition struct (32 bytes):
#   offset  0: id (i64) — C string
#   offset  8: name (i64) — C string
#   offset 16: steps (i64) — vec of WorkflowStep ptrs
#   offset 24: enabled (i64) — 0 or 1

fn workflow_def_new(id, name) {
    var d = fl_alloc(40);
    store64(d, id);
    store64(d + 8, name);
    store64(d + 16, vec_new());
    store64(d + 24, 1);
    store64(d + 32, 1);
    return d;
}

# Run up to `max_parallel` steps of a tier concurrently. 1 (the default) is
# serial. Returns the value actually stored.
#
# ⚠ MEASURE BEFORE ENABLING THIS. Each parallel step pays for a detached worker
# thread: **~50us** per step at 2.8.1 on an 8-wide batch (it was ~89us for
# `thread_create` + `thread_join` when this note was first written; detached
# spawns cost ~14us more than joined ones on the same host, the price of not
# leaking ~4.1 KB of heap per step). A CPU-bound step body costs well under a
# microsecond. The break-even is a step that takes roughly as long as the spawn;
# below that, parallel tiers are dramatically SLOWER than serial ones, which is
# why the default is 1 and why majra will not choose for you.
#
#   step ~10ms (an HTTP call, a query)  -> ~0.5% overhead, a large win
#   step ~50-100us                      -> roughly break-even
#   step ~1us (pure computation)        -> catastrophic; leave it serial
#
# ⚠ YOUR EXECUTOR MUST BE THREAD-SAFE. It is called from several threads at
# once, and majra cannot check that.
#
# ⚠ POLICY_FAIL is weaker under parallelism. Serially, a POLICY_FAIL step
# aborts the run before its later tier-mates start. In a parallel batch the
# rest of the CURRENT batch has already run by the time the failure is
# observed; no later batch is started. Results are still applied in tier
# order, so the run's outcome is deterministic — but the side effects of a
# batch-mate are not prevented.
fn workflow_def_set_parallel(def, max_parallel) {
    if (def == 0) { return 1; }
    if (max_parallel < 1) { max_parallel = 1; }
    store64(def + 32, max_parallel);
    return max_parallel;
}

fn workflow_def_max_parallel(def) {
    if (def == 0) { return 1; }
    return load64(def + 32);
}

fn workflow_def_add_step(def, step) {
    vec_push(load64(def + 16), step);
}

# StepResult struct (24 bytes):
#   offset  0: status (i64)
#   offset  8: output (i64) — arbitrary result data
#   offset 16: error_msg (i64) — C string or 0

fn step_result_new(status, output, error_msg) {
    var sr = fl_alloc(24);
    store64(sr, status);
    store64(sr + 8, output);
    store64(sr + 16, error_msg);
    return sr;
}

# StepExecutor vtable (8 bytes):
#   offset 0: execute_fn(step_ptr, context_ptr) -> StepResult ptr

# WorkflowContext struct (16 bytes):
#   offset  0: step_results (i64) — hashmap: step_id -> StepResult ptr
#   offset  8: input (i64) — workflow input data

fn workflow_context_new(input) {
    var ctx = fl_alloc(16);
    store64(ctx, map_new());
    store64(ctx + 8, input);
    return ctx;
}

fn context_get_step_result(ctx, step_id) {
    return map_get(load64(ctx), step_id);
}

fn context_set_step_result(ctx, step_id, result) {
    map_set(load64(ctx), step_id, result);
}

# Check if a step's dependencies are satisfied.
fn _deps_satisfied(step, ctx) {
    var deps = load64(step + 16);
    var mode = load64(step + 24);
    var dep_count = vec_len(deps);
    if (dep_count == 0) { return 1; }

    var satisfied = 0;
    var i = 0;
    while (i < dep_count) {
        var dep_id = vec_get(deps, i);
        var result = context_get_step_result(ctx, dep_id);
        if (result != 0 && load64(result) == STEP_COMPLETED) {
            satisfied = satisfied + 1;
        }
        i = i + 1;
    }

    if (mode == TRIGGER_ALL) {
        return satisfied == dep_count;
    }
    # TRIGGER_ANY
    return satisfied > 0;
}

# Topological sort into tiers (Kahn's algorithm).
# Returns a vec of vecs (each inner vec is a tier of step pointers).
fn _compute_tiers(def) {
    var steps = load64(def + 16);
    var num_steps = vec_len(steps);
    var tiers = vec_new();

    # Build in-degree map: step_id -> count of dependencies.
    #
    # In-degree state is keyed by step id, so two steps sharing an id collapse
    # into ONE map entry and every duplicate after the first is silently
    # dropped from the schedule. Detect it and refuse the workflow instead:
    # returning a partial DAG that looks complete is the worse failure.
    var in_degree = map_new();
    var i = 0;
    while (i < num_steps) {
        var s = vec_get(steps, i);
        var sid = load64(s);
        if (map_has(in_degree, sid) == 1) { return 0; }
        map_set(in_degree, sid, vec_len(load64(s + 16)));
        i = i + 1;
    }

    # Iteratively collect steps with 0 in-degree
    var remaining = num_steps;
    while (remaining > 0) {
        var tier = vec_new();
        i = 0;
        while (i < num_steps) {
            var s = vec_get(steps, i);
            var sid = load64(s);
            if (map_get(in_degree, sid) == 0) {
                vec_push(tier, s);
                map_set(in_degree, sid, -1);
            }
            i = i + 1;
        }
        if (vec_len(tier) == 0) {
            # Kahn's algorithm cannot make progress: the remaining steps form a
            # CYCLE, or one depends on an id that is not in this workflow.
            #
            # This used to `break` and hand back the acyclic PREFIX, so
            # workflow_execute ran part of the DAG and reported success — a
            # workflow silently missing its tail. Return 0 so the caller can
            # tell a malformed DAG from a completed one.
            return 0;
        }
        # Reduce in-degree for dependents
        var j = 0;
        var tlen = vec_len(tier);
        while (j < tlen) {
            var done_step = vec_get(tier, j);
            var done_id = load64(done_step);
            # For each step, check if it depends on done_id
            i = 0;
            while (i < num_steps) {
                var s = vec_get(steps, i);
                var deps = load64(s + 16);
                var k = 0;
                var dlen = vec_len(deps);
                while (k < dlen) {
                    if (streq(vec_get(deps, k), done_id) == 1) {
                        var sid = load64(s);
                        var cur = map_get(in_degree, sid);
                        if (cur > 0) {
                            map_set(in_degree, sid, cur - 1);
                        }
                    }
                    k = k + 1;
                }
                i = i + 1;
            }
            j = j + 1;
        }
        remaining = remaining - vec_len(tier);
        vec_push(tiers, tier);
    }

    return tiers;
}

# Release a workflow context.
#
# workflow_execute still leaks its tier vecs and StepResults (both from the
# bump allocator, which cannot free), so this is not a complete teardown — it
# covers the context block itself, which is the one thing the malformed-DAG
# early return can cleanly reclaim. Full run teardown needs the tier
# structures to move off the bump allocator; tracked on the roadmap.
fn workflow_context_free(ctx) {
    if (ctx != 0) { fl_free(ctx); }
    return 0;
}

# Run one step: retry loop and backoff. Returns a StepResult, never 0.
#
# Pure with respect to the context — it READS ctx (via the caller's dependency
# check) but never writes it, which is what makes it safe to run several of
# these on different threads. All context writes happen on the coordinating
# thread after the batch finishes.
#
# The returned status is always COMPLETED, SKIPPED or FAILED.
fn _dag_run_step(step, ctx, executor_fn) {
    var max_retries = load64(step + 40);
    # ⚠ A negative retry_max made the loop condition false at once, so the
    # executor never ran and the step failed as "executor returned null".
    if (max_retries < 0) { max_retries = 0; }
    var attempt = 0;
    var result = 0;
    var st = 0;
    while (attempt <= max_retries) {
        result = fncall2(executor_fn, step, ctx);
        # ⚠ `break`, not `attempt = max_retries + 1`: with retry_max INT64_MAX
        # that overflowed to INT64_MIN, kept the loop running, and re-executed
        # a step that had already succeeded, forever. An executor-returned
        # SKIPPED ("nothing to do") is terminal too — retrying repeats its side
        # effects for a result that cannot change.
        if (result != 0) {
            st = load64(result);
            if (st == STEP_COMPLETED) { break; }
            if (st == STEP_SKIPPED) { break; }
        }
        attempt = attempt + 1;
        if (attempt <= max_retries) {
            # Linear backoff: attempt * 10 ms. `_majra_sleep_ns`
            # (src/envelope.cyr) sleeps to a monotonic deadline, so a
            # signal landing mid-wait resumes rather than shortens it —
            # the EINTR-with-remainder intent of the raw nanosleep loop
            # this replaced. That loop spelled x86_64's 35, which on
            # aarch64-Linux is unlinkat(2): it returned an error at once,
            # never -4, and the backoff never slept.
            _majra_sleep_ns(attempt * 10000000);
        }
    }
    if (result == 0) {
        return step_result_new(STEP_FAILED, 0, "executor returned null");
    }
    # ⚠ Any other final status (PENDING, RUNNING, out of range) was retried as a
    # failure but then applied as a success: the apply phase checks only for
    # FAILED, so POLICY_FAIL was bypassed and the run reported COMPLETED for a
    # step that never completed. Coerce it into a FAILED result, as the
    # null-result path does. A fresh StepResult — the executor's may be shared.
    st = load64(result);
    if (st != STEP_COMPLETED) {
        if (st != STEP_SKIPPED) {
            if (st != STEP_FAILED) {
                var msg = load64(result + 16);
                if (msg == 0) { msg = "executor returned a non-terminal status"; }
                return step_result_new(STEP_FAILED, load64(result + 8), msg);
            }
        }
    }
    return result;
}

# Job struct handed to a worker thread (56 bytes, internal):
#   offset  0: step
#   offset  8: ctx
#   offset 16: executor_fn
#   offset 24: result   — the worker's OWN slot; no two jobs share one
#   offset 32: skipped  — 1 if dependencies were unsatisfied
#   offset 40: pending  — the batch's in-flight counter word (parallel only)
#   offset 48: inline   — 1 if the spawn failed and the coordinator runs it
fn _dag_worker(job) {
    if (load64(job + 32) == 1) { return 0; }
    store64(job + 24, _dag_run_step(load64(job), load64(job + 8), load64(job + 16)));
    return 0;
}

# 1 if this job ran, failed, and its step's POLICY_FAIL aborts the run. The run
# phase stops on exactly this condition and the apply loop aborts on the same
# one, so it never reaches (or dereferences the 0 result of) an unstarted job.
# ⚠ Keep the two in step if either changes.
fn _dag_job_aborts(job) {
    if (load64(job + 32) == 1) { return 0; }
    var r = load64(job + 24);
    if (r == 0) { return 0; }
    if (load64(r) != STEP_FAILED) { return 0; }
    if (load64(load64(job) + 32) != POLICY_FAIL) { return 0; }
    return 1;
}

# Batch worker: run the job, then count it done and wake the coordinator.
#
# ⚠ Workers are spawned DETACHED and the coordinator waits on this counter
# instead of thread_join. thread_create bump-allocates a 24 B handle and a
# 4096 B TLS block that thread_join never returns — about 4.1 KB of heap lost
# for good per parallel step. thread_create_detached allocates no handle and
# carves its TLS from the stack mapping it unmaps on exit. Nothing here touches
# the job after the decrement: the coordinator may free it from then on.
fn _dag_batch_worker(job) {
    _dag_worker(job);
    var pending = load64(job + 40);
    # Only the decrement that reaches 0 wakes: the coordinator waits for 0, and
    # FUTEX_WAIT's value check covers any decrement that races its park.
    if (atomic_fetch_add(pending, -1) == 1) {
        #ifndef CYRIUS_TARGET_AGNOS
        syscall(SYS_FUTEX, pending, FUTEX_WAKE, 0x7fffffff, 0, 0, 0);
        #endif
    }
    return 0;
}

# Execute a workflow definition with a given executor function and input.
# executor_fn(step_ptr, ctx_ptr) -> StepResult ptr
# Returns: RUN_COMPLETED, or RUN_FAILED (including for a malformed DAG).
#
# Steps within a tier execute serially unless workflow_def_set_parallel raised
# the width; then they run in bounded batches of detached worker threads.
#
# ⚠ A POLICY_FAIL failure stops the tier. Serially the next tier-mate never
# starts; in parallel the current batch finishes but no later batch starts.
# From 2.7.0 through 2.8.0 every tier-mate ran first and failures were checked
# only afterwards, so siblings of a failed step still executed their side
# effects.
fn workflow_execute(def, executor_fn, input) {
    var ctx = workflow_context_new(input);
    var tiers = _compute_tiers(def);
    # _compute_tiers returns 0 for a malformed DAG (a dependency cycle, a
    # dangling dependency id, or duplicate step ids). Running the schedulable
    # prefix and reporting success is exactly the failure this guards.
    if (tiers == 0) {
        # The context was allocated above; release it rather than abandon it on
        # the one path that returns before the run starts.
        workflow_context_free(ctx);
        return RUN_FAILED;
    }
    var num_tiers = vec_len(tiers);
    var final_status = RUN_COMPLETED;

    var t = 0;
    while (t < num_tiers) {
        var tier = vec_get(tiers, t);
        var tier_len = vec_len(tier);

        # --- Run the tier ---
        #
        # Serial and parallel share _dag_run_step, so retry, backoff and the
        # null-result fallback cannot drift between the two paths.
        #
        # Every step's result lands in its OWN job slot; nothing is shared
        # between workers, and no worker touches the context. Steps in one tier
        # are by construction independent — that is what a tier means — so
        # deferring all context writes until after the batch finishes is
        # equivalent to writing them as we go, and it is what keeps the
        # executor from needing to synchronise against majra's own state.
        var width = load64(def + 32);
        if (width < 1) { width = 1; }

        var jobs = fl_alloc(tier_len * 8);
        var s = 0;
        while (s < tier_len) {
            var step_j = vec_get(tier, s);
            var job = fl_alloc(56);
            store64(job, step_j);
            store64(job + 8, ctx);
            store64(job + 16, executor_fn);
            store64(job + 24, 0);
            var unsat = 0;
            if (_deps_satisfied(step_j, ctx) == 0) { unsat = 1; }
            store64(job + 32, unsat);
            store64(job + 40, 0);
            store64(job + 48, 0);
            store64(jobs + s * 8, job);
            s = s + 1;
        }

        if (width == 1 || tier_len == 1) {
            s = 0;
            while (s < tier_len) {
                _dag_worker(load64(jobs + s * 8));
                # Fail fast: later tier-mates keep result 0 and are never
                # applied — the apply loop aborts at this same job.
                if (_dag_job_aborts(load64(jobs + s * 8)) == 1) { break; }
                s = s + 1;
            }
        } else {
            # Bounded batches rather than a thread per step: `width` is a
            # concurrency cap, not a suggestion.
            var pending = fl_alloc(8);
            var base = 0;
            while (base < tier_len) {
                var n = width;
                if (base + n > tier_len) { n = tier_len - base; }
                # The counter is set BEFORE any worker can decrement it.
                store64(pending, n);
                var k = 0;
                while (k < n) {
                    var bj = load64(jobs + (base + k) * 8);
                    store64(bj + 40, pending);
                    if (thread_create_detached(&_dag_batch_worker, bj) == 0) {
                        store64(bj + 48, 1);
                    }
                    k = k + 1;
                }
                # A failed spawn's step must still run — inline it rather than
                # silently skipping it. It decrements the counter itself.
                k = 0;
                while (k < n) {
                    var ij = load64(jobs + (base + k) * 8);
                    if (load64(ij + 48) == 1) { _dag_batch_worker(ij); }
                    k = k + 1;
                }
                # Wait for the batch. One load per iteration feeds both the
                # test and FUTEX_WAIT, so a decrement in between makes the
                # kernel see a mismatch and return rather than park.
                var left = load64(pending);
                while (left != 0) {
                    # agnos: detached bodies ran inline at spawn, so this is
                    # never reached there; yield rather than futex regardless.
                    #ifdef CYRIUS_TARGET_AGNOS
                    sys_sched_yield();
                    #endif
                    #ifndef CYRIUS_TARGET_AGNOS
                    syscall(SYS_FUTEX, pending, FUTEX_WAIT, left, 0, 0, 0);
                    #endif
                    left = load64(pending);
                }
                base = base + n;
                # Fail fast between batches: every unstarted job comes after
                # the failing one in tier order, so the apply loop stops first.
                var stop = 0;
                k = base - n;
                while (k < base) {
                    if (_dag_job_aborts(load64(jobs + k * 8)) == 1) { stop = 1; }
                    k = k + 1;
                }
                if (stop == 1) { break; }
            }
            # A worker's FUTEX_WAKE can land after this free (it decrements,
            # then wakes). fl_free does not unmap, so that is at worst a
            # spurious wake for a later user of the block, which every futex
            # waiter in majra and the stdlib already re-checks for.
            fl_free(pending);
        }

        # --- Apply results, in tier order ---
        s = 0;
        var abort = 0;
        while (s < tier_len && abort == 0) {
            var job2 = load64(jobs + s * 8);
            var step2 = load64(job2);
            var step_id = load64(step2);

            if (load64(job2 + 32) == 1) {
                context_set_step_result(ctx, step_id, step_result_new(STEP_SKIPPED, 0, 0));
            } else {
                var result = load64(job2 + 24);
                context_set_step_result(ctx, step_id, result);

                if (load64(result) == STEP_FAILED) {
                    var policy = load64(step2 + 32);
                    if (policy == POLICY_FAIL) {
                        final_status = RUN_FAILED;
                        abort = 1;
                    }
                    if (policy == POLICY_SKIP) {
                        context_set_step_result(ctx, step_id, step_result_new(STEP_SKIPPED, 0, 0));
                    }
                    # POLICY_CONTINUE: keep going
                }
            }
            s = s + 1;
        }

        s = 0;
        while (s < tier_len) { fl_free(load64(jobs + s * 8)); s = s + 1; }
        fl_free(jobs);

        if (abort == 1) { return final_status; }
        t = t + 1;
    }

    return final_status;
}

# InMemoryWorkflowStorage: hashmap-based storage for definitions and runs.
# WorkflowStorage struct (16 bytes):
#   offset 0: definitions (i64) — hashmap: id -> WorkflowDefinition ptr
#   offset 8: runs (i64) — hashmap: id -> run data ptr

fn workflow_storage_new() {
    var ws = fl_alloc(16);
    store64(ws, map_new());
    store64(ws + 8, map_new());
    return ws;
}

fn storage_save_def(ws, def) {
    map_set(load64(ws), load64(def), def);
}

fn storage_get_def(ws, id) {
    return map_get(load64(ws), id);
}

fn storage_delete_def(ws, id) {
    return map_delete(load64(ws), id);
}

fn storage_list_defs(ws) {
    return map_values(load64(ws));
}
