# majra/postgres_backend — PostgreSQL wire protocol for workflow storage
#
# Implements the PostgreSQL frontend/backend protocol (v3) over TCP.
# Supports startup, simple query, and parameterized query.
#
# Wire format:
#   Frontend -> Backend: [1B type][4B length][payload]
#   Backend -> Frontend: [1B type][4B length][payload]
#   Startup message has no type byte: [4B length][4B protocol][params...]
#
# ⚠ SECURITY — TRANSPORT AND AUTHENTICATION (2.13.0)
#
# Two ways to connect:
#
#   pg_connect      PLAINTEXT. Every query and result row crosses the wire in
#                   the clear. Use it only over loopback or an already-
#                   confidential channel (a unix-socket proxy, a VPN link).
#   pg_connect_tls  SSLRequest, then TLS through lib/tls.cyr's native stack,
#                   with the server's certificate VERIFIED against `ca_file` (or
#                   the system roots) and bound to `server_name`. A server that
#                   declines TLS is refused, never fallen back from.
#
# Both authenticate with SCRAM-SHA-256 (RFC 5802 / RFC 7677, PostgreSQL's
# default since v14) or a cleartext password, whichever the server asks for.
# SCRAM never sends the password and checks the server's signature, so a
# server that does not know the password's verifier cannot finish it. MD5 and
# every other method are refused. Channel binding (SCRAM-SHA-256-PLUS) is not
# implemented: over plaintext, an active attacker can still answer with a
# cleartext request and read the password, which is why pg_connect belongs on
# a trusted path. The base64 codec is ipc_encrypted.cyr's (same bundle).

# --- PostgreSQL Wire Protocol Constants ---

# Message types (frontend -> backend)
var PG_MSG_QUERY = 81;
var PG_MSG_TERMINATE = 88;
var PG_MSG_PASSWORD = 112;

# Message types (backend -> frontend)
var PG_MSG_AUTH = 82;
var PG_MSG_READY = 90;
var PG_MSG_ROW_DESC = 84;
var PG_MSG_DATA_ROW = 68;
var PG_MSG_CMD_COMPLETE = 67;
var PG_MSG_ERROR = 69;
var PG_MSG_NOTICE = 78;

# Auth types
var PG_AUTH_OK = 0;
var PG_AUTH_CLEARTEXT = 3;

# Largest backend message majra will allocate for. The wire length field is a
# signed int32, so without a cap a peer can request ~2 GB with a five-byte
# header. 16 MiB is far above any DataRow majra's own schema produces.
var PG_MAX_MSG = 16777216;

# --- Connection ---

# PgConn struct (32 bytes):
#   offset  0: fd (i64) — -1 once the connection is closed or poisoned
#   offset  8: ready (i64) — 1 if ready for query, 0 once closed or poisoned
#   offset 16: tls (i64) — lib/tls.cyr ctx, 0 on a plaintext connection (2.13.0)
#   offset 24: tls_arena (i64) — the pooled arena backing that ctx (2.13.0)

fn _pg_write_be32(buf, offset, val) {
    store8(buf + offset, (val >> 24) & 0xFF);
    store8(buf + offset + 1, (val >> 16) & 0xFF);
    store8(buf + offset + 2, (val >> 8) & 0xFF);
    store8(buf + offset + 3, val & 0xFF);
}

fn _pg_read_be32(buf, offset) {
    return (load8(buf+offset) << 24) | (load8(buf+offset+1) << 16) | (load8(buf+offset+2) << 8) | load8(buf+offset+3);
}

fn _pg_read_be16(buf, offset) {
    return (load8(buf+offset) << 8) | load8(buf+offset+1);
}

# SIGNED big-endian int32.
#
# `_pg_read_be32` composes four ZERO-EXTENDED load8 results, so it can never
# return a negative number: the PostgreSQL NULL sentinel (int32 -1, on the wire
# as FF FF FF FF) came back as 4294967295. Every `< 0` test against it was
# therefore dead code. Use this reader for any wire field PostgreSQL may send
# negative — today that is the DataRow column length.
fn _pg_read_i32(buf, offset) {
    var v = _pg_read_be32(buf, offset);
    if (v >= 0x80000000) { return v - 0x100000000; }
    return v;
}

# Read exactly `want` bytes, looping over short reads. Returns the byte count,
# or -1 if the peer closed or errored before `want` bytes arrived. A blocking
# TCP socket is entitled to return fewer bytes than requested; treating that as
# fatal (as this file did) drops legitimate traffic.
fn _pg_read_full(fd, buf, want) {
    var total = 0;
    while (total < want) {
        var r = syscall(SYS_READ, fd, buf + total, want - total);
        # EINTR (-4) retries; see the note in src/ws.cyr's _ws_read_full.
        if (r == -4) { r = 0; }
        elif (r <= 0) { return -1; }
        total = total + r;
    }
    return total;
}

# sendto(2)'s number, or 0 where there is no MSG_NOSIGNAL send path.
# Spelled per arch. Through cyrius 6.6.4 it had to be — sendto had no ESYSXLAT
# row (quirk #9), so the x86_64 44 ran as fstatfs on aarch64; 6.6.5 added a
# `sendto 44→206` row, and the per-arch form is kept because it is correct
# under both toolchains (see `_IPC_SYS_SENDTO` in `src/ipc.cyr`). The peers
# declare no SYS_SENDTO. macOS has no MSG_NOSIGNAL; agnos and Windows have no
# BSD sockets.
fn _pg_sendto_nr() {
    #ifdef CYRIUS_TARGET_LINUX
    #ifdef CYRIUS_ARCH_X86
    return 44;
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return 206;
    #endif
    #endif
    return 0;
}

# Write exactly `len` bytes, looping over short writes.
#
# ⚠ Sent with MSG_NOSIGNAL (0x4000). A bare write(2) to a connection the server
# has reset (failover, pg_terminate_backend, an idle-timeout load balancer)
# raises SIGPIPE, whose default action kills the consumer process. A non-socket
# fd gets ENOTSOCK (-88) and falls back to write(2).
fn _pg_write_full(fd, buf, len) {
    var total = 0;
    var nr = _pg_sendto_nr();
    while (total < len) {
        var w = 0;
        if (nr != 0) {
            w = syscall(nr, fd, buf + total, len - total, 0x4000, 0, 0);
            if (w == -88) {
                nr = 0;
                w = syscall(SYS_WRITE, fd, buf + total, len - total);
            }
        } else {
            w = syscall(SYS_WRITE, fd, buf + total, len - total);
        }
        if (w == -4) { w = 0; }
        elif (w <= 0) { return -1; }
        total = total + w;
    }
    return total;
}

# --- Transport (2.13.0) ---
#
# Every byte of a connection goes through these two, so a TLS connection is a
# PgConn with a ctx at +16 and nothing above this layer knows the difference.
# The raw-fd helpers above stay for the SSLRequest exchange, which happens in
# the clear before TLS starts.

# Read exactly `want` bytes from the connection. Returns `want`, or -1.
fn _pg_recv_full(conn, buf, want) {
    var tls = load64(conn + 16);
    if (tls == 0) { return _pg_read_full(load64(conn), buf, want); }
    var total = 0;
    while (total < want) {
        # 0 is the peer's close_notify and a negative is a TLS_ERR_*: either
        # way the message cannot be completed.
        var r = tls_read(tls, buf + total, want - total);
        if (r <= 0) { return -1; }
        total = total + r;
    }
    return total;
}

# Write exactly `len` bytes to the connection. Returns `len`, or -1.
fn _pg_send_full(conn, buf, len) {
    var tls = load64(conn + 16);
    if (tls == 0) { return _pg_write_full(load64(conn), buf, len); }
    var total = 0;
    while (total < len) {
        var w = tls_write(tls, buf + total, len - total);
        if (w <= 0) { return -1; }
        total = total + w;
    }
    return total;
}

# TLS arenas, pooled. lib/tls.cyr draws a connection's handshake and record
# buffers (about 175 KB for TLS 1.3) from the allocator it is given, and with
# none it takes them from the bump heap, which never frees: a client that
# reconnected leaked that much per connection. An arena lives on the bump heap
# too, so one per connection would leak the same way. Instead a closed
# connection's arena is reset and kept here, and the next pg_connect_tls takes
# it: memory is bounded by the most TLS connections ever open at once.
var _pg_tls_pool = 0;        # _majra_vec of reset arenas
var _pg_tls_pool_mtx = 0;

fn _pg_tls_pool_lock() {
    if (_pg_tls_pool_mtx == 0) {
        var m = mutex_new();
        # The loser of a first-use race drops its 8-byte cell; both use one lock.
        atomic_cas(&_pg_tls_pool_mtx, 0, m);
    }
    mutex_lock(_pg_tls_pool_mtx);
    if (_pg_tls_pool == 0) { _pg_tls_pool = _majra_vec_new(); }
    return 0;
}

fn _pg_tls_arena_take() {
    _pg_tls_pool_lock();
    var a = 0;
    var n = vec_len(_pg_tls_pool);
    if (n > 0) {
        a = vec_get(_pg_tls_pool, n - 1);
        vec_truncate(_pg_tls_pool, n - 1);
    }
    mutex_unlock(_pg_tls_pool_mtx);
    # Growable: a long certificate chain or a large CA file outgrows any fixed
    # guess, and reset keeps the chunks, so it settles at its high-water mark.
    if (a == 0) { a = arena_allocator_growable(262144); }
    return a;
}

fn _pg_tls_arena_give(a) {
    if (a == 0) { return 0; }
    reset_via(a);
    _pg_tls_pool_lock();
    _majra_vec_push(_pg_tls_pool, a);
    mutex_unlock(_pg_tls_pool_mtx);
    return 0;
}

# End the TLS session (if any), close the socket, and return the arena. After
# this the handle reads as closed: fd -1, not ready, no ctx.
fn _pg_close_transport(conn) {
    var tls = load64(conn + 16);
    if (tls != 0) { tls_close(tls); }
    var fd = load64(conn);
    if (fd >= 0) { syscall(SYS_CLOSE, fd); }
    _pg_tls_arena_give(load64(conn + 24));
    store64(conn, -1);
    store64(conn + 8, 0);
    store64(conn + 16, 0);
    store64(conn + 24, 0);
    return 0;
}

# Mark a connection unusable: close the socket and fail every later call fast.
#
# pg_query used to return an empty vec on a failed read or write and leave the
# fd in the handle. The next pg_query (or pg_close's Terminate) then wrote to a
# reset socket — SIGPIPE — or, after an oversized or malformed message, parsed
# the unread remainder of the previous result as its own reply.
fn _pg_poison(conn) {
    if (conn == 0) { return 0; }
    return _pg_close_transport(conn);
}

# Release a message struct returned by _pg_read_msg, and its body.
#
# Nothing freed these: pg_query's main loop, pg_connect's handshake and its
# ReadyForQuery loop, and the ErrorResponse drain all dropped both the 24-byte
# descriptor and its body on the floor. A long-lived connection leaked one of
# each per message received, which for a query returning many DataRows is per
# row.
fn _pg_msg_free(m) {
    if (m == 0) { return 0; }
    var d = load64(m + 8);
    if (d != 0) { fl_free(d); }
    fl_free(m);
    return 0;
}

# Largest frontend message majra will frame. The length field is 32 bits; a
# longer message had its length silently TRUNCATED, and the server then parsed
# the tail of the SQL as further protocol messages (the CVE-2024-27304 class).
# PostgreSQL itself refuses anything above 0x3FFFFFFF.
var _PG_MAX_FRONTEND_MSG = 0x3FFFFFFF;

# The server's own cap on a startup packet (MAX_STARTUP_PACKET_LENGTH).
var _PG_MAX_STARTUP = 10000;

# Send startup message: protocol version 3.0, user, database.
# Returns the byte count, -1 on a write failure, -2 if nothing was sent.
#
# Takes its arguments directly. They used to arrive through process-wide
# globals (a quirk #1 precaution) guarded by a mutex held across connect(2) and
# the whole untimed handshake, so one stalled server blocked every pg_connect
# in the process.
fn _pg_startup(conn, user, database) {
    if (user == 0 || database == 0) { return -2; }
    var user_len = strlen(user);
    var db_len = strlen(database);
    # [4B len][4B protocol][user\0name\0database\0name\0\0]
    var payload_len = 4 + 5 + user_len + 1 + 9 + db_len + 1 + 1;
    var msg_len = 4 + payload_len;
    if (msg_len > _PG_MAX_STARTUP) { return -2; }
    var msg = fl_alloc(msg_len);
    if (msg == 0) { return -2; }
    _pg_write_be32(msg, 0, msg_len);
    _pg_write_be32(msg, 4, 196608);
    var pos = 8;
    memcpy(msg + pos, "user", 4); pos = pos + 4; store8(msg + pos, 0); pos = pos + 1;
    memcpy(msg + pos, user, user_len); pos = pos + user_len; store8(msg + pos, 0); pos = pos + 1;
    memcpy(msg + pos, "database", 8); pos = pos + 8; store8(msg + pos, 0); pos = pos + 1;
    memcpy(msg + pos, database, db_len); pos = pos + db_len; store8(msg + pos, 0); pos = pos + 1;
    store8(msg + pos, 0);
    var rc = _pg_send_full(conn, msg, msg_len);
    fl_free(msg);
    return rc;
}

# Read a single backend message. Returns {type, data_ptr, data_len} or 0.
fn _pg_read_msg(conn) {
    var hdr[8];
    if (_pg_recv_full(conn, &hdr, 5) < 0) { return 0; }
    var msg_type = load8(&hdr);
    var msg_len = _pg_read_be32(&hdr, 1);
    # The length covers itself, so anything below 4 is malformed; the upper
    # bound stops a peer requesting a multi-gigabyte allocation from a
    # five-byte header.
    if (msg_len < 4 || msg_len > PG_MAX_MSG) { return 0; }
    var data_len = msg_len - 4;
    var data = 0;
    if (data_len > 0) {
        data = fl_alloc(data_len + 1);
        if (data == 0) { return 0; }
        if (_pg_recv_full(conn, data, data_len) < 0) {
            fl_free(data);
            return 0;
        }
        store8(data + data_len, 0);
    }
    var result = fl_alloc(24);
    if (result == 0) {
        if (data != 0) { fl_free(data); }
        return 0;
    }
    store64(result, msg_type);
    store64(result + 8, data);
    store64(result + 16, data_len);
    return result;
}

# --- SQL literals ---
#
# majra's PostgreSQL client speaks the simple query protocol and implements no
# prepared statements, so every value reaches the server inside a literal and
# quoting is the only defence available.
#
# ⚠ Values are DOLLAR-QUOTED: $m_$...$m_$. The body of a dollar-quoted string
# is taken verbatim — no escape processing — so its safety does not depend on
# any server setting. The '' doubling this used before was correct only while
# standard_conforming_strings=on: a DBA's `ALTER DATABASE ... SET
# standard_conforming_strings = off` turned `\'` back into an escaped quote and
# a tenant-supplied id closed the literal. E'' strings trade that dependency
# for backslash_quote and the client encoding; dollar quoting has neither.
#
# The tag is `$m` + k underscores + `$`, with k one longer than the longest run
# of '_' in the value, so the value cannot contain the tag and cannot complete
# one with the closing tag's own bytes. A literal must follow whitespace or
# punctuation — after an identifier character the `$` would extend the
# identifier.

# k for `s` (length n): the longest run of '_' in it, plus one.
fn _pg_dq_k(s, n) {
    var best = 0;
    var run = 0;
    var i = 0;
    while (i < n) {
        if (load8(s + i) == 95) {
            run = run + 1;
            if (run > best) { best = run; }
        } else {
            run = 0;
        }
        i = i + 1;
    }
    return best + 1;
}

# Write the k tag at dst. Returns its length (k + 3).
fn _pg_dq_put(dst, k) {
    store8(dst, 36);
    store8(dst + 1, 109);
    var i = 0;
    while (i < k) {
        store8(dst + 2 + i, 95);
        i = i + 1;
    }
    store8(dst + 2 + k, 36);
    return k + 3;
}

fn _pg_sb_dq_tag(sb, k) {
    str_builder_putc(sb, 36);
    str_builder_putc(sb, 109);
    var i = 0;
    while (i < k) {
        str_builder_putc(sb, 95);
        i = i + 1;
    }
    str_builder_putc(sb, 36);
    return 0;
}

# Append `s` to `sb` as a quoted SQL string literal, including its delimiters.
# Returns 0 on success, -1 if `s` is null.
fn _pg_add_literal(sb, s) {
    if (s == 0) { return -1; }
    var k = _pg_dq_k(s, strlen(s));
    _pg_sb_dq_tag(sb, k);
    str_builder_add_cstr(sb, s);
    _pg_sb_dq_tag(sb, k);
    return 0;
}

# Growable SQL text on the freelist: {data, len, cap, err}, data always
# NUL-terminated.
#
# ⚠ Not str_builder: its header, every grow and str_builder_build's copy all
# come from the bump allocator, which never frees, so every workflow call —
# carrying a steps_json of any size — grew the process permanently. This one is
# released with _pg_q_free once the statement is sent.
fn _pg_q_new() {
    var q = fl_alloc(32);
    if (q == 0) { return 0; }
    var d = fl_alloc(256);
    if (d == 0) { fl_free(q); return 0; }
    store8(d, 0);
    store64(q, d);
    store64(q + 8, 0);
    store64(q + 16, 256);
    store64(q + 24, 0);
    return q;
}

fn _pg_q_free(q) {
    if (q == 0) { return 0; }
    fl_free(load64(q));
    fl_free(q);
    return 0;
}

# Room for n more bytes plus the NUL. Returns 0, or -1 (and marks q failed).
fn _pg_q_reserve(q, n) {
    if (load64(q + 24) != 0) { return -1; }
    var len = load64(q + 8);
    var cap = load64(q + 16);
    if (len + n + 1 <= cap) { return 0; }
    var nc = cap * 2;
    if (nc < len + n + 1) { nc = len + n + 1; }
    var nd = fl_alloc(nc);
    if (nd == 0) { store64(q + 24, 1); return -1; }
    memcpy(nd, load64(q), len + 1);
    fl_free(load64(q));
    store64(q, nd);
    store64(q + 16, nc);
    return 0;
}

fn _pg_q_add(q, p, n) {
    if (_pg_q_reserve(q, n) < 0) { return -1; }
    var len = load64(q + 8);
    memcpy(load64(q) + len, p, n);
    store64(q + 8, len + n);
    store8(load64(q) + len + n, 0);
    return 0;
}

fn _pg_q_cstr(q, s) {
    return _pg_q_add(q, s, strlen(s));
}

fn _pg_q_int(q, v) {
    var nb[24];
    var l = fmt_int_buf(v, &nb);
    return _pg_q_add(q, &nb, l);
}

# _pg_add_literal for a _pg_q. Returns 0, or -1 if `s` is null or on OOM.
fn _pg_q_lit(q, s) {
    if (s == 0) { return -1; }
    var n = strlen(s);
    var k = _pg_dq_k(s, n);
    if (_pg_q_reserve(q, n + 2 * (k + 3)) < 0) { return -1; }
    var d = load64(q);
    var p = load64(q + 8);
    p = p + _pg_dq_put(d + p, k);
    memcpy(d + p, s, n);
    p = p + n;
    p = p + _pg_dq_put(d + p, k);
    store8(d + p, 0);
    store64(q + 8, p);
    return 0;
}

# The finished SQL text, or 0 if any append failed.
fn _pg_q_sql(q) {
    if (load64(q + 24) != 0) { return 0; }
    return load64(q);
}

# Send a simple query. Returns the byte count, -1 on a write failure (the
# stream is then in an unknown state), or -2 if nothing was sent.
fn _pg_send_query(conn, sql) {
    var sql_len = strlen(sql);
    if (sql_len > _PG_MAX_FRONTEND_MSG - 5) { return -2; }
    var msg_len = 4 + sql_len + 1;
    var msg = fl_alloc(1 + msg_len);
    if (msg == 0) { return -2; }
    store8(msg, PG_MSG_QUERY);
    _pg_write_be32(msg, 1, msg_len);
    memcpy(msg + 5, sql, sql_len);
    store8(msg + 5 + sql_len, 0);
    var rc = _pg_send_full(conn, msg, 1 + msg_len);
    fl_free(msg);
    return rc;
}

# Send password message (cleartext). Same return convention as _pg_send_query.
fn _pg_send_password(conn, password) {
    if (password == 0) { return -2; }
    var pw_len = strlen(password);
    if (pw_len > _PG_MAX_FRONTEND_MSG - 5) { return -2; }
    var msg_len = 4 + pw_len + 1;
    var msg = fl_alloc(1 + msg_len);
    if (msg == 0) { return -2; }
    store8(msg, PG_MSG_PASSWORD);
    _pg_write_be32(msg, 1, msg_len);
    memcpy(msg + 5, password, pw_len);
    store8(msg + 5 + pw_len, 0);
    var rc = _pg_send_full(conn, msg, 1 + msg_len);
    # Do not leave the plaintext password sitting in a freed heap block.
    memset(msg, 0, 1 + msg_len);
    fl_free(msg);
    return rc;
}

# Send terminate message
fn _pg_terminate(conn) {
    var msg[8];
    store8(&msg, PG_MSG_TERMINATE);
    _pg_write_be32(&msg, 1, 4);
    _pg_send_full(conn, &msg, 5);
    return 0;
}

# Tear down a half-built connection (and a message, if one is held), handle
# included. Returns 0, which pg_connect hands back.
fn _pg_connect_fail(conn, msg) {
    if (msg != 0) { _pg_msg_free(msg); }
    _pg_close_transport(conn);
    fl_free(conn);
    return 0;
}

# --- SCRAM-SHA-256 (RFC 5802, RFC 7677) — 2.13.0 ---
#
# The exchange, as PostgreSQL runs it:
#   S: AuthenticationSASL          the mechanisms it offers
#   C: SASLInitialResponse         "SCRAM-SHA-256", client-first-message
#   S: AuthenticationSASLContinue  server-first-message (nonce, salt, iterations)
#   C: SASLResponse                client-final-message (with the proof)
#   S: AuthenticationSASLFinal     server-final-message (the server's signature)
#   S: AuthenticationOk
# The password never crosses the wire, and the server proves it holds the
# verifier: a signature that does not match fails the connect.
#
# The username in client-first is empty: PostgreSQL takes it from the startup
# message, as libpq does. The password is used as its bytes. SASLprep leaves an
# ASCII password unchanged, so that is exact for ASCII; a non-ASCII password the
# server normalised (NFKC) when it was set will not authenticate.

var PG_AUTH_SASL = 10;
var PG_AUTH_SASL_CONTINUE = 11;
var PG_AUTH_SASL_FINAL = 12;

# The most PBKDF2 iterations a server may ask for. Each costs one HMAC-SHA-256,
# about 1.6 us here, so this bounds what a hostile server can make a connect
# spend at about 1.6 s. PostgreSQL's default is 4,096 and OWASP's figure for
# PBKDF2-SHA-256 is 600,000. Raise it if a server needs more.
var PG_SCRAM_MAX_ITERATIONS = 1000000;

# How long pg_connect_tls gives the TLS handshake, in ns.
var PG_TLS_HANDSHAKE_NS = 30000000000;

# Hi(password, salt, i): PBKDF2-HMAC-SHA-256, one 32-byte block (RFC 5802
# §2.2). Writes 32 bytes to `out`. Returns 0, or -1 when out of memory.
fn _pg_scram_hi(pw, pwlen, salt, saltlen, iters, out) {
    var first = fl_alloc(saltlen + 4);
    if (first == 0) { return 0 - 1; }
    memcpy(first, salt, saltlen);
    _pg_write_be32(first, saltlen, 1);
    var u[32];
    hmac_sha256(pw, pwlen, first, saltlen + 4, &u);
    fl_free(first);
    memcpy(out, &u, 32);
    var i = 1;
    while (i < iters) {
        # In place: hmac_sha256 reads all of its message before writing out.
        hmac_sha256(pw, pwlen, &u, 32, &u);
        var j = 0;
        while (j < 32) {
            store64(out + j, load64(out + j) ^ load64(&u + j));
            j = j + 8;
        }
        i = i + 1;
    }
    memset(&u, 0, 32);
    return 0;
}

# The client's proof and the server signature to expect, for one exchange
# whose AuthMessage is `auth` (RFC 5802 §3). Writes 32 bytes to each of
# `proof` and `server_sig`. Returns 0, or -1 when out of memory. Every
# password-derived key is zeroed before return.
fn _pg_scram_compute(pw, pwlen, salt, saltlen, iters, auth, authlen, proof, server_sig) {
    var salted[32];
    var ckey[32];
    var stored[32];
    var csig[32];
    var skey[32];
    if (_pg_scram_hi(pw, pwlen, salt, saltlen, iters, &salted) < 0) { return 0 - 1; }
    hmac_sha256(&salted, 32, "Client Key", 10, &ckey);
    sha256(&ckey, 32, &stored);
    hmac_sha256(&stored, 32, auth, authlen, &csig);
    var j = 0;
    while (j < 32) {
        store64(proof + j, load64(&ckey + j) ^ load64(&csig + j));
        j = j + 8;
    }
    hmac_sha256(&salted, 32, "Server Key", 10, &skey);
    hmac_sha256(&skey, 32, auth, authlen, server_sig);
    memset(&salted, 0, 32);
    memset(&ckey, 0, 32);
    memset(&stored, 0, 32);
    memset(&csig, 0, 32);
    memset(&skey, 0, 32);
    return 0;
}

# 1 if an AuthenticationSASL body (`d`, `n` bytes, from the type word on)
# offers SCRAM-SHA-256. The names are NUL-terminated; an empty one ends them.
fn _pg_sasl_offers_scram(d, n) {
    var p = 4;
    while (p < n) {
        var e = p;
        while (e < n && load8(d + e) != 0) { e = e + 1; }
        if (e == n) { return 0; }
        if (e == p) { return 0; }
        if (e - p == 13) {
            if (memeq(d + p, "SCRAM-SHA-256", 13) == 1) { return 1; }
        }
        p = e + 1;
    }
    return 0;
}

# Parse a server-first-message (`m`, `n` bytes) answering client nonce `cn`.
# Returns a 40-byte block {nonce, nonce_len, salt, salt_len, iterations}
# (`nonce` points into `m`; `salt` is decoded, release the block with
# _pg_scram_first_free), or 0 when it is malformed or not an answer to us.
fn _pg_scram_parse_first(m, n, cn, cnlen) {
    # "r=" first: a leading "m=" is a mandatory extension, which a client that
    # does not implement it must refuse (RFC 5802 §5.1).
    if (n < 2) { return 0; }
    if (load8(m) != 114 || load8(m + 1) != 61) { return 0; }
    var p = 2;
    while (p < n && load8(m + p) != 44) {
        var c = load8(m + p);
        if (c < 33 || c > 126) { return 0; }
        p = p + 1;
    }
    var nlen = p - 2;
    # The combined nonce is ours plus the server's part.
    if (nlen <= cnlen) { return 0; }
    if (memeq(m + 2, cn, cnlen) == 0) { return 0; }
    if (p + 3 > n) { return 0; }
    if (load8(m + p + 1) != 115 || load8(m + p + 2) != 61) { return 0; }
    p = p + 3;
    var ss = p;
    while (p < n && load8(m + p) != 44) { p = p + 1; }
    var slen = p - ss;
    if (p + 3 > n) { return 0; }
    if (load8(m + p + 1) != 105 || load8(m + p + 2) != 61) { return 0; }
    p = p + 3;
    # A positive decimal with no leading zero, within PG_SCRAM_MAX_ITERATIONS.
    if (p >= n) { return 0; }
    if (load8(m + p) < 49 || load8(m + p) > 57) { return 0; }
    var iters = 0;
    while (p < n && load8(m + p) != 44) {
        var d = load8(m + p);
        if (d < 48 || d > 57) { return 0; }
        iters = iters * 10 + (d - 48);
        if (iters > PG_SCRAM_MAX_ITERATIONS) { return 0; }
        p = p + 1;
    }
    var sd = majra_base64_decode(m + ss, slen);
    if (sd == 0) { return 0; }
    if (load64(sd + 8) < 1) { fl_free(load64(sd)); fl_free(sd); return 0; }
    var r = fl_alloc(40);
    if (r == 0) { fl_free(load64(sd)); fl_free(sd); return 0; }
    store64(r, m + 2);
    store64(r + 8, nlen);
    store64(r + 16, load64(sd));
    store64(r + 24, load64(sd + 8));
    store64(r + 32, iters);
    fl_free(sd);
    return r;
}

fn _pg_scram_first_free(r) {
    if (r == 0) { return 0; }
    fl_free(load64(r + 16));
    fl_free(r);
    return 0;
}

# 1 if a server-final-message (`m`, `n` bytes) carries the signature we
# computed. "e=" (the server's error) and anything malformed answer 0.
fn _pg_scram_check_final(m, n, server_sig) {
    if (n < 2) { return 0; }
    if (load8(m) != 118 || load8(m + 1) != 61) { return 0; }
    var e = 2;
    while (e < n && load8(m + e) != 44) { e = e + 1; }
    var d = majra_base64_decode(m + 2, e - 2);
    if (d == 0) { return 0; }
    var ok = 0;
    if (load64(d + 8) == 32) { ok = ct_eq_bytes(load64(d), server_sig, 32); }
    fl_free(load64(d));
    fl_free(d);
    return ok;
}

# Build the client-final-message for a parsed server-first `sf` (the raw
# message `sfm`, `sfn` bytes) and client-first-bare `cfb`. Returns an
# fl_alloc'd buffer (its length via rethi) and writes the server signature to
# expect into `server_sig`; 0 on failure. The buffer holds the proof: zero it
# before freeing.
fn _pg_scram_final(password, cfb, cfblen, sfm, sfn, sf, server_sig) {
    var nonce = load64(sf);
    var nlen = load64(sf + 8);
    # client-final-message-without-proof: c=biws (base64 of "n,,"), r=nonce
    var wlen = 9 + nlen;
    var authlen = cfblen + 1 + sfn + 1 + wlen;
    var auth = fl_alloc(authlen);
    if (auth == 0) { ret2(0, 0); }
    memcpy(auth, cfb, cfblen);
    store8(auth + cfblen, 44);
    memcpy(auth + cfblen + 1, sfm, sfn);
    store8(auth + cfblen + 1 + sfn, 44);
    var w = auth + cfblen + 1 + sfn + 1;
    memcpy(w, "c=biws,r=", 9);
    memcpy(w + 9, nonce, nlen);
    var proof[32];
    var rc = _pg_scram_compute(password, strlen(password), load64(sf + 16), load64(sf + 24),
      load64(sf + 32), auth, authlen, &proof, server_sig);
    if (rc < 0) { fl_free(auth); ret2(0, 0); }
    var p64 = majra_base64_encode(&proof, 32);
    memset(&proof, 0, 32);
    if (p64 == 0) { fl_free(auth); ret2(0, 0); }
    var flen = wlen + 3 + 44;
    var out = fl_alloc(flen + 1);
    if (out != 0) {
        memcpy(out, w, wlen);
        memcpy(out + wlen, ",p=", 3);
        memcpy(out + wlen + 3, p64, 44);
        store8(out + flen, 0);
    }
    memset(p64, 0, 44);
    fl_free(p64);
    fl_free(auth);
    if (out == 0) { ret2(0, 0); }
    ret2(out, flen);
}

# SASLInitialResponse ('p'): the mechanism name, then the client-first-message
# with its length. Returns the byte count, or a negative.
fn _pg_send_sasl_initial(conn, cf, cflen) {
    var msg_len = 4 + 14 + 4 + cflen;
    var msg = fl_alloc(1 + msg_len);
    if (msg == 0) { return 0 - 2; }
    store8(msg, PG_MSG_PASSWORD);
    _pg_write_be32(msg, 1, msg_len);
    memcpy(msg + 5, "SCRAM-SHA-256", 13);
    store8(msg + 18, 0);
    _pg_write_be32(msg, 19, cflen);
    memcpy(msg + 23, cf, cflen);
    var rc = _pg_send_full(conn, msg, 1 + msg_len);
    fl_free(msg);
    return rc;
}

# SASLResponse ('p'): the client-final-message. Zeroed after sending: it
# carries the proof.
fn _pg_send_sasl_response(conn, data, dlen) {
    var msg_len = 4 + dlen;
    var msg = fl_alloc(1 + msg_len);
    if (msg == 0) { return 0 - 2; }
    store8(msg, PG_MSG_PASSWORD);
    _pg_write_be32(msg, 1, msg_len);
    memcpy(msg + 5, data, dlen);
    var rc = _pg_send_full(conn, msg, 1 + msg_len);
    memset(msg, 0, 1 + msg_len);
    fl_free(msg);
    return rc;
}

# Run the authentication exchange to AuthenticationOk. Returns 0, or -1 when
# authentication fails or the server breaks the protocol.
#
# ⚠ A SCRAM exchange, once started, must reach a VERIFIED server-final before
# AuthenticationOk is accepted. A server (or anyone in the path of a plaintext
# connection) that skips SASLFinal and sends AuthenticationOk would otherwise
# have skipped the one step that proves it knows the verifier.
fn _pg_authenticate(conn, password) {
    var scram = 0;          # 0 none, 1 sent client-first, 2 sent client-final, 3 verified
    var cf1 = 0;            # client-first-message, fl_alloc'd; the bare part is cf1 + 3
    var cfblen = 0;
    var ssig[32];
    var rounds = 0;
    var result = 0 - 1;
    var done = 0;
    while (done == 0 && rounds < 8) {
        rounds = rounds + 1;
        var msg = _pg_read_msg(conn);
        if (msg == 0) { done = 1; }
        elif (load64(msg) != PG_MSG_AUTH) {
            # ErrorResponse (a refused login) or anything else before
            # AuthenticationOk ends the attempt.
            _pg_msg_free(msg);
            done = 1;
        } elif (load64(msg + 16) < 4) {
            # A body of exactly 4 bytes is all type word; shorter is malformed
            # (and used to be a null dereference).
            _pg_msg_free(msg);
            done = 1;
        } else {
            var d = load64(msg + 8);
            var n = load64(msg + 16);
            var at = _pg_read_be32(d, 0);
            if (at == PG_AUTH_OK) {
                if (scram == 0 || scram == 3) { result = 0; }
                done = 1;
            } elif (at == PG_AUTH_CLEARTEXT && scram == 0) {
                if (password == 0) { done = 1; }
                elif (_pg_send_password(conn, password) < 0) { done = 1; }
            } elif (at == PG_AUTH_SASL && scram == 0) {
                if (password == 0) { done = 1; }
                elif (_pg_sasl_offers_scram(d, n) == 0) { done = 1; }
                else {
                    # 18 random bytes make a 24-character nonce, no padding.
                    var raw[24];
                    if (random_bytes(&raw, 18) != 18) { done = 1; }
                    else {
                        var cn = majra_base64_encode(&raw, 18);
                        memset(&raw, 0, 24);
                        cfblen = 5 + 24;
                        cf1 = fl_alloc(3 + cfblen);
                        if (cn == 0 || cf1 == 0) { done = 1; }
                        else {
                            # client-first = the "n,," gs2 header (no channel
                            # binding), then client-first-bare "n=,r=<nonce>".
                            memcpy(cf1, "n,,", 3);
                            memcpy(cf1 + 3, "n=,r=", 5);
                            memcpy(cf1 + 8, cn, 24);
                            if (_pg_send_sasl_initial(conn, cf1, 3 + cfblen) < 0) { done = 1; }
                            else { scram = 1; }
                        }
                        if (cn != 0) { fl_free(cn); }
                    }
                }
            } elif (at == PG_AUTH_SASL_CONTINUE && scram == 1) {
                var sf = _pg_scram_parse_first(d + 4, n - 4, cf1 + 8, 24);
                if (sf == 0) { done = 1; }
                else {
                    var cf = _pg_scram_final(password, cf1 + 3, cfblen, d + 4, n - 4, sf, &ssig);
                    var cflen = rethi();
                    _pg_scram_first_free(sf);
                    if (cf == 0) { done = 1; }
                    else {
                        if (_pg_send_sasl_response(conn, cf, cflen) < 0) { done = 1; }
                        else { scram = 2; }
                        memset(cf, 0, cflen);
                        fl_free(cf);
                    }
                }
            } elif (at == PG_AUTH_SASL_FINAL && scram == 2) {
                if (_pg_scram_check_final(d + 4, n - 4, &ssig) == 1) { scram = 3; }
                else { done = 1; }
            } else {
                # MD5 (5), GSSAPI, SSPI, or a SASL step out of order.
                done = 1;
            }
            _pg_msg_free(msg);
        }
    }
    if (cf1 != 0) { fl_free(cf1); }
    memset(&ssig, 0, 32);
    return result;
}

# The TLS hook: trust `ca_file` (PEM) instead of the system roots. Non-zero
# fails the connect. Called by lib/tls.cyr as hook(hook_ctx, handle).
fn _pg_tls_hook(ca_file, handle) {
    if (tls_ctx_load_verify_locations(handle, ca_file, 0) != 1) { return 1; }
    return 0;
}

# SSLRequest, then the TLS handshake on the connection's socket. Returns 0,
# or -1. The ctx and its arena are on the handle as soon as they exist, so the
# caller's teardown releases them on every failure path.
fn _pg_start_tls(conn, host, server_name, ca_file) {
    var fd = load64(conn);
    var req[8];
    _pg_write_be32(&req, 0, 8);
    _pg_write_be32(&req, 4, 80877103);
    if (_pg_write_full(fd, &req, 8) != 8) { return 0 - 1; }
    # Exactly one byte, read straight off the socket: 'S' (83) goes ahead.
    # 'N' is a server that will not do TLS, which this call refuses rather than
    # fall back to plaintext; anything else is not an answer. Nothing more is
    # read before the handshake, so a byte injected after the 'S' is the TLS
    # stack's to reject, never a protocol message (the CVE-2021-23222 class).
    var b[8];
    if (_pg_read_full(fd, &b, 1) != 1) { return 0 - 1; }
    if (load8(&b) != 83) { return 0 - 1; }
    var name = server_name;
    if (name == 0) { name = host; }
    if (name == 0 || strlen(name) == 0) { name = "127.0.0.1"; }
    var a = _pg_tls_arena_take();
    if (a == 0) { return 0 - 1; }
    store64(conn + 24, a);
    var hook = 0;
    if (ca_file != 0) { hook = &_pg_tls_hook; }
    var ctx = tls_connect_alloc_in(a, fd, name, hook, ca_file);
    if (ctx == 0) { return 0 - 1; }
    store64(conn + 16, ctx);
    tls_set_deadline(ctx, clock_now_ns() + PG_TLS_HANDSHAKE_NS);
    if (tls_connect_complete(ctx) != 1) { return 0 - 1; }
    # The handshake's bound only: queries are not timed, over TLS or not.
    tls_set_deadline(ctx, 0);
    return 0;
}

# Shared by pg_connect and pg_connect_tls. Returns PgConn or 0.
fn _pg_connect_impl(host, port, user, database, password, use_tls, server_name, ca_file) {
    # `host` used to be accepted and then ignored — every connection went to
    # INADDR_LOOPBACK() no matter what the caller asked for. Now parsed; a
    # non-dotted-quad host is a hard failure rather than a silent redirect to
    # localhost. (No resolver in the stdlib: pass an IPv4 literal.)
    var addr = INADDR_LOOPBACK();
    if (host != 0 && strlen(host) > 0) {
        addr = majra_parse_ipv4(host);
        if (addr < 0) { return 0; }
    }
    # `_SYS_SOCKET` / `_SYS_CONNECT`: see the note in src/redis_backend.cyr.
    var fd = syscall(_SYS_SOCKET, AF_INET, SOCK_STREAM, 0);
    if (fd < 0) { return 0; }
    var sa = sockaddr_in(addr, port);
    if (syscall(_SYS_CONNECT, fd, sa, 16) < 0) {
        syscall(SYS_CLOSE, fd);
        return 0;
    }
    var conn = fl_alloc(32);
    if (conn == 0) {
        syscall(SYS_CLOSE, fd);
        return 0;
    }
    store64(conn, fd);
    store64(conn + 8, 0);
    store64(conn + 16, 0);
    store64(conn + 24, 0);

    if (use_tls == 1) {
        if (_pg_start_tls(conn, host, server_name, ca_file) != 0) { return _pg_connect_fail(conn, 0); }
    }
    # A startup message that was never sent would leave the read below blocked
    # forever on a server still waiting for it.
    if (_pg_startup(conn, user, database) < 0) { return _pg_connect_fail(conn, 0); }
    if (_pg_authenticate(conn, password) != 0) { return _pg_connect_fail(conn, 0); }

    # Read until ReadyForQuery. A _pg_read_msg failure is NOT equivalent to
    # ReadyForQuery: treating it as such handed back a fully-formed connection
    # struct for a socket that had already failed or closed, and every later
    # pg_query on it returned an empty row set indistinguishable from "no
    # rows". Fail the connect instead.
    var done = 0;
    while (done == 0) {
        var msg = _pg_read_msg(conn);
        if (msg == 0) { return _pg_connect_fail(conn, 0); }
        if (load64(msg) == PG_MSG_READY) { done = 1; }
        _pg_msg_free(msg);
    }
    store64(conn + 8, 1);
    return conn;
}

# Connect to PostgreSQL over PLAINTEXT. Returns PgConn or 0. See the security
# note at the top of this file: use it only on a trusted path.
fn pg_connect(host, port, user, database, password) {
    return _pg_connect_impl(host, port, user, database, password, 0, 0, 0);
}

# Connect to PostgreSQL over TLS (2.13.0). Returns PgConn or 0.
#
#   host         the server's IPv4 address, as for pg_connect
#   server_name  the name its certificate must carry: a DNS name, or an IP
#                literal (matched against the certificate's IP SANs). 0 uses
#                `host`.
#   ca_file      a PEM file of trusted CAs (a private CA, or a self-signed
#                server's own certificate). 0 uses the system roots.
#
# The certificate is always verified; there is no unverified mode. A server
# that answers the SSLRequest with 'N' is refused. Authentication then runs as
# for pg_connect, inside the TLS session.
fn pg_connect_tls(host, port, user, database, password, server_name, ca_file) {
    return _pg_connect_impl(host, port, user, database, password, 1, server_name, ca_file);
}

# 1 if `conn` is an open TLS connection, else 0 (2.13.0).
fn pg_conn_is_tls(conn) {
    if (conn == 0) { return 0; }
    if (load64(conn + 16) != 0) { return 1; }
    return 0;
}

# Sends Terminate and closes the connection (close_notify first, over TLS). The
# handle is not freed; afterwards it reads as closed, so a second pg_close or a
# pg_query on it is a no-op rather than a write to a reused fd number.
fn pg_close(conn) {
    if (conn == 0) { return 0; }
    if (load64(conn) >= 0) { _pg_terminate(conn); }
    _pg_close_transport(conn);
    return 0;
}

# Parse a DataRow body into a vec of fl_alloc'd C strings (0 for NULL).
# Returns 0 if the row is malformed — validated before anything is allocated.
fn _pg_parse_row(data, data_len) {
    # Every offset below is derived from the wire, so each one is bounded
    # against the message body the server actually sent.
    if (data == 0 || data_len < 2) { return 0; }
    var col_count = _pg_read_be16(data, 0);
    # Each column costs at least its own 4-byte length prefix.
    if (col_count > (data_len - 2) / 4) { return 0; }
    var pos = 2;
    var ci = 0;
    while (ci < col_count) {
        if (pos + 4 > data_len) { return 0; }
        # SIGNED read: PostgreSQL encodes NULL as length -1, and the
        # zero-extending _pg_read_be32 turned that into 4294967295 — a 4 GiB
        # alloc + 4 GiB memcpy on any NULL.
        var col_len = _pg_read_i32(data, pos);
        pos = pos + 4;
        if (col_len > data_len - pos) { return 0; }
        if (col_len > 0) { pos = pos + col_len; }
        ci = ci + 1;
    }
    var row = _majra_vec_new();
    pos = 2;
    ci = 0;
    while (ci < col_count) {
        var cl = _pg_read_i32(data, pos);
        pos = pos + 4;
        if (cl < 0) {
            _majra_vec_push(row, 0);
        } else {
            var val = fl_alloc(cl + 1);
            if (val == 0) {
                var fi = 0;
                while (fi < vec_len(row)) {
                    var old = vec_get(row, fi);
                    if (old != 0) { fl_free(old); }
                    fi = fi + 1;
                }
                _majra_vec_free(row);   # 2.10.1: the cells were freed, the row was not
                return 0;
            }
            memcpy(val, data + pos, cl);
            store8(val + cl, 0);
            _majra_vec_push(row, val);
            pos = pos + cl;
        }
        ci = ci + 1;
    }
    return row;
}

# Run one simple query. Returns the rows (a vec when `collect` is 1, else 0)
# with a status via ret2: 0 on success, -1 if the server answered with
# ErrorResponse or the query could not be sent or read. Every failure other than
# ErrorResponse poisons the connection.
#
# ⚠ An abort must never just stop reading. The unread remainder of the result —
# the body of a message over PG_MAX_MSG, the rows after a malformed DataRow,
# CommandComplete, ReadyForQuery — stayed queued, and the next query on the
# handle consumed it as its own reply: an empty result first, then an earlier
# query's rows reported as its own. ErrorResponse is the one case with a known
# sync point, and it drains to it.
fn _pg_query_st(conn, sql, collect) {
    var rows = 0;
    if (collect == 1) { rows = _majra_vec_new(); }
    if (conn == 0 || sql == 0) { ret2(rows, -1); }
    if (load64(conn) < 0) { ret2(rows, -1); }
    var sr = _pg_send_query(conn, sql);
    if (sr < 0) {
        if (sr == -1) { _pg_poison(conn); }
        ret2(rows, -1);
    }

    var status = 0;
    var done = 0;
    while (done == 0) {
        var msg = _pg_read_msg(conn);
        if (msg == 0) { _pg_poison(conn); ret2(rows, -1); }
        var mtype = load64(msg);

        if (mtype == PG_MSG_ROW_DESC) {
            if (load64(msg + 8) == 0 || load64(msg + 16) < 2) {
                _pg_msg_free(msg);
                _pg_poison(conn);
                ret2(rows, -1);
            }
        }
        elif (mtype == PG_MSG_DATA_ROW) {
            if (collect == 1) {
                var row = _pg_parse_row(load64(msg + 8), load64(msg + 16));
                # A server sending malformed DataRows cannot be trusted to
                # reach ReadyForQuery either.
                if (row == 0) {
                    _pg_msg_free(msg);
                    _pg_poison(conn);
                    ret2(rows, -1);
                }
                _majra_vec_push(rows, row);
            }
        }
        elif (mtype == PG_MSG_ERROR) {
            # PostgreSQL ALWAYS sends ReadyForQuery after ErrorResponse.
            # Breaking here left it queued, so the next pg_query read the
            # previous query's ReadyForQuery as its own first message and
            # every subsequent result was offset by one. Drain to the real
            # sync point before returning.
            status = -1;
            while (done == 0) {
                var m2 = _pg_read_msg(conn);
                if (m2 == 0) {
                    _pg_msg_free(msg);
                    _pg_poison(conn);
                    ret2(rows, -1);
                }
                if (load64(m2) == PG_MSG_READY) { done = 1; }
                _pg_msg_free(m2);
            }
        }
        elif (mtype == PG_MSG_READY) {
            done = 1;
        }
        _pg_msg_free(msg);
    }
    ret2(rows, status);
}

# Execute a SQL query. Returns vec of rows, where each row is a vec of column values (C strings).
fn pg_query(conn, sql) {
    return _pg_query_st(conn, sql, 1);
}

# Execute a SQL statement (no result rows expected).
fn pg_exec(conn, sql) {
    return pg_query(conn, sql);
}

# Release the rows vector `pg_query` / `pg_exec` returned, with every cell.
#
# 2.9.0. Before this, rows and cells came off the BUMP allocator and a
# long-lived client grew without bound; they are freelist-backed now, and this
# is how a caller gives them back. Each cell is a NUL-terminated buffer (0 for
# SQL NULL), so a caller that kept a cell pointer must copy it first.
fn pg_rows_free(rows) {
    if (rows == 0) { return 0; }
    var i = 0;
    while (i < vec_len(rows)) {
        var row = vec_get(rows, i);
        if (row != 0) {
            var c = 0;
            while (c < vec_len(row)) {
                var cell = vec_get(row, c);
                if (cell != 0) { fl_free(cell); }
                c = c + 1;
            }
            _majra_vec_free(row);
        }
        i = i + 1;
    }
    _majra_vec_free(rows);
    return 0;
}

# --- Workflow Storage over PostgreSQL ---

# Run a _pg_q statement and release it. Returns the _pg_query_st status (-1 if
# the text could not be built).
fn _pg_q_exec(conn, q) {
    var sql = _pg_q_sql(q);
    var st = -1;
    if (sql != 0) {
        _pg_query_st(conn, sql, 0);
        st = rethi();
    }
    _pg_q_free(q);
    return st;
}

# Initialize tables for workflow storage.
fn pg_init_workflow_tables(conn) {
    {
        var q = _pg_q_new();
        if (q != 0) {
            _pg_q_cstr(q, "CREATE TABLE IF NOT EXISTS majra_workflow_definitions (id TEXT PRIMARY KEY, ");
            _pg_q_cstr(q, "name TEXT NOT NULL, description TEXT, steps_json TEXT NOT NULL DEFAULT '[]', ");
            _pg_q_cstr(q, "enabled BOOLEAN NOT NULL DEFAULT TRUE, version INTEGER NOT NULL DEFAULT 1, ");
            _pg_q_cstr(q, "created_by TEXT NOT NULL DEFAULT 'system', created_at BIGINT NOT NULL, ");
            _pg_q_cstr(q, "updated_at BIGINT NOT NULL)");
            _pg_q_exec(conn, q);
        }
    }
    {
        var q = _pg_q_new();
        if (q != 0) {
            _pg_q_cstr(q, "CREATE TABLE IF NOT EXISTS majra_workflow_runs (id TEXT PRIMARY KEY, ");
            _pg_q_cstr(q, "workflow_id TEXT NOT NULL, workflow_name TEXT NOT NULL, ");
            _pg_q_cstr(q, "status TEXT NOT NULL DEFAULT 'pending', input_json TEXT, output_json TEXT, ");
            _pg_q_cstr(q, "error TEXT, triggered_by TEXT NOT NULL DEFAULT 'manual', ");
            _pg_q_cstr(q, "created_at BIGINT NOT NULL, ");
            _pg_q_cstr(q, "started_at BIGINT, completed_at BIGINT)");
            _pg_q_exec(conn, q);
        }
    }
    {
        var q = _pg_q_new();
        if (q != 0) {
            _pg_q_cstr(q, "CREATE TABLE IF NOT EXISTS majra_workflow_step_runs (id TEXT PRIMARY KEY, ");
            _pg_q_cstr(q, "run_id TEXT NOT NULL, step_id TEXT NOT NULL, step_name TEXT NOT NULL, ");
            _pg_q_cstr(q, "status TEXT NOT NULL DEFAULT 'pending', input_json TEXT, output_json TEXT, ");
            _pg_q_cstr(q, "error TEXT, attempt INTEGER NOT NULL DEFAULT 1, started_at BIGINT, ");
            _pg_q_cstr(q, "completed_at BIGINT, duration_ms BIGINT)");
            _pg_q_exec(conn, q);
        }
    }
    # Non-collecting (2.10.1): pg_exec collects a rows vec, which these dropped.
    _pg_query_st(conn, "CREATE INDEX IF NOT EXISTS idx_majra_wf_runs_workflow ON majra_workflow_runs(workflow_id)", 0);
    _pg_query_st(conn, "CREATE INDEX IF NOT EXISTS idx_majra_wf_step_runs_run ON majra_workflow_step_runs(run_id)", 0);
}

# Save a workflow definition (upsert). Returns 0, or -1 on failure.
#
# ⚠ -1 includes a server-side rejection. This returned 0 whenever the SQL could
# be built — a read-only hot standby after failover, a missing table, a
# statement_timeout or a dead connection all reported the definition as
# persisted.
fn pg_save_workflow_def(conn, def_id, name, steps_json) {
    var q = _pg_q_new();
    if (q == 0) { return -1; }
    _pg_q_cstr(q, "INSERT INTO majra_workflow_definitions ");
    _pg_q_cstr(q, "(id, name, steps_json, created_at, updated_at) VALUES (");
    if (_pg_q_lit(q, def_id) < 0) { _pg_q_free(q); return -1; }
    _pg_q_cstr(q, ", ");
    if (_pg_q_lit(q, name) < 0) { _pg_q_free(q); return -1; }
    _pg_q_cstr(q, ", ");
    if (_pg_q_lit(q, steps_json) < 0) { _pg_q_free(q); return -1; }
    var now = time_now_ns() / 1000000;
    _pg_q_cstr(q, ", ");
    _pg_q_int(q, now);
    _pg_q_cstr(q, ", ");
    _pg_q_int(q, now);
    _pg_q_cstr(q, ") ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, ");
    _pg_q_cstr(q, "steps_json = EXCLUDED.steps_json, updated_at = EXCLUDED.updated_at");
    if (_pg_q_exec(conn, q) != 0) { return -1; }
    return 0;
}

# Get a workflow definition by ID. Returns first row or 0 (not found, or the
# query failed).
fn pg_get_workflow_def(conn, def_id) {
    var q = _pg_q_new();
    if (q == 0) { return 0; }
    _pg_q_cstr(q, "SELECT id, name, steps_json FROM majra_workflow_definitions WHERE id = ");
    if (_pg_q_lit(q, def_id) < 0) { _pg_q_free(q); return 0; }
    var sql = _pg_q_sql(q);
    if (sql == 0) { _pg_q_free(q); return 0; }
    var rows = _pg_query_st(conn, sql, 1);
    var st = rethi();
    _pg_q_free(q);
    if (st != 0) { return 0; }
    if (vec_len(rows) == 0) { return 0; }
    return vec_get(rows, 0);
}

# Delete a workflow definition. Returns 0, or -1 on failure (including a
# server-side rejection — see pg_save_workflow_def).
fn pg_delete_workflow_def(conn, def_id) {
    var q = _pg_q_new();
    if (q == 0) { return -1; }
    _pg_q_cstr(q, "DELETE FROM majra_workflow_definitions WHERE id = ");
    if (_pg_q_lit(q, def_id) < 0) { _pg_q_free(q); return -1; }
    if (_pg_q_exec(conn, q) != 0) { return -1; }
    return 0;
}
