# majra/fleet — distributed job queue with work-stealing
#
# Wraps ManagedQueue to provide per-node job assignment and rebalancing.

# FleetQueueConfig struct (24 bytes):
#   offset  0: steal_threshold (i64) — min items before stealing from a node
#   offset  8: max_steal_batch (i64) — max items to steal per rebalance
#   offset 16: max_concurrent (i64) — per-node concurrency limit

fn fleet_config_new(steal_threshold, max_steal_batch, max_concurrent) {
    var cfg = fl_alloc(24);
    store64(cfg, steal_threshold);
    store64(cfg + 8, max_steal_batch);
    store64(cfg + 16, max_concurrent);
    return cfg;
}

# FleetQueue struct (24 bytes):
#   offset  0: nodes (i64) — hashmap: node_id_str -> ManagedQueue ptr
#   offset  8: config (i64) — FleetQueueConfig ptr
#   offset 16: mutex (i64)

fn fleet_new(config) {
    var fq = fl_alloc(24);
    store64(fq, map_new());
    store64(fq + 8, config);
    store64(fq + 16, mutex_new());
    return fq;
}

# Register a node. Creates a per-node ManagedQueue.
#
# Re-registering an existing node_id is now a NO-OP that returns 0. It used to
# map_set a fresh ManagedQueue over the existing entry, silently discarding
# every job already queued or running on that node and leaking the old queue —
# and a re-register on reconnect is exactly what a flapping node does.
# Returns 1 if a node was created, 0 if it already existed.
#
# ⚠ node_id is COPIED. The hashmap stores the key pointer by reference, so a
# caller that parsed the id out of a reused frame buffer (or freed it) left the
# map keyed on overwritten bytes: the node became unfindable and the next
# fleet_submit crashed. Same hazard _ratelimit_key_own closed. The queue gets
# its own copy because it can outlive the map entry (fleet_node_queue handles).
fn fleet_register_node(fq, node_id) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    if (map_get(load64(fq), node_id) != 0) {
        mutex_unlock(mtx);
        return 0;
    }
    var cfg = load64(fq + 8);
    var mq = mq_new(_fleet_id_own(node_id), load64(cfg + 16));
    map_set(load64(fq), _fleet_id_own(node_id), mq);
    mutex_unlock(mtx);
    return 1;
}

fn _fleet_id_own(id) {
    var n = strlen(id);
    var p = fl_alloc(n + 1);
    memcpy(p, id, n);
    store8(p + n, 0);
    return p;
}

# The map's own copy of node_id, or 0. Caller must hold the fleet mutex.
fn _fleet_stored_id(nodes, node_id) {
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var ki = 0;
    while (ki < cap) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) == 1) {
            if (streq(load64(ep), node_id) == 1) { return load64(ep); }
        }
        ki = ki + 1;
    }
    return 0;
}

# Move the next QUEUED job from `src` to `dst` WITHOUT reallocating it.
# Returns 0 if src had nothing queued, 1 if a job moved, 2 if dst is 0 and the
# job was taken as an orphan. Caller must hold the fleet mutex.
#
# ⚠ Moving used to be mq_take_queued + mq_enqueue + queue_item_free, which
# freed the QueueItem fleet_submit had handed to the caller. Their handle then
# aliased whatever reused that 40-byte block, so queue_item_payload returned
# another job's data and mq_cancel read a foreign key. The SAME item and its
# ManagedItem (id, enqueued_at) now move; cancel against the node holding it.
# Taken items are never freed here — cancelled or orphaned, the handle is
# still the submitter's.
fn _fleet_move_job(src, dst) {
    var smtx = load64(src + 16);
    var sjobs = load64(src + 8);
    var item = 0;
    var mi = 0;
    var searching = 1;
    while (searching == 1) {
        mutex_lock(smtx);
        var it = cpq_dequeue(load64(src));
        if (it == 0) {
            mutex_unlock(smtx);
            return 0;
        }
        var skey = load64(it + 32);
        var m = map_get(sjobs, skey);
        if (m != 0) { map_delete(sjobs, skey); }
        mutex_unlock(smtx);
        if (m == 0) {
            # Untracked item: give it a fresh tracking entry rather than drop
            # it, as the old re-enqueue did.
            m = fl_alloc(72);
            store64(m, load64(it));
            store64(m + 8, load64(it + 8));
            store64(m + 16, load64(it + 16));
            store64(m + 24, load64(it + 24));
            store64(m + 32, JOB_QUEUED);
            store64(m + 40, time_now_ns());
            store64(m + 48, 0);
            store64(m + 56, 0);
            store64(m + 64, 0);
        }
        if (load64(m + 32) == JOB_CANCELLED) {
            fl_free(m);
        } else {
            item = it;
            mi = m;
            searching = 0;
        }
    }

    if (dst == 0) {
        fl_free(mi);
        return 2;
    }

    var dmtx = load64(dst + 16);
    var djobs = load64(dst + 8);
    mutex_lock(dmtx);
    # ⚠ Keys are only unique per queue: _next_job_key's global is serialised
    # by each queue's own mutex, not across queues. Re-key on a clash so the
    # map_set cannot overwrite a job already tracked on dst.
    var key = load64(item + 32);
    while (map_get(djobs, key) != 0) { key = _next_job_key(); }
    store64(item + 32, key);
    map_set(djobs, key, mi);
    mutex_unlock(dmtx);

    cpq_enqueue(load64(dst), item);
    var vt = load64(dst + 48);
    if (vt != 0) {
        metrics_queue_enqueued(vt, load64(dst + 24), load64(item + 16));
    }
    return 1;
}

# Deregister a node, redistributing whatever it still holds.
#
# This used to drop the map entry and walk away, discarding every queued job on
# that node and leaking the ManagedQueue. Queued work is now moved to the
# least-loaded remaining node; if the node was the last one, the jobs are
# genuinely undeliverable and the count is returned so the caller can react.
# Returns the number of jobs that could NOT be rehomed.
fn fleet_deregister_node(fq, node_id) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var nodes = load64(fq);
    var mq = map_get(nodes, node_id);
    if (mq == 0) { mutex_unlock(mtx); return 0; }
    var stored = _fleet_stored_id(nodes, node_id);
    map_delete(nodes, node_id);
    # Free strictly AFTER the delete, which needs the key to find the entry;
    # the tombstone's stale pointer is never key-compared.
    if (stored != 0) { fl_free(stored); }

    # Take queued jobs directly, NOT via mq_dequeue. mq_dequeue refuses once
    # running_count reaches max_concurrent, so a node with jobs already running
    # would have dropped out of this loop immediately and discarded every
    # QUEUED job — the same silent job loss deregister was supposed to stop.
    var orphaned = 0;
    var draining = 1;
    while (draining == 1) {
        var tid = _fleet_select_node(fq);
        var dst = 0;
        if (tid != 0) { dst = map_get(nodes, tid); }
        var moved = _fleet_move_job(mq, dst);
        if (moved == 0) { draining = 0; }
        elif (moved == 2) { orphaned = orphaned + 1; }
    }
    mutex_unlock(mtx);
    return orphaned;
}

# Get the ManagedQueue for a node.
#
# Reads of the node map now take the mutex. fleet_node_queue and fleet_stats
# read it while register/deregister mutate it under the lock, so a concurrent
# rehash could hand back a stale bucket pointer.
fn fleet_node_queue(fq, node_id) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var mq = map_get(load64(fq), node_id);
    mutex_unlock(mtx);
    return mq;
}

# Select the least-loaded node. Returns node_id string or 0.
#
# Iterates the hashmap slot array directly (24-byte slots: key@0, value@8,
# occupied@16) rather than calling map_keys. map_keys builds a vec from the
# BUMP allocator, which never reclaims — and this runs on every fleet_submit,
# so a long-lived fleet leaked a vec per submitted job. Same change in
# fleet_rebalance and fleet_stats.
#
# Caller must hold the fleet mutex.
fn _fleet_select_node(fq) {
    var nodes = load64(fq);
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var best_id = 0;
    var best_load = 0;
    var ki = 0;
    while (ki < cap) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) == 1) {
            var mq = load64(ep + 8);
            var load = mq_queued_count(mq) + mq_running_count(mq);
            if (best_id == 0 || load < best_load) {
                best_load = load;
                best_id = load64(ep);
            }
        }
        ki = ki + 1;
    }
    return best_id;
}

# Submit a job to the least-loaded node. Returns the QueueItem or 0.
fn fleet_submit(fq, priority, payload) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var node_id = _fleet_select_node(fq);
    if (node_id == 0) {
        mutex_unlock(mtx);
        return 0;
    }
    var mq = map_get(load64(fq), node_id);
    # ⚠ Enqueue BEFORE unlocking. Unlocking first let a concurrent
    # fleet_deregister_node remove and drain `mq` in the gap, so the job landed
    # in a queue nothing would ever read — lost, with a success-shaped return.
    # fleet -> mq is the lock order deregister already takes.
    var it = mq_enqueue(mq, priority, payload);
    mutex_unlock(mtx);
    return it;
}

# Rebalance: steal from overloaded nodes and assign to underloaded.
# Returns number of jobs stolen.
fn fleet_rebalance(fq) {
    var cfg = load64(fq + 8);
    var threshold = load64(cfg);
    var max_batch = load64(cfg + 8);
    var mtx = load64(fq + 16);
    mutex_lock(mtx);

    var nodes = load64(fq);
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var stolen = 0;

    # Find overloaded and underloaded nodes
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var mq = load64(ep + 8);
            var queued = mq_queued_count(mq);

            if (queued > threshold) {
                # This node is overloaded — try to steal
                var to_steal = queued - threshold;
                if (to_steal > max_batch) { to_steal = max_batch; }

                # Find underloaded targets
                var j = 0;
                while (j < cap && to_steal > 0) {
                    var tp = entries + j * 24;
                    if (j != i && load64(tp + 16) == 1) {
                        var tmq = load64(tp + 8);
                        # Steal as many as this target can take, rather than
                        # one per (source, target) pair. The target index used
                        # to advance after every steal, so with two nodes
                        # max_steal_batch could never exceed 1 however it was
                        # configured.
                        var taking = 1;
                        while (taking == 1 && to_steal > 0 && mq_queued_count(tmq) < threshold) {
                            # Take the queued job, NOT mq_dequeue. A steal is
                            # not an execution: mq_dequeue would mark the job
                            # RUNNING, inflate the source's running_count, and
                            # — worse — REFUSE outright once that count hit
                            # max_concurrent, which is exactly the saturated
                            # node a rebalance most needs to relieve.
                            if (_fleet_move_job(mq, tmq) == 0) { taking = 0; }
                            else {
                                stolen = stolen + 1;
                                to_steal = to_steal - 1;
                            }
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }

    mutex_unlock(mtx);
    return stolen;
}

fn fleet_node_count(fq) {
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var n = map_size(load64(fq));
    mutex_unlock(mtx);
    return n;
}

# FleetQueueStats struct (32 bytes):
#   offset  0: total_nodes
#   offset  8: total_queued
#   offset 16: total_running
#   offset 24: total_completed
fn fleet_stats(fq) {
    var s = fl_alloc(32);
    var mtx = load64(fq + 16);
    mutex_lock(mtx);
    var nodes = load64(fq);
    var entries = map_entries(nodes);
    var cap = map_cap(nodes);
    var total_q = 0;
    var total_r = 0;
    var total_c = 0;
    var n = 0;
    var i = 0;
    while (i < cap) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var mq = load64(ep + 8);
            total_q = total_q + mq_queued_count(mq);
            total_r = total_r + mq_running_count(mq);
            total_c = total_c + mq_total_completed(mq);
            n = n + 1;
        }
        i = i + 1;
    }
    store64(s, n);
    store64(s + 8, total_q);
    store64(s + 16, total_r);
    store64(s + 24, total_c);
    mutex_unlock(mtx);
    return s;
}
