# majra/ipc — Unix domain socket IPC with length-prefixed framing
#
# Protocol: 4-byte big-endian length prefix + payload bytes.
# Blocking I/O (no async). Frames are capped at IPC_MAX_FRAME both ways.
#
# ⚠ ACCESS CONTROL: the bound socket's mode is set to 0600 (owner only) so a
# co-tenant local user cannot connect. It was previously left to the ambient
# umask, which on a typical 022 process yields a world-connectable socket —
# and majra performs no peer-credential check, so connecting IS authenticating.
# A caller needing group access must widen the mode itself after ipc_bind.

# Linux x86_64 syscall numbers for networking.
#
# These five are rows in the aarch64 backend's ESYSXLAT renumbering table
# (41→198, 42→203, 43→202, 49→200, 50→201 — decoded from the 6.6.4 emitter,
# unchanged in the 6.6.6 one, which routes 60 source numbers where 6.6.4
# routed 44), so they issue the right syscall on both Linux arches. They are
# kept as target-neutral `_SYS_*` names rather than the peers' `SYS_SOCKET`
# etc.
# because the agnos and Windows peers do not declare those, and the backends
# (`src/redis_backend.cyr`, `src/postgres_backend.cyr`) reuse the same numbers
# without a target guard.
#
# ⚠ `fchmod` (91) was NOT a row and so ran as capset(2) on aarch64-Linux —
# every `ipc_bind` failed there. It goes through the per-target `sys_fchmod`
# wrapper now (see `ipc_bind`); do not re-add a `var _SYS_FCHMOD` here.
# `sys_fchmod` exists on the two Linux peers and macOS (all via
# `lib/syscalls_linux_common.cyr`); the `#ifndef CYRIUS_TARGET_AGNOS` arms
# below are also what a Windows build would compile, and Windows has neither
# the wrapper nor AF_UNIX sockets — this transport has never been a Windows
# surface, and 2.7.2's raw 91 was no more meaningful there.
var _SYS_SOCKET = 41;
var _SYS_CONNECT = 42;
var _SYS_ACCEPT = 43;
var _SYS_BIND = 49;
var _SYS_LISTEN = 50;
var _SOCK_STREAM = 1;
var _AF_UNIX = 1;
# shutdown(2): 48 is also an ESYSXLAT row (48→210). On agnos 48 is
# SYS_SOCK_SEND, so `_ipc_shutdown` never issues it there.
var _SYS_SHUTDOWN = 48;
var _SHUT_RDWR = 2;
# Linux SOCK_CLOEXEC — same value on both Linux arches. Darwin rejects it in
# socket(2)'s type argument, so macOS sets FD_CLOEXEC with fcntl instead.
var _SOCK_CLOEXEC = 524288;

# sendto(2) is spelled per arch (sakshi does the same). Through cyrius 6.6.4
# it had to be: 44 was NOT an ESYSXLAT row, and raw 44 is fstatfs on aarch64.
# 6.6.5 added a `sendto 44→206` row, so a bare 44 would now be routed too —
# the per-arch form stays because it is correct under BOTH toolchains (206 is
# no row's source number, so nothing re-translates it) and a consumer builds
# the bundle under its own pin, not majra's. Used only on Linux — see
# `_ipc_write_full`.
#ifdef CYRIUS_TARGET_LINUX
#ifdef CYRIUS_ARCH_X86
var _IPC_SYS_SENDTO = 44;
#endif
#ifdef CYRIUS_ARCH_AARCH64
var _IPC_SYS_SENDTO = 206;
#endif
#endif
var _MSG_NOSIGNAL = 16384;

# Largest frame either direction will accept or emit. The receive side always
# had this cap; the send side did not, so majra could emit a frame that every
# majra receiver rejects.
var IPC_MAX_FRAME = 1048576;
# sockaddr_un.sun_path is 108 bytes including the NUL.
var IPC_MAX_PATH = 107;

# Parse a dotted-quad IPv4 literal into the little-endian packed form
# store32() expects (matching INADDR_LOOPBACK()'s 0x0100007F). Returns -1 if
# `host` is not a bare dotted quad.
fn majra_parse_ipv4(host) {
    var acc = 0;
    var octet = 0;
    var digits = 0;
    var shift = 0;
    var i = 0;
    var n = strlen(host);
    while (i <= n) {
        var ch = 0;
        if (i < n) { ch = load8(host + i); }
        if (i == n || ch == 46) {
            if (digits == 0 || octet > 255) { return -1; }
            if (shift > 24) { return -1; }
            acc = acc | (octet << shift);
            shift = shift + 8;
            octet = 0;
            digits = 0;
        } elif (ch >= 48 && ch <= 57) {
            octet = octet * 10 + (ch - 48);
            digits = digits + 1;
            if (digits > 3) { return -1; }
        } else {
            return -1;
        }
        i = i + 1;
    }
    if (shift != 32) { return -1; }
    return acc;
}

# Build a sockaddr_un. Returns 0 for a path that is empty or too long.
#
# This used to CLAMP an over-long path to 107 bytes rather than fail, so two
# distinct service paths sharing a 107-byte prefix silently resolved to the
# same socket — a client could reach a service it did not ask for. An empty
# path was also accepted, which binds into the ABSTRACT namespace under
# whatever bytes the uninitialised block happened to hold (fl_alloc does not
# zero a recycled block).
fn _sockaddr_un(path) {
    if (path == 0) { return 0; }
    var plen = strlen(path);
    if (plen == 0 || plen > IPC_MAX_PATH) { return 0; }
    var sa = fl_alloc(112);
    if (sa == 0) { return 0; }
    memset(sa, 0, 112);
    store8(sa, _AF_UNIX);
    store8(sa + 1, 0);
    memcpy(sa + 2, path, plen);
    store8(sa + 2 + plen, 0);
    return sa;
}

# Actual addrlen for a sockaddr_un carrying `path`: family (2) + path + NUL.
# Passing a hardcoded 110 made the kernel read past the path into whatever the
# block held.
fn _sockaddr_un_len(path) {
    return 2 + strlen(path) + 1;
}

# macOS-only hardening for a fresh socket fd: FD_CLOEXEC (Darwin has no
# SOCK_CLOEXEC) and SO_NOSIGPIPE (Darwin has no MSG_NOSIGNAL).
fn _ipc_fd_harden(fd) {
    #ifdef CYRIUS_TARGET_MACOS
    syscall(SYS_FCNTL, fd, 2, 1);                       # F_SETFD FD_CLOEXEC
    var one[8];
    memset(&one, 0, 8);
    store32(&one, 1);
    sys_setsockopt(fd, 65535, 4130, &one, 4);           # SOL_SOCKET, SO_NOSIGPIPE
    #endif
    return 0;
}

# socket(AF_UNIX, SOCK_STREAM) that is close-on-exec.
#
# ⚠ Without it an exec'd child (a sandboxed tool, a helper) inherited the
# listener and every live connection: it could accept() connections meant for
# the server — and connecting IS authenticating here — around the 0600 mode.
fn _ipc_socket() {
    #ifdef CYRIUS_TARGET_AGNOS
    return -1;
    #endif
    #ifdef CYRIUS_TARGET_LINUX
    return syscall(_SYS_SOCKET, _AF_UNIX, _SOCK_STREAM | _SOCK_CLOEXEC, 0);
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    var fd = syscall(_SYS_SOCKET, _AF_UNIX, _SOCK_STREAM, 0);
    if (fd >= 0) { _ipc_fd_harden(fd); }
    return fd;
    #endif
    #ifdef CYRIUS_TARGET_WIN
    return -1;
    #endif
}

# shutdown(fd, SHUT_RDWR). Wakes a thread parked in read(2)/write(2) on `fd`
# and fails every later I/O on it, WITHOUT releasing the descriptor number —
# which is what makes it safe to call while another thread may still hold that
# number. agnos has no AF_UNIX sockets and no half-close: no-op there.
fn _ipc_shutdown(fd) {
    if (fd < 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return syscall(_SYS_SHUTDOWN, fd, _SHUT_RDWR);
    #endif
}

# Make `path` bindable. Returns 0 when nothing is there or a STALE socket was
# removed, -1 when the path must not be touched.
#
# ⚠ ipc_bind used to unlink the path unconditionally. A misconfigured path
# naming a regular file deleted that file; a second instance binding a LIVE
# server's path unlinked its inode and silently took over every new client,
# orphaning the first server with no error on either side. Now: not a socket
# → refuse; a socket that accepts a connection → live, refuse; only a refused
# (or vanished) connect proves it stale. The lstat→unlink window is a TOCTOU
# accepted for this purpose. Anything unexpected fails closed. A live server
# refused this way sees one connection that closes without sending a byte.
fn _ipc_clear_stale(path, sa) {
    #ifdef CYRIUS_TARGET_AGNOS
    return -1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var st = fl_alloc(256);
    if (st == 0) { return -1; }
    memset(st, 0, 256);
    var lr = sys_lstat(path, st);
    var mode = load32(st + STAT_MODE);
    fl_free(st);
    if (lr < 0) { return 0; }                       # absent (or bind will say why)
    if ((mode & 61440) != 49152) { return -1; }     # S_IFMT != S_IFSOCK
    var probe = -1;
    #ifdef CYRIUS_TARGET_LINUX
    # Non-blocking (SOCK_NONBLOCK 2048): a live listener with a full backlog
    # would otherwise park this connect until it accepts. -EAGAIN counts as live.
    probe = syscall(_SYS_SOCKET, _AF_UNIX, _SOCK_STREAM | _SOCK_CLOEXEC | 2048, 0);
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    probe = _ipc_socket();
    #endif
    if (probe < 0) { return -1; }
    var cr = syscall(_SYS_CONNECT, probe, sa, _sockaddr_un_len(path));
    syscall(SYS_CLOSE, probe);
    var refused = -111;                             # Linux ECONNREFUSED
    #ifdef CYRIUS_TARGET_MACOS
    refused = -61;
    #endif
    if (cr != refused && cr != -2) { return -1; }   # live, or unknown: keep it
    sys_unlink(path);
    return 0;
    #endif
}

# IPC Server: bind to a Unix socket path, listen.
# agnos has no AF_UNIX domain sockets — the whole ipc transport fail-closes
# there (callers fall back to an in-process or network path). Guarding the
# three connection-establishing fns keeps the raw Linux socket numbers
# (41/42/43/49/50, which mean sleep_ms/kbscan/spawn_path/... on agnos) off
# the agnos target.
fn ipc_bind(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(MAJRA_ERR_IPC);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sa = _sockaddr_un(path);
    if (sa == 0) { return Err(MAJRA_ERR_IPC); }
    var fd = _ipc_socket();
    if (fd < 0) { fl_free(sa); return Err(MAJRA_ERR_IPC); }

    # ⚠ fchmod MUST happen BEFORE bind, and 2.6.9 had it after.
    #
    # bind(2) on AF_UNIX creates the filesystem inode from the SOCKFS inode's
    # mode masked by the ambient umask, and connect(2) permission-checks THAT
    # inode. fchmod after bind changes only the sockfs inode, which nothing
    # consults again — it returns success and accomplishes nothing. Verified on
    # this machine under umask 022: fchmod-after-bind leaves the path at 0755
    # (world-connectable) while fstat on the fd reports 0600; fchmod-before-bind
    # yields 0600 on the path.
    #
    # That made 2.6.9 strictly worse than the gap it replaced: the module header
    # began promising owner-only access, and majra performs no peer-credential
    # check, so a consumer trusting that promise got a world-connectable
    # endpoint where connecting IS authenticating.
    #
    # `sys_fchmod` (lib/syscalls_linux_common.cyr) spells the peer's own
    # SYS_FCHMOD — 91 on x86_64, 52 on aarch64. 2.7.2 and earlier issued a raw
    # 91, which is not an ESYSXLAT row: on aarch64-Linux it ran as capset(2)
    # with `fd` as the header pointer, returned -EFAULT, and this branch closed
    # the socket — the Unix IPC transport could not bind on that arch at all.
    if (sys_fchmod(fd, 384) < 0) {
        syscall(SYS_CLOSE, fd);
        fl_free(sa);
        return Err(MAJRA_ERR_IPC);
    }

    if (_ipc_clear_stale(path, sa) != 0) {
        syscall(SYS_CLOSE, fd);
        fl_free(sa);
        return Err(MAJRA_ERR_IPC);
    }
    var ret = syscall(_SYS_BIND, fd, sa, _sockaddr_un_len(path));
    fl_free(sa);
    # Every one of these paths used to leak both the fd and the sockaddr.
    if (ret < 0) { syscall(SYS_CLOSE, fd); return Err(MAJRA_ERR_IPC); }
    ret = syscall(_SYS_LISTEN, fd, 128);
    if (ret < 0) { syscall(SYS_CLOSE, fd); sys_unlink(path); return Err(MAJRA_ERR_IPC); }
    return Ok(fd);
    #endif
}

# Accept a connection. Returns client fd.
fn ipc_accept(server_fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(MAJRA_ERR_IPC);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # accept4(SOCK_CLOEXEC): the accepted fd must not leak into exec'd children
    # any more than the listener (see `_ipc_socket`). sys_accept4 composes it
    # from accept + fcntl on macOS.
    var fd = sys_accept4(server_fd, 0, 0, _SOCK_CLOEXEC);
    if (fd < 0) { return Err(MAJRA_ERR_IPC); }
    #ifdef CYRIUS_TARGET_MACOS
    _ipc_fd_harden(fd);
    #endif
    return Ok(fd);
    #endif
}

# Connect to a Unix socket path. Returns fd.
fn ipc_connect(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(MAJRA_ERR_IPC);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sa = _sockaddr_un(path);
    if (sa == 0) { return Err(MAJRA_ERR_IPC); }
    var fd = _ipc_socket();
    if (fd < 0) { fl_free(sa); return Err(MAJRA_ERR_IPC); }
    var ret = syscall(_SYS_CONNECT, fd, sa, _sockaddr_un_len(path));
    fl_free(sa);
    if (ret < 0) { syscall(SYS_CLOSE, fd); return Err(MAJRA_ERR_IPC); }
    return Ok(fd);
    #endif
}

# Write exactly `len` bytes, retrying on EINTR (-4) and on short writes.
# A signal used to tear down the connection mid-frame.
#
# ⚠ On Linux this is sendto(MSG_NOSIGNAL), not write(2). A plain write to a
# socket whose peer has gone raises SIGPIPE, whose default action KILLS the
# process — so one local client that connects and leaves took down a whole
# ipc_accept daemon instead of getting Err(MAJRA_ERR_IPC). The library does not
# install SIG_IGN process-wide. A non-socket fd (-ENOTSOCK) falls back to
# write(2); macOS sets SO_NOSIGPIPE on the sockets majra creates instead.
fn _ipc_write_full(fd, buf, len) {
    var total = 0;
    var use_send = 1;
    while (total < len) {
        var w = -88;
        #ifdef CYRIUS_TARGET_LINUX
        if (use_send == 1) {
            w = syscall(_IPC_SYS_SENDTO, fd, buf + total, len - total, _MSG_NOSIGNAL, 0, 0);
            if (w == -88) { use_send = 0; }         # ENOTSOCK: a pipe or file
        }
        #endif
        if (w == -88) { w = syscall(SYS_WRITE, fd, buf + total, len - total); }
        if (w == -4) { w = 0; }
        elif (w <= 0) { return -1; }
        total = total + w;
    }
    return total;
}

# Read exactly `want` bytes, retrying on EINTR (-4) and on short reads.
# Returns -1 on error, -2 if the peer closed before any byte arrived.
fn _ipc_read_full(fd, buf, want) {
    var total = 0;
    while (total < want) {
        var r = syscall(SYS_READ, fd, buf + total, want - total);
        if (r == -4) { r = 0; }
        elif (r == 0) {
            if (total == 0) { return -2; }
            return -1;
        }
        elif (r < 0) { return -1; }
        total = total + r;
    }
    return total;
}

# Send a length-prefixed frame.
fn ipc_send_frame(fd, data, len) {
    # The receive side has always capped frames at 1 MiB; the send side did
    # not, so majra could emit a frame every majra receiver rejects. Cap both.
    if (len < 0 || len > IPC_MAX_FRAME) { return Err(MAJRA_ERR_IPC_FRAME_TOO_LARGE); }
    var hdr[4];
    store8(&hdr, (len >> 24) & 0xFF);
    store8(&hdr + 1, (len >> 16) & 0xFF);
    store8(&hdr + 2, (len >> 8) & 0xFF);
    store8(&hdr + 3, len & 0xFF);
    if (_ipc_write_full(fd, &hdr, 4) < 0) { return Err(MAJRA_ERR_IPC); }
    if (len > 0) {
        if (_ipc_write_full(fd, data, len) < 0) { return Err(MAJRA_ERR_IPC); }
    }
    return Ok(0);
}

# Receive a length-prefixed frame.
fn ipc_recv_frame(fd) {
    var hdr[4];
    var r = _ipc_read_full(fd, &hdr, 4);
    if (r == -2) { return Err(MAJRA_ERR_IPC_CONN_CLOSED); }
    if (r < 0) { return Err(MAJRA_ERR_IPC); }
    var len = load8(&hdr) * 16777216 + load8(&hdr + 1) * 65536 + load8(&hdr + 2) * 256 + load8(&hdr + 3);
    if (len > IPC_MAX_FRAME) {
        # ⚠ TERMINAL. The declared body is still queued on the socket, so the
        # next ipc_recv_frame would read four bytes of the peer's payload as
        # the next length prefix and the peer would choose every subsequent
        # frame boundary. **The caller MUST close this fd and stop using the
        # connection** — this function does not, because the fd belongs to the
        # caller.
        #
        # 2.6.9 closed it here, which was worse than the desync it prevented:
        # the caller's struct kept the now-stale descriptor number, and the
        # kernel is free to reassign it to any file or socket opened afterwards
        # by any thread. Subsequent sends then wrote encrypted frames into an
        # unrelated descriptor, and the eventual ipc_close double-closed a
        # number that no longer belonged to majra.
        return Err(MAJRA_ERR_IPC_FRAME_TOO_LARGE);
    }
    var buf = fl_alloc(len + 1);
    if (buf == 0) { return Err(MAJRA_ERR_IPC); }
    if (len > 0) {
        if (_ipc_read_full(fd, buf, len) < 0) {
            fl_free(buf);
            return Err(MAJRA_ERR_IPC);
        }
    }
    store8(buf + len, 0);
    var frame = fl_alloc(16);
    if (frame == 0) { fl_free(buf); return Err(MAJRA_ERR_IPC); }
    store64(frame, len);
    store64(frame + 8, buf);
    return Ok(frame);
}

# Release a frame returned by ipc_recv_frame.
fn ipc_frame_free(f) {
    if (f == 0) { return 0; }
    var b = load64(f + 8);
    if (b != 0) { fl_free(b); }
    fl_free(f);
    return 0;
}

# Close an IPC connection.
fn ipc_close(fd) {
    syscall(SYS_CLOSE, fd);
}
