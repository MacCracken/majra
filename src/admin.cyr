# majra/admin — HTTP admin/metrics endpoint
#
# Read-only observability surface over HTTP/1.1. Intended for
# localhost or reverse-proxied deployment; NO auth, NO mutation,
# NO write endpoints. Consumers who need mTLS or token auth should
# wrap this with a fronting proxy (nginx, sigil-TLS, etc.).
#
# Routes (all GET):
#   /health              → "ok" text/plain
#   /fleet               → JSON {total, online, offline, ...}
#   /ratelimit           → JSON limiter-wide totals ("scope":"global")
#   /ratelimit?key=<k>   → JSON that key's counters ("scope":"key")
#
# Uses the sandhi server surface (sandhi_server_*, folded into the
# cyrius stdlib). Blocking single-threaded accept loop; a request
# handler returns quickly.
# For high-throughput observability, front with Prometheus or a
# pull-scraping agent rather than making this multi-threaded.

# Tracker kinds, mirroring src/heartbeat.cyr's HB_KIND_* tags.
var ADMIN_TRACKER_CONCURRENT = 0;
var ADMIN_TRACKER_BASIC = 1;

# MajraAdmin struct (32 bytes, 4 fields):
#   offset  0: fleet_tracker  (i64) — chb_tracker or hb_tracker (may be 0)
#   offset  8: ratelimiter    (i64) — ratelimiter ptr (may be 0)
#   offset 16: tracker_kind   (i64) — DETECTED, not declared
#   offset 24: reserved       (i64) — future: pubsub hub ref
#
# The kind is now read from the tracker's own type tag rather than taken from
# the caller.
#
# History, because the shape matters: chb_fleet_stats reads a mutex pointer at
# offset 16, which on a basic hb_tracker used to be 8 bytes PAST the
# allocation — an out-of-bounds read, then locked. 2.6.9 added a
# caller-declared kind field, and 2.6.10 found that the two-argument
# constructor still had to TRUST that declaration, because the two tracker
# types were indistinguishable from their pointers. Flipping the default to
# BASIC was rejected: it would have kept incorrect callers safe only by
# silently removing /fleet from every correct one.
#
# 2.7.0 tagged both tracker layouts, so the constructor detects. A caller can
# no longer get this wrong, and majra_admin_new_ex's explicit kind is now only
# a fallback for a tracker majra did not build.

fn majra_admin_new(fleet_tracker, ratelimiter) {
    var a = fl_alloc(32);
    store64(a, fleet_tracker);
    store64(a + 8, ratelimiter);
    store64(a + 16, _admin_detect_kind(fleet_tracker));
    store64(a + 24, 0);
    return a;
}

# Detect from the tracker's tag; fall back to CONCURRENT only for a tracker
# with no recognisable tag, which is what a pre-2.7.0 caller-built tracker or
# a foreign pointer looks like.
fn _admin_detect_kind(t) {
    if (t == 0) { return ADMIN_TRACKER_CONCURRENT; }
    var k = hb_tracker_kind(t);
    if (k == HB_KIND_BASIC) { return ADMIN_TRACKER_BASIC; }
    if (k == HB_KIND_CONCURRENT) { return ADMIN_TRACKER_CONCURRENT; }
    return ADMIN_TRACKER_BASIC;
}

# Explicit-kind constructor. Retained for a tracker majra did not build; the
# detected kind is used when the tracker carries a recognisable tag, so an
# incorrect explicit kind cannot reintroduce the out-of-bounds read.
fn majra_admin_new_ex(fleet_tracker, tracker_kind, ratelimiter) {
    var a = fl_alloc(32);
    store64(a, fleet_tracker);
    store64(a + 8, ratelimiter);
    var detected = hb_tracker_kind(fleet_tracker);
    if (detected == HB_KIND_BASIC) { store64(a + 16, ADMIN_TRACKER_BASIC); }
    elif (detected == HB_KIND_CONCURRENT) { store64(a + 16, ADMIN_TRACKER_CONCURRENT); }
    else { store64(a + 16, tracker_kind); }
    store64(a + 24, 0);
    return a;
}

fn majra_admin_tracker_kind(a) { return load64(a + 16); }

fn majra_admin_fleet_tracker(a) { return load64(a); }
fn majra_admin_ratelimiter(a)   { return load64(a + 8); }

# Build a JSON response body for fleet stats. Returns {ptr, len} via ret2.
# Uses chb_fleet_stats when a concurrent tracker is attached; the stats
# struct layout is {total_nodes, online, suspect, offline, total_gpus,
# total_vram, available_vram, evicted}.
fn _admin_fleet_json(a) {
    var t = load64(a);
    if (t == 0) {
        var empty = "{\"error\":\"no fleet tracker\"}";
        ret2(empty, strlen(empty));
    }
    # Only a concurrent tracker has the mutex chb_fleet_stats reads at +16.
    # A basic hb_tracker is 16 bytes, so calling it would read past the
    # allocation and lock whatever it found.
    if (load64(a + 16) != ADMIN_TRACKER_CONCURRENT) {
        var basic = "{\"error\":\"fleet stats require a concurrent tracker\"}";
        ret2(basic, strlen(basic));
    }
    var s = chb_fleet_stats(t);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"total\":");
    str_builder_add_int(sb, load64(s));
    str_builder_add_cstr(sb, ",\"online\":");
    str_builder_add_int(sb, load64(s + 8));
    str_builder_add_cstr(sb, ",\"suspect\":");
    str_builder_add_int(sb, load64(s + 16));
    str_builder_add_cstr(sb, ",\"offline\":");
    str_builder_add_int(sb, load64(s + 24));
    str_builder_add_cstr(sb, ",\"gpus\":");
    str_builder_add_int(sb, load64(s + 32));
    str_builder_add_cstr(sb, ",\"vram_total\":");
    str_builder_add_int(sb, load64(s + 40));
    str_builder_add_cstr(sb, ",\"vram_available\":");
    str_builder_add_int(sb, load64(s + 48));
    str_builder_add_cstr(sb, "}");
    var body = str_builder_build(sb);
    ret2(str_data(body), str_len(body));
}

# /ratelimit?key=<k> reports THAT KEY's counters. Omitting the key reports the
# limiter-wide totals, labelled so the two cannot be confused.
#
# Until 2.7.0 this returned the global counters regardless of the key, so an
# operator reading /ratelimit?key=tenant-a saw fleet-wide totals and could
# easily read them as that tenant's. 2.6.9 added "scope":"global" so the answer
# was at least self-describing; ratelimit_stats_for_key is the real one.
fn _admin_ratelimit_json(a, key) {
    var rl = load64(a + 8);
    if (rl == 0) {
        var empty = "{\"error\":\"no ratelimiter\"}";
        ret2(empty, strlen(empty));
    }

    var sb = str_builder_new();
    if (key != 0 && strlen(key) > 0) {
        var ks = ratelimit_stats_for_key(rl, key);
        if (ks == 0) {
            var unknown = "{\"error\":\"unknown key\",\"scope\":\"key\"}";
            ret2(unknown, strlen(unknown));
        }
        str_builder_add_cstr(sb, "{\"scope\":\"key\",\"allowed\":");
        str_builder_add_int(sb, ratelimit_key_allowed(ks));
        str_builder_add_cstr(sb, ",\"rejected\":");
        str_builder_add_int(sb, ratelimit_key_rejected(ks));
        str_builder_add_cstr(sb, ",\"tokens_x1000\":");
        str_builder_add_int(sb, ratelimit_key_tokens(ks));
        str_builder_add_cstr(sb, ",\"last_access_ns\":");
        str_builder_add_int(sb, ratelimit_key_last_ns(ks));
        str_builder_add_cstr(sb, "}");
        ratelimit_stats_free(ks);
    } else {
        var gs = ratelimit_stats(rl);
        str_builder_add_cstr(sb, "{\"scope\":\"global\",\"allowed\":");
        str_builder_add_int(sb, load64(gs));
        str_builder_add_cstr(sb, ",\"rejected\":");
        str_builder_add_int(sb, load64(gs + 8));
        str_builder_add_cstr(sb, ",\"active_keys\":");
        str_builder_add_int(sb, load64(gs + 16));
        str_builder_add_cstr(sb, ",\"evicted\":");
        str_builder_add_int(sb, load64(gs + 24));
        str_builder_add_cstr(sb, "}");
        ratelimit_stats_free(gs);
    }
    var body = str_builder_build(sb);
    ret2(str_data(body), str_len(body));
}

# HTTP handler matching the sandhi_server_run handler signature:
#   fn handler(ctx, cfd, buf, blen)
# where ctx is the MajraAdmin pointer.
fn majra_admin_handler(ctx, cfd, buf, blen) {
    var path = sandhi_server_get_path(buf, blen);
    if (path == 0) {
        sandhi_server_send_status(cfd, HTTP_BAD_REQUEST, "bad request");
        return 0;
    }
    var route = sandhi_server_path_only(path);

    if (str_eq(route, str_from("/health")) == 1) {
        sandhi_server_send_response(cfd, HTTP_OK, "OK", "text/plain", "ok", 2, 0);
        return 0;
    }
    if (str_eq(route, str_from("/fleet")) == 1) {
        var body = _admin_fleet_json(ctx);
        var body_len = rethi();
        sandhi_server_send_response(cfd, HTTP_OK, "OK", "application/json", body, body_len, 0);
        return 0;
    }
    if (str_eq(route, str_from("/ratelimit")) == 1) {
        var key = sandhi_server_get_param(path, "key");
        var body = _admin_ratelimit_json(ctx, key);
        var body_len = rethi();
        sandhi_server_send_response(cfd, HTTP_OK, "OK", "application/json", body, body_len, 0);
        return 0;
    }

    sandhi_server_send_status(cfd, HTTP_NOT_FOUND, "not found");
    return 0;
}

# Run the admin endpoint in this thread. Blocks indefinitely.
#
# `addr` is a dotted-quad STRING — pass "127.0.0.1" for localhost-only, and
# "0.0.0.0" only behind a reverse proxy. Returns -1 for an unparseable address
# rather than binding somewhere unintended.
#
# ⚠ This used to forward `addr` straight to sandhi_server_run, which passes it
# to sock_bind -> sockaddr_in, where it is a PACKED INTEGER (0x0100007F for
# 127.0.0.1), not a string. So the documented "bind 127.0.0.1 for
# localhost-only" call actually stored the low 32 bits of a char* pointer as
# the bind address — the one guarantee this endpoint makes (it has no auth of
# its own) was decided by a pointer value.
fn majra_admin_serve(admin, addr, port) {
    var packed = majra_parse_ipv4(addr);
    if (packed < 0) { return -1; }
    return sandhi_server_run(packed, port, &majra_admin_handler, admin);
}
