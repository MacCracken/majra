# majra/relay — sequenced, deduplicated inter-node message relay
#
# Each node gets a sequence counter. Receivers track the last seen
# sequence per sender, dropping duplicates and out-of-order messages.

# RelayMessage struct (64 bytes, 8 fields):
#   offset  0: seq (i64)
#   offset  8: from_str (i64) — Str ptr
#   offset 16: to_str (i64) — Str ptr (0 or empty = broadcast)
#   offset 24: topic_str (i64) — Str ptr
#   offset 32: payload (i64) — ptr to payload data
#   offset 40: timestamp_ns (i64) — WALL CLOCK (epoch ns), not monotonic
#   offset 48: correlation_id (i64) — Str ptr or 0
#   offset 56: is_reply (i64) — 0 or 1

# Build a RelayMessage. `to` of 0 or "" marks it a broadcast.
fn relay_msg_new(seq, from, to, topic, payload) {
    var m = fl_alloc(64);
    store64(m, seq);
    store64(m + 8, from);
    store64(m + 16, to);
    store64(m + 24, topic);
    store64(m + 32, payload);
    # ⚠ **Wall clock, not `time_now_ns()`.** A RelayMessage is serialised and
    # sent to another node, and Rust stamps it `DateTime<Utc>` — a portable
    # instant. `time_now_ns()` is CLOCK_MONOTONIC, whose zero is an arbitrary
    # per-boot point, so the number this carried was meaningless outside the
    # emitting process: two nodes could not order each other's messages by it,
    # and a persisted one could not be read back after a reboot. Reported by
    # agnosai 2026-08-13 while porting `fleet/relay`.
    #
    # Nothing in this module compares timestamps — dedup and ordering are by
    # `seq`, not by time — so this changes what the field MEANS without changing
    # any decision made inside majra.
    #
    # ⚠ `time_epoch_ns` is majra's OWN (`src/envelope.cyr`), not the stdlib's
    # `clock_epoch_ns` — `chrono` is not among the modules a `--no-deps` build
    # prepends, and `--no-deps` is what CI runs, so the stdlib call compiled
    # locally and failed there with `undefined function`.
    store64(m + 40, time_epoch_ns());
    store64(m + 48, 0);
    store64(m + 56, 0);
    return m;
}

# The message's wall-clock stamp, in epoch nanoseconds (2.6.5 — it was
# CLOCK_MONOTONIC before, which is not portable across processes).
fn relay_msg_timestamp(m) {
    return load64(m + 40);
}

# DedupEntry struct (16 bytes):
#   offset 0: last_seq (i64)
#   offset 8: last_seen_ns (i64)

# Relay struct (64 bytes):
#   offset  0: node_id (i64) — Str ptr
#   offset  8: next_seq (i64)
#   offset 16: seen (i64) — hashmap: node_id_str -> DedupEntry ptr
#   offset 24: subscribers (i64) — vec of channel ptrs
#   offset 32: pending_requests (i64) — hashmap: correlation_id -> channel ptr
#   offset 40: mutex (i64)
#   offset 48: messages_sent (i64) — counter ptr
#   offset 56: messages_received (i64) — counter ptr
#   offset 64: duplicates_dropped (i64) — counter ptr
#   offset 72: dedup_evicted (i64) — counter ptr
#   offset 80: max_dedup (i64) — 0 = unbounded (the default)
#   offset 88: sequence_gaps (i64) — counter ptr  (2.6.0)
#   offset 96: capacity (i64) — subscriber channel depth (2.6.5)

# The subscriber channel depth `relay_subscribe` hands out when none is asked
# for. Rust's `Relay::with_defaults`, and what every caller got before 2.6.5.
var RELAY_DEFAULT_CAPACITY = 256;

# Create a relay for `node_id` with the default subscriber depth of 256.
#
# Dedup is unbounded by default; see `relay_set_max_dedup` before changing that.
fn relay_new(node_id) {
    return relay_with_capacity(node_id, RELAY_DEFAULT_CAPACITY);
}

# Create a relay whose subscriber channels hold `capacity` messages.
#
# ⚠ **`relay_subscribe` used to hardcode `chan_new(256)`**, so a caller asking
# for 4 and a caller asking for 4096 got byte-identical behaviour — the
# parameter Rust's `broadcast::channel(capacity)` honours was accepted upstream
# and silently discarded here. agnosai recorded it in `fleet/relay.cyr` as "owed
# to majra"; this is that debt. A `capacity <= 0` falls back to the default
# rather than building a zero-depth channel nothing could ever be sent through.
fn relay_with_capacity(node_id, capacity) {
    var r = fl_alloc(104);
    store64(r, node_id);
    store64(r + 8, 1);
    store64(r + 16, map_new());
    store64(r + 24, vec_new());
    store64(r + 32, map_new());
    store64(r + 40, mutex_new());
    store64(r + 48, counter_new());
    store64(r + 56, counter_new());
    store64(r + 64, counter_new());
    store64(r + 72, counter_new());
    store64(r + 80, 0);
    store64(r + 88, counter_new());
    if (capacity <= 0) { capacity = RELAY_DEFAULT_CAPACITY; }
    store64(r + 96, capacity);
    return r;
}

# Bound the dedup table to `max` senders, evicting the least-recently-seen when
# it overflows. `0` (the default) means unbounded and is what `relay_new` sets.
#
# ⚠ **Enabling this opens a replay window, by construction.** Evicting a sender
# forgets its last-seen sequence number, so that sender's already-delivered
# messages become acceptable again — `relay_receive` will pass them through and
# fan them out a second time. Unbounded is the safe default and the one that
# matches a strict "deliver each sequence once" contract; bound it only when an
# unbounded sender population is the bigger risk, and size `max` above the real
# peer count so eviction is a backstop rather than routine.
fn relay_set_max_dedup(r, max) {
    store64(r + 80, max);
}

# This relay's own node id.
fn relay_node_id(r) {
    return load64(r);
}

# Send a message to a specific node. Returns sequence number.
fn relay_send(r, to, topic, payload) {
    var mtx = load64(r + 40);
    # The whole send is one critical section.
    #
    # The sequence number used to be claimed under the mutex and the fan-out
    # done after releasing it, so two concurrent senders could interleave:
    # thread A takes seq 1, thread B takes seq 2, B fans out first, and every
    # subscriber sees 2 before 1. Subscribers use the sequence for ordering and
    # dedup, so an out-of-order pair is indistinguishable from a replay.
    #
    # Holding the lock across the fan-out is safe precisely BECAUSE the fan-out
    # is chan_try_send (see below) — it never blocks, so this cannot reproduce
    # the head-of-line class 2.5.3 fixed in pubsub.
    #
    # The subscriber vec is also read under the lock now; relay_subscribe
    # mutates it under the same mutex, so iterating it unlocked could observe a
    # reallocated backing buffer mid-push.
    mutex_lock(mtx);
    var seq = load64(r + 8);
    store64(r + 8, seq + 1);

    var msg = relay_msg_new(seq, load64(r), to, topic, payload);

    # Broadcast to all subscribers
    var subs = load64(r + 24);
    var i = 0;
    var len = vec_len(subs);
    # ⚠ **`chan_try_send`, NEVER `chan_send`.** Rust's `Relay` is a
    # `tokio::sync::broadcast` and `Relay::send` is `let _ = self.tx.send(..)`
    # (`fleet/relay.rs:133`) — it never blocks: a full ring overwrites its oldest
    # slot and the lagging receiver observes `RecvError::Lagged`. `chan_send`
    # futex-waits for space instead, so a subscriber that stops draining wedges
    # the SENDER forever, and majra has no unsubscribe to break the wedge.
    #
    # ⚠ This was latent until 2.6.5. Every subscriber channel was 256 deep
    # regardless of the capacity asked for, so the block needed 256 undrained
    # messages; honouring the capacity made it reachable at whatever depth the
    # caller names — `relay_with_capacity(id, 2)` deadlocks on the third send.
    # Dropping when full is the behaviour that matches the oracle.
    while (i < len) {
        chan_try_send(vec_get(subs, i), msg);
        i = i + 1;
    }
    mutex_unlock(mtx);

    counter_inc(load64(r + 48));
    return seq;
}

# Broadcast to all nodes.
fn relay_broadcast(r, topic, payload) {
    return relay_send(r, 0, topic, payload);
}

# Subscribe to inbound messages. Returns a channel.
# The configured depth for this relay's subscribers.
fn relay_capacity(r) {
    return load64(r + 96);
}

fn relay_subscribe(r) {
    var ch = chan_new(load64(r + 96));
    var mtx = load64(r + 40);
    mutex_lock(mtx);
    vec_push(load64(r + 24), ch);
    mutex_unlock(mtx);
    return ch;
}

# Allocate a dedup entry for a new sender.
#
# ⚠ 2.6.0: this took its three inputs from FILE-SCOPE globals until now, as did
# `relay_receive` itself. The comment they carried said they "predate cc5" and
# were a cc3 local-clobbering workaround kept because removing them "would
# require a structural refactor". That refactor is this: they are parameters.
# The globals made `relay_receive` **non-reentrant**, so two threads receiving
# concurrently corrupted each other's dedup decision — reported by agnosai,
# whose sandhi pool runs 100 workers.
fn _relay_alloc_dedup_entry(dmap, key, seq) {
    var entry = fl_alloc(16);
    store64(entry, seq);
    store64(entry + 8, time_now_ns());
    map_set(dmap, key, entry);
    return entry;
}

# Whether `msg` was sent by this relay itself.
fn _recv_skip_own(r, msg) {
    var from = load64(msg + 8);
    var nid = load64(r);
    if (from != 0 && nid != 0 && streq(from, nid) == 1) { return 1; }
    return 0;
}

# 1 = broadcast, 0 = addressed to this node, 2 = addressed elsewhere.
fn _recv_check_target(r, msg) {
    var to = load64(msg + 16);
    var nid = load64(r);
    if (to == 0 || strlen(to) == 0) { return 1; }
    if (streq(to, nid) == 1) { return 0; }
    return 2;
}

# IncomingMessage struct (16 bytes), returned by `relay_receive_ex`:
#   offset 0: is_broadcast (i64) — 1 if the message carried no explicit target
#   offset 8: msg (i64) — the RelayMessage ptr
#
# 2.6.0. Before it, `relay_receive` computed `is_broadcast` and then threw it
# away — a consumer could not tell a broadcast from a direct message without
# re-inspecting the envelope, which is what agnosai's port needed.
fn incoming_is_broadcast(inc) {
    return load64(inc);
}

# The RelayMessage carried by an IncomingMessage.
fn incoming_msg(inc) {
    return load64(inc + 8);
}

# The last sequence number seen from `from`, or -1 if that sender is unknown.
#
# 2.6.0. Exposed so a caller can implement its own gap policy; `relay_stats`'s
# `sequence_gaps` counter is the built-in one.
fn relay_last_seq(r, from) {
    var mtx = load64(r + 40);
    mutex_lock(mtx);
    var entry = map_get(load64(r + 16), from);
    var out = 0 - 1;
    if (entry != 0) { out = load64(entry); }
    mutex_unlock(mtx);
    return out;
}

# Process an incoming message. Returns an IncomingMessage ptr, or 0 if the
# message was skipped (ours, addressed elsewhere, or a duplicate).
#
# ⚠ 2.6.0 made this REENTRANT. It previously stashed its arguments and dedup
# state in file-scope globals AND took no lock at all, while every other mutating
# entry point (`relay_send`, `relay_subscribe`, `relay_evict_stale_dedup`) locked
# `r + 40`. Two threads receiving concurrently therefore raced both the globals
# and the `seen` map. Reported by agnosai, whose sandhi pool runs 100 workers.
#
# The lock is held across the dedup decision, the eviction sweep and the counter
# updates, then released BEFORE the subscriber fan-out — the same shape majra
# 2.5.3 gave `pubsub_publish`, so a slow or full subscriber channel cannot block
# an unrelated receive.
fn relay_receive_ex(r, msg) {
    if (_recv_skip_own(r, msg) == 1) { return 0; }

    var target_check = _recv_check_target(r, msg);
    if (target_check == 2) { return 0; }
    var is_broadcast = target_check;

    var mtx = load64(r + 40);
    mutex_lock(mtx);

    var seen = load64(r + 16);
    var sender = load64(msg + 8);
    var seq = load64(msg);

    var entry = map_get(seen, sender);
    if (entry != 0) {
        var last = load64(entry);
        if (seq <= last) {
            counter_inc(load64(r + 64));
            mutex_unlock(mtx);
            return 0;
        }
        # A sequence gap means at least one message from this sender was lost in
        # transit. Not an error — the message is still delivered — but it is the
        # signal a caller needs to request a resend or raise an alarm.
        if (seq != last + 1) { counter_inc(load64(r + 88)); }
        store64(entry, seq);
        store64(entry + 8, time_now_ns());
    } else {
        # A first message whose sequence is not 1 also skipped messages.
        if (seq != 1) { counter_inc(load64(r + 88)); }
        _relay_alloc_dedup_entry(seen, sender, seq);
    }

    # Enforce the dedup table bound, if one was set. See relay_set_max_dedup for
    # why this is off by default.
    var max_dedup = load64(r + 80);
    if (max_dedup > 0 && map_size(seen) > max_dedup) {
        # Iterate the slot array rather than map_keys, which allocates a vec
        # from the never-freeing bump allocator on every eviction pass.
        var dent = map_entries(seen);
        var dcap = map_cap(seen);
        var oldest_key = 0;
        var oldest_entry = 0;
        var oldest_time = 0;
        var i = 0;
        while (i < dcap) {
            var sp = dent + i * 24;
            if (load64(sp + 16) == 1) {
                var e = load64(sp + 8);
                var t = load64(e + 8);
                if (oldest_key == 0 || t < oldest_time) {
                    oldest_key = load64(sp);
                    oldest_entry = e;
                    oldest_time = t;
                }
            }
            i = i + 1;
        }
        if (oldest_key != 0) {
            map_delete(seen, oldest_key);
            # The DedupEntry block itself was never released, so the mechanism
            # added to BOUND the dedup table's memory leaked one block per
            # eviction — it bounded the map and not the memory.
            if (oldest_entry != 0) { fl_free(oldest_entry); }
            counter_inc(load64(r + 72));
        }
    }

    counter_inc(load64(r + 56));

    # The fan-out happens UNDER the lock and walks the subscriber vec directly.
    #
    # This used to build a per-message `vec_new()` snapshot so the walk could
    # happen unlocked. The snapshot came from the BUMP allocator, which never
    # reclaims, so the relay's hot path leaked a vec per received message —
    # agnosai drives this from a 100-worker pool. Walking under the lock is
    # safe here for the same reason as relay_send: the fan-out is
    # chan_try_send and never blocks.
    var subs = load64(r + 24);

    # ✅ The result struct is allocated AFTER the unlock, which is where it
    # belongs — the block is private to this call and nothing under the lock
    # reads it.
    #
    # ⚠ It was deliberately allocated **under** the lock from 2.6.1 to 2.6.2,
    # and that is worth recording rather than re-deriving. `fl_alloc` was not
    # thread-safe: `lib/freelist.cyr` read and wrote the global `_fl_heads` free
    # lists with plain loads and stores, no mutex and no atomics, so two threads
    # in `relay_receive` concurrently could be handed the SAME block. Not
    # theoretical — it corrupted the dedup table (a message arriving under
    # another sender's sequence, then rejected as a duplicate) and, under real
    # contention, faulted. Pulling the allocation inside the critical section
    # serialised majra against itself as a stopgap.
    #
    # **cyrius 6.5.19 makes `fl_alloc` thread-safe** (a process-wide CAS
    # spinlock over the free-list splice, the arena bump and the arena refill),
    # so the stopgap is retired. It was never a complete fix anyway — it
    # serialised majra against majra while any other thread in the process
    # calling `fl_alloc` still raced it, which is why the real fix had to be
    # upstream. Shortening the critical section back is the point of undoing it:
    # this lock is held across a subscriber-list walk on a hot pub/sub path.
    var j = 0;
    var jlen = vec_len(subs);
    # Same never-block contract as `relay_send` — see the note there.
    while (j < jlen) {
        chan_try_send(vec_get(subs, j), msg);
        j = j + 1;
    }
    mutex_unlock(mtx);

    var inc = fl_alloc(16);
    if (inc == 0) { return 0; }
    store64(inc, is_broadcast);
    store64(inc + 8, msg);
    return inc;
}

# Release an IncomingMessage returned by relay_receive_ex.
fn incoming_msg_free(inc) {
    if (inc != 0) { fl_free(inc); }
    return 0;
}

# Process an incoming message. Returns the message if it passes dedup, or 0.
#
# Kept for backward compatibility: this is `relay_receive_ex` with the
# broadcast flag dropped. New code should prefer `relay_receive_ex`.
fn relay_receive(r, msg) {
    var inc = relay_receive_ex(r, msg);
    if (inc == 0) { return 0; }
    # The wrapper used to drop `inc` on the floor, leaking the freelist block
    # relay_receive_ex allocated for every received message.
    var m = incoming_msg(inc);
    fl_free(inc);
    return m;
}

# How many senders the dedup table currently tracks.
fn relay_dedup_table_size(r) {
    return map_size(load64(r + 16));
}

# Evict dedup entries idle longer than max_idle_ns. Returns count.
fn relay_evict_stale_dedup(r, max_idle_ns) {
    var now = time_now_ns();
    var mtx = load64(r + 40);
    mutex_lock(mtx);
    var seen = load64(r + 16);
    var keys = map_keys(seen);
    var to_remove = vec_new();
    var i = 0;
    var len = vec_len(keys);
    while (i < len) {
        var k = vec_get(keys, i);
        var e = map_get(seen, k);
        if (now - load64(e + 8) > max_idle_ns) {
            vec_push(to_remove, k);
        }
        i = i + 1;
    }
    var count = vec_len(to_remove);
    i = 0;
    while (i < count) {
        map_delete(seen, vec_get(to_remove, i));
        i = i + 1;
    }
    if (count > 0) {
        counter_add(load64(r + 72), count);
    }
    mutex_unlock(mtx);
    return count;
}

# RelayStats struct (48 bytes):
#   offset  0: messages_sent
#   offset  8: messages_received
#   offset 16: duplicates_dropped
#   offset 24: dedup_evicted
#   offset 32: dedup_table_size
#   offset 40: sequence_gaps        (2.6.0 — APPENDED, so offsets 0..32 are
#                                    unchanged and existing readers still work)
fn relay_stats(r) {
    var s = fl_alloc(48);
    store64(s, counter_get(load64(r + 48)));
    store64(s + 8, counter_get(load64(r + 56)));
    store64(s + 16, counter_get(load64(r + 64)));
    store64(s + 24, counter_get(load64(r + 72)));
    store64(s + 32, map_size(load64(r + 16)));
    store64(s + 40, counter_get(load64(r + 88)));
    return s;
}
