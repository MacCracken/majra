# majra/redis_backend — Redis RESP protocol over TCP
#
# Implements RESP (REdis Serialization Protocol) for cross-process
# pub/sub, priority queues, rate limiting, and heartbeat tracking.
#
# Wire format: RESP2 over TCP.
#   Simple string: +OK\r\n
#   Error:         -ERR msg\r\n
#   Integer:       :42\r\n
#   Bulk string:   $5\r\nhello\r\n
#   Array:         *2\r\n$3\r\nGET\r\n$3\r\nkey\r\n

# --- Limits ---
#
# Every one of these bounds a value taken straight off the wire. Without them a
# compromised or impersonated Redis endpoint controls an allocation size, a
# loop bound, or the recursion depth of the reply parser.
#
# Redis's own proto-max-bulk-len defaults to 512 MB; 64 MB is far above
# anything majra's own commands produce and can be raised if a consumer needs
# it.
var RESP_MAX_BULK = 67108864;
var RESP_MAX_ARRAY = 1048576;
var RESP_MAX_DEPTH = 8;

# --- RESP Protocol ---

# sendto(2)'s number, or 0 where there is no MSG_NOSIGNAL send path.
# ⚠ Spelled per arch: sendto has no ESYSXLAT row (quirk #9), so the x86_64 44
# would run as fstatfs on aarch64. The peers declare no SYS_SENDTO. macOS has
# no MSG_NOSIGNAL; agnos and Windows have no BSD sockets.
fn _resp_sendto_nr() {
    #ifdef CYRIUS_TARGET_LINUX
    #ifdef CYRIUS_ARCH_X86
    return 44;
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return 206;
    #endif
    #endif
    return 0;
}

# Write exactly `len` bytes. Returns 0, or -1 if any write failed — a short
# write used to count as success, which desynchronises the command stream: the
# server parses a truncated command and every later reply is misattributed.
#
# ⚠ Sent with MSG_NOSIGNAL (0x4000). A bare write(2) to a connection the peer
# (or an idle-timeout load balancer) has reset raises SIGPIPE, whose default
# action kills the whole consumer process. A non-socket fd gets ENOTSOCK (-88)
# and falls back to write(2). EINTR (-4) retries.
fn _resp_write_full(fd, buf, len) {
    var total = 0;
    var nr = _resp_sendto_nr();
    while (total < len) {
        var w = 0;
        if (nr != 0) {
            w = syscall(nr, fd, buf + total, len - total, 0x4000, 0, 0);
            if (w == -88) {
                nr = 0;
                w = syscall(SYS_WRITE, fd, buf + total, len - total);
            }
        } else {
            w = syscall(SYS_WRITE, fd, buf + total, len - total);
        }
        if (w == -4) { w = 0; }
        elif (w <= 0) { return -1; }
        total = total + w;
    }
    return 0;
}

# Send a RESP command array: `argc` C strings at av[0..argc). Returns 0 on
# success, -1 if the write failed (the stream is then in an unknown state), or
# -2 if nothing was sent (bad argument or allocation failure).
#
# ⚠ Sized first and assembled in ONE fl_alloc block that is freed on every
# path. The str_builder / str_builder_build / vec_new version took ~300 bytes
# per command from the bump allocator, which never frees — a rate limiter at
# 10k ops/s grew the process by megabytes a second.
fn _resp_send_argv(fd, av, argc) {
    if (fd < 0) { return -1; }
    var nb[24];
    var total = 1 + fmt_int_buf(argc, &nb) + 2;
    var i = 0;
    while (i < argc) {
        var arg = load64(av + i * 8);
        if (arg == 0) { return -2; }
        var alen = strlen(arg);
        total = total + 1 + fmt_int_buf(alen, &nb) + 2 + alen + 2;
        i = i + 1;
    }
    var frame = fl_alloc(total);
    if (frame == 0) { return -2; }
    store8(frame, 42);
    var p = 1;
    var dl = fmt_int_buf(argc, &nb);
    memcpy(frame + p, &nb, dl);
    p = p + dl;
    memcpy(frame + p, "\r\n", 2);
    p = p + 2;
    i = 0;
    while (i < argc) {
        var a2 = load64(av + i * 8);
        var alen2 = strlen(a2);
        store8(frame + p, 36);
        p = p + 1;
        dl = fmt_int_buf(alen2, &nb);
        memcpy(frame + p, &nb, dl);
        p = p + dl;
        memcpy(frame + p, "\r\n", 2);
        p = p + 2;
        memcpy(frame + p, a2, alen2);
        p = p + alen2;
        memcpy(frame + p, "\r\n", 2);
        p = p + 2;
        i = i + 1;
    }
    var rc = _resp_write_full(fd, frame, total);
    fl_free(frame);
    return rc;
}

# Send a RESP command array over a TCP socket.
# cmd is a vec of C strings (command + arguments).
# Returns 0 on success, negative on failure (see _resp_send_argv).
fn _resp_send_cmd(fd, cmd) {
    if (fd < 0) { return -1; }
    var len = vec_len(cmd);
    var av = fl_alloc(len * 8 + 8);
    if (av == 0) { return -2; }
    var i = 0;
    while (i < len) {
        store64(av + i * 8, vec_get(cmd, i));
        i = i + 1;
    }
    var rc = _resp_send_argv(fd, av, len);
    fl_free(av);
    return rc;
}

# Read a line from the socket (up to \r\n). Returns an OWNED, NUL-terminated
# fl_alloc copy of the line without its CRLF, with the length via ret2; or 0.
#
# ⚠ The scratch buffer is a function LOCAL (N bytes, on the calling thread's
# stack — quirk #4), not a module global. The global `_resp_buf` was shared by
# every connection in the process, so two threads each reading their own
# RedisConn interleaved bytes into one buffer and parsed each other's replies.
fn _resp_read_line(fd) {
    var lbuf[4096];
    var pos = 0;
    while (pos < 4088) {
        var n = syscall(SYS_READ, fd, &lbuf + pos, 1);
        if (n == -4) { continue; }
        if (n <= 0) { ret2(0, 0); }
        if (pos > 0 && load8(&lbuf + pos - 1) == 13 && load8(&lbuf + pos) == 10) {
            var line_len = pos - 1;
            var copy = fl_alloc(line_len + 1);
            if (copy == 0) { ret2(0, 0); }
            memcpy(copy, &lbuf, line_len);
            store8(copy + line_len, 0);
            ret2(copy, line_len);
        }
        pos = pos + 1;
    }
    ret2(0, 0);
}

# Parse a RESP integer field in place — same rules as str_to_int (an optional
# leading '-', non-digits skipped) without allocating a Str header for it.
fn _resp_int(p, n) {
    var result = 0;
    var neg = 0;
    var i = 0;
    if (n > 0 && load8(p) == 45) { neg = 1; i = 1; }
    while (i < n) {
        var c = load8(p + i);
        if (c >= 48 && c <= 57) { result = result * 10 + c - 48; }
        i = i + 1;
    }
    if (neg == 1) { result = 0 - result; }
    return result;
}

# A Str header over an fl_alloc'd reply buffer. The header itself is fl_alloc'd
# too, so resp_reply_free can release both — a str_new header came from the
# bump allocator and leaked 16 bytes per reply even when the caller freed it.
fn _resp_str(data, len) {
    var s = fl_alloc(16);
    if (s == 0) { return 0; }
    store64(s, data);
    store64(s + 8, len);
    return s;
}

# Read a RESP reply. Returns:
#   For simple strings/errors: Str
#   For integers: the integer value
#   For bulk strings: Str or 0 (nil)
#   For arrays: vec of reply values
# Takes the CONNECTION, not a bare fd, so it can poison a stream it can no
# longer parse.
#
# Every abort below — a cap exceeded, a read failure, an unrecognised type
# byte — leaves bytes the server already committed to sending sitting in the
# socket. Returning without marking the connection meant the next command read
# those leftovers as its own reply and every result from then on was
# misattributed, silently. A caller cannot detect that; the only safe move is
# to make the connection unusable so it fails loudly instead.
#
# A nil bulk string (`$-1`) and the integer `:0` are NOT failures — they also
# return 0, which is why the connection state, not the return value, is what
# distinguishes them.
fn _resp_read_reply(rc) {
    return _resp_read_reply_d(rc, 0);
}

# Mark a connection's framing untrustworthy. Subsequent commands fail fast.
fn _resp_poison(rc) {
    if (rc == 0) { return 0; }
    var fd = load64(rc);
    if (fd >= 0) { syscall(SYS_CLOSE, fd); }
    store64(rc, -1);
    return 0;
}

fn redis_is_alive(rc) {
    if (rc == 0) { return 0; }
    if (load64(rc) < 0) { return 0; }
    return 1;
}

fn _resp_read_reply_d(rc, depth) {
    if (rc == 0) { return 0; }
    var fd = load64(rc);
    if (fd < 0) { return 0; }
    if (depth > RESP_MAX_DEPTH) { _resp_poison(rc); return 0; }
    var line = _resp_read_line(fd);
    var llen = rethi();
    if (line == 0) { _resp_poison(rc); return 0; }
    var type_byte = load8(line);

    # NOTE ON OWNERSHIP: `line` is an fl_alloc'd copy made by _resp_read_line.
    # The simple-string and error cases hand a Str over it back to the caller,
    # so those must NOT free it — the caller owns it and releases it with
    # resp_reply_free. The integer and length-header cases consume it here and
    # free it.
    if (type_byte == 43 || type_byte == 45) {
        # +simple string / -error — caller owns the buffer.
        # ⚠ Shift the text to the START of the block rather than returning a Str
        # at line + 1: resp_reply_free hands str_data to fl_free, which reads
        # the size class 16 bytes before the pointer it is given, and one byte
        # in that lands on the type byte — every '+OK' was "freed" by a failing
        # munmap and leaked.
        var k = 0;
        while (k < llen - 1) {
            store8(line + k, load8(line + k + 1));
            k = k + 1;
        }
        store8(line + llen - 1, 0);
        var s = _resp_str(line, llen - 1);
        if (s == 0) { fl_free(line); }
        return s;
    }
    if (type_byte == 58) {
        # :integer — the line is fully consumed here
        var iv = _resp_int(line + 1, llen - 1);
        fl_free(line);
        return iv;
    }
    if (type_byte == 36) {
        # $bulk string
        var blen = _resp_int(line + 1, llen - 1);
        fl_free(line);
        if (blen < 0) { return 0; }
        # Without this cap, `$9223372036854775807` makes `blen + 2` WRAP
        # NEGATIVE; _fl_class sends any negative size down the size<=16 path,
        # so fl_alloc hands back a 16-byte block which str_new then labels
        # with a length of INT64_MAX. The first str_eq on that reply walks the
        # entire address space.
        if (blen > RESP_MAX_BULK) { _resp_poison(rc); return 0; }
        var buf = fl_alloc(blen + 2);
        # The body is still queued on the socket, so failing here loses framing.
        if (buf == 0) { _resp_poison(rc); return 0; }
        var total = 0;
        while (total < blen + 2) {
            var n = syscall(SYS_READ, fd, buf + total, blen + 2 - total);
            if (n == -4) { n = 0; }
            elif (n <= 0) { fl_free(buf); _resp_poison(rc); return 0; }
            total = total + n;
        }
        # A bulk body must be followed by CRLF; anything else means the length
        # lied and the stream is offset. Overwriting the CR with a NUL then makes
        # a bulk reply a valid C string like every other Str reply — without it
        # str_data(redis_get(...)) ran on into stale freelist bytes.
        if (load8(buf + blen) != 13 || load8(buf + blen + 1) != 10) {
            fl_free(buf);
            _resp_poison(rc);
            return 0;
        }
        store8(buf + blen, 0);
        var bs = _resp_str(buf, blen);
        if (bs == 0) { fl_free(buf); }
        return bs;
    }
    if (type_byte == 42) {
        # *array
        var count = _resp_int(line + 1, llen - 1);
        fl_free(line);
        if (count < 0) { return 0; }
        # An oversized count spins this loop growing `arr` long after the
        # socket has stopped producing, and unbounded nesting turns
        # server-controlled depth into call-stack depth.
        if (count > RESP_MAX_ARRAY) { _resp_poison(rc); return 0; }
        var arr = vec_new();
        var j = 0;
        while (j < count) {
            # ⚠ Do NOT treat a 0 element as a parse failure.
            #
            # 2.6.9 added `if (elem == 0) { return arr; }` here, but this
            # function returns 0 for THREE different things: a read failure, a
            # nil bulk string (`$-1`, which this module's own doc comment
            # documents as 0), and an integer reply of `:0`. So an ordinary
            # Redis reply — a rate-limiter Lua script returning
            # `*2\r\n:0\r\n:1\r\n`, or an MGET with a missing key — was
            # truncated to an empty array, and the elements it did not consume
            # stayed queued on the socket. The next command on that connection
            # then read the leftovers as its own reply and the stream was
            # permanently offset by one. Push every element, and tell a genuine
            # failure apart by the connection state instead: an element that
            # poisoned the handle aborts the array like every other failure,
            # rather than padding it out to `count` with zeros.
            vec_push(arr, _resp_read_reply_d(rc, depth + 1));
            if (load64(rc) < 0) { return 0; }
            j = j + 1;
        }
        return arr;
    }
    # Unrecognised type byte — nothing else will consume the line, and we no
    # longer know where the next reply starts.
    fl_free(line);
    _resp_poison(rc);
    return 0;
}

# Release a Str reply returned by _resp_read_reply for a simple string, an
# error, or a bulk string — its buffer and its header. Integers are values,
# arrays are vecs from the bump allocator; neither needs this.
fn resp_reply_free(reply) {
    if (reply != 0) {
        fl_free(str_data(reply));
        fl_free(reply);
    }
    return 0;
}

# Send one command and read its reply.
#
# The wrappers used to ignore a failed send and go straight to the read — which
# then blocked, untimed, for a reply to a command the server never received
# (or is still waiting for the rest of). A failed write leaves the stream in an
# unknown state, so poison it like a failed read.
fn _resp_roundtrip(rc, av, argc) {
    if (rc == 0) { return 0; }
    var sr = _resp_send_argv(load64(rc), av, argc);
    if (sr == -1) { _resp_poison(rc); return 0; }
    if (sr < 0) { return 0; }
    return _resp_read_reply(rc);
}

# --- Redis Connection ---

# RedisConn struct (16 bytes):
#   offset 0: fd (i64)
#   offset 8: prefix (i64) — C string for key namespacing

fn redis_connect(host, port) {
    # `host` was accepted and then ignored — every connection went to
    # INADDR_LOOPBACK() regardless, so redis_connect("10.0.0.5", 6379) silently
    # talked to localhost. Now parsed; a non-dotted-quad host fails rather than
    # redirecting. (No resolver in the stdlib: pass an IPv4 literal.)
    var addr = INADDR_LOOPBACK();
    if (host != 0 && strlen(host) > 0) {
        addr = majra_parse_ipv4(host);
        if (addr < 0) { return 0; }
    }
    # `_SYS_SOCKET` / `_SYS_CONNECT` are src/ipc.cyr's target-neutral names for
    # 41 / 42 (ESYSXLAT rows on aarch64) — not the peers' `SYS_SOCKET`, which the
    # agnos and Windows peers do not declare and this file has no guard for.
    var fd = syscall(_SYS_SOCKET, AF_INET, SOCK_STREAM, 0);
    if (fd < 0) { return 0; }
    var sa = sockaddr_in(addr, port);
    var ret = syscall(_SYS_CONNECT, fd, sa, 16);
    if (ret < 0) {
        syscall(SYS_CLOSE, fd);
        return 0;
    }
    var rc = fl_alloc(16);
    store64(rc, fd);
    store64(rc + 8, "");
    return rc;
}

fn redis_connect_default() {
    return redis_connect("127.0.0.1", 6379);
}

fn redis_set_prefix(rc, prefix) {
    store64(rc + 8, prefix);
}

# Closes the socket and releases the handle. The handle is INVALID afterwards —
# do not call anything else with it.
#
# 2.6.9's comment claimed the `store64(rc, -1)` poison made a second close
# safe. It did not: the very next line frees the block, so the poison survives
# only until the freelist reuses those bytes, and a double close would then
# read whatever the new owner wrote. The poison is kept for the window before
# the free, but the real contract is the one stated above.
fn redis_close(rc) {
    if (rc == 0) { return 0; }
    var fd = load64(rc);
    if (fd >= 0) { syscall(SYS_CLOSE, fd); }
    store64(rc, -1);
    fl_free(rc);
    return 0;
}

# Build prefixed key. Returns `key` itself when there is no prefix, otherwise
# an fl_alloc'd copy the caller releases with _redis_pkey_free once the command
# is sent (0 on allocation failure).
fn _redis_pkey(rc, key) {
    var prefix = load64(rc + 8);
    if (prefix == 0 || key == 0) { return key; }
    var plen = strlen(prefix);
    if (plen == 0) { return key; }
    var klen = strlen(key);
    var out = fl_alloc(plen + klen + 1);
    if (out == 0) { return 0; }
    memcpy(out, prefix, plen);
    memcpy(out + plen, key, klen);
    store8(out + plen + klen, 0);
    return out;
}

fn _redis_pkey_free(key, pk) {
    if (pk != 0 && pk != key) { fl_free(pk); }
    return 0;
}

# --- Basic Commands ---
#
# Arguments go through a stack-local pointer array (`var av[64]` is 64 BYTES —
# eight slots — as a local, quirk #4) and numbers through a local digit buffer,
# so a command allocates nothing that outlives it.

# One command whose second argument is a prefixed key.
fn _redis_key_cmd(rc, name, key) {
    var av[64];
    var pk = _redis_pkey(rc, key);
    store64(&av, name);
    store64(&av + 8, pk);
    var r = _resp_roundtrip(rc, &av, 2);
    _redis_pkey_free(key, pk);
    return r;
}

fn redis_set(rc, key, value) {
    var av[64];
    var pk = _redis_pkey(rc, key);
    store64(&av, "SET");
    store64(&av + 8, pk);
    store64(&av + 16, value);
    var r = _resp_roundtrip(rc, &av, 3);
    _redis_pkey_free(key, pk);
    return r;
}

fn redis_get(rc, key) {
    return _redis_key_cmd(rc, "GET", key);
}

fn redis_del(rc, key) {
    return _redis_key_cmd(rc, "DEL", key);
}

fn redis_exists(rc, key) {
    return _redis_key_cmd(rc, "EXISTS", key);
}

# SET with EX (expire in seconds)
fn redis_setex(rc, key, value, ttl_secs) {
    var av[64];
    var nb[24];
    fmt_int_buf(ttl_secs, &nb);
    var pk = _redis_pkey(rc, key);
    store64(&av, "SET");
    store64(&av + 8, pk);
    store64(&av + 16, value);
    store64(&av + 24, "EX");
    store64(&av + 32, &nb);
    var r = _resp_roundtrip(rc, &av, 5);
    _redis_pkey_free(key, pk);
    return r;
}

# --- Sorted Set (Queue) ---

fn redis_zadd(rc, key, member, score) {
    var av[64];
    var nb[24];
    fmt_int_buf(score, &nb);
    var pk = _redis_pkey(rc, key);
    store64(&av, "ZADD");
    store64(&av + 8, pk);
    store64(&av + 16, &nb);
    store64(&av + 24, member);
    var r = _resp_roundtrip(rc, &av, 4);
    _redis_pkey_free(key, pk);
    return r;
}

fn redis_zpopmin(rc, key) {
    var av[64];
    var pk = _redis_pkey(rc, key);
    store64(&av, "ZPOPMIN");
    store64(&av + 8, pk);
    store64(&av + 16, "1");
    var r = _resp_roundtrip(rc, &av, 3);
    _redis_pkey_free(key, pk);
    return r;
}

fn redis_zcard(rc, key) {
    return _redis_key_cmd(rc, "ZCARD", key);
}

# --- Pub/Sub (publish only — subscribe requires dedicated connection) ---

fn redis_publish(rc, channel, message) {
    var av[64];
    var pk = _redis_pkey(rc, channel);
    store64(&av, "PUBLISH");
    store64(&av + 8, pk);
    store64(&av + 16, message);
    var r = _resp_roundtrip(rc, &av, 3);
    _redis_pkey_free(channel, pk);
    return r;
}

# --- Hash (for rate limiter) ---

fn redis_hset(rc, key, field, value) {
    var av[64];
    var pk = _redis_pkey(rc, key);
    store64(&av, "HSET");
    store64(&av + 8, pk);
    store64(&av + 16, field);
    store64(&av + 24, value);
    var r = _resp_roundtrip(rc, &av, 4);
    _redis_pkey_free(key, pk);
    return r;
}

fn redis_hget(rc, key, field) {
    var av[64];
    var pk = _redis_pkey(rc, key);
    store64(&av, "HGET");
    store64(&av + 8, pk);
    store64(&av + 16, field);
    var r = _resp_roundtrip(rc, &av, 3);
    _redis_pkey_free(key, pk);
    return r;
}

fn redis_expire(rc, key, seconds) {
    var av[64];
    var nb[24];
    fmt_int_buf(seconds, &nb);
    var pk = _redis_pkey(rc, key);
    store64(&av, "EXPIRE");
    store64(&av + 8, pk);
    store64(&av + 16, &nb);
    var r = _resp_roundtrip(rc, &av, 3);
    _redis_pkey_free(key, pk);
    return r;
}

# --- KEYS (for heartbeat list_online) ---

fn redis_keys(rc, pattern) {
    return _redis_key_cmd(rc, "KEYS", pattern);
}

# --- EVAL (for rate limiter Lua script) ---

fn redis_eval(rc, script, num_keys, key, arg1, arg2, arg3) {
    var av[64];
    var nb[24];
    fmt_int_buf(num_keys, &nb);
    var pk = _redis_pkey(rc, key);
    store64(&av, "EVAL");
    store64(&av + 8, script);
    store64(&av + 16, &nb);
    store64(&av + 24, pk);
    store64(&av + 32, arg1);
    store64(&av + 40, arg2);
    store64(&av + 48, arg3);
    var r = _resp_roundtrip(rc, &av, 7);
    _redis_pkey_free(key, pk);
    return r;
}

# --- PING (connection test) ---

fn redis_ping(rc) {
    var av[64];
    store64(&av, "PING");
    return _resp_roundtrip(rc, &av, 1);
}
