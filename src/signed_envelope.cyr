# majra/signed_envelope — Ed25519-signed envelopes
#
# Wraps `envelope` with a sigil-backed Ed25519 signature for cross-node
# integrity. The signature covers a canonical serialization of the
# envelope fields; verifiers MUST use the same serialization.
#
# Opt-in: unsigned envelopes still flow through pub/sub, relay, etc.
# Signing is per-message and costs one Ed25519 sign (~50-100 μs under
# sigil's software impl; AES-NI-style speedup pending AES-NI in sigil).
#
# SignedEnvelope struct layout (40 bytes, 5 fields):
#   offset  0: envelope  (i64) — ptr to the inner envelope (56 B struct)
#   offset  8: signature (i64) — ptr to 64 raw bytes (Ed25519 sig)
#   offset 16: signer_pk (i64) — ptr to 32 raw bytes (the Ed25519 public key
#                                that signed it; verifiers key off this —
#                                consumers can look up trust separately)
#   offset 24: signed_at (i64) — nanoseconds since CLOCK_MONOTONIC
#   offset 32: canon_len (i64) — length of the canonical buffer (cached
#                                for debug/observability; verifier recomputes)
#
# ⚠ The inner envelope's `from`, `to_name` and `payload` MUST each be a Str or
# 0. The 56-byte envelope carries no payload length, so canonicalisation reads
# the length from the Str header: a cstr, an integer, or a raw/json object in
# any of those fields makes it copy (and sign) an arbitrary span of memory, or
# fault. A field of 0xFFFFFFFF bytes or more is refused (see below).

var SIGNED_ENV_SIG_LEN = 64;
var SIGNED_ENV_PK_LEN = 32;

# Canonical serialization of an envelope into a byte buffer.
# Layout (fixed 48 B header + 3 variable-length Str fields, length-prefixed):
#   [8] id_hi
#   [8] id_lo
#   [8] timestamp_ns
#   [8] to_kind
#   [4] from_len       [from bytes]
#   [4] to_name_len    [to_name bytes (0 bytes if to_name == 0)]
#   [4] payload_len    [payload bytes (payload is treated as a Str)]
#
# Returns a buffer pointer; length returned via ret2/rethi. Returns 0 (length
# 0) when a field's length cannot be encoded — see the length guard below.
# Canonical = deterministic: same envelope → same bytes.
# Verify's fourth result (2.9.0): the signature checks out but nothing anchored
# it to a known key. Deliberately NON-ZERO so an unchanged `== 0` caller fails
# closed rather than trusting an envelope an attacker could have re-signed.
var SIGNED_ENV_SELF_CONSISTENT = 4;

# Domain separation prefix (2.9.0). The signing input starts with these 24
# bytes, so a majra envelope signature cannot be confused with another Ed25519
# message signed under the same key: majra's canonical form is not
# self-describing, and a raw-signature key is otherwise usable for any shape.
#
# WIRE BREAK: a 2.8.x signature does not verify here, and a 2.9.0 signature
# does not verify on 2.8.x. Both sides of a signing deployment upgrade
# together. See CHANGELOG [2.9.0].
var SIGNED_ENV_DOMAIN = "majra/signed-envelope/v1";
var SIGNED_ENV_DOMAIN_LEN = 24;

fn _envelope_canonicalize(e) {
    var from = envelope_from(e);
    var to_name = envelope_to_name(e);
    var payload = envelope_payload(e);

    # A NULL field and an EMPTY field both used to canonicalise to a zero
    # length followed by zero bytes, so two structurally different envelopes —
    # one broadcast (to_name == 0), one addressed to "" — produced identical
    # signing input and a signature valid for both. Encode presence in the
    # length prefix: 0xFFFFFFFF means absent, any other value is a real length.
    var from_len = 0;
    var from_tag = 4294967295;
    if (from != 0) { from_len = str_len(from); from_tag = from_len; }
    var to_len = 0;
    var to_tag = 4294967295;
    if (to_name != 0) { to_len = str_len(to_name); to_tag = to_len; }
    var pay_len = 0;
    var pay_tag = 4294967295;
    if (payload != 0) { pay_len = str_len(payload); pay_tag = pay_len; }

    # ⚠ Length prefixes are u32 and 0xFFFFFFFF is the absent sentinel, so a
    # length >= 0xFFFFFFFF would either truncate or alias "absent" — two
    # different envelopes, one signing input. Refuse instead. This also bounds
    # `total` (no overflow) and turns the common non-Str-field mistake — a
    # garbage word read as str_len — into a refusal rather than a wild memcpy.
    # In-range envelopes canonicalise to exactly the bytes they always did.
    if (from_len < 0 || from_len >= 4294967295) { ret2(0, 0); }
    if (to_len < 0 || to_len >= 4294967295) { ret2(0, 0); }
    if (pay_len < 0 || pay_len >= 4294967295) { ret2(0, 0); }

    var hdr = SIGNED_ENV_DOMAIN_LEN + 8 + 8 + 8 + 8 + 4 + 4 + 4;
    var total = hdr + from_len + to_len + pay_len;
    var buf = fl_alloc(total);

    memcpy(buf, SIGNED_ENV_DOMAIN, SIGNED_ENV_DOMAIN_LEN);
    store64(buf + SIGNED_ENV_DOMAIN_LEN, envelope_id_hi(e));
    store64(buf + SIGNED_ENV_DOMAIN_LEN + 8, envelope_id_lo(e));
    store64(buf + SIGNED_ENV_DOMAIN_LEN + 16, envelope_timestamp(e));
    store64(buf + SIGNED_ENV_DOMAIN_LEN + 24, envelope_to_kind(e));

    var pos = SIGNED_ENV_DOMAIN_LEN + 32;
    # Write u32 big-endian length + bytes for each variable field
    store8(buf + pos, (from_tag >> 24) & 0xFF);
    store8(buf + pos + 1, (from_tag >> 16) & 0xFF);
    store8(buf + pos + 2, (from_tag >> 8) & 0xFF);
    store8(buf + pos + 3, from_tag & 0xFF);
    pos = pos + 4;
    if (from_len > 0) { memcpy(buf + pos, str_data(from), from_len); pos = pos + from_len; }

    store8(buf + pos, (to_tag >> 24) & 0xFF);
    store8(buf + pos + 1, (to_tag >> 16) & 0xFF);
    store8(buf + pos + 2, (to_tag >> 8) & 0xFF);
    store8(buf + pos + 3, to_tag & 0xFF);
    pos = pos + 4;
    if (to_len > 0) { memcpy(buf + pos, str_data(to_name), to_len); pos = pos + to_len; }

    store8(buf + pos, (pay_tag >> 24) & 0xFF);
    store8(buf + pos + 1, (pay_tag >> 16) & 0xFF);
    store8(buf + pos + 2, (pay_tag >> 8) & 0xFF);
    store8(buf + pos + 3, pay_tag & 0xFF);
    pos = pos + 4;
    if (pay_len > 0) { memcpy(buf + pos, str_data(payload), pay_len); pos = pos + pay_len; }

    ret2(buf, total);
}

# Sign an envelope. Produces a SignedEnvelope.
#   sk_ptr: Ed25519 secret key buffer. ⚠ sigil's ed25519_sign reads sk[0..32]
#           as the seed AND sk[32..64] as the cached public key, so this buffer
#           must be the 64-BYTE expanded form, not a bare 32-byte seed. Passing
#           32 bytes reads 32 bytes past the allocation and signs against
#           whatever follows it, producing signatures that never verify. The
#           comment previously said "raw 32-byte Ed25519 secret key", which is
#           what made that an easy mistake. Caller owns it; zeroize after the
#           signing session ends.
#           It must come from ed25519_keypair / ed25519_generate_keypair —
#           never be assembled by hand as seed || some externally sourced pk.
#   pk_ptr: raw 32-byte Ed25519 public key that corresponds to sk
#
# Returns 0 (no envelope) when e, sk_ptr or pk_ptr is 0, when pk_ptr differs
# from sk[32..64], or when a field length cannot be canonicalised.
#
# ⚠ The pk check exists because sigil hashes sk[32..64], not pk_ptr, into the
# signature: a mismatched pk used to yield a non-zero handle that never
# verifies. It does NOT validate sk[32..64] itself. Signing one seed under two
# different pk halves reuses R and leaks the private scalar (the
# "double public key" signing-oracle class, ed25519-dalek RUSTSEC-2022-0093);
# a caller that cannot vouch for where sk's pk half came from must re-derive
# it with ed25519_keypair(seed, …) first.
fn signed_envelope_new(e, sk_ptr, pk_ptr) {
    if (e == 0 || sk_ptr == 0 || pk_ptr == 0) { return 0; }
    if (ct_eq_bytes_lens(sk_ptr + 32, SIGNED_ENV_PK_LEN, pk_ptr, SIGNED_ENV_PK_LEN) == 0) {
        return 0;
    }
    ed25519_init();

    var canon = _envelope_canonicalize(e);
    var canon_len = rethi();
    if (canon == 0) { return 0; }

    var sig = fl_alloc(SIGNED_ENV_SIG_LEN);
    ed25519_sign(sk_ptr, canon, canon_len, sig);
    # The canonical buffer is scratch — free it once it has been signed over.
    fl_free(canon);

    var pk_copy = fl_alloc(SIGNED_ENV_PK_LEN);
    memcpy(pk_copy, pk_ptr, SIGNED_ENV_PK_LEN);

    var se = fl_alloc(40);
    store64(se, e);
    store64(se + 8, sig);
    store64(se + 16, pk_copy);
    store64(se + 24, time_now_ns());
    store64(se + 32, canon_len);
    return se;
}

# Verify a SignedEnvelope. Returns 0 if the signature is valid over the
# canonical encoding of the inner envelope and the stored public key.
# Returns non-zero on any failure: 1 malformed handle, 2 pk mismatch
# (expected_pk != 0), 3 bad signature / mismatched content / a field length
# that cannot be canonicalised — and, since 2.9.0, 4
# (SIGNED_ENV_SELF_CONSISTENT) when the signature is valid but no expected_pk
# was given, which proves self-consistency and NOT authenticity.
#
# expected_pk: if non-zero, verify that the signer_pk matches this
#              specific key (trust anchoring). PASS IT whenever the result
#              gates an action.
#
# ⚠ With expected_pk == 0 a 0 return proves only that the envelope is
# self-consistent (it detects accidental corruption). It is NOT authenticity
# and NOT integrity against an active attacker: anyone who can modify the
# message can change the payload, re-sign with their own key and swap
# signer_pk, and it still returns 0. A caller using this mode MUST check
# signed_envelope_signer_pk(se) against its own trust store before acting.
fn signed_envelope_verify(se, expected_pk) {
    if (se == 0) { return 1; }
    var e = load64(se);
    var sig = load64(se + 8);
    var signer_pk = load64(se + 16);
    if (e == 0 || sig == 0 || signer_pk == 0) { return 1; }

    if (expected_pk != 0) {
        # Constant-time compare of 32 public-key bytes
        if (ct_eq_bytes_lens(signer_pk, SIGNED_ENV_PK_LEN, expected_pk, SIGNED_ENV_PK_LEN) == 0) {
            return 2;
        }
    }

    var canon = _envelope_canonicalize(e);
    var canon_len = rethi();
    if (canon == 0) { return 3; }
    var ok = ed25519_verify(signer_pk, canon, canon_len, sig);
    # This is the UNTRUSTED path — a peer that feeds verify failures could
    # otherwise leak a payload-sized buffer per attempt.
    fl_free(canon);
    if (ok == 0) { return 3; }
    # 2.9.0: the unanchored pass has its OWN code. Through 2.8.2 it returned 0,
    # indistinguishable from an anchored pass, so a caller checking `== 0`
    # trusted an envelope an attacker could have re-signed under their own key.
    if (expected_pk == 0) { return SIGNED_ENV_SELF_CONSISTENT; }
    return 0;
}

# Verify against a known key. Identical to signed_envelope_verify with a
# non-zero expected_pk, except that it cannot be called unanchored by accident:
# a 0 key is a pk mismatch (2), never a pass. Prefer this wherever the result
# gates an action.
fn signed_envelope_verify_anchored(se, expected_pk) {
    if (expected_pk == 0) { return 2; }
    return signed_envelope_verify(se, expected_pk);
}

# Release a SignedEnvelope produced by signed_envelope_new. Does NOT free the
# inner envelope, which the caller supplied and still owns.
fn signed_envelope_free(se) {
    if (se == 0) { return 0; }
    var sig = load64(se + 8);
    var pk = load64(se + 16);
    if (sig != 0) { fl_free(sig); }
    if (pk != 0) { fl_free(pk); }
    fl_free(se);
    return 0;
}

# Accessors
fn signed_envelope_envelope(se)  { return load64(se); }
fn signed_envelope_signature(se) { return load64(se + 8); }
fn signed_envelope_signer_pk(se) { return load64(se + 16); }
fn signed_envelope_signed_at(se) { return load64(se + 24); }
fn signed_envelope_canon_len(se) { return load64(se + 32); }
