    # Fleet
    test_namespace_prefix_validation();
    test_sliding_window_evict();
    test_sliding_window_rejects_zero_window();
    test_ratelimit_subinterval_polling_accrues();
    test_mq_running_count_no_underflow();
    test_mq_concurrency_cap_holds();
    test_mq_cancel_prevents_delivery();
    test_mq_job_map_released();
    test_mq_terminate_queued_is_noop();
    test_fleet_reregister_preserves_jobs();
    test_fleet_rebalance_running_count();
    test_fleet_routing();
    test_fleet_empty_submit();
    test_fleet_submit_deregister_race();
    test_fleet_handle_survives_rebalance();
    test_fleet_rekey_on_collision();
    test_fleet_deregister_rehomes();
    test_fleet_node_id_copied();

    # DAG
    test_pubsub_unsubscribe();
    test_pubsub_lag_drop_newest();
    test_pubsub_lag_drop_oldest();
    test_pubsub_lag_unsubscribe();
    test_pubsub_default_policy_is_block();
    test_pubsub_tombstone_compaction();
    test_transport_vtable_arity();
    test_dag_serial_by_default();
    test_dag_parallel_overlaps();
    test_dag_parallel_respects_width();
    test_dag_parallel_width_clamped();
    test_dag_rejects_cycle();
    test_dag_rejects_dangling_dep();
    test_dag_rejects_duplicate_ids();
    test_dag_retry();
    test_dag_skip_policy();
    test_dag_storage_crud();
    test_dag_policy_fail_is_fail_fast();
    test_dag_non_terminal_status_is_a_failure();
    test_dag_retry_max_extremes();
    test_dag_dependency_semantics();
    test_dag_parallel_does_not_leak_per_step();

    # Transport
    test_circuit_breaker_lifecycle();
    test_connection_pool();

    # Integration
    test_integration_training_job();
    test_integration_namespaced_pubsub();

    # Last: spawns 1010 detached threads. x86_64 only — see the test's note.
    #ifdef CYRIUS_ARCH_X86
    test_cbarrier_release_wakes_over_1000();
    #endif

    return assert_summary();
}

var r = main();
# ⚠ exit_group, not SYS_EXIT (2.8.1). SYS_EXIT ends only the main thread: a
# detached worker still unwinding (test_cbarrier_release_wakes_over_1000's
# 1010 waiters, the DAG's parallel batch workers) outlived it and the process
# reported THAT thread's status — exit 0 over a failing run, which is all CI
# checks. It also let a thread parked by a failed liveness assertion hang the
# run after the summary printed. lib/syscalls_linux_common.cyr: "Prefer
# `sys_exit_group` in a program epilogue."
sys_exit_group(r);
