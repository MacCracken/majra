fn test_relay_send_subscribe() {
    var r = relay_new("node-1");
    var ch = relay_subscribe(r);

    relay_send(r, "node-2", "events/up", 42);
    var msg = chan_recv(ch);
    assert(msg != 0, "relay sub got msg");
    assert_eq(load64(msg), 1, "relay msg seq 1");

    relay_broadcast(r, "announce", 99);
    var msg2 = chan_recv(ch);
    assert_eq(load64(msg2), 2, "relay broadcast seq 2");

    var stats = relay_stats(r);
    assert_eq(load64(stats), 2, "relay 2 sent");
    println("  relay_send_subscribe: ok");
}

# --- 2.6.0: the four relay fixes ----------------------------------------

# 2.6.0: relay_receive is REENTRANT. Before it, the function stashed its
# arguments and dedup state in file-scope globals and took no lock, while every
# other mutating entry point locked `r + 40`. Two threads receiving concurrently
# raced both.
#
# The invariant: a message whose sequence strictly exceeds its own sender's last
# is ALWAYS accepted. Each worker uses its own sender id, so with correct
# per-call state there is no interaction at all and every receive must succeed.
var _rr_relay = 0;
var _rr_iters = 400;
var _rr_a_ok = 0;
var _rr_b_ok = 0;
var _rr_go = 0;

# ⚠ Every message is allocated BEFORE the worker starts, and the worker only
# reads from that pre-built array.
#
# `fl_alloc` is not thread-safe: `lib/freelist.cyr` manipulates the global
# `_fl_heads` free lists with plain loads and stores. Allocating inside the loop
# meant the two workers raced the ALLOCATOR, not the relay — they could be
# handed the same block, so a sender-a message would arrive carrying sender-b's
# sequence and be rejected as a duplicate. That is what this test was actually
# catching, intermittently, and it is not what it is for: the invariant under
# test is that `relay_receive` is reentrant.
fn _rr_worker(msgs, counter_ptr) {
    while (atomic_load(&_rr_go) == 0) { }
    var i = 0;
    var ok = 0;
    while (i < _rr_iters) {
        if (relay_receive(_rr_relay, vec_get(msgs, i)) != 0) { ok = ok + 1; }
        i = i + 1;
    }
    store64(counter_ptr, ok);
    return 0;
}

# Build `_rr_iters` messages for `sender`, sequences 1..n, on the calling thread.
fn _rr_build(sender) {
    var v = vec_new();
    var i = 1;
    while (i <= _rr_iters) {
        var m = fl_alloc(64);
        store64(m, i);
        store64(m + 8, sender);
        store64(m + 16, 0);
        store64(m + 24, "t");
        vec_push(v, m);
        i = i + 1;
    }
    return v;
}

var _rr_msgs_a = 0;
var _rr_msgs_b = 0;
fn _rr_worker_a(arg) { return _rr_worker(_rr_msgs_a, &_rr_a_ok); }
fn _rr_worker_b(arg) { return _rr_worker(_rr_msgs_b, &_rr_b_ok); }

fn test_relay_receive_is_reentrant() {
    _rr_relay = relay_new("node-1");
    _rr_a_ok = 0;
    _rr_b_ok = 0;
    _rr_go = 0;
    _rr_msgs_a = _rr_build("sender-a");
    _rr_msgs_b = _rr_build("sender-b");

    var t1 = thread_create(&_rr_worker_a, 0);
    var t2 = thread_create(&_rr_worker_b, 0);
    atomic_store(&_rr_go, 1);
    thread_join(t1);
    thread_join(t2);

    assert(_rr_a_ok == _rr_iters, "every strictly-increasing message from sender-a is accepted");
    assert(_rr_b_ok == _rr_iters, "every strictly-increasing message from sender-b is accepted");
    assert(relay_last_seq(_rr_relay, "sender-a") == _rr_iters, "sender-a's last seq is intact");
    assert(relay_last_seq(_rr_relay, "sender-b") == _rr_iters, "sender-b's last seq is intact");
    assert(load64(relay_stats(_rr_relay) + 16) == 0, "no message was wrongly dropped as a duplicate");

    println("  relay_receive_is_reentrant: ok");
}

fn test_relay_incoming_broadcast_flag() {
    var r = relay_new("node-1");

    # A message with no explicit target is a broadcast.
    var m1 = fl_alloc(64);
    store64(m1, 1); store64(m1 + 8, "node-2"); store64(m1 + 16, 0); store64(m1 + 24, "ann");
    var inc1 = relay_receive_ex(r, m1);
    assert(inc1 != 0, "relay_receive_ex accepts a broadcast");
    assert(incoming_is_broadcast(inc1) == 1, "and flags it as a broadcast");
    assert(incoming_msg(inc1) == m1, "and carries the original message");

    # A message addressed to this node is NOT a broadcast. Before 2.6.0 this
    # distinction was computed and then discarded.
    var m2 = fl_alloc(64);
    store64(m2, 2); store64(m2 + 8, "node-2"); store64(m2 + 16, "node-1"); store64(m2 + 24, "cmd");
    var inc2 = relay_receive_ex(r, m2);
    assert(inc2 != 0, "relay_receive_ex accepts a targeted message");
    assert(incoming_is_broadcast(inc2) == 0, "and flags it as NOT a broadcast");

    # An empty-string target is a broadcast too, matching _recv_check_target.
    var m3 = fl_alloc(64);
    store64(m3, 3); store64(m3 + 8, "node-2"); store64(m3 + 16, ""); store64(m3 + 24, "ann");
    assert(incoming_is_broadcast(relay_receive_ex(r, m3)) == 1,
    "an empty target string is a broadcast");

    # relay_receive stays backward compatible: same accept/drop decision, and it
    # answers the bare message rather than the wrapper.
    var m4 = fl_alloc(64);
    store64(m4, 4); store64(m4 + 8, "node-2"); store64(m4 + 16, 0); store64(m4 + 24, "ann");
    assert(relay_receive(r, m4) == m4, "relay_receive still returns the message itself");

    println("  relay_incoming_broadcast_flag: ok");
}

fn test_relay_last_seq_and_gaps() {
    var r = relay_new("node-1");

    assert(relay_last_seq(r, "node-2") == 0 - 1, "an unknown sender has no last seq");

    var m1 = fl_alloc(64);
    store64(m1, 1); store64(m1 + 8, "node-2"); store64(m1 + 16, 0); store64(m1 + 24, "t");
    relay_receive(r, m1);
    assert(relay_last_seq(r, "node-2") == 1, "last seq tracks the first message");
    assert(load64(relay_stats(r) + 40) == 0, "a first message at seq 1 is not a gap");

    # Contiguous: no gap.
    var m2 = fl_alloc(64);
    store64(m2, 2); store64(m2 + 8, "node-2"); store64(m2 + 16, 0); store64(m2 + 24, "t");
    relay_receive(r, m2);
    assert(relay_last_seq(r, "node-2") == 2, "last seq advances");
    assert(load64(relay_stats(r) + 40) == 0, "a contiguous sequence records no gap");

    # Jump from 2 to 5: messages 3 and 4 were lost.
    var m5 = fl_alloc(64);
    store64(m5, 5); store64(m5 + 8, "node-2"); store64(m5 + 16, 0); store64(m5 + 24, "t");
    assert(relay_receive(r, m5) != 0, "a gapped message is still DELIVERED");
    assert(load64(relay_stats(r) + 40) == 1, "but the gap is counted");
    assert(relay_last_seq(r, "node-2") == 5, "and last seq jumps to the new value");

    # A first message from a NEW sender at seq > 1 also skipped messages.
    var m9 = fl_alloc(64);
    store64(m9, 9); store64(m9 + 8, "node-7"); store64(m9 + 16, 0); store64(m9 + 24, "t");
    relay_receive(r, m9);
    assert(load64(relay_stats(r) + 40) == 2, "a new sender starting past seq 1 is a gap");

    # A duplicate is dropped and is NOT a gap.
    var dup = fl_alloc(64);
    store64(dup, 5); store64(dup + 8, "node-2"); store64(dup + 16, 0); store64(dup + 24, "t");
    assert(relay_receive(r, dup) == 0, "a replayed sequence is dropped");
    assert(load64(relay_stats(r) + 40) == 2, "and a duplicate is not counted as a gap");
    assert(load64(relay_stats(r) + 16) == 1, "it is counted as a duplicate instead");

    println("  relay_last_seq_and_gaps: ok");
}

fn test_relay_stats_layout_unchanged() {
    # 2.6.0 APPENDED sequence_gaps at offset 40, so every pre-existing offset
    # must still mean what it did. A reader compiled against 2.5.x keeps working.
    var r = relay_new("node-1");
    relay_send(r, "node-2", "t", 1);
    var m = fl_alloc(64);
    store64(m, 1); store64(m + 8, "node-2"); store64(m + 16, 0); store64(m + 24, "t");
    relay_receive(r, m);

    var st = relay_stats(r);
    assert(load64(st) == 1, "offset 0 is still messages_sent");
    assert(load64(st + 8) == 1, "offset 8 is still messages_received");
    assert(load64(st + 16) == 0, "offset 16 is still duplicates_dropped");
    assert(load64(st + 24) == 0, "offset 24 is still dedup_evicted");
    assert(load64(st + 32) == 1, "offset 32 is still dedup_table_size");
    assert(load64(st + 40) == 0, "offset 40 is the new sequence_gaps");

    println("  relay_stats_layout_unchanged: ok");
}

fn test_relay_skip_routing() {
    var r = relay_new("node-1");

    # Skip own message
    var m1 = fl_alloc(64);
    store64(m1, 1); store64(m1 + 8, "node-1"); store64(m1 + 16, ""); store64(m1 + 24, "t");
    assert(relay_receive(r, m1) == 0, "relay skip own");

    # Skip message for other node
    var m2 = fl_alloc(64);
    store64(m2, 1); store64(m2 + 8, "node-3"); store64(m2 + 16, "node-99"); store64(m2 + 24, "t");
    assert(relay_receive(r, m2) == 0, "relay skip other target");

    # Accept broadcast from other node
    var m3 = fl_alloc(64);
    store64(m3, 1); store64(m3 + 8, "node-2"); store64(m3 + 16, 0); store64(m3 + 24, "ann");
    store64(m3 + 40, time_now_ns());
    assert(relay_receive(r, m3) != 0, "relay accept broadcast");

    # Accept targeted message
    var m4 = fl_alloc(64);
    store64(m4, 2); store64(m4 + 8, "node-2"); store64(m4 + 16, "node-1"); store64(m4 + 24, "cmd");
    store64(m4 + 40, time_now_ns());
    assert(relay_receive(r, m4) != 0, "relay accept targeted");

    println("  relay_skip_routing: ok");
}

# =============================================================================
# Barrier — expanded tests (Rust: 17 tests)
# =============================================================================

fn test_barrier_duplicate_arrival() {
    var bs = barrier_set_new();
    var parts = vec_new();
    vec_push(parts, "a"); vec_push(parts, "b");
    barrier_create(bs, "dup-test", parts);

    barrier_arrive(bs, "dup-test", "a");
    barrier_arrive(bs, "dup-test", "a");
    var r = barrier_arrive(bs, "dup-test", "a");
    assert_eq(load64(r), BARRIER_WAITING, "dup still waiting");
    assert_eq(load64(r + 8), 1, "dup arrived count 1");

    barrier_arrive(bs, "dup-test", "b");
    println("  barrier_duplicate_arrival: ok");
}

fn test_cbarrier_force() {
    var cbs = cbarrier_set_new();
    var parts = vec_new();
    vec_push(parts, "x"); vec_push(parts, "y"); vec_push(parts, "z");
    cbarrier_create(cbs, "force-test", parts);

    cbarrier_arrive(cbs, "force-test", "x");
    var r = cbarrier_force(cbs, "force-test", "z");
    assert_eq(load64(r), BARRIER_WAITING, "force still waiting with x,y");

    var r2 = cbarrier_force(cbs, "force-test", "y");
    assert_eq(load64(r2), BARRIER_RELEASED, "force released after y removed");
    println("  cbarrier_force: ok");
}

# --- arrive_and_wait with threads (mirrors Rust async_arrive_and_wait test) ---

# Globals for thread workers
var _aaw_cbs = 0;
var _aaw_done_count = 0;
var _aaw_done_mutex = 0;

fn _aaw_worker(participant) {
    var ret = cbarrier_arrive_and_wait(_aaw_cbs, "sync-mt", participant);
    # If we get here, barrier released
    mutex_lock(_aaw_done_mutex);
    _aaw_done_count = _aaw_done_count + 1;
    mutex_unlock(_aaw_done_mutex);
    return 0;
}

fn test_cbarrier_arrive_and_wait() {
    # Non-blocking path
    var cbs = cbarrier_set_new();
    var parts = vec_new();
    vec_push(parts, "a"); vec_push(parts, "b");
    cbarrier_create(cbs, "sync", parts);
    var r1 = cbarrier_arrive(cbs, "sync", "a");
    assert_eq(load64(r1), BARRIER_WAITING, "aaw non-blocking waiting");
    var r2 = cbarrier_arrive(cbs, "sync", "b");
    assert_eq(load64(r2), BARRIER_RELEASED, "aaw non-blocking released");

    # Blocking path — 3 threads, each calls cbarrier_arrive_and_wait;
    # none return until the barrier is fully populated. Previously
    # crashed under 5.4.8 due to an RBP/child-stack race in
    # thread_create's clone sequence — fixed upstream in cyrius 5.4.10
    # (see the thread.cyr _thread_spawn inline-asm trampoline).
    _aaw_cbs = cbarrier_set_new();
    _aaw_done_count = 0;
    _aaw_done_mutex = mutex_new();

    var p3 = vec_new();
    vec_push(p3, "t1"); vec_push(p3, "t2"); vec_push(p3, "t3");
    cbarrier_create(_aaw_cbs, "sync-mt", p3);

    var th1 = thread_create(&_aaw_worker, "t1");
    var th2 = thread_create(&_aaw_worker, "t2");
    var th3 = thread_create(&_aaw_worker, "t3");
    assert(th1 != 0, "thread t1 spawned");
    assert(th2 != 0, "thread t2 spawned");
    assert(th3 != 0, "thread t3 spawned");

    thread_join(th1);
    thread_join(th2);
    thread_join(th3);
    assert_eq(_aaw_done_count, 3, "all three threads released from barrier");

    println("  cbarrier_arrive_and_wait: ok");
}


