# keccak / random precede sigil — sigil 3.9.8's ML-DSA + AES-GCM surface
# references shake256 / `_keccak_*` and `random_bytes` (single-pass fwd-ref).
include "lib/keccak.cyr"
include "lib/random.cyr"

# sys precedes sigil — sigil 3.12.18 (cyrius 6.6.4) routes `agnosys_uname`
# through `sys_uname` instead of a raw x86_64 `syscall(63, …)`, which on
# aarch64-Linux is read(2). Without this line the build still reports OK
# but warns `undefined function 'sys_uname'` and lowers it to a trapping ud2.
include "lib/sys.cyr"

# sigil (vendored dist, 2.8.4+) provides AES-256-GCM consumed by ipc_encrypted.
include "lib/sigil.cyr"

