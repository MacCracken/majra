# tests/test_patra_queue.tcyr — durable queue via patra
#
# Separate compilation unit from test_backends to avoid exhausting
# the cc5 16384-fixup cap. Includes only what patra_queue actually
# pulls on: core queue constants + patra stdlib.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/hashmap.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/thread.cyr"
include "lib/assert.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/sakshi.cyr"
include "lib/patra.cyr"

include "src/error.cyr"
include "src/counter.cyr"
include "src/envelope.cyr"
include "src/metrics.cyr"
include "src/queue.cyr"
include "src/patra_queue.cyr"

fn test_patra_queue() {
    patra_init();
    # Use /tmp for the test db; unlink first if it exists.
    sys_unlink("/tmp/majra_patra_queue_test.patra");

    var q = patra_queue_new("/tmp/majra_patra_queue_test.patra");
    assert(q != 0, "patra_queue opened");
    assert_eq(patra_queue_queued_count(q), 0, "fresh queue is empty");

    var id1 = patra_queue_enqueue(q, PRIORITY_NORMAL, "job-normal");
    var id2 = patra_queue_enqueue(q, PRIORITY_CRITICAL, "job-critical");
    var id3 = patra_queue_enqueue(q, PRIORITY_LOW, "job-low");
    assert(id1 != 0, "enqueue 1 returned id");
    assert(id2 != 0, "enqueue 2 returned id");
    assert(id3 != 0, "enqueue 3 returned id");
    assert_eq(patra_queue_queued_count(q), 3, "3 jobs queued");

    # Dequeue should return critical first.
    var job1 = patra_queue_dequeue(q);
    assert(job1 != 0, "dequeue returned a job");
    assert_eq(patra_job_priority(job1), PRIORITY_CRITICAL, "critical dequeued first");
    # The payload round-trip was never asserted, so the copy at
    # patra_queue_dequeue was entirely unverified.
    assert_eq(streq(patra_job_payload(job1), "job-critical"), 1, "job1 payload round-trips");
    assert_eq(patra_queue_queued_count(q), 2, "2 queued after dequeue");
    assert_eq(patra_queue_running_count(q), 1, "1 running");

    patra_queue_complete(q, patra_job_id(job1));
    assert_eq(patra_queue_running_count(q), 0, "0 running after complete");
    assert_eq(patra_queue_completed_count(q), 1, "1 completed");

    # Second dequeue → normal priority
    var job2 = patra_queue_dequeue(q);
    assert_eq(patra_job_priority(job2), PRIORITY_NORMAL, "normal dequeued second");

    patra_queue_close(q);

    # Reopen and verify persistence.
    var q2 = patra_queue_new("/tmp/majra_patra_queue_test.patra");
    assert(q2 != 0, "reopen");
    assert_eq(patra_queue_queued_count(q2), 1, "reopen: 1 queued persisted");
    assert_eq(patra_queue_running_count(q2), 1, "reopen: 1 running persisted");
    assert_eq(patra_queue_completed_count(q2), 1, "reopen: 1 completed persisted");

    patra_queue_close(q2);
    sys_unlink("/tmp/majra_patra_queue_test.patra");
    println("  patra_queue: ok");
}

# 2.6.9 regressions: SQL injection through the payload, the swallowed
# patra_exec return, and the 255-byte STR cap that silently dropped jobs.
fn test_patra_queue_hardening() {
    patra_init();
    sys_unlink("/tmp/majra_patra_hardening_test.patra");
    var q = patra_queue_new("/tmp/majra_patra_hardening_test.patra");
    assert(q != 0, "hardening queue opened");

    #
    # SQL injection: the payload used to be spliced into a quoted SQL literal,
    # so a quote closed the literal and rewrote the columns after it. These
    # payloads must survive byte-for-byte.
    var before = patra_queue_queued_count(q);
    var inj_id = patra_queue_enqueue(q, PRIORITY_NORMAL, "it's a job");
    assert(inj_id != 0, "enqueue with an apostrophe returns an id");
    assert_eq(patra_queue_queued_count(q), before + 1, "apostrophe payload actually committed");

    var evil = "x', 2, 0) y '";
    var evil_id = patra_queue_enqueue(q, PRIORITY_LOW, evil);
    assert(evil_id != 0, "enqueue with injection payload returns an id");
    assert_eq(patra_queue_queued_count(q), before + 2, "injection payload committed as data");

    # A long payload: the column was STR (patra caps it at 255) and the
    # rejection was swallowed, so enqueue reported success and dropped the job.
    var big = fl_alloc(1200);
    memset(big, 122, 1199);
    store8(big + 1199, 0);
    var big_id = patra_queue_enqueue(q, PRIORITY_LOW, big);
    assert(big_id != 0, "enqueue of a 1199-byte payload returns an id");
    assert_eq(patra_queue_queued_count(q), before + 3, "long payload actually committed (TEXT column)");

    # Drain and verify the injection payload comes back verbatim.
    var found_evil = 0;
    var drain = patra_queue_dequeue(q);
    while (drain != 0) {
        if (streq(patra_job_payload(drain), evil) == 1) { found_evil = 1; }
        patra_queue_complete(q, patra_job_id(drain));
        patra_job_free(drain);
        drain = patra_queue_dequeue(q);
    }
    assert_eq(found_evil, 1, "injection payload stored and returned verbatim");
    assert_eq(patra_queue_queued_count(q), 0, "queue drained");

    # A status update for an id that does not exist must report no-op, not
    # success — the patra_exec return used to be discarded entirely.
    assert_eq(patra_queue_complete(q, 999999), 0, "complete on a missing id reports 0 rows");

    patra_queue_close(q);
    sys_unlink("/tmp/majra_patra_hardening_test.patra");
    println("  patra_queue_hardening: ok");
}

fn main() {
    alloc_init();
    fl_init();
    println("=== majra patra_queue tests ===");
    test_patra_queue();
    test_patra_queue_hardening();
    return assert_summary();
}

var r = main();
syscall(SYS_EXIT, r);
